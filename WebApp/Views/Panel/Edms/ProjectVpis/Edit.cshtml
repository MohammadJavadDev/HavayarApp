@using Entities.App.Edms;
@using Entities.Auth
@model ProjectVpis
<div class="card">
	<div class="form-action-buttons"><form-action-buttons entity-type="typeof(ProjectVpis)"></form-action-buttons></div>
	<div class="card-body row">
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class="col-md-3 form-group-inline">
			<label class="form-label">پروژه</label>
			@(Html.EntitySelector<Project>
						(
						"ProjectNameIdSelector",
						c => c.IsActive == Entities.Base.IsActiveEnum.Active,
						c => new
						{
							Id = c.Id,
							Name = c.Name,

						},
						c => new { c.Name },
						"{Name}",
						"ProjectNameId",
						null,
						Model?.ProjectNameId.ToString(),
						true
						))
 		</div>

		<div class='col-md-3 form-group-inline'>
			<label class=''>کد</label>
			<input class='form-control' data-bind='code'  asp-for='Code' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3 form-group-inline'>
			<label class=''>عنوان</label>
			<input class='form-control' data-bind='title'  asp-for='Title' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3 form-group-inline'>
			<label class=''>وزن</label>
			<input class='form-control' data-bind='weight' data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+([\\.][\u06F0-\u06F90-9]{1,2})?$'" placeholder="مثال: ۱۲۳.۴۵" asp-for='Weight' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3 form-group-inline'>
			<label class=''>نوع</label>
			<select class='form-control' data-bind='type'  asp-for='Type' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Edms.Enums.ProjectVpisDocTypeEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3 form-group-inline'>
			<label class=''>کلاس مدرک</label>
			<select class='form-control' data-bind='classDocument'  asp-for='ClassDocument' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Edms.Enums.ProjectVpisClassDocumentEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3 form-group-inline'>
			<label class=''>دیسپلین</label>
			<select class='form-control' data-bind='displaying'  asp-for='Displaying' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Edms.Enums.ProjectVpisDisplayingEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3 form-group-inline'>
			<label class=''>سایز صفحه</label>
			<select class='form-control' data-bind='pageSize'  asp-for='PageSize' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Edms.Enums.ProjectVpisPageSizeEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3 form-group-inline'>
			<label class=''>تاریخ مبنای اولین مدرک</label>
			<input class='form-control' data-bind='firstDegreeDocumentShamsiDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true}' value='@Model?.FirstDegreeDocumentMiladiDate' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>
		 

		<div class='col-md-3 form-group-inline'>
			<label class=''>تاریخ برنامه جایگزین</label>
			<input class='form-control' data-bind='replaceShamsiDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true}' value='@Model?.ReplaceMiladiDate' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		 
		<div class="col-md-12">

		</div>
		<div class='col-md-6 form-group-inline'>
			<label class=''>نفر ساعت برای ریویژن 00</label>
			<input class='form-control ltr' data-bind='personHourRevisionZero' data-invalidMessage='فقط عداد' type="text" data-inputmask="'mask': '999:99'"   />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6 form-group-inline'>
			<label class=''>نفر ساعت برای ریویژن 01</label>
			<input class='form-control ltr' data-bind='personHourRevisionOne' data-invalidMessage='فقط عداد' type="text" data-inputmask="'mask': '999:99'"  />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6 form-group-inline'>
			<label class=''>نفر ساعت برای ریویژن 02</label>
			<input class='form-control ltr' data-bind='personHourRevisionTwo' data-invalidMessage='فقط عداد' type="text" data-inputmask="'mask': '999:99'"   />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6 form-group-inline'>
			<label class=''>نفر ساعت برای ریویژن 03</label>
			<input class='form-control ltr' data-bind='personHourRevisionThree' data-invalidMessage='فقط عداد' type="text" data-inputmask="'mask': '999:99'"   />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6 form-group-inline">
			<label class="form-label">بررسی کنندگان مدرک</label>
			@(Html.EntitySelector<User>
						(
						"BeneficiaryUnitIdSelector",
						c => c.IsActive == Entities.Base.IsActiveEnum.Active,
						c => new
						{
							Id = c.Id,
							Name = c.Name,

						},
						c => new { c.Name },
						"{Name}",
						"ReviewersId",
						"ReviewerNames",
						Model?.ReviewersId,
						true,
						true
						))
 		</div>

		<div class="col-md-6 form-group-inline">
			<label class="form-label">تایید کننده</label>
			@(Html.EntitySelector<User>
						(
						"ApproverIdSelector",
						c => c.IsActive == Entities.Base.IsActiveEnum.Active,
						c => new
						{
							Id = c.Id,
							Name = c.Name,

						},
						c => new { c.Name },
						"{Name}",
						"ApproverId",
						null,
						Model?.ApproverId.ToString(),
						true
						))
 		</div>

		<div class="col-md-6 form-group-inline">
			<label class="form-label">تهیه کننده</label>
			@(Html.EntitySelector<User>
						(
						"ProducerIdSelector",
						c => c.IsActive == Entities.Base.IsActiveEnum.Active,
						c => new
						{
							Id = c.Id,
							Name = c.Name,

						},
						c => new { c.Name },
						"{Name}",
						"ProducerId",
						null,
						Model?.ProducerId.ToString(),
						true
						))
		</div>

		<div class='col-md-12 form-group-inline'>
			<label class=''>توضیحات</label>
			<input class='form-control' data-bind='description'  asp-for='Description' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 

	</div>
	<div class='card-footer row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>
	debugger
	  
	var personHourRevisionZero = @(Model?.PersonHourRevisionZero ?? 0)
	var personHourRevisionOne  = @(Model?.PersonHourRevisionOne ?? 0)
	var personHourRevisionTwo  = @(Model?.PersonHourRevisionTwo ?? 0)
	var personHourRevisionThree  = @(Model?.PersonHourRevisionThree ?? 0)

	var normalizeForInputpersonHourRevisionZero = String(MJUtil.minutesToTimeFormat(personHourRevisionZero)).padStart(6, "0")
	var normalizeForInputpersonHourRevisionOne = String(MJUtil.minutesToTimeFormat(personHourRevisionOne)).padStart(6, "0")
	var normalizeForInputpersonHourRevisionTwo = String(MJUtil.minutesToTimeFormat(personHourRevisionTwo)).padStart(6, "0")
	var normalizeForInputpersonHourRevisionThree = String(MJUtil.minutesToTimeFormat(personHourRevisionThree)).padStart(6, "0")

	 
	 $("[data-bind=personHourRevisionZero]").val(normalizeForInputpersonHourRevisionZero)
	 $("[data-bind=personHourRevisionOne]").val(normalizeForInputpersonHourRevisionOne)
	 $("[data-bind=personHourRevisionTwo]").val(normalizeForInputpersonHourRevisionTwo)
	 $("[data-bind=personHourRevisionThree]").val(normalizeForInputpersonHourRevisionThree)

	function savefn($btnAction) {
		if (validateError($$('.card'))) { return; }
		var model = $$('.card').dataBind();
		const $btn = $(this.element).block();

			let spliter= [];
			if(model.personHourRevisionZero)
			{
				spliter= model.personHourRevisionZero.split(":")
			 model.personHourRevisionZero = spliter[0] *60 + spliter[1]
			}

			if(model.personHourRevisionOne)
			{
				 spliter= model.personHourRevisionOne.split(":")
			 model.personHourRevisionOne = spliter[0] *60 + spliter[1]
			}

			if(model.personHourRevisionTwo)
			{
				spliter= model.personHourRevisionTwo.split(":")
			 model.personHourRevisionTwo = spliter[0] *60 + spliter[1]
			}

			if(model.personHourRevisionThree)
			{
				 spliter= model.personHourRevisionThree.split(":")
				 model.personHourRevisionThree = spliter[0] *60 + spliter[1]
			}

		 
		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				
				 $$("[data-bind='id']").val(r.data.id)
				$btnAction.baseaction();
			})
	}

	self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
</script>

@using Entities.App.Inv
@model VchType

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(VchType)"></form-action-buttons>
	</div>
	<div class="card-body">
		<div class="row mb-4">
			<div class="col-12">
				<h4 class="fw-bold text-dark mb-0">نوع رسید انبار</h4>
			</div>
		</div>
		<input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
		<div class="row g-3">
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">عنوان</label>
				<input class="form-control" data-bind="title" data-required="true" asp-for="Title" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">شناسه راهکاران</label>
				<input class="form-control" data-bind="hamkaranId" data-required="true" asp-for="HamkaranId"
					data-invalidMessage="فقط عدد" data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
		</div>
	</div>
</div>

<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;

		var model = page.$pageEl.dataBind();
		const $btn = $($btnAction.element).block();

		$$.post('save', model, function (r) {
			$btn.block(false);

			if (!r.isSuccess) {
				toastr.error(r.message, 'خطا');
				return;
			}

			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			$btnAction.baseaction();
		});
	}

	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>

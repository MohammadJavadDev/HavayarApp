@using Entities.App.Hrm
@using Entities.App.Inv
@using Entities.App.Sale
@using Entities.App.Sale.Enums
@using Entities.Base
@model ProductActivityItem

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(ProductActivityItem)"></form-action-buttons>
	</div>
	<div class="card-body">
		<div class="row mb-4"><div class="col-12"><h4 class="fw-bold text-dark mb-0">جزئیات سرویس دوره‌ای</h4></div></div>
		<input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
		<input class="form-control" data-bind="htsId" value="@Model?.HtsId" type="hidden" />
		<div class="row g-3">
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">کالای محصول</label>
				@(Html.EntitySelector<Part>(
					"ProductActivityItemProductSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Code = c.Code, Name = c.Name },
					c => new { c.Code, c.Name },
					"{Code} {Name}",
					"productId",
					"productName",
					Model?.ProductId?.ToString()
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">قطعه</label>
				@(Html.EntitySelector<Part>(
					"ProductActivityItemPartSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Code = c.Code, Name = c.Name },
					c => new { c.Code, c.Name },
					"{Code} {Name}",
					"partId",
					"partName",
					Model?.PartId?.ToString()
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold required">نوع فعالیت</label>
				<select class="form-control" data-bind="activityType" data-required="true" asp-for="ActivityType" asp-items="Html.GetEnumSelectList(typeof(ProductActivityTypeEnum))">
					<option value="">انتخاب کنید</option>
				</select>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-8 form-group-inline">
				<label class="form-label fw-bold">عنوان اقدام</label>
				<input class="form-control" data-bind="actionTitle" asp-for="ActionTitle" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">مجری</label>
				<select class="form-control" data-bind="executiveCompany" asp-for="ExecutiveCompany" asp-items="Html.GetEnumSelectList(typeof(ActivityExecutorEnum))">
					<option value="">انتخاب کنید</option>
				</select>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-2 form-group-inline">
				<label class="form-label fw-bold">مدت</label>
				<input class="form-control" data-bind="duration" asp-for="Duration" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-2 form-group-inline">
				<label class="form-label fw-bold">مقدار</label>
				<input class="form-control" data-bind="mount" asp-for="Mount" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">هزینه سرویس</label>
				<input class="form-control" data-bind="serviceCost" asp-for="ServiceCost" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">واحد سازمانی</label>
				@(Html.EntitySelector<OrgUnit>(
					"ProductActivityItemOrgSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Title = c.Title },
					c => new { c.Title },
					"{Title}",
					"relevantOrganizationUnitId",
					"relevantOrganizationUnitTitle",
					Model?.RelevantOrganizationUnitId?.ToString()
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
		</div>
	</div>
</div>
<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;
		const model = page.$pageEl.dataBind();
		const $btn = $($btnAction.element).block();
		$$.post('save', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			$btnAction.baseaction();
		});
	}
	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>

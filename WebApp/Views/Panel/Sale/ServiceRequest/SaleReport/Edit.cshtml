<script>

     const serviceRequestId = sessionStorage.getItem("ServiceRequestId") || "@Model?.ServiceRequestId";


        function formatTimeInput($input) {
         if (!$input || $input.length === 0) return;

         var val = $input.val().replace(/[^0-9]/g, '');

         if (val.length === 0) {
             $input.val('');
             return '';
         }

         if (val.length >= 3) {
             var hours = val.substring(0, val.length - 2);
             var minutes = val.substring(val.length - 2);


             if (hours.length === 1) hours = '0' + hours;
             var hourNum = parseInt(hours);
             var minuteNum = parseInt(minutes);

             if (hourNum > 23) hours = '23';
             if (minuteNum > 59) minutes = '59';

             var formattedTime = hours + ':' + minutes;
             $input.val(formattedTime);

             return formattedTime;
         } else {
             $input.val(val);
             return val;
         }
     }

     $(document).ready(function() {
         $(document).on('blur', '.time-input', function() {
             formatTimeInput($(this));
         });

         $(document).on('input', '.time-input', function() {
             var val = $(this).val().replace(/[^0-9]/g, '');
             if (val.length > 4) {
                 val = val.substring(0, 4);
             }
             $(this).val(val);
         });

         $(document).on('keydown', '.time-input', function(e) {
             if (e.key === 'Backspace' || e.key === 'Delete' || e.key === 'Tab' ||
                 e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === 'Home' ||
                 e.key === 'End' || e.key === 'Enter') {
                 return;
             }

             if (!/^[0-9]$/.test(e.key)) {
                 e.preventDefault();
                 return false;
             }
         });
     });


     function savefn($btnAction) {

         if (validateError(page.$pageEl)) return;

         const model = page.$pageEl.dataBind();
         model.ServiceRequestId = serviceRequestId || sessionStorage.getItem("ServiceRequestId");
         const $btn = $(this.element).block();

         $$.post('save', model, function(r) {

             $btn.block(false);

             if (!r.isSuccess) {
                 toastr.error(r.message, 'خطا');
                 return;
             }

             toastr.success('ذخیره سازی با موفقیت انجام شد');

             page.$pageEl.dataBind(r.data);

             const parentId = r.data?.serviceRequestId || r.data?.ServiceRequestId || model.ServiceRequestId || serviceRequestId;
             if (typeof window.reloadSaleReportList === 'function' && parentId) {
                 window.reloadSaleReportList(parentId);
             }

             $btnAction.baseaction();
         });
     }

     self.FormActionButtons.save.onclick(function() { savefn(this); });
     self.FormActionButtons.saveandnew.onclick(function() { savefn(this); });
     self.FormActionButtons.saveandclose.onclick(function() { savefn(this); });

</script>
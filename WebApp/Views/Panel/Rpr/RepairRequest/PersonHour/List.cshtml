@using Entities.App.Rpr
@using Newtonsoft.Json;
@using System.Text.Json;
@model List<RepairRequestManHours>

<div class="container-fluid">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover" id="manHoursListTable" style="width: 100%; table-layout: fixed;">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 8%">ردیف</th>
                            <th style="width: 15%">کاربر</th>
                            <th style="width: 10%">تاریخ</th>
                            <th style="width: 10%">ساعت شروع</th>
                            <th style="width: 10%">ساعت پایان</th>
                            <th style="width: 12%">هزینه نفر ساعت</th>
                            <th style="width: 12%">هزینه فروش</th>
                            <th style="width: 15%">مجموع ساعت کارکرد</th>
                            <th style="width: 20%">توضیحات</th>
                            <th style="width: 10%">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            var index = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td class="text-end">@(item.Personel != null ? $"{item.Personel.Name} {item.Personel.Family} ({item.Personel.Code})" : "-")</td>
                                    <td>@(item.WorkDate ?? "-")</td>
                                    <td>@(item.StartTime ?? "-")</td>
                                    <td>@(item.EndTime ?? "-")</td>
                                    <td class="text-end">@(item.ManHourPrice?.ToString("N0") ?? "-")</td>
                                    <td class="text-end">@(item.ManHourSalePrice?.ToString("N0") ?? "-")</td>
                                    <td class="text-end">@(item.TotalWorkingHours ?? "-")</td>
                                    <td style="max-width:200px; white-space:normal; word-wrap:break-word;">@(item.Comment ?? "-")</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="deleteManHours(@item.Id)">
                                            <i class="fa fa-trash"></i> حذف
                                        </button>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function deleteManHours(id) {
        Swal.fire({
            title: 'آیا اطمینان دارید؟',
            text: "این عملیات غیرقابل بازگشت است!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'بله، حذف شود',
            cancelButtonText: 'انصراف'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: `/Panel/Rpr/RepairRequestManHours/DeleteManHours?id=${id}`,
                    type: 'DELETE',
                    dataType: 'json',
                    success: function (response) {
                        if (response && response.data && response.data.success === true) {
                            toastr.success(response.data.message || 'رکورد با موفقیت حذف شد');
                            if (typeof $$ !== 'undefined' && $$.confirm) {
                                $$.confirm.close();
                            }
                            location.reload();
                        } else {
                            const errorMessage = response?.data?.message || response?.message || 'خطا در حذف رکورد';
                            toastr.error(errorMessage);
                        }
                    },
                    error: function (xhr) {
                        let errorMessage = 'خطا در حذف رکورد';
                        if (xhr.status === 404) {
                            try {
                                const response = JSON.parse(xhr.responseText);
                                errorMessage = response?.data?.message || response?.message || 'رکورد مورد نظر یافت نشد';
                            } catch(e) {
                                errorMessage = 'رکورد مورد نظر یافت نشد';
                            }
                        } else if (xhr.responseJSON && xhr.responseJSON.data) {
                            errorMessage = xhr.responseJSON.data.message || xhr.responseJSON.message || errorMessage;
                        } else if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        } else if (xhr.responseText) {
                            try {
                                const response = JSON.parse(xhr.responseText);
                                errorMessage = response?.data?.message || response?.message || errorMessage;
                            } catch(e) {
                                errorMessage = xhr.responseText;
                            }
                        }
                        toastr.error(errorMessage);
                    }
                });
            }
        });
    }

        $(document).ready(function () {

        if ($.fn.DataTable.isDataTable('#manHoursListTable')) {
            $('#manHoursListTable').DataTable().clear().destroy();
        }

        $('#manHoursListTable').DataTable({
            destroy: true,
            autoWidth: false,
            pageLength: 10,
            order: [[2, 'desc']],
            language: {
                emptyTable: "هیچ اطلاعاتی یافت نشد",
                zeroRecords: "هیچ اطلاعاتی یافت نشد",
                infoEmpty: "نمایش 0 تا 0 از 0 آیتم",
                search: "جستجو:",
                lengthMenu: "نمایش _MENU_ آیتم در هر صفحه",
                info: "نمایش _START_ تا _END_ از _TOTAL_ آیتم",
                paginate: {
                    first: "اول",
                    last: "آخر",
                    next: "بعدی",
                    previous: "قبلی"
                }
            }
        });
    });
</script>

<style>
    #manHoursListTable {
        width: 100% !important;
    }

        #manHoursListTable thead th {
            white-space: nowrap;
            background-color: #343a40;
            color: white;
        }

        #manHoursListTable tbody tr:hover {
            background-color: #f5f5f5;
        }

        #manHoursListTable td {
            vertical-align: middle;
        }

    .dataTables_wrapper .dataTable {
        table-layout: fixed !important;
    }
</style>
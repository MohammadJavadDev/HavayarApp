	function viewCommentsList() {
		const productionOrderItemId = $$('#changeDataSection [data-bind="id"]').val();
		if (!productionOrderItemId || productionOrderItemId == '0') {
			toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید');
			return;
		}

		const url = `/Panel/ProductionOrderItem/ProductionOrderItemCommentListPartial?productionOrderItemId=${productionOrderItemId}`;
		
		$$.get(url, function(result) {
			let bodyCn = `<div style="overflow-x: auto; max-height: 70vh; overflow-y: auto;">${result}</div>`;
			$.confirm({
				title: 'تاریخچه تغییر وضعیت',
				columnClass: 'col-md-12',
				content: bodyCn,
				rtl: true,
				buttons: {
					close: {
						text: 'بستن',
						btnClass: 'btn-secondary'
					}
				},
				onContentReady: function () {
					// اطمینان از کارکرد تب‌های Bootstrap داخل jquery-confirm
					const $tabs = this.$content.find('[data-bs-toggle="tab"]');
					$tabs.off('click.poiHistory').on('click.poiHistory', function (e) {
						e.preventDefault();
						const target = $$(this).attr('data-bs-target');
						const $root = $$(this).closest('.jconfirm-content');
						$root.find('.nav-link').removeClass('active');
						$$(this).addClass('active');
						$root.find('.tab-pane').removeClass('show active');
						$root.find(target).addClass('show active');
					});
				}
			});
		});
	}

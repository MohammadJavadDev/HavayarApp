									<div class="col-md-3 col-sm-6">
										<div class="border-start border-4 border-dark ps-3">
											<label class="form-label text-muted small mb-1">اختتام</label>
											<div class="fw-semibold small">@(Model?.CompletionShamsiDate ?? "-")</div>
										</div>
									</div>
									<div class="col-md-3 col-sm-6">
										<div class="border-start border-4 border-muted ps-3">
											<label class="form-label text-muted small mb-1">توقف</label>
											<div class="fw-semibold small">@(Model?.StopShamsiDate ?? "-")</div>
										</div>
									</div>
								</div>
								</div>
							</div>
					</div>

				 


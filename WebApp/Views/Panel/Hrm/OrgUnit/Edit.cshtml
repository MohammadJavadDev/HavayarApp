 @using Entities.App.Hrm
@model OrgUnit

<div class="card">
     <div class="form-action-buttons"><form-action-buttons entity-type="typeof(OrgUnit)"></form-action-buttons></div>
    <div class="card-body row">
       <input class='form-control' data-bind='id'  value='@Model?.Id' type='hidden'/>

          <div class='col-md-6'>
               <label class='required'>عنوان</label>
               <input class='form-control' data-bind='title' required asp-for='Title' />
               <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
          </div>

          


          <div class='col-md-6'>
               <label class=' '>پیش کد پروژه</label>
               <input class='form-control' data-bind='projectPrefixCode' required asp-for='ProjectPrefixCode' />
               <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
          </div>


          <div class='col-md-4'>

               <label class="form-label">والد</label>
               @(Html.EntitySelector<OrgUnit>
                              (
                              "ParentIdSelector",
                              c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                              c => new
                              {
                                   Id = c.Id,
                                   Title = c.Title,

                              },
                              c => new { c.Title },
                              "{Title}",
                              "ParentId",
                              null,
                              Model?.ParentId.ToString(),
                              false
                              ))
                               
               <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
          </div>


           


             </div>
               <div class='card-footer row'>
                        <div class='col-md-3'>
                            <span>ایجاد کننده :</span>
                            <span data-bind="createdByName">@Model?.CreatedByName</span>
                        </div>

                        <div class='col-md-3'>
                            <span>تاریخ ایجاد :</span>
                            <span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
                        </div>

                            <div class='col-md-3'>
                            <span>ویرایش کننده :</span>
                            <span data-bind="modifiedByName">@Model?.ModifiedByName</span>
                        </div>

                        <div class='col-md-3'>
                            <span>تاریخ ویرایش :</span>
                            <span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
                        </div>
                </div>
</div>

<script>

     $$('[data-action=save]').click(function() {

         if(validateError($$('.card')))
             { return; }

         var model = $$('.card').dataBind();

            const $btn = $(this).block();
         $$.post('save',
             model,
             function(r) {
                 $btn.block(false);
                 if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');

                 toastr.success('ذخیره سازی با موفقیت انجام شد .');
                 $$('.card').dataBind(r.data);
             })
     })


</script>
@using Entities.App.Sale
@{
	var parentId = (long)ViewBag.ParentId;
	var customerId = ViewBag.CustomerId as long? ?? 0;
}
<div class="card" id="srDetailChildCard">
	<div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
		<h5 class="mb-0 fw-bold">جزئیات درخواست پشتیبانی</h5>
		<button type="button" class="btn btn-sm btn-primary" data-action="newChild">افزودن</button>
	</div>
	<div class="card-body">
		<table class="table table-striped table-row-bordered gy-2 w-100" id="srDetailChildTable">
			<thead>
				<tr class="fw-bold fs-6 text-muted">
					<th>نوع درخواست</th>
					<th>کد قطعه</th>
					<th>نام قطعه</th>
					<th>سریال</th>
					<th>شماره سفارش ساخت</th>
					<th>تاریخ ابلاغ</th>
					<th>ساعت</th>
					<th style="width:120px;">عملیات</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
</div>
<script>
	const srDetailParentId = @parentId;
	const srDetailCustomerId = '@customerId';
	const srDetailTable = $$('#srDetailChildTable').DataTable({
		serverSide: false,
		autoWidth: false,
		pageLength: 10,
		language: { url: '/panelLib/plugins/custom/datatables/fa.json' },
		ajax: {
			url: '/Panel/Sale/ServiceRequestDetail/GetListByParentId?serviceRequestId=' + srDetailParentId,
			type: 'GET',
			dataSrc: function (json) {
				if (json && json.isSuccess === false) {
					toastr.error(json.message || 'خطا در دریافت اطلاعات');
					return [];
				}
				return (json && json.data) ? json.data : (Array.isArray(json) ? json : []);
			}
		},
		columns: [
			{ data: 'requestTypeTitle', defaultContent: '-' },
			{ data: 'partCode', defaultContent: '-' },
			{ data: 'partName', defaultContent: '-' },
			{ data: 'serial', defaultContent: '-' },
			{ data: 'productionOrderNumber', defaultContent: '-' },
			{ data: 'noticeShamsiDate', defaultContent: '-' },
			{ data: 'noticeTime', defaultContent: '-' },
			{
				data: 'id',
				orderable: false,
				className: 'text-center',
				render: function (id) {
					return '<button type="button" class="btn btn-sm btn-icon btn-light-warning" data-action="editChild" data-id="' + id + '"><i class="fa fa-edit"></i></button> '
						+ '<button type="button" class="btn btn-sm btn-icon btn-light-danger" data-action="deleteChild" data-id="' + id + '"><i class="fa fa-trash"></i></button>';
				}
			}
		]
	});

	function decodeChildPartial(r) {
		if (window.appController && typeof appController.decodePartialResponse === 'function')
			return appController.decodePartialResponse(r);
		return { html: (typeof r === 'string' ? r : ''), scripts: [] };
	}

	function initServiceRequestDetailForm($root, customerId) {
		const $kind = $root.find('[data-product-kind]');
		function applyKind() {
			const isHavayar = $kind.val() !== 'other';
			$root.find('.js-havayar-fields').toggle(isHavayar);
			$root.find('.js-other-fields').toggle(!isHavayar);
		}
		if ($kind.length) {
			if (!$kind.val()) {
				const hasOther = $root.find('[data-bind="otherPartId"]').val();
				$kind.val(hasOther ? 'other' : 'havayar');
			}
			$kind.off('change.srProduct').on('change.srProduct', applyKind);
			applyKind();
		}
		const $time = $root.find('[data-bind="noticeTime"]');
		if ($time.length && !$time.val()) {
			const now = new Date();
			const clock = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
			if ($time[0].inputmask && typeof $time[0].inputmask.setValue === 'function')
				$time[0].inputmask.setValue(clock);
			else
				$time.val(clock);
		}
		const $noticeDate = $root.find('[data-bind="noticeShamsiDate"]');
		if ($noticeDate.length && !$noticeDate.val() && typeof MJUtil !== 'undefined' && MJUtil.miladiToShamsi) {
			let shamsi = MJUtil.miladiToShamsi(new Date());
			if (MJUtil.toEnglishNumbers) shamsi = MJUtil.toEnglishNumbers(shamsi);
			$noticeDate.val((shamsi || '').split(' ')[0]);
		}
		const $order = $root.find('#ServiceRequestDetailOrderSelector');
		const orderOpts = { filters: function () { return { CustomerId: customerId || '0' }; } };
		let orderInst = $order.data('entitySelector') || $order.data('entitySelectorInstance');
		if (orderInst) orderInst.extraFilters = orderOpts.filters;
		else if ($order.length && typeof $order.entitySelector === 'function') $order.entitySelector(orderOpts);
		const $serial = $root.find('#ServiceRequestDetailSerialSelector');
		const serialOpts = {
			filters: function () { return { OrderDetailId: $root.find('[data-bind="orderDetailId"]').val() || '0' }; },
			watchDependencies: ['#ServiceRequestDetailOrderSelector']
		};
		let serialInst = $serial.data('entitySelector') || $serial.data('entitySelectorInstance');
		if (serialInst) {
			serialInst.extraFilters = serialOpts.filters;
			serialInst.options.watchDependencies = serialOpts.watchDependencies;
			if (typeof serialInst.watchDependencies === 'function') serialInst.watchDependencies();
		} else if ($serial.length && typeof $serial.entitySelector === 'function') $serial.entitySelector(serialOpts);
	}

	function openSrDetailModal(id) {
		const url = id
			? '/Panel/Sale/ServiceRequestDetail/Edit?id=' + id + '&serviceRequestId=' + srDetailParentId
			: '/Panel/Sale/ServiceRequestDetail/New?serviceRequestId=' + srDetailParentId;
		const $trigger = id
			? $$('#srDetailChildCard').find('[data-action="editChild"][data-id="' + id + '"]')
			: $$('#srDetailChildCard').find('[data-action="newChild"]');
		$trigger.block();
		page.getPartialView(url, function (r) {
			$trigger.block(false);
			if (!r) { toastr.error('خطا در دریافت فرم', 'خطا'); return; }
			const decoded = decodeChildPartial(r);
			const $bodyCn = $('<div style="overflow-x:hidden;overflow-y:auto;max-height:70vh;"></div>').append(decoded.html || '');
			$bodyCn.find('.form-action-buttons').remove();
			$.confirm({
				title: id ? 'ویرایش محصول' : 'افزودن محصول',
				columnClass: 'col-md-10',
				content: $bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-primary',
						action: function () {
							const $content = this.$content;
							if (validateError($content)) return false;
							const kind = $content.find('[data-product-kind]').val();
							if (kind === 'other') {
								$content.find('[data-bind="orderDetailId"]').val('');
								$content.find('[data-bind="orderDetailSerialId"]').val('');
							} else {
								$content.find('[data-bind="otherPartId"]').val('');
								$content.find('[data-bind="otherPartSerial"]').val('');
							}
							const model = $content.dataBind();
							const selfConfirm = this;
							const $saveBtn = $(this.buttons.save.el).block();
							$$.post('/Panel/Sale/ServiceRequestDetail/save', model, function (resp) {
								$saveBtn.block(false);
								if (!resp.isSuccess) { toastr.error(resp.message || 'خطا در ذخیره', 'خطا'); return; }
								toastr.success('ذخیره سازی با موفقیت انجام شد');
								selfConfirm.close();
								srDetailTable.ajax.reload(null, false);
							});
							return false;
						}
					},
					cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
				},
				onContentReady: function () {
					const selfConfirm = this;
					setTimeout(function () {
						if (typeof initPersionDatePicker === 'function')
							initPersionDatePicker(selfConfirm.$body);
						selfConfirm.$body.find('.entity-selector-wrapper').each(function () {
							if (!$(this).data('readonly') && typeof $(this).entitySelector === 'function')
								$(this).entitySelector();
						});
						initServiceRequestDetailForm(selfConfirm.$body, srDetailCustomerId);
						if (typeof initTimeInputs === 'function')
							initTimeInputs(selfConfirm.$body);
					}, 100);
				}
			});
		});
	}

	$$('#srDetailChildCard').on('click', '[data-action="newChild"]', function () { openSrDetailModal(null); });
	$$('#srDetailChildCard').on('click', '[data-action="editChild"]', function () { openSrDetailModal($(this).data('id')); });
	$$('#srDetailChildCard').on('click', '[data-action="deleteChild"]', function () {
		const id = $(this).data('id');
		Swal.fire({ title: 'حذف', text: 'آیا از حذف این ردیف مطمئن هستید؟', icon: 'warning', showCancelButton: true, confirmButtonText: 'بله', cancelButtonText: 'خیر' })
			.then(function (result) {
				if (!result.isConfirmed) return;
				$$.get('/Panel/Sale/ServiceRequestDetail/Delete?id=' + id, function (r) {
					if (r && r.isSuccess === false) { toastr.error(r.message || 'خطا در حذف'); return; }
					toastr.success('رکورد با موفقیت حذف شد');
					srDetailTable.ajax.reload(null, false);
				});
			});
	});
</script>

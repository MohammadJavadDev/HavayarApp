@using Entities.App.Srv
<datatableprofile entity-Type="typeof(StationeryRequest)"></datatableprofile>

<div class="d-flex flex-wrap gap-3 my-2 px-1 small">
	<span><span class="d-inline-block rounded" style="width:14px;height:14px;background:yellow;vertical-align:middle;"></span> در حال بررسی</span>
	<span><span class="d-inline-block rounded" style="width:14px;height:14px;background:lightgreen;vertical-align:middle;"></span> تاییده شده</span>
	<span><span class="d-inline-block rounded" style="width:14px;height:14px;background:red;vertical-align:middle;"></span> رد شده</span>
	<span><span class="d-inline-block rounded" style="width:14px;height:14px;background:green;vertical-align:middle;"></span> انجام شد</span>
</div>

<div class="card my-3" id="srvStationeryRequestCommentsCard">
	<div class="card-header bg-white py-3">
		<h5 class="mb-0 fw-bold">سابقه بررسی و تایید</h5>
	</div>
	<div class="card-body">
		<div id="srvStationeryRequestComments" class="table-responsive">
			<table class="table table-striped table-row-bordered gy-2 w-100 mb-0">
				<thead>
					<tr class="fw-bold fs-6 text-muted">
						<th>وضعیت</th>
						<th>توضیح</th>
						<th>ایجادکننده</th>
						<th>تاریخ</th>
					</tr>
				</thead>
				<tbody>
					<tr><td colspan="4" class="text-muted">یک ردیف را انتخاب کنید</td></tr>
				</tbody>
			</table>
		</div>
	</div>
</div>

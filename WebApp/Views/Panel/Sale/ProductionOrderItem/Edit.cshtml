@using Common.Utilities
@using Data.SystemAuth
@using Entities.App.Inv;
@using Entities.App.Sale;
@using Entities.App.Sale.Enums;
@using WebApp.Controllers.Dynamic
@inject ISdk sdk
@model ProductionOrderItem
@{

	var newMode = Model.Id == null;

	var isAdmin = sdk.IsAdministrator;

	// پرچم‌های نمایش دکمه از ProductionOrderItemController.Edit / New (معادل HTS؛ مخفی نه فقط disabled)
	var canSaveItem = ViewBag.CanSaveItem as bool? ?? false;
	var canChangeStatus = ViewBag.CanChangeStatus as bool? ?? false;
	var canAcceptEngineering = ViewBag.CanAcceptEngineering as bool? ?? false;
	var canAcceptProjectManager = ViewBag.CanAcceptProjectManager as bool? ?? false;
	var canSendInquiryResult = ViewBag.CanSendInquiryResult as bool? ?? false;
	var canCommitteeDecide = ViewBag.CanCommitteeDecide as bool? ?? false;
	var canStopActions = ViewBag.CanStopActions as bool? ?? false;
	var canViewChildLinks = ViewBag.CanViewChildLinks as bool? ?? false;

	// فاز ۶ - رابط کاربری: رشته مهندسی (مکانیک/برق) این قلم توسط ProductionOrderItemController.Edit محاسبه و
	// از طریق ViewBag تامین می‌شود تا منطق تشخیص DeviceType در دو جا (سرور/کلاینت) تکرار نشود
	var isElectricalDiscipline = ViewBag.IsElectricalDiscipline as bool? ?? false;

	//Seed Role => Sale.ProductionOrderItemBom => Bom اقلام سفارش ساخت (صفحه HTS 508)
	var canManageBom = isAdmin || sdk.HasRole(ProductionOrderItemController.BomManageRoleName);
	//Seed Role => تکمیل اطلاعات bom اقلام سفارش ساخت صنایع => فقط فیلدهای جدید BOM
	var canEditBomNewFields = isAdmin || sdk.HasRole(ProductionOrderItemController.BomNewFieldsRoleName);
	var canOpenBom = canManageBom || canEditBomNewFields;

	// پیوست‌های سربرگ سفارش ساخت (معادل دکمه «دانلود پیوست سفارش» ریبون اقلام در HTS)
	var po = Model?.ProductionOrder;
	var orderAttachments = new[]
	{
		new { title = "پیوست تایید مدیریت", id = po?.ManagementConfirmationAttachmentId, name = po?.ManagementConfirmationAttachmentFile?.OriginalName },
		new { title = "پیوست فاکتور پیش پرداخت", id = po?.DepositFactorAttachmentId, name = po?.DepositFactorAttachmentFile?.OriginalName },
		new { title = "پیوست پیش فاکتور", id = po?.PreFactorAttachmentId, name = po?.PreFactorAttachmentFile?.OriginalName },
		new { title = "پیوست قرارداد", id = po?.ContractAttachmentId, name = po?.ContractAttachmentFile?.OriginalName },
		new { title = "پیوست مهندسی / متره", id = po?.EngineeringAttachmentId, name = po?.EngineeringAttachmentFile?.OriginalName }
	}.Where(a => a.id.HasValue && a.id > 0).ToList();
}

<div class="card">
   <form-action-buttons entity-type="typeof(ProductionOrderItem)"
						save-btn="@canSaveItem"
						save-and-close-btn="@canSaveItem"
						save-and-new-btn="false">
			@if (canChangeStatus)
			{
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-exchange"
				action-name="addComment" title="تغییر وضعیت"></form-action-button>
			}
			<form-action-button color-class="btn-active-icon-dark btn-color-info" icon-class="fa fa-list"
							action-name="viewComments" title="تاریخچه تغییر وضعیت"></form-action-button>
			@if (canStopActions)
			{
			<form-action-button color-class="btn-active-icon-dark btn-color-danger" icon-class="fa fa-stop-circle"
				action-name="addStopRequest" title="ثبت توقف"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-warning" icon-class="fa fa-clock"
				action-name="viewStopRequests" title="لیست توقفات"></form-action-button>
			}
			@if (canOpenBom)
			{
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-sitemap"
							action-name="viewBom" title="Bom محصول"></form-action-button>
			}
			@if (canAcceptEngineering)
			{
			<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-user-cog"
				action-name="acceptEngineering" title="تایید/رد مهندسی"></form-action-button>
			}
			@if (canAcceptProjectManager)
			{
			<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-user-tie"
				action-name="acceptProjectManager" title="تایید/رد مدیر پروژه"></form-action-button>
			}
			@if (canSendInquiryResult)
			{
			<form-action-button color-class="btn-active-icon-dark btn-color-warning" icon-class="fa fa-users"
				action-name="sendToSupplyCommittee" title="ارسال نتیجه استعلام به کمیته تامین"></form-action-button>
			}
			@if (canCommitteeDecide)
			{
			<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-check-double"
				action-name="committeeDecide" title="تصمیم کمیته تامین"></form-action-button>
			}
			@if (canViewChildLinks)
			{
			<form-action-button color-class="btn-active-icon-dark btn-color-secondary" icon-class="fa fa-cogs"
				action-name="viewSpareParts" title="قطعات یدکی"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-secondary" icon-class="fa fa-paperclip"
				action-name="viewOrderAttachments" title="پیوست‌های سفارش ساخت"></form-action-button>
			}
		</form-action-buttons>
</div>

 
 
 <div class="card  my-2">
			<div class="card-body row">
				<span class="section-box-title">اطلاعات پایه</span>

@using Entities.App;
@model Entities.App.Contact
@{}
<div class="card">
 
          

 
    <div class="">
          <div class="form-action-buttons">
               <form-action-buttons entity-type="typeof(Contact)"></form-action-buttons>
          </div>
        
       <input class='form-control' data-bind='id'  value='@Model?.Id' type='hidden'/>
          <div class="row card-body">
               <div class='col-md-6'>
                    <label class='required'>نام</label>
                    <input class='form-control' data-bind='name' required asp-for='Name' />
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class='col-md-6'>
                    <label class=''>نام خانوادگی</label>
                    <input class='form-control' data-bind='lastName' asp-for='LastName' />
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class='col-md-6'>
                    <label class=''>کد ملی</label>
                    <input class='form-control' data-bind='nationalCode' asp-for='NationalCode' />
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class='col-md-6'>
                    <label class=''>شناسه ملی</label>
                    <input class='form-control' data-bind='nationalId' asp-for='NationalId' />
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class='col-md-6'>
                    <label class=''>نوع مخاطب</label>
                    <select class='form-control' data-bind='contactType' asp-for='ContactType' asp-items="Html.GetEnumSelectList(typeof(ContactType))">
                    </select>
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>


               <div class='col-md-6 align-content-center'>
                    <div class="form-check">
                         <input data-bind='isSupplier' class="form-check-input" type="checkbox" asp-for='IsSupplier' />
                         <label class="form-check-label" asp-for='IsSupplier'>
                              تامین کننده است
                         </label>
                    </div>
               </div>
       </div>
              
    </div>
               <div class='card-footer '>
          <div class="row">
               <div class='col-md-3'>
                    <span>ایجاد کننده :</span>
                    <span data-bind="createdByName">@Model?.CreatedByName</span>
               </div>

               <div class='col-md-3'>
                    <span>تاریخ ایجاد :</span>
                    <span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
               </div>

               <div class='col-md-3'>
                    <span>ویرایش کننده :</span>
                    <span data-bind="modifiedByName">@Model?.ModifiedByName</span>
               </div>

               <div class='col-md-3'>
                    <span>تاریخ ویرایش :</span>
                    <span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
               </div>
                    </div>
                  
                </div>
</div>
<script>
 

     $$('[data-action="save"]').click(function() {

         if(validateError($$('.card')))
             { return; }

         var model = $$('.card').dataBind();

        const $btn = $(this).block();
         post('/Panel/Contact/save',
             model,
             function(r) {
                 $btn.block(false);
                 if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');

                 toastr.success('ذخیره سازی با موفقیت انجام شد .');
                 $$('.card').dataBind(r.data);
             })
     })


</script>
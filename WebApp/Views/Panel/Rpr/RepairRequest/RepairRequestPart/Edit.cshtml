@using Entities.App.Inv
@using Entities.App.Rpr
@model RepairRequestPart



<div class="card">
    <div class="form-action-buttons"><form-action-buttons entity-type="typeof(RepairRequestPart)"></form-action-buttons></div>

</div>
<div class="card">
   
    <div class="card-body row">

        <input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />


        <div class="col-md-3">
            <label class='form-label fw-bold'>کالا</label>
            @(Html.EntitySelector<Part>(
                "PartSelector",
                c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                c => new
                {
                    Id = c.Id,
                    Code = c.Code,
                    Name = c.Name
                },
                c => new { c.Code, c.Name },
                "{Code} {Name}",
                "PartId",
                "PartName",
                Model?.PartId?.ToString()
            ))
            <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
        </div>

        <div class="col-md-3">
            <label class='form-label fw-bold'>واحد کالا</label>
            @(Html.EntitySelector<PartUnit>(
                "PartUnitSelector",
                c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                c => new
                {
                    Id = c.Id,
                    Title = c.Title
                },
                c => new { c.Title },
                "{Title}",
                "PartUnitId",
                "PartName",
                Model?.PartUnitId?.ToString()
            ))
            <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
        </div>

        <div class='col-md-3'>
            <label class="form-label fw-bold">نسخه</label>
            <input class='form-control' data-bind='revision' asp-for='Revision' />
        </div>

        <div class='col-md-1 align-content-center'>
            <div class="form-check">
                <input data-bind='damagedPart' class="form-check-input" type="checkbox" asp-for='DamagedPart' />
                <label class="form-check-label form-label fw-bold" asp-for='DamagedPart'>
                    داغی
                </label>
            </div>
        </div>


        <div class="col-md-3">
            <label class='form-label fw-bold'>توضیحات قطعه داغی</label>
            <textarea class="form-control" asp-for="ReplacementPartDescription" rows="1"></textarea>
        </div>

        <div class='col-md-3'>
            <label class="form-label fw-bold">شماره فرم قطعه داغی</label>
            <input class='form-control' data-bind='replacementPartFormNumber' asp-for='ReplacementPartFormNumber' />
        </div>


        <div class='col-md-3'>
            <label class="form-label fw-bold">مبلغ خرید</label>
            <input class='form-control' data-bind='buyPrice' asp-for='BuyPrice' />
        </div>


        <div class='col-md-3'>
            <label class="form-label fw-bold">قیمت فروش</label>
            <input class='form-control' data-bind='salePrice' asp-for='SalePrice' />
        </div>

        
        <div class='col-md-3'>
            <label class="form-label fw-bold">مقدار مصرفی</label>
            <input class='form-control' data-bind='usedMount' asp-for='UsedMount' />
        </div>

               
        <div class='col-md-3'>
            <label class="form-label fw-bold">مقدار برگشتی</label>
            <input class='form-control' data-bind='returnMount' asp-for='ReturnMount' />
        </div>


        <div class="col-md-6">
            <label class="form-label fw-bold">توضیحات</label>
            <textarea class="form-control" asp-for="Description" rows="1"></textarea>
        </div>
    </div>

</div>
<div class="card">
    <div class='card-footer row'>
        <div class='col-md-3'>
            <span>ایجاد کننده :</span>
            <span>@Model?.CreatedByName</span>
        </div>
        <div class='col-md-3'>
            <span>تاریخ ایجاد :</span>
            <span>@Model?.CreatedOnShamsiDateTime</span>
        </div>
        <div class='col-md-3'>
            <span>ویرایش کننده :</span>
            <span>@Model?.ModifiedByName</span>
        </div>
        <div class='col-md-3'>
            <span>تاریخ ویرایش :</span>
            <span>@Model?.ModifiedDateShamsiDateTime</span>
        </div>
    </div>
</div>
<script>

    function savefn($btnAction) {
        if (validateError($$('.card'))) { return; }
        var model = $$('.card').dataBind();
        const $btn = $(this.element).block();
        $$.post('save',
            model,
            function (r) {
                $btn.block(false);
                if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
                toastr.success('ذخیره سازی با موفقیت انجام شد .');
                $$('.card').dataBind(r.data);
                $btnAction.baseaction();
            })
    }

    self.FormActionButtons.save.onclick(function () { savefn(this) })
    self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
    self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
</script>
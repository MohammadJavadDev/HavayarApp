     function loadContractorList(repairRequestId) {
         if (!repairRequestId || repairRequestId === '0') {
             $('#contractorTableBody').html('<tr><td colspan="13" class="text-center text-warning">شناسه تعمیرات یافت نشد</td></tr>');
             return;
         }

         $.ajax({
             url: '/Panel/Rpr/RepairRequest/GetRepairRequestContractor',
             type: 'GET',
             data: { repairRequestId: repairRequestId },
             dataType: 'json',
             success: function(response) {
                 if (response && response.isSuccess === true && response.data && response.data.length >= 0) {
                     renderContractorTable(response.data);
                 } else {
                     $('#contractorTableBody').html('<tr><td colspan="13" class="text-center text-warning">هیچ اطلاعاتی یافت نشد</td></tr>');
                 }
             },
             error: function(xhr) {
                 console.error('خطا در دریافت اطلاعات:', xhr);
                 $('#contractorTableBody').html('<tr><td colspan="13" class="text-center text-danger">خطا در دریافت اطلاعات</td></tr>');
             }
         });
     }

     function renderContractorTable(data) {
         var tbody = $('#contractorTableBody');
         tbody.empty();

         $.each(data, function(index, item) {
             var contractorName = '-';
             if (item.contractor) {
                 contractorName = item.contractor.title || item.contractor.name || '-';
             }

             var row = '<tr data-item-id="' + (item.id || 0) + '">';
             row += '<td class="text-center">';
             row += '<button type="button" class="btn btn-icon btn-warning btn-sm" data-action="editContractorBtn" data-id="' + (item.id || 0) + '" style="margin-left: 5px;">';
             row += '<i class="fa fa-pencil"></i>';
             row += '</button>';
             row += '<button type="button" class="btn btn-icon btn-danger btn-sm" data-action="deleteContractorBtn" data-id="' + (item.id || 0) + '">';
             row += '<i class="fa fa-trash"></i>';
             row += '</button>';
             row += '</td>';
             row += '<td class="text-center">' + (index + 1) + '</td>';
             row += '<td>' + contractorName + '</td>';
             row += '<td class="text-end">' + (item.cost ? new Intl.NumberFormat('fa-IR').format(item.cost) : '-') + '</td>';
             row += '<td><span title="' + (item.part ? item.part.name + ' - ' + item.part.code : '') + '">' + (item.part ? item.part.name : '-') + ' (' + (item.part ? item.part.code : '-') + ')</span></td>';
             row += '<td class="text-center">' + (item.sendPartShamsiDate || '-') + '</td>';
             row += '<td class="text-center">' + (item.contractorAcceptShamsiDate || '-') + '</td>';
             row += '<td class="text-center">' + (item.agreegmentShamsiDate || '-') + '</td>';
             row += '<td class="text-center">' + (item.contractorReturnShamsiDate || '-') + '</td>';
             row += '<td class="text-center">' + (item.costAnnouncementShamsiDate || '-') + '</td>';
             row += '<td>' + (item.createdByName || item.createdBy || '-') + '</td>';
             row += '<td class="text-center">' + (item.createdOnShamsiDateTime || '-') + '</td>';
             row += '<td style="max-width:250px; white-space:normal; word-wrap:break-word;">' + (item.comment || '-') + '</td>';
             row += '</tr>';
             tbody.append(row);
         });
     }


			</div>

			<div class='col-md-3 form-group-inline'>
			 
					<label class='text-muted d-block  ' style="font-size: 0.9rem;">دمای بیشینه</label>
					<span class='fw-semibold fs-6' data-bind='maximumTemperature'>@(Model?.MaximumTemperature?.ToString() ?? "-")</span>
				 
			</div>

			<div class='col-md-3 form-group-inline'>
				 
					<label class='text-muted d-block  ' style="font-size: 0.9rem;">درصد خلوص</label>
					<span class='fw-semibold fs-6' data-bind='purityPercentage'>@(Model?.PurityPercentage?.ToString() ?? "-")</span>
		 
			</div>

			<div class='col-md-3 form-group-inline'>
				 
					<label class='text-muted d-block  ' style="font-size: 0.9rem;">رطوبت نسبی</label>
					<span class='fw-semibold fs-6' data-bind='relativeHumidity'>@(Model?.RelativeHumidity?.ToString() ?? "-")</span>
				 
			</div>

			<div class='col-md-3 form-group-inline'>
			 
					<label class='text-muted d-block  ' style="font-size: 0.9rem;">فشار بارومتریک</label>
					<span class='fw-semibold fs-6' data-bind='barometricPressure'>@(Model?.BarometricPressure?.ToString() ?? "-")</span>
			 
			</div>

			<div class='col-md-3 form-group-inline'>
				 
					<label class='text-muted d-block  ' style="font-size: 0.9rem;">نوع محرک</label>
					<span class='fw-semibold fs-6' data-bind='movingType'>@(string.IsNullOrWhiteSpace(Model?.MovingType) ? "-" : Model?.MovingType)</span>
				 
			</div>

				<div class='col-md-3 form-group-inline'>
					 
						<span class='text-muted me-2'>بازرسی حین ساخت:</span>
						@if (Model?.HasInspection == true)
						{
							<span class="badge badge-success">دارد</span>
						}
						else
						{
							<span class="badge badge-secondary">ندارد</span>
						}
				 
				</div>


			</div>
		</div>


 

 
 <div class="card  my-2" id="changeDataSection">
			<div class="card-body row">
				<span class="section-box-title">تولید</span>
				<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
				 
					@if (newMode)
					{
						<div class="col-md-4 form-group-inline">
					<label class=''>سفارش ساخت</label>
						@(Html.EntitySelector<ProductionOrder>(
											"ProductionOrderSelector",
											c => c.IsActive == Entities.Base.IsActiveEnum.Active,
											c => new
											{
												Id = c.Id,
												ProductionOrderNumber = (int)c.ProductionOrderNumber,
												NumberSerach = c.ProductionOrderNumber
											},
											c => new { c.ProductionOrderNumber },
											"{ProductionOrderNumber}",
											"ProductionOrderId",
											"ProductionOrderName",
											Model?.ProductionOrderId.ToString(),
											true
											))
											
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
			  	</div>
			
					}
					@if (newMode)
					{
							<div class="col-md-8 form-group-inline">
					<label class='required'>کالا</label>
								@(Html.EntitySelector<Part>(
										"PartSelector",
										c => c.IsActive == Entities.Base.IsActiveEnum.Active,
										c => new
										{
											Id = c.Id,
											Name = c.Name,
											Code = c.Code
										},
										c => new { c.Name, c.Code },
										"{Name} {Code}",
										"PartId",
										"PartName",
										Model?.PartId?.ToString(),
										true
										))
										
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>
					
					}

					@if (newMode)
				{

					<div class='col-md-4 form-group-inline'>

						<label class='required'  >تعداد / مقدار</label>
						<input class='form-control' data-bind='amount' data-invalidMessage='فقط عداد'
						data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''"
						asp-for='Amount' required />

					</div>
				}

				 <div class='col-md-4 form-group-inline'>
						<label class=''>نوع دستگاه</label>
						<select class='form-control' data-bind='deviceType' asp-for='DeviceType'
							   asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.ProductionOrderItemDeviceTypeEnum))">
						</select>
						<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
					</div>
				<div class='col-md-4 form-group-inline'>
					<label class=''>مرحله ساخت</label>
					<select class='form-control' data-bind='productionStep' asp-for='ProductionStep'
						asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.ProductionOrderItemProductionStepEnum))">
					</select>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>
						<div class='col-md-4 form-group-inline'>
					<label class=''>شماره برنامه ریزی</label>
					<input class='form-control' data-bind='planningNumber' data-invalidMessage='فقط عداد'
						data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''"
						asp-for='PlanningNumber' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>
					<div class='col-md-4 form-group-inline'>
					<label class=''>سریال</label>
					<input class='form-control' data-bind='serial' asp-for='Serial' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>
				<div class='col-md-4 form-group-inline'>
					<label class=''>نوع سریال</label>
					<select class='form-control' data-bind='serialType' asp-for='SerialType'
						   asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.ProductionOrderItemSerialTypeEnum))">
					</select>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				
				<div class='col-md-4 form-group-inline'>
					<label class=''>تاریخ شروع تولید</label>
					<input class='form-control' data-bind='productionStartShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.ProductionStartMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>



				<div class='col-md-4 form-group-inline'>
					<label class=''>تاریخ شمسی پایان تولید</label>
					<input class='form-control' data-bind='productionEndShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.ProductionEndMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>



				<div class='col-md-4 form-group-inline'>
					<label class=''>تاریخ پایان تست</label>
					<input class='form-control' data-bind='testingEndShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.TestingEndMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>



				<div class='col-md-4 form-group-inline'>
					<label class=''>تاریخ آماده سازی</label>
					<input class='form-control' data-bind='preparationShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.PreparationMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				@* معادل فیلد «تاریخ تحویل» فرم HTS (DeliveryDateInText) *@
				<div class='col-md-4 form-group-inline'>
					<label class=''>تاریخ تحویل</label>
					<input class='form-control' data-bind='deliveryShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.DeliveryMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-4 form-group-inline'>
					<label class=''>وضعیت</label>
					<select class='form-control' data-bind='status' asp-for='Status'
						asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.ProductionOrderItemStatusEnum))">
					</select>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-12 form-group-inline'>
					<label class=''>ملاحظات صنایع</label>
					<textarea class='form-control' data-bind='planningConsideration'
						asp-for='PlanningConsideration'>@Model?.PlanningConsideration</textarea>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

			</div>
		</div>

@if (!newMode)
{
	@* ستون‌های فقط‌خواندنی گرید HTS که روی فرم ویرایش نبودند — برای دید صنایع/برنامه‌ریزی *@
	<div class="card my-2">
		<div class="card-body row">
			<span class="section-box-title">اطلاعات تکمیلی برنامه‌ریزی</span>
			<div class='col-md-3 form-group-inline'>
				<label class='text-muted d-block' style="font-size: 0.9rem;">تاریخ ارسال به صنایع (اخذ)</label>
				<span class='fw-semibold fs-6'>@(Model?.SendToIndustrialShamsiDate ?? "-")</span>
			</div>
			<div class='col-md-3 form-group-inline'>
				<label class='text-muted d-block' style="font-size: 0.9rem;">تاریخ تحویل استاندارد</label>
				<span class='fw-semibold fs-6'>@(Model?.StandardDeliveryShamsiDate ?? "-")</span>
			</div>
			<div class='col-md-3 form-group-inline'>
				<label class='text-muted d-block' style="font-size: 0.9rem;">تاریخ آماده‌سازی مدارک</label>
				<span class='fw-semibold fs-6'>@(Model?.DocumentPreparationShamsiDate ?? "-")</span>
			</div>
			<div class='col-md-3 form-group-inline'>
				<label class='text-muted d-block' style="font-size: 0.9rem;">اولین تغییر صنایع</label>
				<span class='fw-semibold fs-6'>@(Model?.FirstIndustrialChangeShamsiDate ?? "-")</span>
			</div>
			<div class='col-md-3 form-group-inline'>
				<label class='text-muted d-block' style="font-size: 0.9rem;">وضعیت تولید (آخرین رخداد)</label>
				<span class='badge badge-light-warning fs-6 px-3 py-2'>@(Model?.ProductionStatus.ToDisplay() ?? "-")</span>
			</div>
			<div class='col-md-3 form-group-inline'>
				<span class='text-muted me-2'>روتین:</span>
				@if (Model?.IsRoutine == true)
				{
					<span class="badge badge-success">بله</span>
				}
				else
				{
					<span class="badge badge-secondary">خیر</span>
				}
			</div>
			<div class='col-md-6 form-group-inline'>
				<label class='text-muted d-block' style="font-size: 0.9rem;">آخرین کامنت تولید</label>
				<span class='fw-semibold fs-6'>@(string.IsNullOrWhiteSpace(Model?.LastComment) ? "-" : Model?.LastComment)</span>
			</div>
			<div class='col-md-6 form-group-inline'>
				<label class='text-muted d-block' style="font-size: 0.9rem;">ملاحظات فروش</label>
				<span class='fw-semibold fs-6'>@(string.IsNullOrWhiteSpace(Model?.SalesConsideration) ? "-" : Model?.SalesConsideration)</span>
			</div>
			<div class='col-md-6 form-group-inline'>
				<label class='text-muted d-block' style="font-size: 0.9rem;">ملاحظات مهندسی</label>
				<span class='fw-semibold fs-6'>@(string.IsNullOrWhiteSpace(Model?.EngineeringConsideration) ? "-" : Model?.EngineeringConsideration)</span>
			</div>
		</div>
	</div>
}
 

<div class="card">

	<div class='card-body row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>
	 
	var permissions = @Html.Raw(Json.Serialize(new {
		   canSaveItem,
		   canChangeStatus,
		   canAcceptEngineering,
		   canAcceptProjectManager,
		   canSendInquiryResult,
		   canCommitteeDecide,
		   canStopActions,
		   canViewChildLinks,
		   canManageBom,
		   canOpenBom
	   }));
	var productionOrderItem = @Html.Raw(Json.Serialize(Model));
	var isNewMode = @(newMode ? "true" : "false");
	// پیوست‌های سربرگ سفارش ساخت برای دانلود از همین صفحه (معادل ViewProductionOrderAttachedFile در HTS)
	var orderAttachments = @Html.Raw(Json.Serialize(orderAttachments));

	// مقادیر عددی دقیقاً منطبق بر Entities.App.Sale.Enums.ProductionOrderItemCheckStatusEnum
	var CHECK_STATUS = {
		IndustrialDashboardInternal: 1904,
		ForeignIndustryCatalog: 1905,
		InquiryNeeded: 1906,
		IndustrialMinistryReviewRequired: 1908,
		SendToSupplyCommitteeChair: 1909,
		MechanicalEngineeringApprovalPending: 2195,
		CommitteeHeadReviewPending: 2202,
		AwaitingProjectManagerApproval: 2258
	};

	// دکمه‌های غیرمجاز اصلاً رندر نمی‌شوند (معادل HTS enable(false) → مخفی در پنل جدید)
	function initializePage() {
		// no-op: visibility is server-rendered
	}

	initializePage()

	function currentProductionOrderItemId() {
		return $$("#changeDataSection [data-bind='id']").val();
	}

	self.FormActionButtons.viewBom && self.FormActionButtons.viewBom.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') {
			toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید');
			return;
		}
		appController.addPage('/Panel/ProductionOrderItem/BomListBy?productionOrderItemId=' + id);
	});

	//#region Accept/Reject Engineering
	self.FormActionButtons.acceptEngineering && self.FormActionButtons.acceptEngineering.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') {
			toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید');
			return;
		}

		if (!permissions.canAcceptEngineering) {
			toastr.error('شما دسترسی تایید/رد مهندسی این قلم را ندارید');
			return;
		}

		$.confirm({
			title: 'تایید/رد مهندسی',
			content: `
				<div class="row">
					<div class="col-12 mb-3">
						<label class="required">تصمیم</label>
						<select class="form-control" id="engineeringDecisionSelect">
							<option value="1">تایید</option>
							<option value="2">رد</option>
							<option value="3">نیاز به بازنگری</option>
						</select>
					</div>
					<div class="col-12">
						<label>توضیحات</label>
						<textarea class="form-control" id="engineeringDecisionComment" rows="3"></textarea>
					</div>
				</div>`,
			rtl: true,
			buttons: {
				submit: {
					text: 'ثبت',
					btnClass: 'btn-success',
					action: function () {
						const decision = this.$content.find('#engineeringDecisionSelect').val();
						const comment = this.$content.find('#engineeringDecisionComment').val() || '';
						$$.post(`/Panel/ProductionOrderItem/AcceptEngineering/${id}?decision=${decision}&comment=${encodeURIComponent(comment)}`, null, function (r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}
							toastr.success('تصمیم مهندسی با موفقیت ثبت شد');
							appController.refreshCurrentPage();
						});
					}
				},
				cancel: {
					text: 'انصراف',
					btnClass: 'btn-secondary'
				}
			}
		});
	});
	//#endregion

	//#region Accept/Reject Project Manager
	self.FormActionButtons.acceptProjectManager && self.FormActionButtons.acceptProjectManager.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') {
			toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید');
			return;
		}

		if (!permissions.canAcceptProjectManager) {
			toastr.error('شما دسترسی تایید/رد مدیر پروژه را ندارید');
			return;
		}

		$.confirm({
			title: 'تایید/رد مدیر پروژه',
			content: `
				<div class="row">
					<div class="col-12 mb-3">
						<label class="required">تصمیم</label>
						<select class="form-control" id="pmDecisionSelect">
							<option value="1">تایید</option>
							<option value="2">رد</option>
							<option value="3">نیاز به بازنگری</option>
						</select>
					</div>
					<div class="col-12">
						<label>توضیحات</label>
						<textarea class="form-control" id="pmDecisionComment" rows="3"></textarea>
					</div>
				</div>`,
			rtl: true,
			buttons: {
				submit: {
					text: 'ثبت',
					btnClass: 'btn-success',
					action: function () {
						const decision = this.$content.find('#pmDecisionSelect').val();
						const comment = this.$content.find('#pmDecisionComment').val() || '';
						$$.post(`/Panel/ProductionOrderItem/AcceptProjectManager/${id}?decision=${decision}&comment=${encodeURIComponent(comment)}`, null, function (r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}
							toastr.success('تصمیم مدیر پروژه با موفقیت ثبت شد');
							appController.refreshCurrentPage();
						});
					}
				},
				cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
			}
		});
	});
	//#endregion

	//#region Supply Committee (تصمیم کمیته / ارسال نتیجه استعلام)
	// معادل پنجره «تغییر وضعیت» HTS در حالت استعلام: committeeMode=true → رئیس کمیته مقصد را انتخاب می‌کند؛
	// committeeMode=false → استعلام‌گر/وزارت نتیجه را با کامنت/پیوست به رئیس کمیته (۱۹۰۹) برمی‌گرداند
	function openInquiryModal(committeeMode) {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') { toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید'); return; }

		const url = `/Panel/ProductionOrderItem/ProductionOrderItemInquiryPartial?productionOrderItemId=${id}&committeeMode=${committeeMode}`;
		$$.get(url, function (result) {
			const bodyCn = `<div style="overflow-x: hidden;">${result}</div>`;
			$.confirm({
				title: committeeMode ? 'تصمیم کمیته تامین' : 'ارسال نتیجه استعلام به رئیس کمیته تامین',
				columnClass: 'col-md-8',
				content: bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: committeeMode ? 'ثبت تصمیم' : 'ارسال به کمیته',
						btnClass: committeeMode ? 'btn-success' : 'btn-warning',
						action: function () {
							const $content = this.$content;
							const modalSelf = this;
							const model = $content.dataBind();

							if (!model.comment || !String(model.comment).trim()) {
								toastr.error('کامنت الزامی است');
								return false;
							}

							const INQUIRY_DESTINATIONS = [CHECK_STATUS.InquiryNeeded, CHECK_STATUS.IndustrialMinistryReviewRequired];
							if (committeeMode) {
								const destination = parseInt(model.destination);
								if (INQUIRY_DESTINATIONS.includes(destination)) {
									if (!model.ResponsibleId) { toastr.error('مسئول استعلام الزامی است'); return false; }
									if (!model.leadTimeShamsiDate) { toastr.error('مدت زمان اخذ استعلام (LeadTime) الزامی است'); return false; }
								}

								const payload = {
									destination: destination,
									responsibleId: model.ResponsibleId ? parseInt(model.ResponsibleId) : null,
									leadTimeShamsiDate: model.leadTimeShamsiDate || null,
									attachmentFileId: model.attachmentFileId ? parseInt(model.attachmentFileId) : null,
									comment: model.comment
								};
								$$.post(`/Panel/ProductionOrderItem/CommitteeDecide/${id}`, payload, function (r) {
									if (!r.isSuccess) { toastr.error(`${r.message}`, 'خطا'); return; }
									toastr.success('تصمیم کمیته تامین با موفقیت ثبت شد');
									modalSelf.close();
									appController.refreshCurrentPage();
								});
							} else {
								const payload = {
									comment: model.comment,
									attachmentFileId: model.attachmentFileId ? parseInt(model.attachmentFileId) : null
								};
								$$.post(`/Panel/ProductionOrderItem/SendToSupplyCommittee/${id}`, payload, function (r) {
									if (!r.isSuccess) { toastr.error(`${r.message}`, 'خطا'); return; }
									toastr.success('نتیجه استعلام با موفقیت به رئیس کمیته تامین ارسال شد');
									modalSelf.close();
									appController.refreshCurrentPage();
								});
							}
							return false;
						}
					},
					cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
				},
				onContentReady: function () {
					const modalSelf = this;
					setTimeout(function () {
						initPersionDatePicker(modalSelf.$body);
						initFileUploaders(modalSelf.$body);
						modalSelf.$body.find('select.select2-hidden-accessible').each(function () {
							const $select = $(this);
							const currentData = $select.select2('data');
							$select.select2('destroy');
							$select.select2({ dropdownParent: modalSelf.$body, width: '100%', placeholder: $select.attr('placeholder') || 'انتخاب کنید' });
							if (currentData && currentData.length > 0) { $select.val($select.val()).trigger('change'); }
						});

						// فیلدهای مسئول/LeadTime فقط برای مقصدهای استعلام (۱۹۰۶/۱۹۰۸) — عین HTS
						const $destination = modalSelf.$body.find('#inquiryDestinationSelect');
						const toggleInquiryOnly = function () {
							const dest = parseInt($destination.val());
							const show = [CHECK_STATUS.InquiryNeeded, CHECK_STATUS.IndustrialMinistryReviewRequired].includes(dest);
							modalSelf.$body.find('.inquiry-only').toggleClass('d-none', !show);
						};
						$destination.on('change', toggleInquiryOnly);
						toggleInquiryOnly();
					}, 100);
				}
			});
		});
	}

	self.FormActionButtons.sendToSupplyCommittee && self.FormActionButtons.sendToSupplyCommittee.onclick(function () {
		if (!permissions.canSendInquiryResult) { toastr.error('شما دسترسی ارسال نتیجه استعلام به کمیته تامین را ندارید'); return; }
		openInquiryModal(false);
	});

	self.FormActionButtons.committeeDecide && self.FormActionButtons.committeeDecide.onclick(function () {
		if (!permissions.canCommitteeDecide) { toastr.error('شما دسترسی تصمیم کمیته تامین را ندارید'); return; }
		openInquiryModal(true);
	});
	//#endregion

	//#region Spare parts / order attachments (معادل دکمه‌های «قطعه یدکی» و «دانلود پیوست سفارش» ریبون HTS)
	self.FormActionButtons.viewSpareParts && self.FormActionButtons.viewSpareParts.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') { toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید'); return; }

		$$.get(`/Panel/ProductionOrderItem/SparePartListPartial?productionOrderItemId=${id}`, function (result) {
			$.confirm({
				title: 'قطعات یدکی کالای این قلم',
				columnClass: 'col-md-10',
				content: `<div style="overflow-x: auto; max-height: 70vh; overflow-y: auto;">${result}</div>`,
				rtl: true,
				buttons: { close: { text: 'بستن', btnClass: 'btn-secondary' } }
			});
		});
	});

	self.FormActionButtons.viewOrderAttachments && self.FormActionButtons.viewOrderAttachments.onclick(function () {
		if (!orderAttachments || orderAttachments.length === 0) {
			toastr.info('برای سفارش ساخت این قلم پیوستی ثبت نشده است');
			return;
		}

		let html = '<ul class="list-group">';
		orderAttachments.forEach(function (a) {
			html += `<li class="list-group-item d-flex justify-content-between align-items-center">
				<span><i class="fa fa-paperclip me-2 text-muted"></i>${a.title}${a.name ? ' — <span class="text-muted">' + a.name + '</span>' : ''}</span>
				<button type="button" class="btn btn-sm btn-light-primary" data-action="downloadOrderAttachment" data-file-id="${a.id}"><i class="fa fa-download me-1"></i>دانلود</button>
			</li>`;
		});
		html += '</ul>';

		$.confirm({
			title: 'پیوست‌های سفارش ساخت',
			columnClass: 'col-md-8',
			content: html,
			rtl: true,
			buttons: { close: { text: 'بستن', btnClass: 'btn-secondary' } },
			onContentReady: function () {
				this.$content.on('click', '[data-action="downloadOrderAttachment"]', function () {
					downloadFile($(this).data('file-id'));
				});
			}
		});
	});
	//#endregion

	function savefn($btnAction) {
		var id = $$("[data-bind='id']").val();
		 

		var model = $$("#changeDataSection").dataBind();
		  
		if(!id || id == 0)
		{
			model.PartId =  $$("[data-bind=PartId]").val();

			if(!model.PartId )
			{
				toastr.error(`کالا برای ایجاد قلم سفارش ثبت نشده .`, 'خطا');
				return;
			}
			model.DeviceType =   $$("[data-bind=DeviceType]").val();

			model.amount = $$("[data-bind=amount]").val();

			if(!model.amount || model.amount == 0 )
			{
				toastr.error(`تعداد/مقدار به درستی وارد نشده است`, 'خطا');
				return;
			}
			model.ProductionOrderId  = $$("[data-bind=ProductionOrderId]").val();
		}
		// if (validateError($$("#changeDataSection"))) { return; }
		
		const $btn = $(this.element).block();
		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				$$("#changeDataSection").dataBind(r.data);
				$btnAction.baseaction();
			})
	}

	self.FormActionButtons.save && self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew && self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose && self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })

	// دکمه افزودن تغییر وضعیت
	self.FormActionButtons.addComment && self.FormActionButtons.addComment.onclick(function () {
		openCommentModal();
	});

	// دکمه نمایش لیست تاریخچه تغییر وضعیت
	self.FormActionButtons.viewComments && self.FormActionButtons.viewComments.onclick(function () {
		viewCommentsList();
	});

	// دکمه ثبت توقف
	self.FormActionButtons.addStopRequest && self.FormActionButtons.addStopRequest.onclick(function () {
		openStopRequestModal();
	});

	// دکمه نمایش لیست توقفات
	self.FormActionButtons.viewStopRequests && self.FormActionButtons.viewStopRequests.onclick(function () {
		viewStopRequestsList();
	});

	// Stop Request Functions
	function openStopRequestModal(stopRequestId = null) {
		const productionOrderItemId = $$('#changeDataSection [data-bind="id"]').val();
		if (!productionOrderItemId || productionOrderItemId == '0') {
			toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید');
			return;
		}

		const url = stopRequestId 
			? `/Panel/ProductionOrderItem/StopRequestPartial?id=${stopRequestId}&productionOrderItemId=${productionOrderItemId}`
			: `/Panel/ProductionOrderItem/StopRequestPartial?productionOrderItemId=${productionOrderItemId}`;
		
		$$.get(url, function(result) {
			let bodyCn = `<div style="overflow-x: hidden;overflow-y: auto; max-height: 70vh;">${result}</div>`;
			$.confirm({
				title: stopRequestId ? 'ویرایش درخواست توقف' : 'ثبت درخواست توقف',
				columnClass: 'col-md-10',
				content: bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-primary',
						action: function() {
							const $content = this.$content;
							
							if (validateError($content)) {
								return false;
							}
							
							// جمع‌آوری مقادیر select2 برای علت توقف
							const $stopReasonSelect = $content.find('#stopReasonSelectModal');
							if ($stopReasonSelect.length > 0) {
								const selectedReasons = $stopReasonSelect.val();
								if (selectedReasons && selectedReasons.length > 0) {
									const selectedTexts = [];
									$stopReasonSelect.find('option:selected').each(function() {
										selectedTexts.push($$(this).text().trim());
									});
									$content.find('[data-bind="stopReasonIds"]').val(selectedReasons.join(','));
									$content.find('[data-bind="stopReasonTitles"]').val(selectedTexts.join(','));
								} else {
									toastr.error('علت توقف الزامی است');
									return false;
								}
							}

							const desc = $content.find('[data-bind="description"]').val();
							if (!desc || !String(desc).trim()) {
								toastr.error('شرح الزامی است');
								return false;
							}
							
							const model = $content.dataBind();
							const self = this;
							
							$$.post('/Panel/ProductionOrderItem/SaveStopRequest', model, function(r) {
								if (!r.isSuccess) {
									toastr.error(`${r.message}`, 'خطا');
									return false;
								}
								
								toastr.success('درخواست توقف با موفقیت ذخیره شد');
								appController.closeCurrentPage()
								self.close();
							});
							
							return false;
						}
					},
					cancel: {
						text: 'انصراف',
						btnClass: 'btn-secondary'
					}
				},
				onContentReady: function () {
					var self = this;
					setTimeout(function () {
						initPersionDatePicker(self.$body);
						// Initialize select2 for multi-select stop reasons
						self.$body.find('#stopReasonSelectModal').select2({
							placeholder: 'انتخاب کنید',
							allowClear: true,
							width: '100%',
							dropdownParent: self.$body
						});
						// Fix other select2 dropdowns (EntitySelectors) in modal
						self.$body.find('select.select2-hidden-accessible').not('#stopReasonSelectModal').each(function() {
							const $select = $$(this);
							const currentData = $select.select2('data');
							$select.select2('destroy');
							$select.select2({
								dropdownParent: self.$body,
								width: '100%',

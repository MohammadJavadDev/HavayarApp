@using Entities.App.Inv
@using Entities.App.Prp
@using WebFramework.TagHelpers;
@model RepairRequestContractor

<div class="card">

    <div class="card  card-body my-3">
        <div class='row '>
            <div class="col-md-6">
                <label>پیمانکار</label>
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addContractorModal">
                    <i class="fa fa-plus"></i>
                </button>

                @(Html.EntitySelector<Contractor>(
                                "ContractorSelector",
                                c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                                c => new { Id = c.Id, Title = c.Title },
                                c => new { c.Title },
                                "{Title}",
                                "ContractorId",
                                null,
                                Model?.ContractorId.ToString()
                                ))
            </div>

            <div class="modal fade" id="addContractorModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header"><h5 class="modal-title">افزودن پیمانکار جدید</h5></div>
                        <div class="modal-body">
                            <input type="text" id="newContractorTitle" class="form-control" placeholder="عنوان پیمانکار را وارد کنید" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" onclick="saveContractor()">ذخیره</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-md-6">
                <label>نام قطعه ارسالی</label>

                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addPartModal">
                    <i class="fa fa-plus"></i>
                </button>
                @(Html.EntitySelector<Part>(
                                "PartSelector",
                                c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                                c => new { Id = c.Id, Code = c.Code, Title = c.Name },
                                c => new { c.Code, c.Name },
                                "{Code} {Title}",
                                "PartId",
                                null,
                                Model?.PartId.ToString()
                                ))
            </div>

            <div class="modal fade" id="addPartModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header"><h5 class="modal-title">نام قطعه ارسالی جدید</h5></div>
                        <div class="modal-body">
                            <input type="text" id="newPartTitle" class="form-control" placeholder="عنوان قطعه ارسالی را وارد کنید" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" onclick="savePart()">ذخیره</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                        </div>
                    </div>
                </div>
            </div>


            <div class='col-md-6'>
                <label class=''>
                    تاریخ  ارسال
                </label>
                <input class='form-control' data-bind='sendPartShamsiDate' data-persionDatePicker="true"
                       persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                       value='@Model?.SendPartShamsiDate' />
            </div>

            <div class='col-md-6'>
                <label class=''>
                    تاریخ  اعلام هزینه تعمیر
                </label>
                <input class='form-control' data-bind='costAnnouncementShamsiDate' data-persionDatePicker="true"
                       persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                       value='@Model?.CostAnnouncementShamsiDate' />
            </div>

            <div class='col-md-6'>
                <label class=''>
                    مبلغ تعمیر
                </label>
                <input type="text"
                       class="form-control numeric-input"
                       onkeypress="return (event.charCode >= 48 && event.charCode <= 57)"
                       data-bind="textInput: cost"
                       value="@Model?.Cost" />
            </div>

            <div class='col-md-6'>
                <label class=''>
                    تاریخ تایید به پیمانکار
                </label>
                <input class='form-control' data-bind='contractorAcceptShamsiDate' data-persionDatePicker="true"
                       persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                       value='@Model?.ContractorAcceptShamsiDate' />
            </div>

            <div class='col-md-6'>
                <label class=''>
                    تاریخ توافق با پیمانکار
                </label>
                <input class='form-control' data-bind='agreegmentShamsiDate' data-persionDatePicker="true"
                       persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                       value='@Model?.AgreegmentShamsiDate' />
            </div>

            <div class='col-md-6'>
                <label class=''>
                    تاریخ برگشت از پیمانکار
                </label>
                <input class='form-control' data-bind='contractorReturnShamsiDate' data-persionDatePicker="true"
                       persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                       value='@Model?.ContractorReturnShamsiDate' />
            </div>

            <div class="col-md-12">
                <label>توضیحات</label>
                <textarea class="form-control" data-bind="comment" rows="5">@Model?.Comment</textarea>
            </div>

        </div>
    </div>

</div>

<div class='card-footer row'>
    <div class='col-md-3'>
        <span>ایجاد کننده :</span>
        <span>@Model?.CreatedByName</span>
    </div>
    <div class='col-md-3'>
        <span>تاریخ ایجاد :</span>
        <span>@Model?.CreatedOnShamsiDateTime</span>
    </div>
    <div class='col-md-3'>
        <span>ویرایش کننده :</span>
        <span>@Model?.ModifiedByName</span>
    </div>
    <div class='col-md-3'>
        <span>تاریخ ویرایش :</span>
        <span>@Model?.ModifiedDateShamsiDateTime</span>
    </div>
</div>

<script>

        function saveContractor() {
        var title = $('#newContractorTitle').val();
        if (!title) { alert("لطفا عنوان پیمانکار را وارد کنید"); return; }

        $.ajax({
            url: '/Panel/Rpr/RepairRequest/AddContractor',
            type: 'POST',
            data: JSON.stringify({ Title: title }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $('#addContractorModal').modal('hide');
                $('#newContractorTitle').val('');
                location.reload();
            },
            error: function (xhr, status, error) {
                console.error("Error details:", xhr.responseText);
                alert("خطا در ثبت پیمانکار: " + xhr.statusText);
            }
        });
    }

      function savePart() {
        var title = $('#newPartTitle').val();
        if (!title) { alert("لطفا عنوان قطعه ارسالی را وارد کنید"); return; }

        $.ajax({
            url: '/Panel/Rpr/RepairRequest/AddPart',
            type: 'POST',
            data: JSON.stringify({ Name: title }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                $('#addContractorModal').modal('hide');
                $('#newPartTitle').val('');
                location.reload();
            },
            error: function (xhr, status, error) {
                console.error("Error details:", xhr.responseText);
                alert("خطا در ثبت قطعه ارسالی: " + xhr.statusText);
            }
        });
    }

    function addCommas(n) {
        if (!n) return "";
        n = n.toString().replace(/[^\d]/g, "");
        return n.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    $(document).ready(function () {
        $('.numeric-input').each(function () {
            var raw = $(this).val();
            console.log("Initial value:", raw);
            $(this).val(addCommas(raw));
        });

        $(document).on('input', '.numeric-input', function () {
            var caretPos = this.selectionStart;
            var raw = $(this).value || $(this).val();
            raw = raw.replace(/,/g, "");
            var formatted = addCommas(raw);
            $(this).val(formatted);
            this.setSelectionRange(formatted.length, formatted.length);
        });
    });
</script>
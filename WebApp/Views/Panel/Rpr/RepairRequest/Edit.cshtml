         if (page && page.$pageEl && page.$pageEl.length > 0) {
             var id = page.$pageEl.find("[data-bind='id']").val();
             if (id && id !== '0' && id !== '') {
                 globalRepairRequestId = id;
                 return globalRepairRequestId;
             }
         }


         var directId = $("[data-bind='id']").val();
         if (directId && directId !== '0' && directId !== '') {
             globalRepairRequestId = directId;
             return globalRepairRequestId;
         }


         if (Model && Model.Id) {
             globalRepairRequestId = Model.Id;
             return globalRepairRequestId;
         }

         return null;
     }



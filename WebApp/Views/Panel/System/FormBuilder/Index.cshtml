                            debugger

                            let objectUpdate = listOffields;

                            if (parentId) {

                                const parentIds = parentId.split("-");


                                parentIds.forEach(ids => {
                                    if (!KTUtil.isEmpty(ids)) {
                                        if (KTUtil.isArray(objectUpdate)) {
                                            objectUpdate.remove(c => c.id === ids);

                                        }
                                        else {
                                            objectUpdate.fields.remove(c => c.id === ids);
                                        }


                                    }

                                });

                            }
                            renderfields();
                            arrayofFeilds.remove(c => c.id === id)
                        }
                    },
                    close: {
                        text: 'انصراف',
                        btnClass: 'btn btn-danger',
                        action: function () {

                        }
                    }
                }
            });

        }

        function addFeild(feildModel) {
            debugger

            let pathObject = `data`;
            feildModel.id = KTUtil.isEmpty(feildModel?.id) ? KTUtil.getUniqueId("feild") : feildModel?.id;

            let objectUpdate = listOffields;

            if (feildModel.parentId) {

                const parentIds = feildModel?.parentId.split("-");


                parentIds.forEach(ids => {
                    if (!KTUtil.isEmpty(ids)) {
                        if (KTUtil.isArray(objectUpdate)) {
                            objectUpdate = objectUpdate.filter(c => c.id == ids)[0];


                        }
                        else {
                            objectUpdate = objectUpdate.fields.filter(c => c.id == ids)[0];
                        }

                        pathObject += `.${objectUpdate.name}`
                    }

                });

            }

            feildModel.path = pathObject;

            if (KTUtil.isArray(objectUpdate)) {

                objectUpdate.remove(c => c.id === feildModel.id);
                objectUpdate.push(feildModel);

            }
            else {
                if (!objectUpdate.fields) {
                    objectUpdate.fields = [];
                }

                objectUpdate.fields.remove(c => c.id === feildModel.id);
                objectUpdate.fields.push(feildModel);

            }
            arrayofFeilds.remove(c => c.id === feildModel.id);
            arrayofFeilds.push(feildModel);


            renderfields();
            return true;
        }


@using Entities.App.Trn
@using Entities.App.Trn.Enums
@model CourseParticipant

<div class="card">
     <div class="form-action-buttons">
          <form-action-buttons entity-type="typeof(CourseParticipant)">
          </form-action-buttons>
     </div>
</div>

<input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
<input class="form-control" data-bind="courseId" value="@Model?.CourseId" type="hidden" />

<div class="card my-2">
     <div class="card-body row">
          <span class="section-box-title">شرکت‌کننده دوره</span>

          <div class='col-md-4 form-group-inline'>
               <label class="form-label fw-bold required">شرکت‌کننده</label>
               @(Html.EntitySelector<Participant>(
                                   "ParticipantSelector",
                                   c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                                   c => new
                                   {
                                        Id = c.Id,
                                        FullName = c.FirstName + " " + c.LastName,
                                        NationalCode = c.NationalCode
                                   },
                                   c => new { c.FirstName, c.LastName, c.NationalCode },
                                   "{FullName}",
                                   "ParticipantId",
                                   Model?.Participant != null ? (Model.Participant.FirstName + " " + Model.Participant.LastName) : null,
                                   Model?.ParticipantId.ToString(),
                                   true))
               <div data-invalidmessagespan class="my-1 mx-1"> <span class="text-danger"></span> </div>
          </div>

          <div class='col-md-4 form-group-inline'>
               <label class='form-label fw-bold'>نمره</label>
               <input class='form-control' dir="ltr" data-bind='cngScore' maxlength="2"
                      data-invalidMessage='فقط عدد'
                      data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''"
                      asp-for='CngScore' />
               <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
          </div>

          <div class='col-md-4 form-group-inline'>
               <label class='form-label fw-bold'>جایگاه</label>
               <input class='form-control' data-bind='place'
                      asp-for='Place' />
               <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
          </div>

          <div class='col-md-4 form-group-inline'>
               <label class='form-label fw-bold'>وضعیت ثبت‌نام</label>
               <select class='form-control' data-bind='participantRegisterStatus'
                       asp-for='ParticipantRegisterStatus'
                       asp-items="Html.GetEnumSelectList(typeof(ParticipantRegisterStatusEnum))">
               </select>
               <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
          </div>
     </div>
</div>

<div class="card my-2">
     <div class="card-body row">
          <span class="section-box-title">اطلاعات سیستمی</span>

          <div class="col-md-3">
               <span class="fw-bold">ایجاد کننده :</span>
               <span data-bind="createdByName">@Model?.CreatedByName</span>
          </div>

          <div class="col-md-3">
               <span class="fw-bold">تاریخ ایجاد :</span>
               <span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
          </div>

          <div class="col-md-3">
               <span class="fw-bold">ویرایش کننده :</span>
               <span data-bind="modifiedByName">@Model?.ModifiedByName</span>
          </div>

          <div class="col-md-3">
               <span class="fw-bold">تاریخ ویرایش :</span>
               <span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
          </div>
     </div>
</div>
<script>
     function savefn($btnAction) {
          if (validateError(page.$pageEl)) return;

          const model = page.$pageEl.dataBind();
          const $btn = $($btnAction.element).block();

          $$.post('save', model, function (r) {
               $btn.block(false);

               if (!r.isSuccess) {
                    toastr.error(r.message, 'خطا');
                    return;
               }

               toastr.success('ذخیره سازی با موفقیت انجام شد');
               page.$pageEl.dataBind(r.data);
               $btnAction.baseaction();
          });
     }

     self.FormActionButtons.save.onclick(function () { savefn(this); });
     self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
     self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>

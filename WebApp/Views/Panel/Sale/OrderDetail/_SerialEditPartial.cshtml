@{
	Layout = null;
}
@using Entities.App.Pln
@using Entities.App.SLS
@using Entities.App.Sale
@model OrderDetailSerial

<div class="row g-3 order-detail-serial-edit">
	<input type="hidden" data-bind="id" value="@Model?.Id" />
	<input type="hidden" data-bind="orderDetailId" value="@Model?.OrderDetailId" />

	<div class="col-md-4">
		<label class="form-label required">سریال</label>
		<input class="form-control" data-bind="serial" data-required="true" value="@Model?.Serial" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>

	<div class="col-md-4">
		<label class="form-label">مدل</label>
		<input class="form-control" data-bind="model" value="@Model?.Model" />
	</div>

	<div class="col-md-4">
		<label class="form-label">شماره سفارش ساخت</label>
		<input class="form-control" data-bind="productionOrderNumber" value="@Model?.ProductionOrderNumber" />
	</div>

	<div class="col-md-6">
		<label class="form-label">پروژه</label>
		@(Html.EntitySelector<PlaningProject>(
			"SerialPlaningProjectSelector",
			c => c.IsActive == Entities.Base.IsActiveEnum.Active,
			c => new { Id = c.Id, Name = c.Name, Code = c.Code },
			c => new { c.Name, c.Code },
			"{Code} - {Name}",
			"PlaningProjectId",
			Model?.PlaningProject?.Name,
			Model?.PlaningProjectId?.ToString()
		))
	</div>

	<div class="col-md-6">
		<label class="form-label">مشتری</label>
		@(Html.EntitySelector<Customer>(
			"SerialCustomerSelector",
			c => c.IsActive == Entities.Base.IsActiveEnum.Active,
			c => new { Id = c.Id, Title = c.Party.FullName, Code = c.Code },
			c => new { c.Party.FullName, c.Code },
			"{Title}",
			"CustomerId",
			Model?.Customer?.Party?.FullName,
			Model?.CustomerId?.ToString()
		))
	</div>

	<div class="col-md-3">
		<label class="form-label">ساعت کارکرد روزانه</label>
		<input class="form-control" data-bind="hoursDaily" value="@Model?.HoursDaily" />
	</div>

	<div class="col-md-3">
		<label class="form-label">مدت گارانتی</label>
		<input class="form-control" data-bind="guaranteeTime" value="@Model?.GuaranteeTime" />
	</div>

	<div class="col-md-3">
		<label class="form-label">روز ارسال گارانتی</label>
		<input class="form-control" data-bind="guaranteeSendDay" value="@Model?.GuaranteeSendDay" />
	</div>

	<div class="col-md-3">
		<label class="form-label">روز راه‌اندازی گارانتی</label>
		<input class="form-control" data-bind="guaranteeLaunchDay" value="@Model?.GuaranteeLaunchDay" />
	</div>

	<div class="col-md-4">
		<label class="form-label">تاریخ ارسال</label>
		<input class="form-control" data-bind="sendShamsiDate"
			data-persionDatePicker="true"
			persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
			value="@Model?.SendShamsiDate" />
	</div>

	<div class="col-md-4">
		<label class="form-label">تاریخ راه‌اندازی</label>
		<input class="form-control" data-bind="launchShamsiDate"
			data-persionDatePicker="true"
			persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
			value="@Model?.LaunchShamsiDate" />
	</div>

	<div class="col-md-4">
		<label class="form-label">تاریخ خروج از کارخانه</label>
		<input class="form-control" data-bind="exitFactoryShamsiDate"
			data-persionDatePicker="true"
			persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
			value="@Model?.ExitFactoryShamsiDate" />
	</div>

	<div class="col-md-9">
		<label class="form-label">توضیحات صنایع</label>
		<textarea class="form-control" data-bind="industrialComment" rows="2">@Model?.IndustrialComment</textarea>
	</div>

	<div class="col-md-3 d-flex align-items-end">
		<div class="form-check mb-2">
			<input data-bind="hasInsurance" class="form-check-input" type="checkbox" id="chkHasInsurance" @(Model?.HasInsurance == true ? "checked" : "") />
			<label class="form-check-label" for="chkHasInsurance">دارای بیمه</label>
		</div>
	</div>
</div>

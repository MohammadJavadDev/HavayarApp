<div class="card my-2">
     <div class="card-body row">
          <span class="section-box-title">اطلاعات سیستمی</span>

          <div class="col-md-3">
               <span class="fw-bold">ایجاد کننده :</span>
               <span data-bind="createdByName">@Model?.CreatedByName</span>
          </div>

          <div class="col-md-3">
               <span class="fw-bold">تاریخ ایجاد :</span>
               <span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
          </div>

          <div class="col-md-3">
               <span class="fw-bold">ویرایش کننده :</span>
               <span data-bind="modifiedByName">@Model?.ModifiedByName</span>
          </div>

          <div class="col-md-3">
               <span class="fw-bold">تاریخ ویرایش :</span>
               <span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
          </div>
     </div>
</div>
<script>
     function getCourseId() {
          return $$('[data-bind="id"]').val();
     }

     function openSubPage(urlTemplate) {
          const id = getCourseId();
          if (!id || id === '0') {
               toastr.error('ابتدا دوره را ذخیره کنید');
               return;
          }
          appController.addPage(urlTemplate.replace('{id}', encodeURIComponent(id)));
     }

     function isPrivateCourse() {
          return Number($$('[data-bind="executingMethod"]').val()) === 636;
     }

     function isPublicParticipantTrack() {
          const trainingCode = ($$('[data-bind="trainingCode"]').val() || '').toString();
          const executingMethod = Number($$('[data-bind="executingMethod"]').val());
          return trainingCode.indexOf('TRCNG') === 0 || executingMethod === 635;
     }

     // R3 client-side: دوره اختصاصی (Private = 636) بدون شرکت معتبر نیست (سرور هم اعتبارسنجی می‌کند)
     // دکمه لاگ ایمیل گواهی فقط برای دوره اختصاصی فعال است (مثل HTS)
     function togglePrivateDependentUi() {
          const isPrivate = isPrivateCourse();
          const $wrapper = $$('#companyWrapper');
          const $hidden = $$('#CompanySelector [data-bind="companyId"]');
          const $label = $wrapper.find('.form-label');
          if (isPrivate) {
               $wrapper.show();
               $hidden.attr('data-required', 'true');
               $label.addClass('required');
          } else {
               $wrapper.hide();
               $hidden.removeAttr('data-required');
               $label.removeClass('required');
          }
          if (self.FormActionButtons.emaillog) {
               self.FormActionButtons.emaillog.element.disabled = !isPrivate;
          }
     }

     function savefn($btnAction) {
          if (validateError(page.$pageEl)) return;

          const model = page.$pageEl.dataBind();

          if (Number(model.executingMethod) === 636 && (!model.companyId || model.companyId === '0')) {
               toastr.error('برای دوره اختصاصی انتخاب شرکت الزامی است.', 'خطا');
               return;
          }

          const $btn = $($btnAction.element).block();

          $$.post('save', model, function (r) {
               $btn.block(false);

               if (!r.isSuccess) {
                    toastr.error(r.message, 'خطا');
                    return;
               }

               toastr.success('ذخیره سازی با موفقیت انجام شد');
               page.$pageEl.dataBind(r.data);
               $btnAction.baseaction();
          });
     }

     self.FormActionButtons.save.onclick(function () { savefn(this); });
     self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
     self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });

     $$('[data-bind="executingMethod"]').on('change', togglePrivateDependentUi);
     togglePrivateDependentUi();

     page.$pageEl.on('click', '[data-action="addAgent"]', function () {
          appController.addPage('/Panel/Trn/Agent/New');
     });

     // TRCNG یا فراخوان عمومی (635) → CourseParticipant؛ در غیر این صورت اختصاصی → CourseCompanyParticipant
     if (self.FormActionButtons.participants) {
          self.FormActionButtons.participants.onclick(function () {
               const url = isPublicParticipantTrack()
                    ? '/Panel/Trn/CourseParticipant/ListByCourseId?courseId={id}'
                    : '/Panel/Trn/CourseCompanyParticipant/ListByCourseId?courseId={id}';
               openSubPage(url);
          });
     }
     if (self.FormActionButtons.evaluation) {
          self.FormActionButtons.evaluation.onclick(function () { openSubPage('/Panel/Trn/CourseEvaluation/ListByCourseId?courseId={id}'); });
     }
     if (self.FormActionButtons.certificates) {
          self.FormActionButtons.certificates.onclick(function () { openSubPage('/Panel/Trn/Certificate/ListByCourseId?courseId={id}'); });
     }
     if (self.FormActionButtons.emaillog) {
          self.FormActionButtons.emaillog.onclick(function () { openSubPage('/Panel/Trn/CertificateEmailLog/ListByCourseId?courseId={id}'); });
     }
</script>

<style>

    .mainDropPage {
        background-color: var(--bs-app-bg-color);
        border: 1px dotted;
        border-radius: 5px;
        padding: 5px;
    }



    .tooltip-row-s {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-content: space-between;
        justify-content: space-between;
        align-items: baseline;
    }

    .droppeble-element {
    }

    .dropzone {
        padding: 1.5rem 1.75rem !important;
        text-align: center !important;
        cursor: pointer !important;
        border: 1px dashed var(--bs-primary) !important;
        background-color: var(--bs-primary-light) !important;
        border-radius: 0.475rem !important;
    }



    [role-systemPage] {
        padding: 6px 12px;
        min-height: 150px;
    }


    [role-systemtab] li .active {
        color: var(--bs-nav-pills-link-active-color) !important;
        background-color: var(--bs-nav-pills-link-active-bg) !important;
    }

    [data-element=true] {
        padding: 1.5rem 1.75rem !important;
        cursor: pointer !important;
        border: 1px dashed black !important;
        border-radius: 0.475rem !important;
    }


    li .nav-link i {
        float: left;
        border: 1px solid;
        padding: 3px;
        border-radius: 5px;
    }


   


    .select2-selection__choice__remove {
        left: 5px;
    }
</style>


<div class="card m-2">
    <div class="card-header align-items-center justify-content-center">
        سند ساز
    </div>
    <div class="card-body">
        <ul class="nav nav-pills nav-justified" id="myTab" role="tablist">

            <li class="nav-item" role="presentation">
                <button class="nav-link " id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab" aria-controls="home" aria-selected="false">اطلاعات</button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="field-tab" data-bs-toggle="tab" data-bs-target="#field" type="button" role="tab" aria-controls="field" aria-selected="true">ستون ها</button>
            </li>


            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tabel-tab" data-bs-toggle="tab" data-bs-target="#tabel" type="button" role="tab" aria-controls="contact" aria-selected="false">جدول</button>
            </li>


        </ul>
        <div class="tab-content" id="pageTabs">
            <div class="tab-pane fade  p-3" id="info" role="tabpanel" aria-labelledby="home-tab">
                <div class="row">
                    <div class="col-md-6 mb-10">
                        <div class="">
                            <label class="required form-label">نام </label>
                            <input type="text" class="form-control " data-bind="className" />
                        </div>
                    </div>
                    <div class="col-md-6 mb-10">
                        <div class=" ">
                            <label class="required form-label">عنوان </label>
                            <input type="text" class="form-control" data-bind="displayName" />
                        </div>
                    </div>

                </div>

            </div>
            <div class="tab-pane fade show active" id="field" role="tabpanel" aria-labelledby="field-tab">

                <div class="row mt-3 ">
                    <div class="col-md-2 border-1 border p-3 drp">
                        طرح ها
                        <hr>
                        <div id="componets">

                            <div class="dropzone droppeble-element">
                                <div class="row p-4 border m-1 item" data-componetDrop="container" data-tmplid="#containerTmpl">
                                    <div class='col-md-2 align-content-center'>
                                        <i class="fa fa-arrows-alt" data-handler="true" aria-hidden="true"></i>
                                    </div>
                                    <div class="col-md-10">  <span>Div Row</span> </div>
                                </div>
                            </div>

                            <div class="dropzone droppeble-element">
                                <div class="row p-4 border m-1 item" data-componetDrop="Col12" data-tmplid="#Col12">
                                    <div class='col-md-2 align-content-center'>
                                        <i class="fa fa-arrows-alt" data-handler="true" aria-hidden="true"></i>
                                    </div>
                                    <div class="col-md-10">  <span>Div Col-12</span> </div>
                                </div>
                            </div>

                            <div class="dropzone droppeble-element">
                                <div class="row p-4 border m-1 item" data-componetDrop="Col6" data-tmplid="#Col6">
                                    <div class='col-md-2 align-content-center'>
                                        <i class="fa fa-arrows-alt" data-handler="true" aria-hidden="true"></i>
                                    </div>
                                    <div class="col-md-10">  <span>Div Col-6</span> </div>
                                </div>
                            </div>

                            <div class="dropzone droppeble-element">
                                <div class="row p-4 border m-1 item" data-componetDrop="Col4" data-tmplid="#Col4">
                                    <div class='col-md-2 align-content-center'>
                                        <i class="fa fa-arrows-alt" data-handler="true" aria-hidden="true"></i>
                                    </div>
                                    <div class="col-md-10">  <span>Div Col-4</span> </div>
                                </div>
                            </div>

                            <div class="dropzone droppeble-element">
                                <div class="row p-4 border m-1 item" data-componetDrop="Col3" data-tmplid="#Col3">
                                    <div class='col-md-2 align-content-center'>
                                        <i class="fa fa-arrows-alt" data-handler="true" aria-hidden="true"></i>
                                    </div>
                                    <div class="col-md-10">  <span>Div Col-3</span> </div>
                                </div>
                            </div>


                            <div class="dropzone droppeble-element">
                                <div class="row p-4 border m-1 item" data-componetDrop="container" data-tmplid="#containerTmpl">
                                    <div class='col-md-2 align-content-center'>
                                        <i class="fa fa-arrows-alt" data-handler="true" aria-hidden="true"></i>
                                    </div>
                                    <div class="col-md-10">  <span>Div Row</span> </div>
                                </div>
                            </div>
                            <div class="dropzone droppeble-element">
                                <div class="row p-4 border m-1 item" data-componetDrop="card" data-tmplid="#cardTmpl">
                                    <div class='col-md-2 align-content-center'>
                                        <i class="fa fa-arrows-alt" data-handler="true" aria-hidden="true"></i>
                                    </div>
                                    <div class="col-md-10">  <span>Card</span> </div>
                                </div>
                            </div>

                            <div class="dropzone droppeble-element">
                                <div class="row p-4 border m-1 item" data-componetDrop="tab" data-tmplid="#tabTmpl">
                                    <div class='col-md-2 align-content-center'>
                                        <i class="fa fa-arrows-alt" data-handler="true" aria-hidden="true"></i>
                                    </div>
                                    <div class="col-md-10">  <span>Tab</span> </div>
                                </div>
                            </div>
                            <div class="dropzone droppeble-element">

                                <div class="row p-4 border m-1 item" data-componetDrop="gridview" data-tmplid="#gridviewTmpl">
                                    <div class='col-md-2 align-content-center'>
                                        <i class="fa fa-arrows-alt" data-handler="true" aria-hidden="true"></i>
                                    </div>
                                    <div class="col-md-10">  <span>GridView</span> </div>
                                </div>

                            </div>
                        </div>



                    </div>

                    <div class="col-md-7 border-1 border p-10 drp">
                        <div id="designPlace" data-dropzone="true" data-section="ture">
                            <div>

                                <div class="row">
                                    <div class="col-md-3">
                                        <button class="btn btn-success" data-action="saveform">ذخیره</button>
                                    </div>
                                </div>
                                <div class="mainDropPage droppeble-element" style="min-height: 150px;">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 border-1 border p-3 ">
                        فیلد ها
                        <hr>
                        <div id="fieldsPlace" class="drp">
                        </div>
                        <div>
                            <button class="btn btn-success w-100" id="addfield">افزودن فیلد</button>
                        </div>
                    </div>

                </div>


            </div>

            <div class="tab-pane fade" id="tabel" role="tabpanel" aria-labelledby="tabel-tab">
                <div class="col-md-12">
                    <div class="bg-light-warning col-md-12 mb-6 mt-6 p-2 row text-center">
                        <div class="col-md-5">
                            <label>فیلد فرم</label>
                        </div>

                        <div class="col-md-4">
                            <label>عنوان</label>
                        </div>

                        <div class="col-md-3">
                            مرتب سازی
                        </div>

                    </div>
                    <div id="tableDesignPlace">
                    </div>

                </div>
                <div class="row justify-content-center mt-3 mb-3">
                    <div class="col-md-6">
                        <button class="btn btn-light-info" style="width:100%" id="addCol">افزودن ستون</button>

                    </div>

                </div>
            </div>

        </div>

        <div class="row justify-content-center">
            <div class="col-md-3">
                <button id="save" class="btn btn-light-success">
                    ذخیره
                </button>
                <button id="publish" class="btn btn-success">
                    انتشار
                </button>
            </div>
        </div>
    </div>
</div>




@section Scripts{



    <script type="text/x-jquery-tmpl" id="tooltipTmpl">
        <div class="tooltip-row-s">
         <div class="mx-1">
            <a class=" hover-scale " role="button" data-action="edit" data-containerid="${id}"  data-containerparentid="${parentId}" >
                        <i class="ki-duotone ki-pencil fs-2  text-warning ">
                            <span class="path1"></span>
                            <span class="path2"></span>
                        </i>
                    </a>
                     </div>
                      <div class="mx-1">
                     <a class="hover-scale " role="button" data-action="remove" data-containerid="${id}"   data-containerparentid="${parentId}" >
                            <i class="ki-duotone ki-trash  fs-2  text-danger ">
                                <span class="path1"></span>
                                <span class="path2"></span>
                                <span class="path3"></span>
                                <span class="path4"></span>
                                <span class="path5"></span>
                            </i>
                        </a>
                     </div>
          </div>
    </script>

    <script type="text/x-jquery-tmpl" id="tabelDesignTmpl">
        <div class="row mt-3" data-sortTabelFeild="true">
            <div class="col-md-5 row">
                <div class="col-md-1">
                  <i class="fa fa-arrows-alt" aria-hidden="true" data-handler="true"></i>
                </div>

                <div class="col-md-1">
                    <a class="hover-scale " role="button" data-action="removeFeildTabel">
                <i class="ki-duotone ki-trash  fs-2  text-danger ">
                         <span class="path1"></span>
                         <span class="path2"></span>
                         <span class="path3"></span>
                         <span class="path4"></span>
                         <span class="path5"></span>
                        </i>
                       </a>
                  </div>

                       <div class="col-md-10">
                    <select class="form-control" multiple >

                    </select>
                    </div>
            </div>
            <div class="col-md-4">
             <input class="form-control" data-bind="title" />
            </div>
            <div class="col-md-3">
            <select class="form-control" >
            <option value="">
                بدون تغییر
            </option>
            <option value="0">
                کم به زیاد
            </option>
            <option value="1">
                زیاد به کم
            </option>
            </select>
            </div>
        </div>
    </script>

    <script type="text/x-jquery-tmpl" id="feildElementTmpl">

        <div class="">
             <label class=" {{if required === true}} required {{else}}  {{/if}} form-label">${displayName} </label>

                {{if fieldType === "string"}}
                      {{if multiLine === false}}
                         <input type="text" value="${defaultValue}" {{if readOnly === true}} disabled {{/if}} {{if customStringRegex && customStringRegex.length > 0 }}  data-inputmask=" 'regex':'${customStringRegex}'  ,   'placeholder' : '' " {{else}}  {{/if}}  {{if maxLength && maxLength.length > 0}} maxlength="${maxLength}"  {{else}}  {{/if}}  class="form-control " data-bind="${name}" inputmode="text">
                         {{else}}
                          <textarea type="text" {{if readOnly === true}} disabled {{/if}}  {{if customStringRegex && customStringRegex.length > 0 }}  data-inputmask=" 'regex':'${customStringRegex}'  ,   'placeholder' : '' " {{else}}  {{/if}}  {{if maxLength && maxLength.length > 0}} maxlength="${maxLength}"  {{else}}  {{/if}}  class="form-control " data-bind="${name}" inputmode="text">${defaultValue}</textarea>
                         {{/if}}

                {{/if}}

                {{if fieldType === "long"}}
                           <input type="text" value="${defaultValue}" {{if readOnly === true}} disabled {{/if}}    data-inputmask=" 'regex':'^[0-9]*$'  ,   'placeholder' : '' "    class="form-control " data-bind="${name}" inputmode="text">
                 {{/if}}

                  {{if fieldType === "autoNumber"}}
                    <input type="text"  disabled  class="form-control " data-bind="${name}" inputmode="text">
                 {{/if}}
                  {{if fieldType === "guid"}}
                      <input type="text" value="${defaultValue}"  {{if readOnly === true}} disabled {{/if}}  class="form-control " data-bind="${name}" inputmode="text">
                 {{/if}}
                  {{if fieldType === "file"}}
                        <div class="fv-row">

                                 <div class="upload-image-dropzone" data-uploadFile="true" data-uploadFileMaxSize="${maxFileSize}" data-uploadFileTypeFormat="${customFileTypeFormat}" data-uploadFileName="${name}">

                                     <div class="dz-message needsclick">
                                         <i class="ki-duotone ki-file-up fs-3x text-primary">
                                             <span class="path1"> </span>
                                             <span class="path2"></span>
                                         </i>

                                         <div class="ms-4">
                                             <h3 class="fs-5 fw-bold text-gray-900 mb-1">فایل اینجا رها کنید یا کلیلک کنید</h3>
                                             <span class="fs-7 fw-semibold text-gray-500">${customFileTypeFormat} فرمت های مجاز</span>
                                         </div>

                                     </div>
                                 </div>

                             </div>
                 {{/if}}
                  {{if fieldType === "time"}}
                 <input  class="form-control " {{if readOnly === true}} disabled {{/if}}  data-bind="${name}" data-persionDatePicker="true" data-persionDatePickerOption='{"onlyTimePicker" : true , "format" :"HH:mm:ss" ,"inline": false,"calendarType": "persian" }'>
                 {{/if}}
                   {{if fieldType === "date"}}
                                 <input  {{if readOnly === true}} disabled {{/if}}  class="form-control " data-bind="${name}" data-persionDatePicker="true" data-persionDatePickerOption='{ "format" :"YYYY/MM/DD" ,"inline": false,"calendarType": "persian" }'>

                 {{/if}}

                  {{if fieldType === "dateTime"}}
                   <input  class="form-control " {{if readOnly === true}} disabled {{/if}}  data-bind="${name}" data-persionDatePicker="true" data-persionDatePickerOption='{ "timePicker": {"enabled" : true} , "format" :"YYYY/MM/DD HH:mm:ss" ,"inline": false,"calendarType": "persian" }'>

                 {{/if}}

                  {{if fieldType === "bool"}}

                      <div class="col-md-12   row text-center">
                         <div class="  col-md-6">
                                     <input {{if readOnly === true}} disabled {{/if}}  class="form-check-input" type="radio" value="true" id="${id}1${tmpId}" name="${name}${tmpId}" data-bind="${name}">
                                     <label class="form-check-label" for="${id}1${tmpId}">
                                            بله
                                     </label>
                                 </div>

                             <div class="  col-md-6">
                                 <input {{if readOnly === true}} disabled {{/if}}  class="form-check-input" type="radio" value="false" id="${id}2${tmpId}" name="${name}${tmpId}" data-bind="${name}">
                                 <label class="form-check-label" for="${id}2${tmpId}">
                                    خیر
                                 </label>
                             </div>
                    </div>

                  {{/if}}

                  {{if fieldType === "select"}}
                  <select data-bind="${name}" {{if readOnly === true}} disabled {{/if}} class="form-control" >

                     {{each(prop, val) options}}
                         <option value="${val.value}">  ${val.title}</option>
                     {{/each}}

                  </select>

                 {{/if}}


             <span class="text-gray-500 mt-1 fw-semibold fs-6">${helperText}</span>
         </div>

    </script>


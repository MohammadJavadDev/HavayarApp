@using Entities.App.Trn
@using WebApp.Controllers.Dynamic
@model TodoListListByParentViewModel

@{
     var tableId = "todoListTable_" + Model.CompanyId;
}

<div class="card" id="todoListListPage" data-company-id="@Model.CompanyId">
     <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold">
               <i class="fa fa-clipboard-list ms-2"></i>
               تاریخچه مذاکرات شرکت (@Model.CompanyTitle)
          </h5>
          <div>
               <button type="button" class="btn btn-sm btn-primary" id="btnNewTodoList">
                    <i class="fa fa-plus ms-1"></i>
                    پیگیری جدید
               </button>
          </div>
     </div>
     <div class="card-body">
          <table id="@tableId" class="table table-striped table-row-bordered gy-2 w-100">
               <thead>
                    <tr class="fw-bold fs-6 text-muted">
                         <th>عنوان</th>
                         <th>توضیحات</th>
                         <th>ایجاد کننده</th>
                         <th>تاریخ ایجاد</th>
                         <th>ساعت</th>
                         <th>انجام شد</th>
                    </tr>
               </thead>
               <tbody></tbody>
          </table>
     </div>
</div>
<script>
     const companyId = '@Model.CompanyId';
     const tableSelector = '#@tableId';
     const listApiUrl = '/Panel/Trn/TodoList/GetListByParentId?companyId=' + companyId;

     function escapeHtml(text) {
          if (text === null || text === undefined) return '-';
          return String(text)
               .replace(/&/g, '&amp;')
               .replace(/</g, '&lt;')
               .replace(/>/g, '&gt;')
               .replace(/"/g, '&quot;');
     }

     const table = $$(tableSelector).DataTable({
          serverSide: false,
          autoWidth: false,
          scrollX: true,
          pageLength: 10,
          lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, 'همه']],
          order: [[1, 'desc']],
          language: { url: '/panelLib/plugins/custom/datatables/fa.json' },
          ajax: {
               url: listApiUrl,
               type: 'GET',
               dataSrc: function (json) {
                    if (json && json.isSuccess === false) {
                         toastr.error(json.message || 'خطا در دریافت اطلاعات');
                         return [];
                    }
                    return (json && json.data) ? json.data : (Array.isArray(json) ? json : []);
               }
          },
          columns: [
               { data: 'title', render: function (d) { return escapeHtml(d); } },
               { data: 'description', render: function (d) { return escapeHtml(d); } },
               { data: 'createdByName', render: function (d) { return escapeHtml(d); } },
               { data: 'createdOnShamsiDateTime', render: function (d) { return escapeHtml(d ? String(d).split(' ')[0] : ''); } },
               {
                    data: 'createdOnMiladiDateTime',
                    render: function (d) {
                         if (!d) return '';
                         const date = new Date(d);
                         if (isNaN(date.getTime())) return '';
                         const pad = function (n) { return String(n).padStart(2, '0'); };
                         return pad(date.getHours()) + ':' + pad(date.getMinutes()) + ':' + pad(date.getSeconds());
                    }
               },
               {
                    data: 'isDone',
                    className: 'text-center',
                    render: function (d) { return d ? '<i class="fa fa-check text-success"></i>' : ''; }
               }
          ]
     });

     window['@tableId'] = table;

     $$('#btnNewTodoList').on('click', function () {
          appController.addPage('/Panel/Trn/TodoList/New?companyId=' + companyId);
     });
</script>

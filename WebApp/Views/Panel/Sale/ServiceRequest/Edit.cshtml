            <div class="col-md-2 d-flex align-items-center mt-4">
                <div class="form-check">
                    <input data-bind="unreal"
                           class="form-check-input"
                           type="checkbox"
                           asp-for="Unreal" />

                    <label class="form-check-label fw-bold form-label fw-bold"
                           asp-for="Unreal">
                        غیر واقعی
                    </label>
                </div>

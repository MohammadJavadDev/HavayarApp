<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - App.BackgroundJob</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/App.BackgroundJob.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
     <nav class="navbar navbar-expand-lg navbar-custom">
          <div class="container-fluid main-container">
               <a class="navbar-brand js-soft-nav" href="/" data-title="ابزارهای توسعه">
                    <i class="fas fa-tools me-2"></i>
                    ابزارهای توسعه
               </a>
               <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
               </button>
               <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                         <li class="nav-item">
                              <a class="nav-link js-soft-nav" asp-controller="Home" asp-action="Index" data-title="تولید کلاس از دیتابیس">
                                   <i class="fas fa-database me-1"></i>
                                   اطلاعات جداول
                              </a>
                         </li>
                         <li class="nav-item">
                              <a class="nav-link js-soft-nav" asp-controller="Jobs" asp-action="Index" data-title="مدیریت سرویس‌های پس‌زمینه">
                                   <i class="fas fa-cogs me-1"></i>
                                   زمانبندی ها
                              </a>
                         </li>
                         <li class="nav-item">
                              <a class="nav-link js-soft-nav" asp-controller="JobLogs" asp-action="Index" data-title="تاریخچه زمان‌بندی‌ها">
                                   <i class="fas fa-history me-1"></i>
                                   تاریخچه زمانبندی ها
                              </a>
                         </li>
                    </ul>
               </div>
          </div>
     </nav>

     <div class="main-container">
          <div id="app-content">
               @RenderBody()
          </div>
     </div>

     <div id="toast-container" class="toast-container position-fixed bottom-0 start-0 p-3" style="z-index: 1090;"></div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - App.BackgroundJob
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/app-toast.js" asp-append-version="true"></script>
    <script src="~/js/soft-nav.js" asp-append-version="true"></script>
    <script src="~/js/job-realtime.js" asp-append-version="true"></script>
    <script src="~/js/jobs-page.js" asp-append-version="true"></script>
    <script src="~/js/joblogs-page.js" asp-append-version="true"></script>
    <script src="~/js/home-page.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@using Entities.App.Eng;
@using Entities.App.Inv
@model PartList

<div class="card mt-1">
<div class="form-action-buttons"><form-action-buttons entity-type="typeof(PartList)"></form-action-buttons></div>
</div>

<div class="card mt-1">
	<div class="card-body row">
		<div class="col-12 mb-4">
			<h3 class="fw-bold text-dark">اطلاعات اصلی</h3>
		</div>
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class="col-md-6">
			<label class=''>دسته بندی</label>
			@(Html.EntitySelector<PartListGroup>(
				"PartListGroupSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Product_Name = c.Product.Name, Product_Code = c.Product.Code, Title = c.Title
				},
				c => new { c.Product, c.Title },
				"{Product.Name} {Product.Code} {Title}",
				"PartListGroupId",
				"PartListGroupName",
				Model?.PartListGroupId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>محصول</label>
			@(Html.EntitySelector<Part>(
				"ProductSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Name = c.Name, Code = c.Code
				},
				c => new { c.Name, c.Code },
				"{Name} {Code}",
				"ProductId",
				"ProductName",
				Model?.ProductId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>کالا</label>
			@(Html.EntitySelector<Part>(
				"PartSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Name = c.Name, Code = c.Code
				},
				c => new { c.Name, c.Code },
				"{Name} {Code}",
				"PartId",
				"PartName",
				Model?.PartId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>مقدار</label>
			<input class='form-control'  data-bind='qty'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='Qty' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>ترتیب</label>
			<input class='form-control'  data-bind='order'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='Order' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-12'>
			<label class=''>توضیحات</label>
			<input class='form-control' data-bind='description'  asp-for='Description' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	</div>
</div>

<div class="card mt-1">
	
<div class="card-body row">

		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
	 
</div>

<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) { return; }
		var model = page.$pageEl.dataBind();
		const $btn = $(this.element).block();
		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				page.$pageEl.dataBind(r.data);
				$btnAction.baseaction();
			})
	}

	self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
</script>

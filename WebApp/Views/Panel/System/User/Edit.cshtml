@using Data.Contracts
@using Entities.App.Gnr
@using Entities.Auth
@using Entities.Base
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Entities.Auth.User
@inject IRepository<Role> serviceRole;
@{



     var systemRoles =   serviceRole.TableNoTracking.Select(c => new { c.Id, c.Name, c.Title }).ToArray();
     long copyAccessTargetId = Model?.Id ?? 0;
     var userProfileImage = "/file/profile-image/" + Model?.ProfileUrl;
}

<style>
    .image-input-placeholder {
        background-image: url('assets/media/svg/files/blank-image.svg');
    }
    [data-bs-theme="dark"] .image-input-placeholder {
        background-image: url('assets/media/svg/files/blank-image-dark.svg');
    }</style>
 

<div class="card">
    <div class="card-body">
        
            <div class="row">
                <div class="mb-7">

                    <label class="fs-6 fw-semibold mb-3">
                        <span>بروزرسانی تصویر پروفایل</span>

                    </label>

                    <div class="mt-1">

                        <div class="image-input image-input-outline image-input-placeholder image-input-empty image-input-empty">

                              <div class="image-input-wrapper w-100px h-100px" id="imageplaceholder" style="background-image: url('@userProfileImage')"></div>

                            <label class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow">

                                <i class="fa fa-pencil" aria-hidden="true" id="uploadProfileImage"></i>

                            <input type="hidden" value="@Model?.ProfileUrl" data-input-name="profileUrl" data-bind="profileUrl">

                            </label>

                            <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow">
                                <i class="ki-duotone ki-cross fs-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                            </span>

                            <span class="btn btn-icon btn-circle btn-active-color-primary w-25px h-25px bg-body shadow">
                                <i class="ki-duotone ki-cross fs-2">
                                    <span class="path1"></span>
                                    <span class="path2"></span>
                                </i>
                            </span>

                        </div>

                    </div>

                </div>

                <div class="col-md-6 ">
                    <div class="form-group">
                        <label class="form-label">نام</label>
                        <input value="@Model?.Name" class="form-control" data-bind="Name" />
                    <input type="hidden" value="@Model?.Id" data-bind="Id" />
                    
                    </div>

                </div>
                <div class="col-md-6 ">
                    <div class="form-group">
                        <label class="form-label">نام کاربری</label>
                    <input value="@Model?.Username" class="form-control" data-bind="Username" />
                    
                    </div>
                </div>
               <div class="col-md-6 ">
                    <div class="form-group">
                         <label class="form-label">نام به فارسی</label>
                         <input value="@Model?.NameFa" class="form-control" data-bind="NameFa" />
                         <input type="hidden" value="@Model?.Id" data-bind="Id" />

                    </div>

               </div>

               <div class="col-md-6 ">
                    <div class="form-group">
                         <label class="form-label">شخص شرکت</label>
                      
			          @(Html.EntitySelector<Party>(
				          "CustomerSelector",
				          c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				          c => new
				          {
					          Id = c.Id, 
                                  FullName = c.FullName,
                                  Number = c.Number
				          },
                           c => new { c.FullName, c.Number },
                                                  "{FullName} {Number}",
				          "PartyId",
				          "PartyName",
				          Model?.PartyId?.ToString()
			          ))
			          <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		       

                    </div>

               </div>

              

               <div class="col-md-6 ">
                    <div class="form-group">
                         <label class="form-label">ایمیل</label>
                         <input value="@Model?.Email" class="form-control" data-bind="Email" />

                    </div>
               </div>
               <div class='col-md-6'>
                    <label class=''>نوع تعریف کاربر</label>
                    <select class='form-select' data-bind='authorizationType' asp-for='AuthorizationType'
                            asp-items="Html.GetEnumSelectList(typeof(AuthorizationTypeEnum))">
                    </select>
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>
                <div class="col-md-6 ">
                    <div class="form-group">
                        <label class="form-label">رمز عبور </label>
                    <input value="" class="form-control" data-bind="password" />

                    </div>
                </div>
               <div class='col-md-6'>
                    <label class=''>وضعیت </label>
                    <select class='form-select' data-bind='IsActive' asp-for='IsActive'
                            asp-items="Html.GetEnumSelectList(typeof(IsActiveEnum))">
                    </select>
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>
              
 
                <div class="form-group">
                    <label >نقشها</label>

                <select class="form-control" multiple="multiple" data-bind="Roles">

                        @foreach (var r in systemRoles)
                        {
                            if (Model?.RoleIds?.Contains((long)r.Id) ?? false)
                            {
                                   <option value="@r.Name:@r.Id" selected>@r.Title</option>
                            }
                            else
                            {
                                <option value="@r.Name:@r.Id">@r.Title</option>
                            }

                        }

                    </select>
                </div>
                <div class="col-md-6 mt-10 d-flex gap-2">
                    <button type="button" id="saveUser" class="btn btn-primary">ذخیره</button>
                    @if (Model?.Id > 0)
                    {
                        <button type="button" id="openPanelAsUser" class="btn btn-warning">باز شدن با دسترسی کاربر</button>
                        <button type="button" id="copyAccessFromUser" class="btn btn-info">ایجاد دسترسی مشابه کاربر دیگر</button>
                    }
                </div>

                @if (Model?.Id > 0)
                {
                    <div class="col-md-12 mt-5 d-none" id="copyAccessPanel">
                        <div class="border rounded p-4">
                            <div class="row">
                                <div class="col-md-6 form-group-inline">
                                    <label class="form-label fw-bold">کاربر مرجع (جستجو با نام، نام فارسی یا نام کاربری)</label>
                                    @(Html.EntitySelector<User>(
                                        "CopyAccessSourceSelector",
                                        c => c.IsActive == IsActiveEnum.Active && c.Id != copyAccessTargetId,
                                        c => new { Id = c.Id, Name = c.Name, NameFa = c.NameFa ?? c.Name, Username = c.Username },
                                        c => new { c.Name, c.NameFa, c.Username },
                                        "{NameFa} ({Username})"
                                    ))
                                </div>
                                <div class="col-md-6 d-flex align-items-end">
                                    <div class="form-check mb-2">
                                        <input type="checkbox" class="form-check-input" id="copyAccessRemoveExisting" />
                                        <label class="form-check-label" for="copyAccessRemoveExisting">حذف دسترسی‌های قبلی</label>
                                    </div>
                                </div>
                                <div class="col-md-12 text-muted mb-3">اگر تیک نخورد، نقش‌های کاربر مرجع به نقش‌های فعلی اضافه می‌شود (نقش تکراری اضافه نمی‌شود).</div>
                                <div class="col-md-12 d-flex gap-2">
                                    <button type="button" class="btn btn-primary" id="applyCopyAccess">اعمال</button>
                                    <button type="button" class="btn btn-light" id="cancelCopyAccess">انصراف</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        
    </div>
</div>


 
<script>

     $$('select[multiple]').select2({
         tags: true,
         tokenSeparators: [',']
     });

     $$("#uploadProfileImage")
         .click(function () {

             upload({
                 allowedTypes: "*.png,*.jpg,*.jpeg",
                 path: "UserProfileImage",
                 onComplete: function (g) {
                     if (!g.data.path) return error(g.message);
                     debugger

                     $("[data-input-name=profileUrl]").val(g.data.path)
                     $("#imageplaceholder").css("background-image", `url('${g.data.path}')`)

                 }
             })

         });

     $$("#saveUser").click(function () {
         var model = $(".card").dataBind();

         

          let roleNames =[];
          let roleIds = []
          model.Roles.forEach((c)=>{
             let roleName = c.split(":")[0];
              let roleId = c.split(":")[1];

              roleNames.push(roleName);
              roleIds.push(roleId);
          });

          model.Roles = roleNames;
          model.RoleIds  =roleIds;
           
       
 
         $$.post("/panel/SaveUser", model, function (r) {

             if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
             $$('.card').dataBind(r.data);

             $$("[data-bind='password']").val("");

             toastr.success("ذخیره سازی با موفقیت انجام شد .");
         })
     });

     $$("#copyAccessFromUser").on("click", function () {
         $$("#copyAccessPanel").toggleClass("d-none");
     });

     $$("#cancelCopyAccess").on("click", function () {
         $$("#copyAccessPanel").addClass("d-none");
     });

     $$("#applyCopyAccess").on("click", function () {
         const targetId = $$("[data-bind='Id']").first().val();
         const sourceId = $$("#CopyAccessSourceSelector .entity-selector-value").val();
         const removeExisting = $$("#copyAccessRemoveExisting").is(":checked");

         if (!targetId || targetId === "0") {
             toastr.error("ابتدا کاربر را ذخیره کنید.");
             return;
         }
         if (!sourceId) {
             toastr.error("کاربر مرجع را انتخاب کنید.", "خطا");
             return;
         }

         const $btn = $(this).block();
         $$.post("/panel/User/CopyAccess", {
             targetUserId: targetId,
             sourceUserId: sourceId,
             removeExisting: removeExisting
         }, function (res) {
             $btn.block(false);
             if (!res.isSuccess) return toastr.error(res.message, "خطا");
             toastr.success(res.message);
             appController.refreshCurrentPage();
         });
     });

     $$("#openPanelAsUser").on("click", function () {
         const id = $$("[data-bind='Id']").first().val();
         if (!id || id === "0") {
             toastr.error("ابتدا کاربر را ذخیره کنید.");
             return;
         }

         const popup = window.open("about:blank", "havayarViewAs" + id, "width=1440,height=900,left=40,top=30,resizable=yes,scrollbars=yes");
         if (!popup) {
             toastr.error("مرورگر پنجره جدید را بست. اجازه پنجره بازشو را بدهید.");
             return;
         }

         const $btn = $(this).block();
         $$.post("/panel/User/StartViewAs", { id: id }, function (r) {
             $btn.block(false);
             if (!r.isSuccess || !r.data || !r.data.url) {
                 popup.close();
                 toastr.error((r && r.message) || "باز کردن پنل کاربر انجام نشد.", "خطا");
                 return;
             }
             try {
                 if (popup.closed) return;
                 popup.location.href = r.data.url;
             } catch (e) {
                 toastr.error("پنجره بررسی بسته شد.");
             }
         });
     });

</script>
                        

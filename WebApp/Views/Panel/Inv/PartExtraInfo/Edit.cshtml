			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 

		<div class='col-md-3'>
			<label class=''>Airend RPM</label>
			<input class='form-control'  data-bind='airEndRPM'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='AirEndRPM' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 

		<div class='col-md-3'>
			<label class=''>Model Motor</label>
			<input class='form-control' data-bind='motorModel'  asp-for='MotorModel' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

 

		<div class='col-md-3'>
			<label class=''>Pressure Working</label>
			<input class='form-control'  data-bind='workPressure'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='WorkPressure' />

               </div>

               <div class='col-md-2 align-content-center'>
                    <div class="form-check">
                         <input data-bind='irankitReplacement' class="form-check-input" type="checkbox" asp-for='IrankitReplacement' />
                         <label class="form-check-label form-label fw-bold" asp-for='IrankitReplacement'>
                              تعويض كيت ايراند
                         </label>
                    </div>
               </div>

               <div class='col-md-2 align-content-center'>
                    <div class="form-check">
                         <input data-bind='electricMotorGreasing' class="form-check-input" type="checkbox" asp-for='ElectricMotorGreasing' />
                         <label class="form-check-label form-label fw-bold" asp-for='ElectricMotorGreasing'>

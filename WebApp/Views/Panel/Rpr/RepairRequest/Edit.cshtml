    function loadContractorList(repairRequestId) {
        if (!repairRequestId || repairRequestId === '0') {
            $('#contractorTableBody').html('<tr><td colspan="13" class="text-center text-warning">شناسه تعمیرات یافت نشد</td></tr>');
            return;
        }

        $.ajax({
            url: '/Panel/Rpr/RepairRequest/GetRepairRequestContractor',
            type: 'GET',
            data: { repairRequestId: repairRequestId },
            dataType: 'json',
            success: function(response) {
                debugger
                if (response && response.isSuccess === true && response.data && response.data.length >= 0){
                    debugger
                    renderContractorTable(response.data);
                } else {
                    $('#contractorTableBody').html('<tr><td colspan="13" class="text-center text-warning">هیچ اطلاعاتی یافت نشد</td></tr>');
                }
            },
            error: function(xhr) {
                console.error('خطا در دریافت اطلاعات:', xhr);
                $('#contractorTableBody').html('<tr><td colspan="13" class="text-center text-danger">خطا در دریافت اطلاعات</td></tr>');
            }
        });
    }

    function renderContractorTable(data) {
        var tbody = $('#contractorTableBody');
        tbody.empty();

        $.each(data, function(index, item) {
            debugger
            var contractorName = '-';
            if (item.contractor) {
                debugger
                contractorName = item.contractor.title || item.contractor.name || '-';
            }
            
            var row = '<tr data-item-id="' + (item.id || 0) + '">';
            row += '<td class="text-center">';
            row += '<button type="button" class="btn btn-icon btn-warning btn-sm" data-action="editContractorBtn" data-id="' + (item.id || 0) + '" style="margin-left: 5px;">';
            row += '<i class="fa fa-pencil"></i>';
            row += '</button>';
            row += '<button type="button" class="btn btn-icon btn-danger btn-sm" data-action="deleteContractorBtn" data-id="' + (item.id || 0) + '">';
            row += '<i class="fa fa-trash"></i>';
            row += '</button>';
            row += '</td>';
            row += '<td class="text-center">' + (index + 1) + '</td>';
            row += '<td>' + contractorName + '</td>';
            row += '<td class="text-end">' + (item.cost ? new Intl.NumberFormat('fa-IR').format(item.cost) : '-') + '</td>';
            row += '<td><span title="' + (item.part.name + ' - ' + item.part.code || '') + '">' + (item.part.name || '-') + ' (' + (item.part.code || '-') + ')</span></td>';
            row += '<td class="text-center">' + (item.sendPartShamsiDate || '-') + '</td>';
            row += '<td class="text-center">' + (item.contractorAcceptShamsiDate || '-') + '</td>';
            row += '<td class="text-center">' + (item.agreegmentShamsiDate || '-') + '</td>';
            row += '<td class="text-center">' + (item.contractorReturnShamsiDate || '-') + '</td>';
            row += '<td class="text-center">' + (item.costAnnouncementShamsiDate || '-') + '</td>';
            row += '<td>' + (item.createdByName || item.createdBy || '-') + '</td>';
            row += '<td class="text-center">' + (item.createdOnShamsiDateTime || '-') + '</td>';
            row += '<td style="max-width:250px; white-space:normal; word-wrap:break-word;">' + (item.comment || '-') + '</td>';
            row += '</tr>';
            tbody.append(row);
        });
    }

    function refreshContractorTable() {
    var repairRequestId = $('[data-bind="id"]').val();
    
    if (repairRequestId && repairRequestId !== '0' && repairRequestId !== '') {
        $('#contractorTableBody').html('<td><td colspan="13" class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">در حال بارگذاری...</span></div></td></tr>');
        loadContractorList(repairRequestId);
    } else {
        console.warn('شناسه تعمیرات برای رفرش جدول یافت نشد');
    }
}

function saveOrUpdateContractor(model, self) {
    return new Promise((resolve, reject) => {
        $$.post('/Panel/Rpr/RepairRequest/AddRepairRequestContractor', model, function(r) {
            if (!r.isSuccess) {
                toastr.error(r.message || 'خطا در ذخیره', 'خطا');
                reject(r);
                return;
            }
            
            var actionText = model.Id && model.Id != 0 ? 'ویرایش' : 'افزودن';
            toastr.success(`پیمانکار با موفقیت ${actionText} شد`);
            resolve(r);
        });
    });
}

function openContractorModal(contractorId = null) {
    debugger
    var repairRequestId = $('[data-bind="id"]').val();
    
    if (!repairRequestId || repairRequestId === '0') {
        toastr.error('لطفا ابتدا اطلاعات تعمیرات را ذخیره کنید');
        return;
    }

    var url;
    var titleText;
    
    if (contractorId) {
        url = '/Panel/Rpr/RepairRequest/EditContractorForm?id=' + contractorId + '&repairRequestId=' + repairRequestId;

        titleText = 'ویرایش پیمانکار';
    } else {
  
        url = '/Panel/Rpr/RepairRequest/ShowContractorForm?repairRequestId=' + repairRequestId;
        titleText = 'افزودن پیمانکار';
    }
    
    $$.get(url, function(result) {
        var bodyCn = $('<div style="overflow-x: hidden; overflow-y: auto; max-height: 70vh;">' + result + '</div>');
        initPersionDatePicker(bodyCn);
        
        $.confirm({
            title: titleText,
            columnClass: 'col-md-6',
            content: bodyCn,
            rtl: true,
            buttons: {
                save: {
                    text: 'ذخیره',
                    btnClass: 'btn-success',
                    action: function() {
                        var $content = this.$content;
                        if (validateError($content)) {
                            return false;
                        }
                        
                        var model = $content.dataBind();
                        model.RepairRequestId = repairRequestId;
                                                
                        if (contractorId) {
                            model.Id = contractorId;
                        }
                        
                        var self = this;
                        
                        saveOrUpdateContractor(model, self).then(function() {
                            refreshContractorTable();
                            self.close();
                        }).catch(function(error) {
                        });
                        
                        return false;
                    }
                },
                cancel: {
                    text: 'انصراف',
                    btnClass: 'btn-secondary'
                }
            },
            onContentReady: function() {
                var self = this;
                setTimeout(function() {
                    debugger
                    self.$body.find('select.select2-hidden-accessible').each(function() {
                        var $select = $$(this);
                        var currentData = $select.select2('data');
                        $select.select2('destroy');
                        $select.select2({
                            dropdownParent: self.$body,
                            width: '100%',
                            placeholder: $select.attr('placeholder') || 'انتخاب کنید'
                        });
                        if (currentData && currentData.length > 0) {
                            $select.val($select.val()).trigger('change');
                        }
                    });
                }, 100);
            }
 });
    });
}    

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 60 MB. IIS default is 30000000 bytes (~28.6 MB) and returns 404.13 before the app runs.
             Keep in sync with maxUploadRequestBytes in Program.cs. -->
        <requestLimits maxAllowedContentLength="115343360" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>

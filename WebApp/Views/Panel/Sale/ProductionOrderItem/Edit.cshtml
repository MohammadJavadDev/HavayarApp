			toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید');
			return;
		}

		const url = `/Panel/ProductionOrderItem/StopRequestListPartial?productionOrderItemId=${productionOrderItemId}`;
		
		$$.get(url, function(result) {
			let bodyCn = `<div style="overflow-x: auto; max-height: 600px; overflow-y: auto;">${result}</div>`;
			$.confirm({
				title: 'لیست درخواست‌های توقف',

                    <div class="card-body">
                         <div class="row g-3 align-items-end mb-4">
                         </div>
                    </div>
               </div>

          </div>
     </div>

     <div class="card mt-4 border-0 shadow-sm">
          <div class="card-body">
               <div class="row text-muted">

                    <div class="col-md-3">
                         <span class="fw-bold">ایجاد کننده :</span>
                         <span data-bind="createdByName">@Model?.CreatedByName</span>
                    </div>

                    <div class="col-md-3">
                         <span class="fw-bold">تاریخ ایجاد :</span>
                         <span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
                    </div>

                    <div class="col-md-3">
                         <span class="fw-bold">ویرایش کننده :</span>
                         <span data-bind="modifiedByName">@Model?.ModifiedByName</span>
                    </div>

                    <div class="col-md-3">
                         <span class="fw-bold">تاریخ ویرایش :</span>
                         <span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
                    </div>

               </div>
          </div>
     </div>
</div>
<script>

         function getUrlParameter(name) {
             const urlParams = new URLSearchParams(window.location.search);
             return urlParams.get(name);
         }

         const urlParams = new URLSearchParams(window.location.search);

         const serviceRequestIdFromUrl =
             urlParams.get('servicerequestid') ||
             urlParams.get('serviceRequestId') ||
             urlParams.get('ServiceRequestId');

         const parentIdFromUrl =
             urlParams.get('parentid') ||
             urlParams.get('parentId') ||
             urlParams.get('ParentId');

         const serviceRequestId =
             serviceRequestIdFromUrl ||
             sessionStorage.getItem("ServiceRequestId") ||
             "@Model?.ServiceRequestId";

         const currentSaleReportId =
             "@Model?.Id" || null;

         function loadMissions() {

             if (!serviceRequestId) {
                 return;
             }

             const $select = $('#SaleMissionIdSelector');

             $select.prop('disabled', true);
             $select.html('<option value="">در حال بارگذاری...</option>');

             $$.get(
                 `GetMissionsNumber?serviceRequestId=${serviceRequestId}`,
                 function (response) {

                     $select.prop('disabled', false);

                     if (!response.isSuccess) {
                         toastr.error(
                             response.message || 'خطا در دریافت اطلاعات ماموریت',
                             'خطا'
                         );
                         $select.html('<option value="">خطا در بارگذاری</option>');
                         return;
                     }

                     $select.empty();
                     $select.append('<option value="">-- انتخاب ماموریت --</option>');

                     const missions = response.data || [];

                     if (missions.length === 0) {
                         $select.append('<option value="" disabled>ماموریتی یافت نشد</option>');
                         return;
                     }

                     missions.forEach(function (mission) {
                         const optionText = mission.text || mission.Text;
                         const optionValue = mission.id || mission.Id;

                         const $option = $('<option>')
                             .val(optionValue)
                             .text(optionText);

                         $select.append($option);
                     });
                 }
             );
         }

     function loadProducts() {

         if (!serviceRequestId) {
             return;
         }

         const $select = $('#saleReportProductsIdIdSelector');

         $select.prop('disabled', true);
         $select.html('<option value="">در حال بارگذاری...</option>');

         $$.get(
             `GetProductRelated?serviceRequestId=${serviceRequestId}`,
             function (response) {

                 $select.prop('disabled', false);

                 if (response && response.isSuccess === false) {
                     toastr.error(
                         response.message || 'خطا در دریافت اطلاعات محصول',
                         'خطا'
                     );
                     $select.html('<option value="">خطا در بارگذاری</option>');
                     return;
                 }

                 $select.empty();
                 $select.append('<option value="">-- انتخاب نمایید --</option>');

                 let products = [];

                 if (Array.isArray(response)) {
                     products = response;
                 } else if (response && response.data) {
                     if (Array.isArray(response.data)) {
                         products = response.data;
                     } else if (response.data.data && Array.isArray(response.data.data)) {
                         products = response.data.data;
                     }
                 }

                 if (products.length === 0) {
                     $select.append('<option value="" disabled>محصولی یافت نشد</option>');
                     return;
                 }

                 // پر کردن لیست
                 products.forEach(function (product) {
                     const optionText = product.text || product.Text;
                     const optionValue = product.id || product.Id;
                     $select.append(new Option(optionText, optionValue));
                 });

                 // انتخاب خودکار اولین محصول از API
                 if (products.length > 0) {
                     const firstProduct = products[0];
                     const firstId = firstProduct.id || firstProduct.Id;
                     $select.val(firstId);
                     console.log('اولین محصول از API به صورت خودکار انتخاب شد:', firstId);
                 }
             }
         ).fail(function(xhr) {
             $select.prop('disabled', false);

             let errorMessage = 'خطا در ارتباط با سرور';

             if (xhr.responseJSON && xhr.responseJSON.message) {
                 errorMessage = xhr.responseJSON.message;
             }

             toastr.error(errorMessage, 'خطا');
             $select.html('<option value="">خطا در بارگذاری</option>');
         });
     }


         function loadSameReports() {

             if (!serviceRequestId) {
                 return;
             }

             const $select = $('#SameReportIdSelector');

             $select.prop('disabled', true);
             $select.html('<option value="">در حال بارگذاری...</option>');

             $$.get(
                 `GetSameReport?serviceRequestId=${serviceRequestId}`,
                 function (response) {

                     $select.prop('disabled', false);

                     if (!response.isSuccess) {
                         toastr.error(
                             response.message || 'خطا در دریافت گزارش‌های مشابه',
                             'خطا'
                         );
                         $select.html('<option value="">خطا در بارگذاری</option>');
                         return;
                     }

                     $select.empty();
                     $select.append('<option value="">-- انتخاب گزارش مشابه --</option>');

                     const reports = response.data || [];

                     if (reports.length === 0) {
                         $select.append('<option value="" disabled>گزارشی یافت نشد</option>');
                         return;
                     }

                     reports.forEach(function (report) {
                         const reportId = report.id || report.Id;
                         const reportText = report.text || report.Text;

                         const $option = $('<option>')
                             .val(reportId)
                             .text(reportText);

                         $select.append($option);
                     });
                     if (parentIdFromUrl) {
                         $select.val(parentIdFromUrl);
                     }
                 }
             );
         }


         function getSameReportData() {
             const missionId = $('#SaleMissionIdSelector').val();
             let sameReportId = $('#SameReportIdSelector').val();

             if (!sameReportId && parentIdFromUrl) {
                 sameReportId = parentIdFromUrl;
                 $('#SameReportIdSelector').val(parentIdFromUrl);
             }

             if (!missionId) {
                 toastr.warning('لطفاً ابتدا ماموریت را انتخاب کنید', 'هشدار');
                 return;
             }

             if (currentSaleReportId && sameReportId == currentSaleReportId) {
                 toastr.warning('گزارش مشابه نمی‌تواند خود گزارش فعلی باشد', 'هشدار');
                 return;
             }

             const $btn = $('#btnGetSameReport');
             const originalHtml = $btn.html();

             $btn.prop('disabled', true);
             $btn.html('<i class="fas fa-spinner fa-spin"></i>');

             const url = `GetReportByParentId?parentId=${encodeURIComponent(sameReportId)}`;

             $$.get(
                 url,
                 function (reportData) {
                     if (!reportData) {
                         toastr.warning('داده‌ای برای نمایش یافت نشد', 'هشدار');
                         return;
                     }

                     const currentId = $('#SaleMissionIdSelector').val();
                     const currentServiceRequestId = serviceRequestId;
                     delete reportData.id;
                     delete reportData.serviceRequestId;
                     delete reportData.saleMissionIds;
                     delete reportData.sameReportId;

                     page.$pageEl.dataBind(reportData.data);

                     $('#SaleMissionIdSelector')
                         .val(currentId)
                         .trigger('change');

                     $('#SameReportIdSelector')
                         .val(sameReportId)
                         .trigger('change');

                     toastr.success('اطلاعات گزارش مشابه با موفقیت بارگذاری شد', 'موفق');
                 }
             )
             .fail(function (xhr) {
                 if (xhr.status === 404) {
                     toastr.warning('گزارش مشابه پیدا نشد', 'هشدار');
                     return;
                 }

                 toastr.error('خطا در دریافت اطلاعات گزارش مشابه', 'خطا');
             })
             .always(function () {

                 $btn.prop('disabled', false);
                 $btn.html(originalHtml);
             });
         }


         function formatTimeInput($input) {

             if (!$input || $input.length === 0)
                 return;

             var val = $input.val().replace(/[^0-9]/g, '');

             if (val.length === 0) {
                 $input.val('');
                 return '';
             }

             if (val.length >= 3) {

                 var hours = val.substring(0, val.length - 2);
                 var minutes = val.substring(val.length - 2);

                 if (hours.length === 1)
                     hours = '0' + hours;

                 var hourNum = parseInt(hours);
                 var minuteNum = parseInt(minutes);

                 if (hourNum > 23)
                     hours = '23';

                 if (minuteNum > 59)
                     minutes = '59';

                 var formattedTime = hours + ':' + minutes;

                 $input.val(formattedTime);

                 return formattedTime;
             } else {

                 $input.val(val);

                 return val;
             }
         }

         $(document).ready(function () {
             loadMissions();
             loadProducts();
             loadSameReports();

             if (parentIdFromUrl && !currentSaleReportId) {
                 setTimeout(function() {

                     $('#SameReportIdSelector').val(parentIdFromUrl);

                     getSameReportData();

                 }, 1000);
             }

             $('#btnGetSameReport').on('click', function () {
                 getSameReportData();
             });

             $(document).on('blur', '.time-input', function () {
                 formatTimeInput($(this));
             });

             $(document).on('input', '.time-input', function () {

                 var val = $(this).val().replace(/[^0-9]/g, '');

                 if (val.length > 4) {
                     val = val.substring(0, 4);
                 }

                 $(this).val(val);
             });

             $(document).on('keydown', '.time-input', function (e) {

                 if (
                     e.key === 'Backspace' ||
                     e.key === 'Delete' ||
                     e.key === 'Tab' ||
                     e.key === 'ArrowLeft' ||
                     e.key === 'ArrowRight' ||
                     e.key === 'Home' ||
                     e.key === 'End' ||
                     e.key === 'Enter'
                 ) {
                     return;
                 }

                 if (!/^[0-9]$/.test(e.key)) {
                     e.preventDefault();
                     return false;
                 }
             });
         });

         function savefn($btnAction) {
             if (validateError(page.$pageEl))
                 return;

             const model = page.$pageEl.dataBind();
             model.ServiceRequestId =
                 serviceRequestId ||
                 serviceRequestIdFromUrl ||
                 sessionStorage.getItem("ServiceRequestId");
             // model.SaleMissionId = $('#SaleMissionIdSelector').val();

             model.SameReportId =
                 $('#SameReportIdSelector').val() ||
                 parentIdFromUrl;

             if (parentIdFromUrl) {
                 model.ParentId = parentIdFromUrl;
             }

             const $btn = $(this.element).block();

             $$.post(
                 'save',
                 model,
                 function (r) {

                     $btn.block(false);

                     if (!r.isSuccess) {
                         toastr.error(r.message, 'خطا');
                         return;
                     }

                     toastr.success('ذخیره سازی با موفقیت انجام شد');

                     page.$pageEl.dataBind(r.data);

                     const parentId =
                         r.data?.serviceRequestId ||
                         r.data?.ServiceRequestId ||
                         model.ServiceRequestId ||
                         serviceRequestId;

                     if (typeof window.reloadSaleReportList === 'function' && parentId) {
                         window.reloadSaleReportList(parentId);
                     }

                     $btnAction.baseaction();
                 }
             );
         }

         self.FormActionButtons.save.onclick(function() { savefn(this); });
         self.FormActionButtons.saveandnew.onclick(function() { savefn(this); });
         self.FormActionButtons.saveandclose.onclick(function() { savefn(this); });

</script>
        function renderDragDrop() {

            $("#designPlace").find(".mainDropPage").attr("data-parentid", tmpId)

            const droppable = new Draggable.Draggable(
                [$(".drp")[0], $(".drp")[1], $(".drp")[2]], {

                draggable: '.item',
                handle: "[data-handler=true]",

            });


            const sortable2 = new Draggable.Sortable(
                $("#designPlace").find(".mainDropPage")[0],
                {
                    draggable: '.item',
                    handle: "[data-handler=true]",
                    mirror: {
                        constrainDimensions: true,
                    },
                });


            droppable.on('drag:stop', (evt) => {

                debugger
                evt.cancel();

                let typeComponet = evt.source.dataset.componetdrop;
                let tmplId = evt.source.dataset.tmplid;

                if ($("#designPlace").find(".dropzone").length !== 0) {

                    let parentEl = $("#designPlace").find(".dropzone").last();
                    let addComponetId = KTUtil.getUniqueId("component");

                    let dataparentId = parentEl.data("parentid");

                    if (!dataparentId) {
                        dataparentId = parentEl.closest("[data-parentId]").data("parentid")
                    }

                    let ddParentId = dataparentId + "-" + addComponetId;

                    let pageId = tmpId;

                    let currentPage = designbuilder.firstOrDefault(c => c.id === pageId);
                    let currentComponent = currentPage;
                    let componetIndex = 1;

                    if (currentPage.childrens.length !== 0) {
                        let listParentId = ddParentId.split('-').slice(1);

                        listParentId.forEach(c => {
                            if (currentComponent.childrens.length !== 0 && currentComponent.childrens.any(z => z.id === c)) {
                                componetIndex++;
                                currentComponent = currentComponent.childrens.firstOrDefault(z => z.id === c);
                            }
                        });

                    }

                    let $tpl = {};
                    if (typeComponet === "feild") {

                        let feildId = evt.source.dataset.feildid;
                        let parentidfeildid = evt.source.dataset.parentidfeildid;

                        var objectUpdate = listOffields;


                        if (parentidfeildid) {

                            const parentIds = parentidfeildid.split("-");


                            parentIds.forEach(ids => {
                                if (!KTUtil.isEmpty(ids)) {
                                    if (KTUtil.isArray(objectUpdate)) {
                                        objectUpdate = objectUpdate.filter(c => c.id == ids)[0];


                                    }
                                    else {
                                        objectUpdate = objectUpdate.fields.filter(c => c.id == ids)[0];
                                    }


                                }

                            });

                        }

                        let tmpId = KTUtil.getUniqueId("radio");

                        if (objectUpdate.fieldType === "document") {
                            parentEl.removeClass("dropzone")
                            return error2("امکان افزودن سند به طراحی نمیباشد.");
                        }
                        $tpl = $("#feildElementTmpl").tmpl({ parentId: ddParentId, id: addComponetId, pageId: pageId, componetIndex, ...objectUpdate, tmpId });

                    }
                    else {
                        $tpl = $(tmplId).tmpl({ parentId: ddParentId, id: addComponetId, pageId: pageId, componetIndex });

                        if (typeComponet === "tab") {
                            $tpl.find(".nav-link").click(function () {
                                debugger
                                let tabId = $(this).attr("tab-id");
                                $(this).closest("ul").find(".active").removeClass("active")
                                $(this).addClass("active")
                                $tpl.find("[role-systemPage]").addClass("d-none")
                                $tpl.find(tabId).removeClass("d-none");

                            });

                            $tpl.find(".nav-link i").click(function () {
                                debugger

                                if ($tpl.find(".nav-link").length === 1) {
                                    return;
                                }

                                let tabId = $(this).closest(".nav-link").attr("tab-id");
                                $(this).closest(".nav-item").remove();
                                $tpl.find(tabId).remove();

                            });

                            $tpl.find("[data-action=addNewTab]").click(function () {
                                let newtabid = KTUtil.getUniqueId("tab");

                                let $tli = $("#tabliTmpl").tmpl({ id: newtabid });

                                let $tpt = $("#tabpageTmpl").tmpl({ id: newtabid });

                                $tpl.find("[data-action=addNewTab]").parent().before($tli);

                                $tpl.find("[role-systemPageGroup=true]").append($tpt);

                                $tli.dblclick(function () {
                                    var $this = $(this).find("span");
                                    $this.attr('contentEditable', true);
                                    $this.on('blur', function () {
                                        $this.attr('contentEditable', false);
                                    });
                                });


                                $tli.find("i").click(function () {
                                    debugger

                                    if ($tpl.find(".nav-link").length === 1) {
                                        return;
                                    }

                                    let tabId = $(this).closest(".nav-link").attr("tab-id");
                                    $(this).closest(".nav-item").remove();
                                    $tpl.find(tabId).remove();

                                });


                                $tli.find(".nav-link").click(function () {
                                    debugger
                                    let tabId = $(this).attr("tab-id");
                                    $(this).closest("ul").find(".active").removeClass("active")
                                    $(this).addClass("active")
                                    $tpl.find("[role-systemPage]").addClass("d-none")
                                    $tpl.find(tabId).removeClass("d-none");

                                });

                            })

                            $tpl.find(".nav-link").dblclick(function () {
                                var $this = $(this).find("span");
                                $this.attr('contentEditable', true);
                                $this.on('blur', function () {
                                    $this.attr('contentEditable', false);
                                });
                            });
                        }

                    }

                    let $ttlTpl = $("#tooltipTmpl").tmpl({ id: addComponetId, parentId: ddParentId });

                    $ttlTpl.find("[data-action=remove]").click(function () {
                        debugger;

                        let id = $(this).data("containerid");
                        let containerparentid = $(this).data("containerparentid");

                        let listParentId = containerparentid.split('-');

                        let currentComponent = designbuilder.firstOrDefault(c => c.id === listParentId[0]);

                        listParentId = listParentId.slice(1)

                        if (listParentId.length === 1) {
                            currentComponent.childrens.firstOrDefault(z => z.id === id).$el.remove();
                            currentComponent.childrens.firstOrDefault(z => z.id === id).$parent.removeClass("draggable-dropzone--occupied");
                            currentComponent.childrens.remove(z => z.id === id);
                        }
                        else {
                            listParentId.forEach(c => {

                                if ((currentComponent.parentId + "-" + id) !== containerparentid) {
                                    if (currentComponent.childrens.length !== 0) {
                                        currentComponent = currentComponent.childrens.firstOrDefault(z => z.id === c);
                                    }
                                }
                                else {
                                    currentComponent.childrens.firstOrDefault(z => z.id === id).$el.remove();
                                    currentComponent.childrens.firstOrDefault(z => z.id === id).$parent.removeClass("draggable-dropzone--occupied");
                                    currentComponent.childrens.remove(z => z.id === id);
                                }

                            });

                        }





                    })

                    $ttlTpl.find("[data-action=edit]").click(function () {

                        debugger
                        let objEdit = {}

                        objEdit.html = $tpl.html();
                        objEdit.css = $tpl.find("[data-element]").attr("style");
                        objEdit.classes = $tpl.find("[data-element]").attr("class").replace("droppeble-element", "");

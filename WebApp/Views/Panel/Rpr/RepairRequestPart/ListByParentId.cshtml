@using Entities.App.Rpr
@{
	var parentId = (long)ViewBag.ParentId;
	var canNew = ViewBag.CanNew == true;
	var canEdit = ViewBag.CanEdit == true;
	var canDelete = ViewBag.CanDelete == true;
}
@* جدول اقلام مصرفی یک نمایه داده است (AfterSales_RepairRequestPart_ByRequest،
   Data/Scripts/Seed_RepairRequestPart_ByRequest_DataProfile.sql).
   دکمه‌های نوار ابزار نمایه فقط رویداد rrPartAction را می‌فرستند و منطق مودال‌ها در اسکریپت همین صفحه است.
   دکمه‌ها با data-can-* و CSS پایین پنهان می‌شوند؛ مجوز واقعی در کنترلر و SQL نمایه است. *@
<div class="rr-part-page" id="rrPartChildCard"
	 data-can-new="@(canNew ? "true" : "false")"
	 data-can-edit="@(canEdit ? "true" : "false")"
	 data-can-delete="@(canDelete ? "true" : "false")">
	<datatableprofile entity-Type="typeof(RepairRequestPart)" profile-names="AfterSales_RepairRequestPart_ByRequest"></datatableprofile>
</div>
<style>
	.rr-part-page[data-can-new="false"] [data-action="rrPartAdd"],
	.rr-part-page[data-can-edit="false"] [data-action="rrPartEdit"],
	.rr-part-page[data-can-delete="false"] [data-action="rrPartDelete"] {
		display: none !important;
	}
</style>
<script>
	const rrPartParentId = @parentId;
	const rrPartCanNew = @(canNew ? "true" : "false");
	const rrPartCanEdit = @(canEdit ? "true" : "false");
	const rrPartCanDelete = @(canDelete ? "true" : "false");

	// شناسهٔ درخواست تعمیر قبل از اولین درخواست داده به نمایه می‌رسد (execScripts پیش از initPage اجرا می‌شود).
	// بدون آن SQL نمایه ردیفی برنمی‌گرداند.
	$$('[data-action="dataProfile"]').attr('data-query-params', JSON.stringify({ RepairRequestId: String(rrPartParentId) }));

	const rrPartTable = {
		ajax: {
			reload: function (callback, resetPaging) {
				const table = $$('[data-action="dataProfile"]').data('dtProfileTable') || self.table;
				if (table && table.ajax) table.ajax.reload(callback, resetPaging);
			}
		}
	};

	function denyRrPartAction() {
		toastr.error('شما مجوز انجام این عملیات را ندارید', 'عدم دسترسی');
	}

	function singleRrPartRow(ctx) {
		const rows = (ctx && ctx.selectedRows && ctx.selectedRows.length)
			? ctx.selectedRows
			: (ctx && ctx.selectedRow ? [ctx.selectedRow] : []);
		if (rows.length !== 1) {
			toastr.warning('فقط یک ردیف را انتخاب کنید');
			return null;
		}
		return rows[0];
	}

	function decodeChildPartial(r) {
		if (window.appController && typeof appController.decodePartialResponse === 'function')
			return appController.decodePartialResponse(r);
		return { html: (typeof r === 'string' ? r : ''), scripts: [] };
	}

	function initChildModalForm($root) {
		if (typeof initPersionDatePicker === 'function')
			initPersionDatePicker($root);
		$root.find('.entity-selector-wrapper').each(function () {
			if (!$(this).data('readonly') && typeof $(this).entitySelector === 'function')
				$(this).entitySelector();
		});
		if (typeof initFileUploaders === 'function')
			initFileUploaders($root);
		if (typeof initMoneyInputs === 'function')
			initMoneyInputs($root);
		else if (window.Inputmask && window.moneyInputmaskOptions)
			Inputmask(moneyInputmaskOptions).mask($root.find('[data-money="true"]'));
		if (typeof initTimeInputs === 'function')
			initTimeInputs($root);
		else if (window.Inputmask && window.timeInputmaskOptions)
			Inputmask(timeInputmaskOptions).mask($root.find('[data-time="true"]'));
	}

	function openRrPartModal(id, $trigger) {
		const url = id
			? '/Panel/Rpr/RepairRequestPart/Edit?id=' + id + '&repairRequestId=' + rrPartParentId
			: '/Panel/Rpr/RepairRequestPart/New?repairRequestId=' + rrPartParentId;
		$trigger.block();
		page.getPartialView(url, function (r) {
			$trigger.block(false);
			if (!r) {
				toastr.error('خطا در دریافت فرم', 'خطا');
				return;
			}
			const decoded = decodeChildPartial(r);
			const $bodyCn = $('<div style="overflow-x:hidden;overflow-y:auto;max-height:70vh;"></div>').append(decoded.html || '');
			$bodyCn.find('.form-action-buttons').remove();
			$.confirm({
				title: id ? 'ویرایش قلم مصرفی' : 'افزودن قلم مصرفی',
				columnClass: 'col-md-10',
				content: $bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-primary',
						action: function () {
							const $content = this.$content;
							if (validateError($content)) return false;
							const model = $content.dataBind();
							const selfConfirm = this;
							const $saveBtn = $(this.buttons.save.el).block();
							$$.post('/Panel/Rpr/RepairRequestPart/save', model, function (resp) {
								$saveBtn.block(false);
								if (!resp.isSuccess) {
									toastr.error(resp.message || 'خطا در ذخیره', 'خطا');
									return;
								}
								toastr.success('ذخیره سازی با موفقیت انجام شد');
								selfConfirm.close();
								rrPartTable.ajax.reload(null, false);
							});
							return false;
						}
					},
					cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
				},
				onContentReady: function () {
					const selfConfirm = this;
					setTimeout(function () { initChildModalForm(selfConfirm.$body); }, 100);
				}
			});
		});
	}

	// دکمه‌های نوار ابزار نمایه فقط رویداد rrPartAction می‌فرستند.
	page.$pageEl.on('rrPartAction', function (e, action, ctx) {
		const $btn = $(e.target);
		switch (action) {
			case 'add':
				if (!rrPartCanNew) return denyRrPartAction();
				openRrPartModal(null, $btn);
				break;
			case 'edit': {
				if (!rrPartCanEdit) return denyRrPartAction();
				const row = singleRrPartRow(ctx);
				if (row) openRrPartModal(Number(row.t1_Id), $btn);
				break;
			}
			case 'delete': {
				if (!rrPartCanDelete) return denyRrPartAction();
				const row = singleRrPartRow(ctx);
				if (row) deleteRrPart(Number(row.t1_Id));
				break;
			}
		}
	});

	function deleteRrPart(id) {
		Swal.fire({ title: 'حذف', text: 'آیا از حذف این ردیف مطمئن هستید؟', icon: 'warning', showCancelButton: true, confirmButtonText: 'بله', cancelButtonText: 'خیر' })
			.then(function (result) {
				if (!result.isConfirmed) return;
				$$.get('/Panel/Rpr/RepairRequestPart/Delete?id=' + id, function (r) {
					if (r && r.isSuccess === false) { toastr.error(r.message || 'خطا در حذف'); return; }
					toastr.success('رکورد با موفقیت حذف شد');
					rrPartTable.ajax.reload(null, false);
				});
			});
	}
</script>

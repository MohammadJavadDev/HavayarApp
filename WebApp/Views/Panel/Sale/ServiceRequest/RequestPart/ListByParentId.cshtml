@using WebApp.Controllers.Dynamic
@model ServiceRequestPartListByParentViewModel

@{
     var tableId = "requestPartListTable_" + Model.ServiceRequestId;
}

<div class="card" id="requestPartListPage" data-service-request-id="@Model.ServiceRequestId">
     <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold">
               <i class="fa fa-cubes ms-2"></i>
               لیست درخواست کالا شناسه (@Model.ServiceRequestId)
          </h5>
         <div>
               <button type="button" class="btn btn-primary" id="btnNewRequestPart">
                    <i class="fa fa-plus-circle ms-1"></i>
                    جدید
               </button>
               <button type="button" class="btn btn-info" id="btnRefreshPage">
                    <i class="fa-light fa-magnifying-glass-arrows-rotate ms-1"></i>
                    بروزرسانی اطلاعات
               </button>
         </div>
     </div>
     <div class="card-body">
          <div class="table-responsive">
               <table class="table table-bordered table-striped table-hover nowrap" id="@tableId" style="width: auto;">
                    <thead>
                         <tr>
                              <th>ردیف</th>
                              <th>شماره سند</th>
                              <th>مرکز فروش</th>
                              <th>سال مالی</th>
                              <th>تاریخ سند</th>
                              <th>کد کالا</th>
                              <th>نام کالا</th>
                              <th>کد قطعه پروژه</th>
                              <th>نام قطعه پروژه</th>
                              <th>واحد</th>
                              <th>تعداد</th>
                              <th>قیمت واحد</th>
                              <th>کد جایگزین</th>
                              <th>نام جایگزین</th>
                              <th>مرکز هزینه</th>
                              <th>تأمین‌کننده</th>
                              <th>مجوز برگشت</th>
                              <th>برگشت قطعه معیوب</th>
                              <th>کد قطعه معیوب</th>
                              <th>نام قطعه معیوب</th>
                              <th>خرابی</th>
                              <th>کد قطعه خراب</th>
                              <th>نام قطعه خراب</th>
                              <th>توضیحات</th>
                              <th>عملیات</th>
                         </tr>
                    </thead>
                    <tbody></tbody>
               </table>
          </div>
     </div>
</div>
<script>
     (function () {
          const serviceRequestId = @Model.ServiceRequestId;
          const tableSelector = "#@tableId";
          const listApiUrl = "/Panel/Sale/ServiceRequestPart/GetListByParentId?serviceRequestId=" + serviceRequestId;

          sessionStorage.setItem("ServiceRequestId", serviceRequestId);

          function dash(val) {
               return val === null || val === undefined || val === "" ? "-" : val;
          }

          function formatBool(val) {
               return val === true || val === "true" || val === 1 ? "بله" : "خیر";
          }

          function formatNumber(val) {
               if (val === null || val === undefined || val === "") return "-";
               const num = Number(val);
               if (isNaN(num)) return val;
               return num.toLocaleString("fa-IR");
          }

          function deleteRequestPart(id) {
               Swal.fire({
                    icon: "warning",
                    title: "آیا از حذف این اطلاعات مطمئن هستید؟",
                    showDenyButton: true,
                    confirmButtonText: "بله",
                    denyButtonText: "خیر"
               }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $$.get("/Panel/Sale/ServiceRequestPart/Delete?id=" + id, function (response) {
                         if (response && response.isSuccess === false) {
                              toastr.error(response.message || "خطا در حذف رکورد");
                              return;
                         }
                         toastr.success("رکورد با موفقیت حذف شد");
                         reloadRequestPartList(serviceRequestId);
                    });
               });
          }

          function measureTextWidth(text, sampleEl) {
               const $probe = $("<span/>").css({
                    position: "absolute",
                    visibility: "hidden",
                    whiteSpace: "nowrap",
                    font: sampleEl ? window.getComputedStyle(sampleEl).font : "14px Vazirmatn, Tahoma, sans-serif"
               }).text(text || "").appendTo("body");
               const width = $probe.outerWidth();
               $probe.remove();
               return width;
          }

          function fitColumnWidths(api) {
               const $container = $(api.table().container());
               const $scrollHead = $container.find(".dataTables_scrollHead");
               const $scrollBody = $container.find(".dataTables_scrollBody");
               const sortIconExtra = 28;

               api.columns().every(function (colIdx) {
                    const headerEl = this.header();
                    const headerText = $(headerEl).text().trim();
                    let maxWidth = measureTextWidth(headerText, headerEl) + sortIconExtra;

                    this.nodes().to$().each(function () {
                         const cellWidth = measureTextWidth($(this).text().trim(), this) + 24;
                         if (cellWidth > maxWidth) maxWidth = cellWidth;
                    });

                    maxWidth = Math.ceil(maxWidth);

                    $(headerEl).css({ "min-width": maxWidth + "px", width: maxWidth + "px" });
                    this.nodes().to$().css({ "min-width": maxWidth + "px", width: maxWidth + "px" });
                    $scrollHead.find("thead th").eq(colIdx).css({ "min-width": maxWidth + "px", width: maxWidth + "px" });
                    $scrollBody.find("tbody tr").each(function () {
                         $(this).children("td").eq(colIdx).css({ "min-width": maxWidth + "px", width: maxWidth + "px" });
                    });
               });

               api.columns.adjust();
          }

          if ($.fn.DataTable.isDataTable(tableSelector)) {
               $$(tableSelector).DataTable().clear().destroy();
          }

          const table = $$(tableSelector).DataTable({
               destroy: true,
               processing: true,
               serverSide: false,
               autoWidth: false,
               scrollX: true,
               pageLength: 10,
               lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "همه"]],
               order: [[0, "asc"]],
               ajax: {
                    url: listApiUrl,
                    type: "GET",
                    dataSrc: function (json) {
                         if (json && json.isSuccess === false) {
                              toastr.error(json.message || "خطا در دریافت اطلاعات");
                              return [];
                         }
                         return (json && json.data) ? json.data : (Array.isArray(json) ? json : []);
                    }
               },
               columns: [
                       {
                         data: "id",
                         orderable: false,
                         searchable: false,
                         className: "text-center",
                         render: function (id) {
                              return `
                                   <button type="button" class="btn btn-sm btn-warning btn-edit-part" data-id="${id}" title="ویرایش">
                                        <i class="fa fa-edit"></i>
                                   </button>
                                   <button type="button" class="btn btn-sm btn-danger btn-delete-part" data-id="${id}" title="حذف">
                                        <i class="fa fa-trash"></i>
                                   </button>
                              `;
                         }
                    },
                    {
                         data: null,
                         orderable: false,
                         searchable: false,
                         className: "text-center",
                         render: function (data, type, row, meta) {
                              return meta.row + meta.settings._iDisplayStart + 1;
                         }
                    },
                    { data: "projectVchNum", className: "text-center", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "salesOfficeName", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "projectVchYear", className: "text-center", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "projectVoucherShamsiDate", className: "text-center", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "partCode", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "partName", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "projectVchPartCode", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "projectVchPartName", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "projectPartUnitTitle", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "mount", className: "text-end", defaultContent: "-", render: function (d) { return formatNumber(d); } },
                    { data: "unitPrice", className: "text-end", defaultContent: "-", render: function (d) { return formatNumber(d); } },
                    { data: "replacePartCode", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "replacePartName", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "costCenterTitle", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "supplierName", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "returnLicence", className: "text-center", render: formatBool },
                    { data: "hasReturn_DamagedPart", className: "text-center", render: formatBool },
                    { data: "damagedPartCode", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "damagedPartName", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "hasFailure", className: "text-center", render: formatBool },
                    { data: "failurePartCode", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "failurePartName", defaultContent: "-", render: function (d) { return dash(d); } },
                    { data: "comment", defaultContent: "-", render: function (d) { return dash(d); } },
                 
               ],
               language: {
                    url: "/panelLib/plugins/custom/datatables/fa.json",
                    emptyTable: "هیچ اطلاعاتی یافت نشد",
                    zeroRecords: "هیچ اطلاعاتی یافت نشد"
               },
               initComplete: function () {
                    fitColumnWidths(this.api());
               }
          });

          window["requestPartListTable_" + serviceRequestId] = table;

          window.reloadRequestPartList = function (id) {
               const targetId = id || serviceRequestId;
               const dt = window["requestPartListTable_" + targetId];
               if (dt && typeof dt.ajax === "object") {
                    dt.ajax.reload(function () {
                         fitColumnWidths(dt);
                    }, false);
               }
          };

          $$("#btnNewRequestPart").on("click", function () {
               appController.addPage("/Panel/Sale/ServiceRequestPart/New?serviceRequestId=" + serviceRequestId);
          });

          $$(tableSelector).on("click", ".btn-edit-part", function () {
               const id = $(this).data("id");
               appController.addPage("/Panel/Sale/ServiceRequestPart/Edit?id=" + id);
          });

          $$(tableSelector).on("click", ".btn-delete-part", function () {
               const id = $(this).data("id");
               deleteRequestPart(id);
          });

          $$("#btnRefreshPage").on("click", function () {
               reloadRequestPartList(serviceRequestId);
          });
     })();
</script>

<style>
     #requestPartListPage #@tableId {
          width: max-content !important;
          table-layout: auto;
     }

     #requestPartListPage #@tableId th,
     #requestPartListPage #@tableId td,
     #requestPartListPage .dataTables_scrollHead th,
     #requestPartListPage .dataTables_scrollBody td {
          white-space: nowrap !important;
          vertical-align: middle;
          padding-inline: 0.75rem;
     }

     #requestPartListPage #@tableId tbody tr:hover {
          background-color: #f5f5f5;
     }

     #requestPartListPage .dataTables_wrapper .dataTables_scroll {
          overflow-x: auto;
     }
</style>

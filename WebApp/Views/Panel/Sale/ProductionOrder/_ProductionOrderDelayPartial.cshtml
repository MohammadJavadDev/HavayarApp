@using Entities.App.Pln
@using Entities.App.Pln.Enums
@using Entities.App.Sale
@model ProductionOrderDelay
@{
	var productionOrderId = Model?.ProductionOrderId;
}

<div class="row">
	<input type="hidden" data-bind="id" value="@Model?.Id" />
	<input type="hidden" data-bind="productionOrderId" value="@productionOrderId" />

	<div class="col-md-12">
		<label class=''>قلم سفارش ساخت</label>
		@(Html.EntitySelector<ProductionOrderItem>(
			"DelayProductionOrderItemSelector",
			c => c.IsActive == Entities.Base.IsActiveEnum.Active && c.IsDeleted == false && c.ProductionOrderId == productionOrderId,
			c => new
			{
				Id = c.Id,
				c.Serial,
				PartName = c.Part.Name,
				PartCode = c.Part.Code
			},
			c => new { c.Serial },
			"{Serial} || {PartCode} || {PartName}",
			"ProductionOrderItemId",
			"ProductionOrderItemName",
			Model?.ProductionOrderItemId?.ToString()
		))
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>

	@* معادل DelayResponsibleId در Pln_ProductionOrder_Delay (HTS) — روی entity الزامی است *@
	<div class="col-md-6">
		<label class='required'>عامل تاخیر</label>
		<select class='form-control' data-bind='delayResponsible' asp-for='DelayResponsible' required
				asp-items="Html.GetEnumSelectList(typeof(DelayResponsibleEnum))">
		</select>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>

	<div class="col-md-6">
		<label class=''>تعداد روز تاخیر</label>
		<input class='form-control' data-bind='delayDays' data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='DelayDays' />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>

	@* قرارداد dataBind: data-bind روی نام شمسی، value روی مقدار میلادی (تبدیل خودکار) *@
	<div class="col-md-6">
		<label class=''>تاریخ شروع تاخیر</label>
		<input class='form-control ltr' data-bind='delayStartShamsiDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}' value='@Model?.DelayStartMiladiDate' />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>

	<div class="col-md-6">
		<label class=''>تاریخ پایان تاخیر</label>
		<input class='form-control ltr' data-bind='delayEndShamsiDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}' value='@Model?.DelayEndMiladiDate' />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>

	<div class="col-md-12">
		<label class=''>علت تاخیر</label>
		<textarea class='form-control' data-bind='delayReason' rows="3">@Model?.DelayReason</textarea>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>

	<div class="col-md-12">
		<label class=''>توضیحات</label>
		<textarea class='form-control' data-bind='description' rows="3">@Model?.Description</textarea>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
</div>

        function readAllfields(fields, parentName = "") {

            let listfields = [];

            fields.forEach(c => {
                if (c.fieldType === "document" && c.documentType === "subDocument") {
                    var d = readAllfields(c.fields, c.displayName);
                    listfields.push(...d)

                }
                else {
                    listfields.push(
                        { displayName: parentName + "." + c.displayName, path: c.path + "." + c.name }
                    )
                }

            });
            return listfields;
        }

        function readAllDocumentArrayfields(fields, parentName = "") {

            let listfields = [];

            fields.forEach(c => {
                if (c.fieldType === "document" && c.documentType === "subDocument") {
                    var d = readAllfields(c.fields, c.displayName);
                    listfields.push(...d)

                }
                else if (c.fieldType === "document" && c.documentType === "subArrayDocument") {
                    listfields.push(
                        { id: c.id, displayName: parentName + "." + c.displayName, path: c.path + "." + c.name }
                    )
                }

            });
            return listfields;
        }

        function findArrayfieldsById(id, fields) {
            let listfeilds = [];
            fields.forEach(c => {
                if (c.id === id) {
                    listfeilds = c.fields;
                }
                else if (c.fieldType === "document" && c.documentType === "subArrayDocument") {

                }
                else if (c.fieldType === "document" && c.documentType === "subDocument") {
                    listfeilds = findArrayfieldsById(id, c.fields);
                }


            });
            return listfeilds;
        }

        function findfieldsById(id, fields) {
            let listfeilds = {};
            fields.forEach(c => {
                if (c.id === id) {
                    listfeilds = c;
                }
                else if (c.fieldType === "document" && c.documentType === "subArrayDocument") {
                    listfeilds = findArrayfieldsById(id, c.fields);
                }
                else if (c.fieldType === "document" && c.documentType === "subDocument") {
                    listfeilds = findArrayfieldsById(id, c.fields);
                }

            });
            if (listfeilds)
                return listfeilds;
        }



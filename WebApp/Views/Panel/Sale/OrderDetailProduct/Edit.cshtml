@using Entities.App.Sale
@using Entities.Base
@model OrderDetailProduct

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(OrderDetailProduct)"></form-action-buttons>
	</div>
	<div class="card-body">
		<div class="row mb-4"><div class="col-12"><h4 class="fw-bold text-dark mb-0">اختصاص قطعه به محصول</h4></div></div>
		<input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
		<input class="form-control" data-bind="htsId" value="@Model?.HtsId" type="hidden" />
		<div class="row g-3">
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold required">قلم حواله</label>
				@(Html.EntitySelector<OrderDetail>(
					"OrderDetailProductOrderDetailSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Seq = c.Seq, Prefactor_VchNo = c.Prefactor_VchNo, Part_Name = c.Part.Name },
					c => new { c.Seq, c.Prefactor_VchNo, c.Part },
					"{Seq} {Part.Name}",
					"orderDetailId",
					"orderDetailSeq",
					Model?.OrderDetailId?.ToString(),
					required: true
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">قلم محصول</label>
				@(Html.EntitySelector<OrderDetail>(
					"OrderDetailProductProductOrderDetailSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Seq = c.Seq, Prefactor_VchNo = c.Prefactor_VchNo, Part_Name = c.Part.Name },
					c => new { c.Seq, c.Prefactor_VchNo, c.Part },
					"{Seq} {Part.Name}",
					"productOrderDetailId",
					"productOrderDetailSeq",
					Model?.ProductOrderDetailId?.ToString()
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">سریال</label>
				@(Html.EntitySelector<OrderDetailSerial>(
					"OrderDetailProductSerialSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Serial = c.Serial, Model = c.Model },
					c => new { c.Serial, c.Model },
					"{Serial}",
					"orderDetailSerialId",
					"orderDetailSerialSerial",
					Model?.OrderDetailSerialId?.ToString()
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">مقدار</label>
				<input class="form-control" data-bind="mount" asp-for="Mount" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
		</div>
	</div>
</div>
<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;
		const model = page.$pageEl.dataBind();
		const $btn = $($btnAction.element).block();
		$$.post('save', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			$btnAction.baseaction();
		});
	}
	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>

@using Entities.App.Inv;
@using WebFramework.TagHelpers;
@model PartExtraInfo
@{
	var InfoType = (int)(Model?.InfoType ?? 0) ;
}
<div class="card">
	<div class="form-action-buttons">
		<form-action-buttons entity-type="typeof(PartExtraInfo)">
			<form-action-button color-class="btn-active-icon-dark btn-color-info" icon-class="fa fa-note"
							action-name="showDataSheet" title="دیتاشیت"></form-action-button>
		</form-action-buttons>
	</div>
	 
</div>

<div class="card my-3">
	<div class="card-body" style="display: flex;justify-content: space-evenly;">
		<div class="form-check form-check-custom form-check-success form-check-solid">
		    <input class="form-check-input" type="radio" value="1" name="InfoType"  id="flexCheckboxLg" checked />
		    <label class="form-check-label" for="flexCheckboxLg">
			   کمپرسور اسکرو اویل اینجکت
		    </label>
		</div>
		<div class="form-check form-check-custom form-check-warning form-check-solid">
		    <input class="form-check-input" type="radio" value="2" name="InfoType"  id="flexRadioLg"/>
		    <label class="form-check-label" for="flexRadioLg">
			 کمپرسور اسکرو اویل فری
		    </label>
		</div>

		<div class="form-check form-check-custom form-check-danger form-check-solid">
		    <input class="form-check-input" type="radio" value="3" name="InfoType"  id="flexCheckboxSm"  />
		    <label class="form-check-label" for="flexCheckboxSm">
		درایر	
		    </label>
		</div>

		<div class="form-check form-check-custom  form-check-solid">
		    <input class="form-check-input" type="radio" value="4" name="InfoType"  id="flexRadioLg4"/>
		    <label class="form-check-label" for="flexRadioLg4">
			PSA
		    </label>
		</div>
		<div class="form-check form-check-custom form-check-warning form-check-solid">
		    <input class="form-check-input" type="radio" value="5" name="InfoType"  id="flexRadioLg5"/>
		    <label class="form-check-label" for="flexRadioLg5">
					ثابت
		    </label>
		</div>
		
	</div>
</div>

<div class="card my-3">
	<div class="card-body row">
	<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<input class='form-control' id="revision" value='@Model?.Revision' type='hidden' />
		<div class="col-md-3">
			<label class='required'>Product</label>
			@(Html.EntitySelector<Part>(
				"ProductSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Code = c.Code, Name = c.Name
				},
				c => new { c.Code, c.Name },
				"{Code} {Name}",
				"productId",
				"productName",
				Model?.ProductId.ToString(),
				true
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>
		 
		<div class='col-md-3' data-info="1,2,3,4">
			<label class=''>Design Type</label>
			<select class='form-control' data-bind='designType'  asp-for='DesignType' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Inv.Enums.PartExtraInfoDesignTypeEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>


		 

		<div class='col-md-3' data-info="1,2,3,4">
			<label>Model</label>
			<input class='form-control' data-bind='model'  asp-for='Model'  />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3' data-info="3,4">
			<label>Model Suffix</label>
			<input class='form-control' data-bind='modelSuffix' asp-for='ModelSuffix' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3' data-info="4">
			<label class=''>Psa Type</label>
			<select class='form-control' data-bind='psaType' asp-for='PsaType' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Inv.Enums.PartExtraInfoPsaTypeEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3' data-info="4">
			<label class=''>Operational Design</label>
			<select class='form-control' data-bind='operationalDesign' asp-for='OperationalDesign' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Inv.Enums.PartExtraInfoOperationalDesignEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3' data-info="3">
			<label class=''>Dryer Type</label>
			<select class='form-control' data-bind='dryerType' asp-for='DryerType' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Inv.Enums.PartExtraInfoDryerTypeEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>
		 
		<div class='col-md-3' data-info="3">
			<label class=''>Dew Point (°C)</label>
			<input class='form-control' data-bind='dewPoint' asp-for='DewPoint' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3' data-info="1,2">
			<label class=''>سایز</label>
			<input class='form-control' data-bind='size'  asp-for='Size' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 

		<div class='col-md-3' data-info="1,2">
			<label class=''>Power KW</label>
			<input class='form-control' data-bind='powerKw'  asp-for='PowerKw' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>
 

		<div class='col-md-3' data-info="1,2">
			<label class=''>Motor RPM</label>
			<input class='form-control' data-bind='motorRpm'  asp-for='MotorRpm' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 

		<div class='col-md-3' data-info="1,2">
			<label class=''>Airend RPM</label>
			<input class='form-control'  data-bind='airEndRPM'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='AirEndRPM' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 

		<div class='col-md-3' data-info="1,2">
			<label class=''>Model Motor</label>
			<input class='form-control' data-bind='motorModel'  asp-for='MotorModel' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

 

		<div class='col-md-3' data-info="1,2,3,4">
			<label class=''>Pressure Working</label>
			<input class='form-control'  data-bind='workPressure'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='WorkPressure' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3' data-info="3">
			<label class=''>Flow Rate (FAD)(m3/min)</label>
			<input class='form-control' data-bind='flowNM3H' asp-for='FlowNM3H' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

 

		<div class='col-md-3' data-info="1,2">
			<label class=''>Mode Airend</label>
			<input class='form-control' data-bind='airEndMode'  asp-for='AirEndMode' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 
		<div class='col-md-3' data-info="1,2">
			<label class=''>Class</label>
			<input class='form-control' data-bind='className'  asp-for='ClassName' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 

		<div class='col-md-3' data-info="1,2">
			<label class=''>Capacity(M3/Min)</label>
			<input class='form-control' data-bind='Capacity' data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='Capacity' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 

		<div class='col-md-3' data-info="1,2">
			<label class=''>Gear Ratio</label>
			<input class='form-control' data-bind='gearRatio'  asp-for='GearRatio' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 

		<div class='col-md-3 align-content-center' data-info="1,2">
			<div class="form-check">
				<input data-bind='inverter' class="form-check-input" type="checkbox" asp-for='Inverter' />
				<label class="form-check-label" asp-for='Inverter'>
					Inverter
				</label>
			</div>
		</div>

 

</div>
</div>


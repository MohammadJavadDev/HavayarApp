@using Entities.App.Sale
@using Entities.App.Sale.Enums
@using Entities.App.Inv
@model ProductionOrderItemBom
@{
	var canManageBom = ViewBag.CanManageBom as bool? ?? false;
	var canEditBomNewFields = ViewBag.CanEditBomNewFields as bool? ?? false;
	var showNewFields = canEditBomNewFields;
	var showLegacyFields = canManageBom;
	// کالا بعد از ایجاد قابل تغییر نیست؛ برای تعویض، ردیف حذف و دوباره اضافه شود.
	var isEdit = Model?.Id is > 0;
}

<div class="row">
	<input type="hidden" data-bind="id" value="@Model?.Id" />
	<input type="hidden" data-bind="productionOrderItemId" value="@Model?.ProductionOrderItemId" />

	@if (showLegacyFields)
	{
	<div class="col-md-12 form-group-inline">
		<label class="required">کالا</label>
		@(Html.EntitySelector<Part>(
			"PartSelector",
			c => c.IsActive == Entities.Base.IsActiveEnum.Active,
			c => new
			{
				Id = c.Id,
				Name = c.Name,
				Code = c.Code
			},
			c => new { c.Name, c.Code },
			"{Name} {Code}",
			"PartId",
			"PartName",
			Model?.PartId.ToString(),
			_readonly: isEdit
		))
		@if (isEdit)
		{
			<div class="text-muted small mt-1">برای تعویض کالا، ردیف را حذف و کالای جدید را اضافه کنید.</div>
		}
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>

	<div class="col-md-6 form-group-inline">
		<label class="required">تعداد/مقدار</label>
		<input class="form-control" data-bind="amount" asp-for="Amount"
			data-invalidMessage="فقط عدد"
			data-inputmask="'regex':'^[\u06F0-\u06F90-9.]+$' , 'placeholder' : ''" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>

	<div class="col-md-6 form-group-inline">
		<label>نسخه</label>
		<input class="form-control" data-bind="revision" asp-for="Revision" readonly
			data-invalidMessage="فقط عدد"
			data-inputmask="'regex':'^[\u06F0-\u06F90-9\-]+$' , 'placeholder' : ''" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	}
	else
	{
		<input type="hidden" data-bind="partId" value="@Model?.PartId" />
		<input type="hidden" data-bind="amount" value="@Model?.Amount" />
		<input type="hidden" data-bind="revision" value="@Model?.Revision" />
		<input type="hidden" data-bind="description" value="@Model?.Description" />
	}

	@if (showNewFields)
	{
	<div class="col-md-6 form-group-inline">
		<label>تعداد تامین شده</label>
		<input class="form-control" data-bind="numberSupplied" asp-for="NumberSupplied"
			data-invalidMessage="فقط عدد"
			data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>

	<div class="col-md-6 form-group-inline">
		<label>مرحله ساخت</label>
		<select class="form-control" data-bind="productionStep" asp-for="ProductionStep"
			asp-items="Html.GetEnumSelectList(typeof(ProductionOrderItemBomProductionStepEnum))">
		</select>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>

	<div class="col-md-6 form-group-inline">
		<label>وضعیت</label>
		<select class="form-control" data-bind="status" asp-for="Status"
			asp-items="Html.GetEnumSelectList(typeof(ProductionOrderItemBomEnum))">
		</select>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	}
	else
	{
		<input type="hidden" data-bind="numberSupplied" value="@Model?.NumberSupplied" />
		<input type="hidden" data-bind="productionStep" value="@((int?)Model?.ProductionStep)" />
		<input type="hidden" data-bind="status" value="@((int?)Model?.Status)" />
	}

	@if (showLegacyFields)
	{
	<div class="col-md-12 form-group-inline">
		<label>توضیحات</label>
		<textarea class="form-control" data-bind="description" asp-for="Description" rows="3"></textarea>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	}
</div>

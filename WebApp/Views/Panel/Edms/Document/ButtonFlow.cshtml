		const groups = [
			["ویرایش تهیه‌کننده", ["NotIssue", "CommentedByReviewer", "CommentedByApprover", "CommentedByDcc"]],
			["Hold", ["Hold", "UnHold"]],
			["بررسی غیروندور", ["Issue", "ApproveByReviewer"]],
			["مسیر وندور", ["IssueForClient", "ApproveByClient"]],
			["DCC", ["ApproveByApprover", "ApprovedByDcc", "RejectByDcc"]],
			["Not Review", ["NotReview"]],
			["برگشت کارفرما / ریویژن", ["RejectByClient", "ApprovedAsNoteByClient", "CommentedByClient", "ReIssued"]],
			["بررسی برگه پاسخ", ["ReplaySheet"]]
		];
		statusPick.innerHTML = groups.map(function (group) {
			const opts = group[1].map(function (code) {
				return '<option value="' + code + '">' + STATUSES[code] + ' — ' + code + '</option>';
			}).join("");
			return '<optgroup label="' + group[0] + '">' + opts + '</optgroup>';
		}).join("");
	}

	function ruleFor(status) {
		return RULES.find(function (rule) { return rule.statuses.indexOf(status) >= 0; }) || null;
	}

	function buttonsForStatus(status) {
		const rule = ruleFor(status);
		if (!rule) return [];
		const list = rule.buttons.slice();
		if (REPLY_STATUSES.has(status) && list.indexOf("reply") < 0) list.push("reply");
		if (rule.actor === "producer" && producerCanHold(status) && list.indexOf("addComment") < 0)
			list.push("addComment");
		return list;
	}

	function visibleButtons(status, actor, mode) {
		const shown = new Set(["history"]);
		if (mode === "afterRevision") {
			if (actor === "producer") shown.add("saveClose");
			return shown;
		}
		const rule = ruleFor(status);
		if (rule && rule.actor === actor)
			buttonsForStatus(status).forEach(function (id) { shown.add(id); });
		if (status === "ReplaySheet" && actor === "approver")
			shown.add("addComment");
		if (actor === "producer" && producerCanHold(status))
			shown.add("addComment");
		return shown;
	}

	function commentsForActor(status, actor, rule) {
		if (status === "ReplaySheet" && actor === "approver") {
			return [
				{ code: "ApproveByApprover", name: "تایید شده تاییدکننده", next: "نوبت DCC" },
				{ code: "CommentedByApprover", name: "نظر داده‌شده تاییدکننده", next: "بازگشت به تهیه‌کننده" }
			];
		}
		const comments = [];
		if (rule && rule.actor === actor)
			rule.comments.forEach(function (item) { comments.push(item); });
		if (actor === "producer" && producerCanHold(status) && !comments.some(function (item) { return item.code === "Hold"; }))
			comments.push(HOLD_COMMENT);
		return comments;
	}

	function paintButtons(container, shown) {
		container.innerHTML = BUTTONS.map(function (btn) {
			const on = shown.has(btn.id);
			return '<span class="df-pill ' + (on ? btn.cls : "off") + '">' + btn.title + '</span>';
		}).join("");
	}

	function renderSim() {
		const status = statusPick.value;
		const actor = actorPick.value;
		const mode = modePick.value;
		const shown = visibleButtons(status, actor, mode);
		const rule = ruleFor(status);
		const caption = q("simCaption");
		const notes = q("simNote");
		const comments = q("simComments");
		paintButtons(q("simButtons"), shown);

		if (mode === "afterRevision") {
			caption.textContent = "بلافاصله بعد از ایجاد ریویژن جدید. ریویژن با NotIssue شروع می‌شود.";
			comments.innerHTML = "";
			notes.innerHTML = '<div class="alert alert-success mb-0">فقط ذخیره و بستن، و فقط برای تهیه‌کننده. نفرساعت جایگزین می‌شود، وضعیت به Issue می‌رود و کامنت Issue ثبت می‌شود. تاریخچه برای همه فعال است.</div>';
			return;
		}

		caption.textContent = rule
			? STATUSES[status] + " — " + rule.actorLabel
			: STATUSES[status] + " — برای این وضعیت دکمه عملیاتی تعریف نشده است";

		const actorComments = commentsForActor(status, actor, rule);
		if (shown.has("addComment") && actorComments.length) {
			comments.innerHTML = '<strong>وضعیت‌هایی که در افزودن کامنت می‌توان انتخاب کرد</strong><ul class="df-comment-list">' +
				actorComments.map(function (item) {
					return '<li><span>' + item.name + '</span><span><span class="df-mono">' + item.code + '</span> · ' + item.next + '</span></li>';
				}).join("") + '</ul>';
		} else if (rule && rule.comments.length && !shown.has("addComment")) {
			comments.innerHTML = '<div class="text-muted">افزودن کامنت برای این کاربر مخفی است.</div>';
		} else {
			comments.innerHTML = "";
		}

		const bits = [];
		if (rule && rule.note) bits.push('<div class="alert alert-warning">' + rule.note + '</div>');
		if (shown.has("reply")) bits.push('<div class="alert alert-primary mb-0">افزودن ReplySheet فقط به تهیه‌کننده سند VPIS نشان داده می‌شود.</div>');
		if (!rule) bits.push('<div class="alert alert-secondary mb-0">در این وضعیت فقط تاریخچه دیده می‌شود.</div>');
		if (rule && rule.actor !== actor && !(actor === "producer" && producerCanHold(status)))
			bits.push('<div class="alert alert-secondary mb-0">این کاربر نقش لازم را ندارد. فقط تاریخچه فعال است.</div>');
		if (actor === "producer" && producerCanHold(status) && rule && rule.actor !== "producer")
			bits.push('<div class="alert alert-warning mb-0">تهیه‌کننده جدا از نقش اصلی این وضعیت می‌تواند مدرک را Hold کند.</div>');
		notes.innerHTML = bits.join("");
	}

	function renderFlow() {
		const flow = q("flowList");
		flow.innerHTML = RULES.map(function (rule, index) {
			const last = index === RULES.length - 1;
			const codes = rule.statuses.map(function (code) { return '<span class="df-tag">' + code + '</span>'; }).join("");
			const loop = rule.loop ? '<div class="df-loop">' + rule.loop + '</div>' : "";
			const btnLabels = buttonsForStatus(rule.statuses[0]).map(buttonTitle).join(" · ");
			return '<div class="df-step ' + rule.tone + '" data-status="' + rule.statuses[0] + '" data-rule="' + rule.id + '">' +
				'<div class="df-rail"><div class="df-dot"></div>' + (last ? "" : '<div class="df-stem"></div>') + '</div>' +
				'<div class="card border mb-3"><div class="card-body py-4"><strong>' + rule.title + '</strong>' +
				'<div class="d-flex flex-wrap gap-2 mt-2">' + codes + '<span class="df-tag">' + rule.actorLabel + '</span><span class="df-tag">' + btnLabels + '</span></div></div></div></div>' + loop;
		}).join("") + '<div class="df-loop">بدون دکمه عملیاتی: ReIssued.</div>';

		flow.querySelectorAll(".df-step").forEach(function (el) {
			el.addEventListener("click", function () {
				statusPick.value = el.dataset.status;
				modePick.value = "normal";
				root.querySelectorAll(".df-step").forEach(function (s) { s.classList.remove("active"); });
				el.classList.add("active");
				showSide(el.dataset.rule);
				renderSim();
			});
		});
	}

	function showSide(ruleId) {
		const rule = RULES.find(function (item) { return item.id === ruleId; });
		q("sideTitle").textContent = rule.title;
		const sideComments = rule.comments.slice();
		if (producerCanHold(rule.statuses[0]) && !sideComments.some(function (item) { return item.code === "Hold"; }))
			sideComments.push(HOLD_COMMENT);
		const commentHtml = sideComments.length
			? '<ul class="df-comment-list">' + sideComments.map(function (item) {
				const who = item.code === "Hold" && rule.actor !== "producer" ? " — فقط تهیه‌کننده" : "";
				return '<li><span>' + item.name + who + '<br><span class="df-mono">' + item.code + '</span></span><span class="df-tag">' + item.next + '</span></li>';
			}).join("") + '</ul>'
			: '<p class="text-muted">در این مرحله افزودن کامنت فعال نیست.</p>';
		q("sideBody").innerHTML =
			'<p><b>دکمه:</b> ' + buttonsForStatus(rule.statuses[0]).map(buttonTitle).join(" · ") + '</p>' +
			'<p><b>چه کسی:</b> ' + rule.actorLabel + '</p>' +
			'<p><b>تاریخچه:</b> همیشه، برای همه</p>' +
			(rule.note ? '<div class="alert alert-warning">' + rule.note + '</div>' : '') +
			'<div><strong>انتخاب داخل کامنت</strong>' + commentHtml + '</div>';
	}

	function renderMatrix() {
		const rows = [];
		RULES.forEach(function (rule) {
			rule.statuses.forEach(function (code) {
				const commentItems = rule.comments.slice();
				if (producerCanHold(code) && !commentItems.some(function (item) { return item.code === "Hold"; }))
					commentItems.push(HOLD_COMMENT);
				const comment = commentItems.length
					? commentItems.map(function (item) {
						const label = item.code === "Hold" && rule.actor !== "producer" ? item.code + " (تهیه‌کننده)" : item.code;
						return '<span class="df-mono">' + label + '</span>';
					}).join(" ، ")
					: "—";
				const producerHoldBtn = producerCanHold(code) && rule.actor !== "producer"
					? '<br><span class="text-muted fs-7">تهیه‌کننده: افزودن کامنت برای Hold</span>'
					: "";
				rows.push('<tr class="df-clickable" data-status="' + code + '"><td><b>' + STATUSES[code] + '</b><br><span class="df-mono">' + code + '</span></td><td>' +
					buttonsForStatus(code).map(buttonTitle).join(" · ") + producerHoldBtn + '<br><span class="text-muted fs-7">به‌علاوه تاریخچه</span></td><td>' +
					rule.actorLabel + '</td><td>' + comment + '</td></tr>');
			});
		});
		GAPS.forEach(function (code) {
			rows.push('<tr class="bg-light"><td><b>' + STATUSES[code] + '</b><br><span class="df-mono">' + code + '</span></td><td>فقط تاریخچه</td><td>قانون دکمه نوشته نشده</td><td>—</td></tr>');
		});
		rows.push('<tr class="bg-light"><td><b>بعد از ایجاد ریویژن جدید</b></td><td>ذخیره و بستن</td><td>فقط تهیه‌کننده سند VPIS</td><td>ذخیره به Issue می‌رود</td></tr>');
		const body = q("matrixBody");
		body.innerHTML = rows.join("");
		body.querySelectorAll("tr[data-status]").forEach(function (row) {
			row.addEventListener("click", function () {
				statusPick.value = row.dataset.status;
				modePick.value = "normal";
				renderSim();
				q("sec-sim").scrollIntoView({ behavior: "smooth", block: "start" });
			});
		});
	}

	q("legendButtons").innerHTML = BUTTONS.map(function (btn) {
		let hint = "فقط در وضعیت خودش";
		if (btn.id === "history") hint = "همیشه";
		else if (btn.cls === "ghost") hint = "در این قوانین مخفی";
		else if (btn.id === "reply" || btn.id === "newRevision") hint = "فقط تهیه‌کننده";
		else if (btn.id === "transmittal") hint = "فقط DCC · بعد از تایید DCC";
		return '<span class="df-pill ' + (btn.cls === "ghost" ? "ghost" : btn.cls) + '">' + btn.title + '<span style="font-weight:500;opacity:.85"> · ' + hint + '</span></span>';
	}).join("");

	statusOptions();
	renderFlow();
	renderMatrix();
	showSide("rule-producer");
	root.querySelector('.df-step[data-rule="rule-producer"]').classList.add("active");
	statusPick.addEventListener("change", function () { modePick.value = "normal"; renderSim(); });
	actorPick.addEventListener("change", renderSim);
	modePick.addEventListener("change", renderSim);
	renderSim();
</script>

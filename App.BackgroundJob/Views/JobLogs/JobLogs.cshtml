@using Services.Job
@model IEnumerable<JobLog>
@{
    ViewData["Title"] = ViewData["Title"] ?? "لاگ‌های جاب";
    ViewData["Icon"] = ViewData["Icon"] ?? "list";
    var schedule = ViewBag.Schedule as Entities.Base.Job.JobSchedule;
}

@await Html.PartialAsync("_PageHeader")

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">نام جاب</dt>
            <dd class="col-sm-9">@(schedule?.JobDefinition?.DisplayName ?? "Unknown Job")</dd>
            <dt class="col-sm-3">Schedule ID</dt>
            <dd class="col-sm-9">@schedule?.Id</dd>
            <dt class="col-sm-3">توضیحات</dt>
            <dd class="col-sm-9">@(schedule?.JobDefinition?.Description ?? "—")</dd>
            <dt class="col-sm-3">وضعیت</dt>
            <dd class="col-sm-9">
                @if (schedule != null)
                {
                    var status = schedule.LastStatus.ToString();
                    if (status == "Running")
                    {
                        <span class="badge bg-warning text-dark status-running"><span class="status-pulse"></span>@status</span>
                    }
                    else if (status == "Error")
                    {
                        <span class="badge bg-danger">@status</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@status</span>
                    }
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer">
        <a href="@Url.Action("Index", "JobLogs")" class="btn btn-secondary js-soft-nav">
            <i class="fas fa-arrow-right me-1"></i> بازگشت
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">همه لاگ‌های این جاب</h5>
    </div>
    <div class="card-body p-0">
        <div class="live-log-stream">
            @if (Model.Any())
            {
                @foreach (var log in Model)
                {
                    var level = (log.LogLevel ?? "Info").ToLowerInvariant();
                    <div class="log-line log-level-@level" data-level="@level">
                        <span class="log-time" dir="ltr">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</span>
                        <span class="log-level">[@log.LogLevel]</span>
                        <span class="log-msg">@log.Message</span>
                        @if (!string.IsNullOrEmpty(log.Details))
                        {
                            <pre class="log-details">@log.Details</pre>
                        }
                        @if (!string.IsNullOrEmpty(log.ExceptionType) || !string.IsNullOrEmpty(log.StackTrace))
                        {
                            <pre class="log-exception">@log.ExceptionType
@log.StackTrace</pre>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4 empty-logs">
                    <i class="fas fa-info-circle fa-2x mb-2"></i>
                    <p class="mb-0">لاگی برای این جاب یافت نشد.</p>
                </div>
            }
        </div>
    </div>
</div>

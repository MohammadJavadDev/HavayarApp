        function field(renderfields) {

            if (renderfields === undefined || renderfields.length === 0) {
                return null;
            }
            return renderfields.map((f) => {

                let idparentId = f.id;

                if (!KTUtil.isEmpty(f.parentId)) {
                    idparentId = f.parentId + '-' + idparentId;
                }

                let $feild = $(` <div>
                            <div class="row item" data-parentIdFeildId=${idparentId} data-feildId=${f.id} data-componetDrop="feild" data-tmplId="#feildElement${f.fieldType}Tmpl">
                                <div class="col-md-1">
                                  <i class="fa fa-arrows-alt" aria-hidden="true" data-handler="true"></i>
                                </div>
                                <div class=" ${f.fieldType === "document" ? "col-md-3" : "col-md-7"} "> ${f.displayName}  -  ${f.fieldTypeTitle} </div>
                                                        ${f.fieldType === "document" ? `
                                                            <div class=" col-md-2">
                                                                  <a   class=" hover-scale " role="button" data-action="${idparentId}addFeildToDocument">
                                                                         <i class="ki-duotone ki-plus fs-2   text-success"></i>
                                                                  </a>
                                                                </div>

                                                             <div class=" col-md-2">
                                                                  <a  class=" hover-scale " role="button" data-action="${idparentId}toggleDocSection">

                                                                      <i class="ki-duotone ki-double-down fs-2  text-info" data-taggle="${idparentId}hide">
                                                                         <span class="path1"></span>
                                                                         <span class="path2"></span>
                                                                         <span class="path3"></span>
                                                                    </i>

                                                                     <i class="ki-duotone ki-double-up fs-2   text-info d-none" data-taggle="${idparentId}show">
                                                                         <span class="path1"></span>
                                                                         <span class="path2"></span>
                                                                         <span class="path3"></span>
                                                                    </i>

                                                                  </a>
                                                                </div>
                                                            `: ``
                    }
                                                      <div class=" col-md-2">
                                                          <a   class=" hover-scale " role="button" data-action="${idparentId}edit">
                                                            <i class="ki-duotone ki-pencil fs-2   text-warning ">
                                                                        <span class="path1"></span>
                                                                        <span class="path2"></span>
                                                                    </i>
                                                          </a>
                                                        </div>
                                                         <div class=" col-md-2">
                                                            <a  class="hover-scale " role="button" data-action="${idparentId}remove">
                                                            <i class="ki-duotone ki-trash  fs-2  text-danger ">
                                                                     <span class="path1"></span>
                                                                     <span class="path2"></span>
                                                                     <span class="path3"></span>
                                                                     <span class="path4"></span>
                                                                     <span class="path5"></span>
                                                                    </i>
                                                                   </a>
                                                        </div>
                                    </div>
                                     ${f.fieldType === "document" ? `
                                         <div data-parentId="${idparentId}" class="d-none">

                                         </div>
                                         `
                        : ``
                    }

                                   </div> `
                );
                if (f.fields && f.fields.length !== 0) {

                    $feild.find("[data-parentId]").append(field(f.fields));

                    $feild.find(`[data-action=${idparentId}toggleDocSection]`).click(function () {
                        let $divhide = $feild.find(`[data-parentId="${idparentId}"]`);

                        if ($feild.find(`[data-action=${idparentId}toggleDocSection]`).find(".d-none").data("taggle") === `${idparentId}hide`) {
                            $feild.find(`[data-action=${idparentId}toggleDocSection]`).find(`[data-taggle=${idparentId}hide]`).removeClass("d-none")
                            $feild.find(`[data-action=${idparentId}toggleDocSection]`).find(`[data-taggle=${idparentId}show]`).addClass("d-none")
                        }
                        else {
                            $feild.find(`[data-action=${idparentId}toggleDocSection]`).find(`[data-taggle=${idparentId}show]`).removeClass("d-none")
                            $feild.find(`[data-action=${idparentId}toggleDocSection]`).find(`[data-taggle=${idparentId}hide]`).addClass("d-none")
                        }

                        $divhide.toggleClass("d-none");

                    });

                }

                $feild.find(`[data-action=${idparentId}edit]`).click(function () {
                    openDialog(f);
                });

                $feild.find(`[data-action=${idparentId}remove]`).click(function () {
                    removeFeild(f.id, idparentId)
                });

                $feild.find(`[data-action=${idparentId}addFeildToDocument]`).click(function () {

                    openDialog({ parentId: `${idparentId}` });
                });


                return $feild;
            })

        }

        function removeFeild(id, parentId) {

            $.confirm({
                title: "حذف فیلد",
                content: $(`<div class='col-md-12'> <span>آیا فیلد حذف شود ؟</span></div>`),
                buttons: {


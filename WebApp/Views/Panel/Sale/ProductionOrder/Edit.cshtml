@using Entities.App.FIN;
@using Entities.App.Gnr;
@using Entities.App.Inv;
@using Entities.App.Sale;
@using Entities.App.SLS;
@using Entities.App.Sale.Enums
@using Entities.App.Pln;
@using Entities.Auth;
@using Common.Utilities
@using Data.SystemAuth
@inject ISdk sdk
@model ProductionOrder
@{
	var isAdmin = sdk.IsAdministrator;

	// تایید مالی فقط در راهکاران انجام می‌شود (مثل HTS) و با Job همگام می‌شود؛ دکمه پنل حذف شد (2026-09-17).

	//Seed Role => Sale.ProductionOrder.Obsolete => سفارش ساخت - منسوخ‌سازی
	var canObsolete = isAdmin || sdk.HasRole("Sale.ProductionOrder.Obsolete");
	var canEditOrder = ViewBag.CanEditOrder as bool? ?? false;
	var editLockMessage = ViewBag.EditLockMessage as string;
	var salesItems = ViewBag.SalesItems as List<ProductionOrderItem> ?? new List<ProductionOrderItem>();

	var delays = ViewBag.ProductionOrderDelayViewData as List<ProductionOrderDelay> ?? new List<ProductionOrderDelay>();
	var showObsolete = canObsolete && Model?.State == ProductionOrderStateEnum.FinancialApproval;
}
<div class="card">
	<div class="form-action-buttons">
		<form-action-buttons entity-type="typeof(ProductionOrder)">
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-print"
				action-name="printProductionOrder" title="چاپ سفارش ساخت"></form-action-button>
			@if (showObsolete)
			{
			<form-action-button color-class="btn-active-icon-dark btn-color-dark" icon-class="fa fa-ban"
				action-name="obsolete" title="منسوخ کردن"></form-action-button>
			}
		</form-action-buttons>
	</div>
</div>
<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />

<div class="row">
	<div class="col-12 mb-2">
		<label class="form-label text-muted small">وضعیت</label>
		<div>
			<span class="badge badge-light-primary fs-6 px-3 py-2" data-bind="stateDisplay">@(Model?.State.ToDisplay() ?? "-")</span>
		</div>
	</div>

	<!-- Tab Navigation -->
	<div class="col-12">
		<div class="card border-0 shadow-sm">
			<div class="card-body p-3">
				<ul class="nav nav-tabs nav-line-tabs nav-stretch fs-6 border-0 px-4 pt-4 justify-content-between" role="tablist">
					<li class="nav-item">
						<a class="nav-link active" data-bs-toggle="tab" href="#tab_general_@Model.Id">
							<i class="bi bi-info-circle me-2"></i>اطلاعات کلی
						</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" data-bs-toggle="tab" href="#tab_history_@Model.Id">
							<i class="bi bi-chat-dots me-2"></i>تاریخچه
							<span class="badge-circle badge badge-light-primary mx-1">@(Model?.Comments.Count ?? 0)</span>
						</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" data-bs-toggle="tab" href="#tab_attachments_@Model.Id">
							<i class="bi bi-paperclip me-2"></i>پیوست‌ها
						</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" data-bs-toggle="tab" href="#tab_delays_@Model.Id">
							<i class="bi bi-clock-history me-2"></i>تاخیرات
							<span class="badge-circle badge badge-light-warning mx-1">@delays.Count</span>
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<div class="col-md-12 my-1">
		<div class="tab-content p-3" id="myTabContent">

			<!-- Tab 1: اطلاعات کلی -->
			<div class="tab-pane fade show active" id="tab_general_@Model.Id" role="tabpanel">
				@if (!canEditOrder && !string.IsNullOrWhiteSpace(editLockMessage))
				{
					<div class="alert alert-warning">@editLockMessage</div>
				}
				<div class="card" id="productionOrderHeaderFields">
					<div class="card-body row">
						<div class="col-12 mb-4">
							<h3 class="fw-bold text-dark">اطلاعات اصلی</h3>
						</div>

						<div class='col-md-6'>
							<label class='required'>وضعیت</label>
							<select class='form-control' data-bind='state' disabled asp-for='State' asp-items="Html.GetEnumSelectList(typeof(ProductionOrderStateEnum))">
							</select>
							<div class="form-text text-muted">
								<!-- وضعیت گردش‌کار فقط از طریق دکمه‌های «تایید مالی»/«منسوخ کردن» بالا تغییر می‌کند -->
								تغییر وضعیت صرفاً از طریق دکمه‌های عملیات بالا امکان‌پذیر است
							</div>
						</div>
						<div class='col-md-3'>
							<label class='required'>شماره سفارش ساخت</label>
							<input class='form-control' data-bind='number' required asp-for='Number' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>
						<div class='col-md-3'>
							<label class=''>نسخه</label>
							<input class='form-control'  data-bind='revision'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='Revision' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>


						<div class="col-md-3">
							<label class=''>قرارداد</label>

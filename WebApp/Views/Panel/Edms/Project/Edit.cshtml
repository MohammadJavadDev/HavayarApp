			<div class='col-md-12'>
				<div data-tab-item-manager="projectItems" data-item-selector=".entity-item">
					<ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-transparent fs-4 fw-bold mb-5" role="tablist">
						<li class="nav-item" role="presentation">
							<a class="nav-link active" data-bs-toggle="tab" href="#progressPercentageTab" role="tab" aria-selected="true">
								<span class="svg-icon svg-icon-2 me-2"></span>
								درصد پیشرفت
							</a>
						</li>
					</ul>
					<div class="tab-content">
						<div class="tab-pane fade show active" id="progressPercentageTab" role="tabpanel" data-add-url="/Panel/Edms/Project/ProjectProgressPercentagePartial">
							<div id='ProgressPercentageContainer' class="entity-item-container">
								@if (Model?.ProgressPercentage != null)
								{
									@foreach (var item in Model.ProgressPercentage)
									{
										<div data-item-id="@(item.Id ?? 0)">
											@await Html.PartialAsync("_ProjectProgressPercentagePartial.cshtml", item)
										</div>
									}
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="card">

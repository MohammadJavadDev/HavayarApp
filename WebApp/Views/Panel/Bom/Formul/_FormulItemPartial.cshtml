@using Entities.App.Bom;
@using WebFramework.TagHelpers;
@model FormulItem
<div class="entity-item">
	<input class='form-control' type="hidden" data-bind='items.id' value='@Model?.Id' />
	<div class='col-md-3'>
		<label class=''>قطعه</label>
		@(Html.EntitySelector<Entities.App.Inv.Part>(
			"itemsPartSelector",
			c => c.IsActive == Entities.Base.IsActiveEnum.Active,
			c => new
			{
				Id = c.Id, Code = c.Code, Name = c.Name
			},
			c => new { c.Code, c.Name },
			"{Code} || {Name}",
			"items.PartId",
			null,
			Model?.PartId?.ToString())
		))
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>

	<div class='col-md-3'>
		<label class=''>ضریب مصرفی</label>
		<input class='form-control' data-bind='items.usingRate'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" value='@Model?.UsingRate' />
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>

</div>

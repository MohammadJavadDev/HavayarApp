@using Entities.App.Inv
@using Entities.App.Sale
@using Entities.Base
@model PartPrice

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(PartPrice)"></form-action-buttons>
	</div>
	<div class="card-body row">
		<span class="section-box-title">جزئیات</span>
		<input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
			<div class="col-md-12 form-group-inline">
				<label class="form-label fw-bold required">کالا</label>
				@(Html.EntitySelector<Part>(
					"PartPricePartSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Code = c.Code, Name = c.Name },
					c => new { c.Code, c.Name },
					"{Code} {Name}",
					"partId",
					"partName",
					Model?.PartId?.ToString()
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold required">قیمت</label>
				<input class="form-control" data-bind="price" data-required="true" asp-for="Price" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">ضریب فروش</label>
				<input class="form-control" data-bind="saleFactor" asp-for="SaleFactor" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">ضریب غیرروتین با حمل</label>
				<input class="form-control" data-bind="nonRoutineWithTransferringFeeSaleFactor" asp-for="NonRoutineWithTransferringFeeSaleFactor" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">ضریب غیرروتین بدون حمل</label>
				<input class="form-control" data-bind="nonRoutineWithoutTransferringFeeSaleFactor" asp-for="NonRoutineWithoutTransferringFeeSaleFactor" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
	</div>
</div>
<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;
		const model = page.$pageEl.dataBind();
		const $btn = $($btnAction.element).block();
		$$.post('save', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			$btnAction.baseaction();
		});
	}
	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>

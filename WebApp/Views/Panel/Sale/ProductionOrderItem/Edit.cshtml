					<label class='text-muted d-block  ' style="font-size: 0.9rem;">فشار خروجی</label>
					<span class='fw-semibold fs-6' data-bind='outputPressureBar'>@(Model?.OutputPressureBar?.ToString() ?? "-")</span>
				 
			</div>

			<div class='col-md-3 form-group-inline'>
		 
					<label class='text-muted d-block  ' style="font-size: 0.9rem;">ظرفیت</label>
					<span class='fw-semibold fs-6' data-bind='capacity'>@(string.IsNullOrWhiteSpace(Model?.Capacity) ? "-" : Model?.Capacity)</span>
				 
			</div>

			<div class='col-md-3 form-group-inline'>
			 
					<label class='text-muted d-block  ' style="font-size: 0.9rem;">مقیاس</label>

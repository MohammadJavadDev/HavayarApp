@using Entities.App.Gnr
@using Entities.App.Hcm
@using Entities.App.Sale;
@model SaleMission

<div class="card shadow-sm border-0">

     <div class="form-action-buttons border-bottom p-3">
          <form-action-buttons entity-type="typeof(SaleMission)"></form-action-buttons>
     </div>

     <div class="card-body">

          <div class="row mb-4">
               <div class="col-12">
                    <h4 class="fw-bold text-dark mb-0">
                         مدیریت ماموریت ها
                    </h4>
               </div>
          </div>

          <input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />

          <div class="row g-3">

               <div class="col-md-3">
                    <label class="form-label ">شماره حکم</label>

                    <input class="form-control"
                           data-bind="statementNumber"
                           asp-for="StatementNumber" />

                    <div data-invalidmessagespan class="mt-1">
                         <span class="text-danger"></span>
                    </div>
               </div>

               <div class="col-md-3">
                    <label class="form-label">پرسنل</label>

                    @(Html.EntitySelector<Personel>(
                                        "CustomerAgencySelector",
                                        c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                                        c => new
                                        {
                                             Id = c.Id,
                                             Name = c.Name,
                                             Family = c.Family
                                        },
                                        c => new { c.Name },
                                        "{Name} {Family}",
                                        "PersonelId",
                                        Model?.Personel?.Name,
                                        Model?.PersonelId?.ToString()
                                        ))

                    <div data-invalidmessagespan class="mt-1">
                         <span class="text-danger"></span>
                    </div>
               </div>

               <div class="col-md-3">
                    <label class="form-label">مرکز هزینه</label>
                    @(Html.EntitySelector<CostCenter>(
                                        "CostCenterSelector",
                                        c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                                        c => new
                                        {
                                             Id = c.Id,
                                             Title = c.Title,
                                        },
                                        c => new { c.Title },
                                        "{Title}",
                                        "CostCenterId",
                                        Model?.CostCenter?.Title,
                                        Model?.CostCenterId?.ToString()
                                        ))
                    <div data-invalidmessagespan class="mt-1">
                         <span class="text-danger"></span>
                    </div>
               </div>

               <div class='col-md-2 align-content-center'>
                    <div class="form-check">
                         <input data-bind='haveGurantee' class="form-check-input" type="checkbox" asp-for='HaveGurantee' />
                         <label class="form-check-label form-label fw-bold" asp-for='HaveGurantee'>
                              گارانتی
                         </label>
                    </div>
               </div>


               <div class='col-md-3'>
                    <label class='form-label '>
                         تاریخ اعزام
                    </label>
                    <input class='form-control' data-bind='DispatchShamsiDate' data-persionDatePicker="true"
                           persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                           value='@Model?.DispatchMiladiDate' />
               </div>
               <div class='col-md-3'>
                    <label class='form-label '>
                         از ساعت
                    </label>
                    <input class='form-control' data-bind='fromHour' data-persionDatePicker="true"
                           persion-datetimepicker='{"format": "HH:mm","autoClose": true,"initialValue": false,"onlyTimePicker": true}'
                           value='@Model?.FromHour' />
               </div>


               <div class='col-md-3'>
                    <label class='form-label '>
                         تا ساعت
                    </label>
                    <input class='form-control' data-bind='toHour' data-persionDatePicker="true"
                           persion-datetimepicker='{"format": "HH:mm","autoClose": true,"initialValue": false,"onlyTimePicker": true}'
                           value='@Model?.ToHour' />
               </div>

               <div class='col-md-3'>
                    <label class=''>
                         تاریخ برگشت
                    </label>
                    <input class='form-control' data-bind='returnShamsiDate' data-persionDatePicker="true"
                           persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                           value='@Model?.ReturnMiladiDate' />
               </div>


               <div class='col-md-3'>
                    <label>هزینه صبحانه</label>
                    <input class='form-control' data-bind='breakfastPrice' asp-for='BreakfastPrice' />
               </div>

               <div class='col-md-3'>
                    <label>تعداد صبحانه</label>
                    <input class='form-control' data-bind='breakfastQuantity' asp-for='BreakfastQuantity' />
               </div>

               <div class='col-md-3'>
                    <label>هزینه ناهار</label>
                    <input class='form-control' data-bind='lunchPrice' asp-for='LunchPrice' />
               </div>

               <div class='col-md-3'>
                    <label>تعداد ناهار</label>
                    <input class='form-control' data-bind='lunchQuantity' asp-for='LunchQuantity' />
               </div>


               <div class='col-md-3'>
                    <label>هزینه شام</label>
                    <input class='form-control' data-bind='dinnerPrice' asp-for='DinnerPrice' />
               </div>


               <div class='col-md-3'>
                    <label>تعداد شام</label>
                    <input class='form-control' data-bind='dinnerQuantity' asp-for='DinnerQuantity' />
               </div>


               <div class='col-md-3'>
                    <label> مبلغ حق شب</label>
                    <input class='form-control' data-bind='nightShiftAllowance' asp-for='NightShiftAllowance' />
               </div>


               <div class='col-md-3'>
                    <label>ضریب حق شب</label>
                    <input class='form-control' data-bind='nightShiftCoefficient' asp-for='NightShiftCoefficient' />
               </div>

               <div class='col-md-3'>
                    <label>مبلغ اضافه کاری</label>
                    <input class='form-control' data-bind='workOvertimeFee' asp-for='WorkOvertimeFee' />
               </div>

               <div class='col-md-3'>
                    <label>ساعت اضافه کاری</label>
                    <input class='form-control' data-bind='workOvertimeHour' asp-for='WorkOvertimeHour' />
               </div>

               <div class='col-md-3'>
                    <label>حق ماموریت</label>
                    <input class='form-control' data-bind='missionRight' asp-for='MissionRight' />
               </div>

               <div class='col-md-3'>
                    <label>ضریب  ماموریت</label>
                    <input class='form-control' data-bind='missionRight' asp-for='MissionRight' />
               </div>


               <div class='col-md-3'>
                    <label> ایاب ذهاب شخصی</label>
                    <input class='form-control' data-bind='transportationPersonal' asp-for='TransportationPersonal' />
               </div>

               <div class='col-md-3'>
                    <label> ایاب ذهاب سواری</label>
                    <input class='form-control' data-bind='transportationDriving' asp-for='TransportationDriving' />
               </div>

               <div class='col-md-3'>
                    <label>حق تعطیل کاری</label>
                    <input class='form-control' data-bind='missionHolidayRightFactor' asp-for='MissionHolidayRightFactor' />
               </div>

               <div class='col-md-3'>
                    <label>تعداد تعطیل کاری</label>
                    <input class='form-control' data-bind='missionHolidayRightFactor' asp-for='MissionHolidayRightFactor' />
               </div>

               <div class='col-md-3'>
                    <label>حقوق روزانه</label>
                    <input class='form-control' data-bind='dailySalary' asp-for='DailySalary' />
               </div>

               <div class='col-md-3'>
                    <label>سایر هزینه</label>
                    <input class='form-control' data-bind='otherCost' asp-for='OtherCost' />
               </div>




               <div class="col-md-12">
                    <label>توضیحات</label>
                    <textarea class="form-control" data-bind="comment" asp-for="Comment" rows="5"></textarea>
               </div>


               <div class="card border mt-5">
                    <div class="card-body">

                         <div class="row g-3 align-items-end mb-4">
                         </div>

                    </div>
               </div>

          </div>
     </div>

     <div class="card mt-4 border-0 shadow-sm">
          <div class="card-body">
               <div class="row text-muted">

                    <div class="col-md-3">
                         <span class="fw-bold">ایجاد کننده :</span>
                         <span data-bind="createdByName">@Model?.CreatedByName</span>
                    </div>

                    <div class="col-md-3">
                         <span class="fw-bold">تاریخ ایجاد :</span>
                         <span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
                    </div>

                    <div class="col-md-3">
                         <span class="fw-bold">ویرایش کننده :</span>
                         <span data-bind="modifiedByName">@Model?.ModifiedByName</span>
                    </div>

                    <div class="col-md-3">
                         <span class="fw-bold">تاریخ ویرایش :</span>
                         <span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
                    </div>

               </div>
          </div>
     </div>
</div>
<script>
     const serviceRequestId = sessionStorage.getItem("ServiceRequestId");

     function getServiceRequestId() {
         debugger
         return $('[data-bind="id"]').val();
     }


     function loadServiceRequestDetails(serviceRequestId) {

         if (!serviceRequestId || serviceRequestId === '0') {
             $('#contractorTableBody').html(`
                     <tr>
                         <td colspan="13" class="text-center text-warning">
                             شناسه معتبر نیست
                         </td>
                     </tr>
                 `);
             return;
         }

         $.ajax({
             url: '/Panel/Sale/ServiceRequest/GetServiceRequest',
             type: 'GET',
             data: { serviceRequestId: serviceRequestId },
             dataType: 'json',
             success: function(res) {
                 debugger
                 if (res && res.isSuccess === true && Array.isArray(res.data)) {
                     renderServiceRequestDetails(res.data);
                 }
                 else {
                     $('#contractorTableBody').html(`
                             <tr>
                                 <td colspan="13" class="text-center text-warning">
                                     اطلاعاتی یافت نشد
                                 </td>
                             </tr>
                         `);
                 }
             },

             error: function() {

                 $('#contractorTableBody').html(`
                         <tr>
                             <td colspan="13" class="text-center text-danger">
                                 خطا در دریافت اطلاعات
                             </td>
                         </tr>
                     `);
             }
         });
     }


     function renderServiceRequestDetails(list) {
         const SaleRequestTypeEnum = {
             1: 'آموزش',
             2: 'اورهال',
             3: 'بازدید و مشاوره',
             4: 'تعمیرات گارانتی',
             5: 'تعمیرات وارانتی',
             6: 'راه اندازی اولیه',
             7: 'پایپینگ',
             8: 'سرویس دوره ای',
             9: 'سایر موارد',
             10: 'OPI',
             11: 'راه اندازی تجهیز تعمیری',
             12: 'پیش راه اندازی',
             13: 'نصب'
         };

         const tbody = $('#contractorTableBody');
         tbody.empty();

         list.forEach((item, index) => {
             const requestTypeName = SaleRequestTypeEnum[item.requestType] || 'نامشخص';

             const row = `
                     <tr data-id="${item.id || 0}">
                         <td class="text-center">
                             <button class="btn btn-warning btn-sm" data-action="editDetail" data-id="${item.id}">
                                 <i class="fa fa-pencil"></i>
                             </button>
                             <button class="btn btn-danger btn-sm" data-action="deleteDetail" data-id="${item.id}">
                                 <i class="fa fa-trash"></i>
                             </button>
                         </td>
                         <td>${index + 1}</td>

                         <td>${requestTypeName}</td>

                         <td class="text-end">
                             ${item.cost ? new Intl.NumberFormat('fa-IR').format(item.cost) : '-'}
                         </td>
                         <td>${item.part?.name || '-'}</td>
                         <td>${item.sendPartShamsiDate || '-'}</td>
                         <td>${item.contractorAcceptShamsiDate || '-'}</td>
                         <td>${item.noticeShamsiDate || '-'}</td>
                         <td>${item.noticeTime || '-'}</td>
                     </tr>`;

             tbody.append(row);
         });
     }


     function refreshServiceRequestDetails() {

         const serviceRequestId = getServiceRequestId();

         if (!serviceRequestId) return;

         $('#contractorTableBody').html(`
                 <tr>
                     <td colspan="13" class="text-center py-4">
                         <div class="spinner-border text-primary"></div>
                     </td>
                 </tr>
             `);

         loadServiceRequestDetails(serviceRequestId);
     }


     $(document).on('click', '[data-action="addNewContractor"]', function() {

         const serviceRequestId = getServiceRequestId();

         if (!serviceRequestId) {
             toastr.error('ابتدا اطلاعات را ذخیره کنید');
             return;
         }

         const url =
             `/Panel/Sale/ServiceRequest/ShowProductDetailForm?serviceRequestId=${serviceRequestId}`;

         $$.get(url, function(html) {

             const bodyCn =
                 $(`<div style="overflow-y:auto;max-height:70vh;">${html}</div>`);

             initPersionDatePicker(bodyCn);

             $.confirm({

                 title: 'افزودن آیتم',
                 columnClass: 'col-md-6',
                 content: bodyCn,
                 rtl: true,

                 buttons: {

                     save: {

                         text: 'ذخیره',
                         btnClass: 'btn-success',

                         action: function() {

                             const $content = this.$content;

                             if (validateError($content))
                                 return false;

                             const model = $content.dataBind();
                             model.ServiceRequestId = serviceRequestId;

                             const self = this;

                             $$.post(
                                 '/Panel/Sale/ServiceRequest/AddRepairProductDetail',
                                 model,
                                 function(r) {

                                     if (!r.isSuccess) {
                                         toastr.error(r.message || 'خطا در ذخیره');
                                         return;
                                     }

                                     toastr.success('با موفقیت ذخیره شد');

                                     refreshServiceRequestDetails();

                                     self.close();
                                 }
                             );

                             return false;
                         }
                     },

                     cancel: {
                         text: 'انصراف',
                         btnClass: 'btn-secondary'
                     }
                 }
             });
         });
     });

     $(document).on('click', '[data-action="editDetail"]', function() {

         const selectedRow = $(this).data('id');
         const serviceRequestId = getServiceRequestId();

         const url = selectedRow
             ? `/Panel/Sale/ServiceRequest/EditServiceRequest?id=${selectedRow}&serviceRequestId=${serviceRequestId}`
             : `/Panel/Sale/ServiceRequest/EditServiceRequest?serviceRequestId=${serviceRequestId}`;

         $$.get(url, function(html) {

             const bodyCn =
                 $(`<div style="overflow-y:auto;max-height:70vh;">${html}</div>`);

             initPersionDatePicker(bodyCn);

             $.confirm({

                 title: selectedRow ? 'ویرایش' : 'افزودن',
                 columnClass: 'col-md-6',
                 content: bodyCn,
                 rtl: true,

                 buttons: {

                     save: {

                         text: 'ذخیره',
                         btnClass: 'btn-success',

                         action: function() {

                             const $content = this.$content;

                             if (validateError($content))
                                 return false;

                             const model = $content.dataBind();
                             if (model.noticeTime) {
                                 model.NoticeTime = model.noticeTime;
                             }
                             delete model.noticetime;
                             delete model.noticeTime;
                             model.ServiceRequestId = serviceRequestId;

                             if (selectedRow)
                                 model.Id = selectedRow;

                             const self = this;
                             debugger
                             $$.post(
                                 '/Panel/Sale/ServiceRequest/AddRepairProductDetail',
                                 model,
                                 function(r) {

                                     if (!r.isSuccess) {
                                         toastr.error(r.message || 'خطا');
                                         return;
                                     }

                                     toastr.success(selectedRow ? 'ویرایش انجام شد' : 'با موفقیت ثبت شد');

                                     refreshServiceRequestDetails();

                                     self.close();
                                 }
                             );

                             return false;
                         }
                     },

                     cancel: {
                         text: 'انصراف'
                     }
                 }
             });
         });
     });

     $(document).on('click', '[data-action="deleteDetail"]', function() {
         const id = $(this).data('id');

         Swal.fire({

             title: 'آیا مطمئن هستید؟',
             text: 'این عملیات قابل بازگشت نیست',
             icon: 'warning',

             showCancelButton: true,

             confirmButtonText: 'حذف',
             cancelButtonText: 'انصراف'

         }).then((result) => {

             if (!result.isConfirmed)
                 return;

             $.ajax({

                 url: `/Panel/Sale/ServiceRequest/DeleteServiceRequest?id=${id}`,
                 type: 'DELETE',

                 success: function(res) {
                     debugger
                     if (res && res.data.data.success === true) {

                         toastr.success(res.data.data.message || 'حذف شد');

                         refreshServiceRequestDetails();
                     }
                     else {

                         toastr.error(res.data.data.message || 'خطا در حذف');
                     }
                 },

                 error: function() {

                     toastr.error('خطا در حذف رکورد');
                 }
             });
         });
     });

     $(document).ready(function() {

         const serviceRequestId = getServiceRequestId();

         if (serviceRequestId && serviceRequestId !== '0') {

             loadServiceRequestDetails(serviceRequestId);
         }
     });

     function savefn($btnAction) {

         if (validateError(page.$pageEl)) return;

         const model = page.$pageEl.dataBind();
         model.ServiceRequestId = sessionStorage.getItem("ServiceRequestId");
         const $btn = $(this.element).block();

         $$.post('save', model, function(r) {

             $btn.block(false);

             if (!r.isSuccess) {
                 toastr.error(r.message, 'خطا');
                 return;
             }

             toastr.success('ذخیره سازی با موفقیت انجام شد');

             page.$pageEl.dataBind(r.data);

             $btnAction.baseaction();
         });
     }

     self.FormActionButtons.save.onclick(function() { savefn(this); });
     self.FormActionButtons.saveandnew.onclick(function() { savefn(this); });
     self.FormActionButtons.saveandclose.onclick(function() { savefn(this); });

</script>

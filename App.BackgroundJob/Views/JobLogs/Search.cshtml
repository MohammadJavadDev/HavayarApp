@model IEnumerable<Entities.Base.Job.JobLog>
@{
    ViewData["Title"] = "Search Job Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Search Job Logs</h2>

<div class="card mb-4">
 
    <div class="card-body">
        <form method="get" class="form-row">
            <div class="form-group col-md-4">
                <label for="query">Search Text</label>
                <input type="text" class="form-control" id="query" name="query" 
                       placeholder="Search in messages, details, exceptions..." value="@ViewData["query"]">
            </div>
            
            <div class="form-group col-md-2">
                <label for="scheduleId">Job Schedule</label>
                <select class="form-control" id="scheduleId" name="scheduleId">
                    <option value="">All Jobs</option>
                    @foreach (var schedule in ViewBag.Schedules as IEnumerable<Entities.Base.Job.JobSchedule>)
                    {
                        <option value="@schedule.Id" selected="@(schedule.Id.ToString() == ViewData["scheduleId"]?.ToString())">
                            @(schedule.JobDefinition?.DisplayName ?? "Unknown Job") (@schedule.Id)
                        </option>
                    }
                </select>
            </div>

            <div class="form-group col-md-2">
                <label for="fromDate">From Date</label>
                <input type="datetime-local" class="form-control" id="fromDate" name="fromDate" 
                       value="@(ViewData["fromDate"] != null ? Convert.ToDateTime(ViewData["fromDate"]).ToString("yyyy-MM-ddTHH:mm") : "")">
            </div>

            <div class="form-group col-md-2">
                <label for="toDate">To Date</label>
                <input type="datetime-local" class="form-control" id="toDate" name="toDate" 
                       value="@(ViewData["toDate"] != null ? Convert.ToDateTime(ViewData["toDate"]).ToString("yyyy-MM-ddTHH:mm") : "")">
            </div>

            <div class="form-group col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-search"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4>Search Results (@Model.Count() results)</h4>
            <a href="@Url.Action("Index", "JobLogs")" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Back to History
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Job</th>
                            <th>Level</th>
                            <th>Message</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@log.JobHistory?.JobSchedule?.JobDefinition?.DisplayName</td>
                                <td><span class="badge @GetLogLevelBadgeClass(log.LogLevel)">@log.LogLevel</span></td>
                                <td>@log.Message</td>
                                <td>
                                    <a href="@Url.Action("Details", "JobLogs", new { id = log.JobHistoryId })#log-@log.Id" 
                                       class="btn btn-sm btn-info" title="View full details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else if (Context.Request.Method == "POST")
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No logs found matching your search criteria.
    </div>
}
else
{
    <div class="alert alert-secondary">
        <i class="fas fa-search"></i> Enter search criteria and click Search to find logs.
    </div>
}

@section Scripts {
    <script>
        // Auto-focus on search input
        $(document).ready(function() {
            $('#query').focus();
        });
    </script>
}

@functions {
    private string GetLogLevelBadgeClass(string logLevel)
    {
        switch (logLevel.ToLower())
        {
            case "error": return "badge-danger";
            case "warning": return "badge-warning";
            case "info": return "badge-info";
            case "debug": return "badge-secondary";
            default: return "badge-info";
        }
    }
}
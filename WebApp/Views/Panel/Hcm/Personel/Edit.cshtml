@using Entities.App.Gnr;
@using Entities.App.Hcm;
@using Entities.App.Hrm;
@model Personel
<div class="card">
	<div class="form-action-buttons"><form-action-buttons entity-type="typeof(Personel)"></form-action-buttons></div>
</div>
<div class="card">
	<div class="card-body row">
		<div class="col-12 mb-4">
			<h3 class="fw-bold text-dark">اطلاعات اصلی</h3>
		</div>
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class='col-md-3'>
			<label class=''>کد</label>
			<input class='form-control' data-bind='code'  asp-for='Code' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>نام</label>
			<input class='form-control' data-bind='name'  asp-for='Name' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>نام خانواده</label>
			<input class='form-control' data-bind='family'  asp-for='Family' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>نمایش نام خانواده</label>
			<input class='form-control' data-bind='familyDisplay'  asp-for='FamilyDisplay' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>نام انگلیسی</label>
			<input class='form-control' data-bind='nameEn'  asp-for='NameEn' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>نام خانوادگی انگلیسی</label>
			<input class='form-control' data-bind='familyEn'  asp-for='FamilyEn' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>نام پدر</label>
			<input class='form-control' data-bind='fatherName'  asp-for='FatherName' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>ایمیل</label>
			<input class='form-control' data-bind='email'  asp-for='Email' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-3">
			<label class=''>واحد سازمانی</label>
			@(Html.EntitySelector<OrgUnit>(
				"OrgUnitSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Title = c.Title
				},
				c => new { c.Title },
				"{Title}",
				"OrgUnitId",
				"OrgUnitName",
				Model?.OrgUnitId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>موبایل</label>
			<input class='form-control' data-bind='mobile'  asp-for='Mobile' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>کد شعبه</label>
			<input class='form-control'  data-bind='branchCode'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='BranchCode' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>تاریخ تولد</label>
			<input class='form-control'  data-bind='birthDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true}' value='@Model?.BirthDate' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>تاریخ تولد واقعی</label>
			<input class='form-control'  data-bind='realyBirthDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true}' value='@Model?.RealyBirthDate' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>تاریخ استخدام</label>
			<input class='form-control'  data-bind='employmentDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true}' value='@Model?.EmploymentDate' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>کد جنسیت</label>
			<input class='form-control'  data-bind='genderCode'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='GenderCode' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>شماره ملی</label>
			<input class='form-control' data-bind='nationalID'  asp-for='NationalID' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>شماره بیمه</label>
			<input class='form-control' data-bind='insuranceNo'  asp-for='InsuranceNo' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>شماره شناسنامه</label>
			<input class='form-control' data-bind='iDNumber'  asp-for='IDNumber' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>سال تجربه کاری خارج از هوایار</label>
			<input class='form-control'  data-bind='workExperienceOutOfHavayarYear'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='WorkExperienceOutOfHavayarYear' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>ماه‌های تجربه کاری خارج از هوایار</label>
			<input class='form-control'  data-bind='workExperienceOutOfHavayarMonth'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='WorkExperienceOutOfHavayarMonth' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>رشته تحصیلی</label>
			<input class='form-control' data-bind='fieldOfStudy'  asp-for='FieldOfStudy' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>مدرک تحصیلی</label>
			<input class='form-control' data-bind='degreeOfEducation'  asp-for='DegreeOfEducation' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-3">
			<label class=''>شخص</label>
			@(Html.EntitySelector<Party>(
				"PartySelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, FullName = c.FullName
				},
				c => new { c.FullName },
				"{FullName}",
				"PartyId",
				"PartyName",
				Model?.PartyId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	</div>
</div>

<div class="card">
 
	<div class='card-body row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) { return; }
		var model = page.$pageEl.dataBind();
		const $btn = $(this.element).block();
		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				page.$pageEl.dataBind(r.data);
				$btnAction.baseaction();
			})
	}

	self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
</script>

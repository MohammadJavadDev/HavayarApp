	function updateBomTable(bomData) {
		const table = $$('#bomTable').DataTable();
		
		// پیدا کردن ردیف موجود با data-item-id
		const $existingRow = $$(`#bomTable tr[data-item-id="${bomData.id}"]`);
		
		// ساخت HTML برای badge ها
		const isLatestBadge = bomData.isLatest 
			? '<span class="badge badge-success">بله</span>' 
			: '<span class="badge badge-secondary">خیر</span>';
		
		const needsAVLBadge = bomData.needsAVL 
			? '<span class="badge badge-warning">دارد</span>' 
			: '<span class="badge badge-secondary">ندارد</span>';
		
		const editBtn = `<button class="btn btn-icon btn-warning btn-sm" data-action="openBomModal"><i class="fa fa-pencil"></i></button>`;
		
		const partNameCell = `<span style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${bomData.partName || ''}">${bomData.partName || ''}</span>`;
		
		if ($existingRow.length > 0) {
			// به‌روزرسانی ردیف موجود
			const row = table.row($existingRow);
			const currentRowNumber = $existingRow.find('td:eq(1)').text(); // حفظ شماره ردیف فعلی
			
			row.data([
				editBtn,
				currentRowNumber,
				bomData.revision || '',
				bomData.partCode || '',
				partNameCell,
				bomData.amount || '',
				bomData.partUnitName || '',
				isLatestBadge,
				bomData.productionStep || '',
				bomData.numberSupplied !== null ? bomData.numberSupplied : '-',
				bomData.status || '',
				bomData.description || '',
				bomData.saleUnitDetails || '',
				needsAVLBadge
			]).draw(false);
		} else {
			// افزودن ردیف جدید
			const newRowNumber = table.rows().count() + 1;
			const newRow = table.row.add([
				editBtn,
				newRowNumber,
				bomData.revision || '',
				bomData.partCode || '',
				partNameCell,
				bomData.amount || '',
				bomData.partUnitName || '',
				isLatestBadge,
				bomData.productionStep || '',
				bomData.numberSupplied !== null ? bomData.numberSupplied : '-',
				bomData.status || '',
				bomData.description || '',
				bomData.saleUnitDetails || '',
				needsAVLBadge
			]).draw(false);
			
			$$(newRow.node()).attr('data-item-id', bomData.id);
		}
	}

	 

@using Entities.App.Sale
@using Entities.App.Sale.Enums
@using Entities.Base
@using static WebApp.Controllers.Dynamic.WorkReportController
@model WorkReport
@{
	var isFullPage = ViewData["RenderLayout"] as bool? != false;
	var filterServiceRequestId = ViewBag.ServiceRequestId as long? ?? 0;

	var ListServiceRequestDetails = ViewBag.ServiceRequestDetails as List<WorkReportServiceRequestDetailViewModel>
		?? new List<WorkReportServiceRequestDetailViewModel>();
}

<div class="card shadow-sm border-0" id="wrFormRoot">
	@if (isFullPage)
	{
		<div class="form-action-buttons border-bottom p-3">
			<form-action-buttons entity-type="typeof(WorkReport)"></form-action-buttons>
		</div>
	}
	<div class="card-body">
		<div class="row mb-4"><div class="col-12"><h4 class="fw-bold text-dark mb-0">گزارش کار ماموریت</h4></div></div>
		<input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
		<input class="form-control" data-bind="failureTypeInText" value="@Model?.FailureTypeInText" type="hidden" />
		<input class="form-control" data-bind="repairsTypeInText" value="@Model?.RepairsTypeInText" type="hidden" />
		<div class="row g-3">
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold required">ماموریت</label>
				@(Html.EntitySelector<Mission>(
					"WorkReportMissionSelector",
					 c => c.IsActive == IsActiveEnum.Active && c.ServiceRequestId == filterServiceRequestId,
								c => new { Id = c.Id, HokmNumber = c.HokmNumber, ServiceRequestId = c.ServiceRequestId, PersonelName = c.Personel.Name + " " + c.Personel.Family },
					c => new { c.HokmNumber },
					 "ش ح :{HokmNumber}  --  {PersonelName}",
					"missionId",
					"missionName",
					Model?.MissionId?.ToString(),
					true
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">گزارش مشابه</label>
				<select class="form-control" id="WorkReportSameReports"></select>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">&nbsp;</label>
				<button type="button" class="btn btn-sm btn-light-primary" data-action="loadSameReport">بارگذاری گزارش مشابه</button>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold required">شماره گزارش</label>
				<input class="form-control" data-bind="reportNumber" data-required="true" asp-for="ReportNumber" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-8 form-group-inline work-report-product-select">
				<label class="form-label fw-bold required">محصول</label>
				<select class="form-control" id="WorkReportDetailSelector" data-bind="serviceRequestDetailId" data-required="true">
					<option value="">انتخاب کنید</option>
					@foreach (var item in ListServiceRequestDetails)
					{
						<option value="@item.Id"
							data-part-name="@item.PartName"
							data-part-code="@item.PartCode"
							data-serial="@item.Serial"
							selected="@(Model?.ServiceRequestDetailId == item.Id)">
							@(item.PartName) @(item.PartCode) @(item.Serial)
						</option>
					}
				</select>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold required">تاریخ شروع سرویس</label>
				<input class="form-control" data-bind="serviceStartShamsiDate" data-required="true" data-persionDatePicker="true"
					persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
					value="@Model?.ServiceStartMiladiDate" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold required">ساعت شروع</label>
				<input class="form-control ltr" type="text" data-bind="serviceStartTime" data-time="true" data-required="true" placeholder="__:__" value="@Model?.ServiceStartTime" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold required">تاریخ پایان سرویس</label>
				<input class="form-control" data-bind="serviceEndShamsiDate" data-required="true" data-persionDatePicker="true"
					persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
					value="@Model?.ServiceEndMiladiDate" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold required">ساعت پایان</label>
				<input class="form-control ltr" type="text" data-bind="serviceEndTime" data-time="true" data-required="true" placeholder="__:__" value="@Model?.ServiceEndTime" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">شرح خرابی</label>
				@(Html.EntitySelector<AfterSalesFailureType>(
					"WorkReportFailureSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Title = c.Title, Code = c.Code },
					c => new { c.Title, c.Code },
					"{Code} {Title}",
					"failureTypeIds",
					"failureTypeInText",
					Model?.FailureTypeIds,
					false,
					true
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">کد عملیاتی</label>
				@(Html.EntitySelector<AfterSalesRepairsType>(
					"WorkReportRepairsSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Title = c.Title, Code = c.Code },
					c => new { c.Title, c.Code },
					"{Code} {Title}",
					"repairsTypeIds",
					"repairsTypeInText",
					Model?.RepairsTypeIds,
					false,
					true
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-12 form-group-inline">
				<label class="form-label fw-bold">موانع اجرایی</label>
				<textarea class="form-control" data-bind="executiveBarriersDescription" asp-for="ExecutiveBarriersDescription" rows="3"></textarea>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold required">ساعت کارکرد</label>
				<input class="form-control ltr" type="text" data-bind="totalRunTime" data-required="true" asp-for="TotalRunTime" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">ساعت کارکرد زیربار</label>
				<input class="form-control ltr" type="text" data-bind="workHoursUnderload" asp-for="WorkHoursUnderload" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">شدت جریان زیربار</label>
				<input class="form-control ltr" type="text" data-bind="flowIntensityUnderload" asp-for="FlowIntensityUnderload" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">شدت جریان بی‌بار</label>
				<input class="form-control ltr" type="text" data-bind="flowIntensityWithoutLoad" asp-for="FlowIntensityWithoutLoad" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">حداکثر فشار کاری</label>
				<input class="form-control ltr" type="text" data-bind="maximumWorkingPressure" asp-for="MaximumWorkingPressure" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">حداقل فشار کاری</label>
				<input class="form-control ltr" type="text" data-bind="minimumWorkingPressure" asp-for="MinimumWorkingPressure" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">دمای محیط</label>
				<input class="form-control ltr" type="text" data-bind="environmentTemperature" asp-for="EnvironmentTemperature" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">دمای دستگاه</label>
				<input class="form-control ltr" type="text" data-bind="deviceTemperature" asp-for="DeviceTemperature" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">ولتاژ شبکه</label>
				<input class="form-control ltr" type="text" data-bind="voltagePowerGrid" asp-for="VoltagePowerGrid" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">دیوپوینت درایر</label>
				<input class="form-control ltr" type="text" data-bind="amountDryerDewpoint" asp-for="AmountDryerDewpoint" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-2 form-group-inline">
				<label class="form-label fw-bold">وضعیت خانه کمپرسور</label>
				<input class="form-check-input mt-2" type="checkbox" data-bind="compressorHouseStatus" asp-for="CompressorHouseStatus" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-2 form-group-inline">
				<label class="form-label fw-bold">وضعیت تابلو برق</label>
				<input class="form-check-input mt-2" type="checkbox" data-bind="electricalPanelStatus" asp-for="ElectricalPanelStatus" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-2 form-group-inline">
				<label class="form-label fw-bold">وضعیت پایپینگ</label>
				<input class="form-check-input mt-2" type="checkbox" data-bind="pipingStatus" asp-for="PipingStatus" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold required">نتیجه ماموریت</label>
				<select class="form-control" data-bind="missionResult" data-required="true" asp-for="MissionResult" asp-items="Html.GetEnumSelectList(typeof(MissionResultEnum))">
					<option value="">انتخاب کنید</option>
				</select>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">ساعت کارکرد قبلی</label>
				<input class="form-control ltr" type="text" data-bind="oldRunTime" asp-for="OldRunTime" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">تاریخ گارانتی کارشناس</label>
				<input class="form-control" data-bind="expertGuaranteeShamsiDate" data-persionDatePicker="true"
					persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
					value="@Model?.ExpertGuaranteeMiladiDate" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-12 form-group-inline">
				<label class="form-label fw-bold">توضیح گارانتی کارشناس</label>
				<textarea class="form-control" data-bind="expertGuaranteeComment" asp-for="ExpertGuaranteeComment" rows="3"></textarea>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
		</div>
	</div>
</div>
<div class="card shadow-sm border-0 mt-3" id="wrAttachmentsCard">
	<div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
		<h5 class="mb-0 fw-bold"><i class="fa fa-paperclip ms-1"></i> پیوست‌ها</h5>
		<button type="button" class="btn btn-sm btn-primary" data-action="addWrAttachmentRow">
			<i class="fa fa-plus ms-1"></i> افزودن ردیف
		</button>
	</div>
	<div class="card-body">
		<div id="wrAttachmentsNeedSaveHint" class="alert alert-info mb-0 d-none">
			برای افزودن پیوست ابتدا گزارش کار را ذخیره کنید
		</div>
		<div id="wrAttachmentsTableWrap">
			<div class="table-responsive">
				<table class="table table-striped table-row-bordered gy-2 mb-0" id="wrAttachmentsTable">
					<thead>
						<tr class="fw-bold fs-6 text-muted">
							<th style="min-width:180px;">عنوان</th>
							<th>فایل</th>
							<th style="width:110px;">عملیات</th>
						</tr>
					</thead>
					<tbody></tbody>
				</table>
			</div>
			<div id="wrAttachmentsEmpty" class="alert alert-info mt-3 mb-0 d-none">
				<i class="fa fa-info-circle"></i> هیچ پیوستی ثبت نشده است
			</div>
		</div>
	</div>
</div>
<style>
	.work-report-product-select .select2-container--default .select2-selection--single {
		height: auto;
		min-height: 38px;
		padding: 4px 8px;
	}
	.work-report-product-select .select2-selection__rendered {
		white-space: normal;
		line-height: 1.4;
	}
	.work-report-product-dropdown .select2-results__option,
	.work-report-product-select .wr-product-tpl {
		white-space: normal;
		line-height: 1.6;
	}
	#wrAttachmentsCard .file-uploader-container {
		margin-bottom: 0;
		min-width: 160px;
	}
	#wrAttachmentsCard .dropzone-area {
		min-height: 58px;
		padding: 6px;
	}
	#wrAttachmentsCard .dz-message p {
		margin: 0;
		font-size: 12px;
	}
	#wrAttachmentsCard .existing-file-item {
		margin-bottom: 0;
	}
</style>
@if (isFullPage)
{
<script>
	const wrServiceRequestId = '@filterServiceRequestId';

	function formatWorkReportProduct(state) {
		if (!state.id) return state.text;
		const $el = $(state.element);
		const $wrap = $('<div class="wr-product-tpl"></div>');
		$wrap.append($('<span></span>').text('نام کالا: ' + ($el.attr('data-part-name') || '')));
		$wrap.append('<br>');
		$wrap.append($('<span></span>').text('کد کالا: ' + ($el.attr('data-part-code') || '')));
		$wrap.append('<br>');
		$wrap.append($('<span></span>').text('سریال : ' + ($el.attr('data-serial') || '')));
		return $wrap;
	}
		function formatWorkReportProductSelection(state) {
			if (!state.id) return state.text;
			const $el = $(state.element);
			const $wrap = $('<div class="wr-product-tpl"></div>');
			$wrap.append($('<span></span>').text('نام کالا: ' + ($el.attr('data-part-name') || '')));
			$wrap.append($('<span></span>').text('کد کالا: ' + ($el.attr('data-part-code') || '')));
			$wrap.append($('<span></span>').text('سریال : ' + ($el.attr('data-serial') || '')));
			return $wrap;
		}


	function initWorkReportProductSelect($root, dropdownParent) {
		const $sel = $root.find('#WorkReportDetailSelector');
		if (!$sel.length) return;
		if ($sel.hasClass('select2-hidden-accessible')) $sel.select2('destroy');
		const opts = {
			width: '100%',
			placeholder: 'انتخاب کنید',
			allowClear: true,
			dir: 'rtl',
			dropdownCssClass: 'work-report-product-dropdown',
			templateResult: formatWorkReportProduct,
				templateSelection: formatWorkReportProductSelection
		};
		if (dropdownParent && dropdownParent.length) opts.dropdownParent = dropdownParent;
		$sel.select2(opts);
	}

	function applyWorkReportSelectorFilters($root) {
		const $mission = $root.find('#WorkReportMissionSelector');
		const missionOpts = { filters: function () { return { ServiceRequestId: wrServiceRequestId || '0' }; } };
		let missionInst = $mission.data('entitySelector') || $mission.data('entitySelectorInstance');
		if (missionInst) missionInst.extraFilters = missionOpts.filters;
		else if ($mission.length && typeof $mission.entitySelector === 'function') $mission.entitySelector(missionOpts);
	}

	function loadSameReports($root) {
		if (!wrServiceRequestId || wrServiceRequestId === '0') return;
		$$.get('/Panel/Sale/WorkReport/GetSameReports?serviceRequestId=' + wrServiceRequestId, function (r) {
			const items = (r && r.data) ? r.data : (Array.isArray(r) ? r : []);
			const $sel = $root.find('#WorkReportSameReports');
			$sel.empty().append('<option value="">انتخاب کنید</option>');
			items.forEach(function (it) {
				$sel.append($('<option></option>').val(it.id).text(it.text));
			});
		});
	}

	function initWorkReportAttachments($root) {
		const $card = $root.find('#wrAttachmentsCard');
		if (!$card.length || $card.data('wr-att-inited')) return;
		$card.data('wr-att-inited', true);

		function getWrId() {
			return $root.find('#wrFormRoot [data-bind="id"]').val();
		}
		function hasWrId() {
			const id = getWrId();
			return id && id !== '0';
		}
		function escapeHtml(text) {
			if (text === null || text === undefined) return '-';
			return String(text)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;');
		}
		function loadAttachments() {
			const id = getWrId();
			if (!id || id === '0') return;
			$$.get('/Panel/Sale/WorkReportAttachment/GetListByParentId?workReportId=' + id, function (r) {
				if (r && r.isSuccess === false) {
					toastr.error(r.message || 'خطا در دریافت پیوست‌ها');
					return;
				}
				renderAttachments((r && r.data) ? r.data : (Array.isArray(r) ? r : []));
			});
		}
		function renderAttachments(items) {
			const $tbody = $card.find('#wrAttachmentsTable tbody');
			$tbody.find('tr[data-saved="1"]').remove();
			(items || []).forEach(function (row) {
				const title = escapeHtml(row.title);
				let fileHtml = '-';
				if (row.fileId) {
					fileHtml = '<a href="/File/download/' + row.fileId + '" target="_blank">' + escapeHtml(row.fileName || 'دانلود فایل') + '</a>';
				} else if (row.fileName) {
					fileHtml = escapeHtml(row.fileName);
				}
				const actions = '<button type="button" class="btn btn-sm btn-icon btn-light-danger" data-action="deleteWrAttachment" data-id="' + row.id + '" title="حذف"><i class="fa fa-trash"></i></button>';
				$tbody.prepend('<tr data-saved="1"><td>' + title + '</td><td>' + fileHtml + '</td><td class="text-center">' + actions + '</td></tr>');
			});
			syncEmpty();
		}
		function syncEmpty() {
			const hasRows = $card.find('#wrAttachmentsTable tbody tr').length > 0;
			$card.find('#wrAttachmentsEmpty').toggleClass('d-none', hasRows);
		}
		function syncSection() {
			const ready = hasWrId();
			$card.find('#wrAttachmentsNeedSaveHint').toggleClass('d-none', ready);
			$card.find('#wrAttachmentsTableWrap').toggleClass('d-none', !ready);
			$card.find('[data-action="addWrAttachmentRow"]').prop('disabled', !ready);
			if (ready) loadAttachments();
			else syncEmpty();
		}
		function addDraftRow() {
			if (!hasWrId()) {
				toastr.error('ابتدا گزارش کار را ذخیره کنید');
				return;
			}
			const uid = 'wrAttFile_' + Date.now();
			const $tr = $('<tr data-draft="1"></tr>');
			$tr.append('<td><input type="text" class="form-control form-control-sm" data-wr-att-title placeholder="عنوان پیوست" /></td>');
			$tr.append(
				'<td><div class="file-uploader-container file-uploader-table">'
				+ '<div class="file-uploader-wrapper"><div class="dropzone-area" data-file-uploader="true"'
				+ ' data-bindid="' + uid + '" data-file-id="" data-multiple="false" data-max-files="1"'
				+ ' data-max-file-size="20" data-accepted-file-types=".pdf,.zip,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx"'
				+ ' data-entity-type="Entities.App.Sale.WorkReportAttachment" data-entity-id=""'
				+ ' data-show-preview="true" data-show-download="true" data-show-delete="true"'
				+ ' data-entity-prop-name="FileId" data-required="true">'
				+ '<div class="dz-message"><p>فایل را اینجا رها کنید یا کلیک کنید</p></div>'
				+ '</div></div><input type="hidden" data-bind="' + uid + '" value="" /></div></td>'
			);
			$tr.append(
				'<td class="text-center text-nowrap">'
				+ '<button type="button" class="btn btn-sm btn-icon btn-light-success" data-action="saveWrAttachmentRow" title="ذخیره"><i class="fa fa-check"></i></button> '
				+ '<button type="button" class="btn btn-sm btn-icon btn-light-secondary" data-action="cancelWrAttachmentRow" title="حذف ردیف"><i class="fa fa-times"></i></button>'
				+ '</td>'
			);
			$card.find('#wrAttachmentsTable tbody').append($tr);
			$card.find('#wrAttachmentsEmpty').addClass('d-none');
			if (typeof initFileUploaders === 'function') initFileUploaders($tr);
		}
		function saveDraftRow($tr) {
			const title = ($tr.find('[data-wr-att-title]').val() || '').trim();
			const fileId = $tr.find('input[type="hidden"]').val();
			if (!title) { toastr.error('عنوان پیوست را وارد کنید'); return; }
			if (!fileId) { toastr.error('فایل را آپلود کنید'); return; }
			const $btn = $tr.find('[data-action="saveWrAttachmentRow"]').block();
			$$.post('/Panel/Sale/WorkReportAttachment/save', {
				workReportId: getWrId(),
				title: title,
				fileId: fileId
			}, function (resp) {
				$btn.block(false);
				if (!resp.isSuccess) { toastr.error(resp.message || 'خطا در ذخیره پیوست', 'خطا'); return; }
				toastr.success('پیوست ذخیره شد');
				$tr.remove();
				loadAttachments();
			});
		}

		$card.on('click', '[data-action="addWrAttachmentRow"]', function () { addDraftRow(); });
		$card.on('click', '[data-action="saveWrAttachmentRow"]', function () { saveDraftRow($(this).closest('tr')); });
		$card.on('click', '[data-action="cancelWrAttachmentRow"]', function () {
			$(this).closest('tr').remove();
			syncEmpty();
		});
		$card.on('click', '[data-action="deleteWrAttachment"]', function () {
			const id = $(this).data('id');
			Swal.fire({
				title: 'حذف پیوست',
				text: 'آیا از حذف این پیوست مطمئن هستید؟',
				icon: 'warning',
				showCancelButton: true,
				confirmButtonText: 'بله',
				cancelButtonText: 'خیر'
			}).then(function (result) {
				if (!result.isConfirmed) return;
				$$.get('/Panel/Sale/WorkReportAttachment/Delete?id=' + id, function (r) {
					if (r && r.isSuccess === false) { toastr.error(r.message || 'خطا در حذف'); return; }
					toastr.success('پیوست حذف شد');
					loadAttachments();
				});
			});
		});

		$card.data('wr-att-sync', syncSection);
		syncSection();
	}

	applyWorkReportSelectorFilters(page.$pageEl);
	initWorkReportProductSelect(page.$pageEl);
	loadSameReports(page.$pageEl);
	initWorkReportAttachments(page.$pageEl);

	page.$pageEl.on('click', '[data-action="loadSameReport"]', function () {
		const sameId = $$('#WorkReportSameReports').val();
		if (!sameId) { toastr.error('گزارش مشابه را انتخاب کنید'); return; }
		$$.get('/Panel/Sale/WorkReport/GetSameReportInfo?id=' + sameId, function (r) {
			if (!r || r.isSuccess === false) { toastr.error((r && r.message) || 'بارگذاری انجام نشد'); return; }
			$$('#wrFormRoot').dataBind(r.data || r);
		});
	});

	function savefn($btnAction) {
		if (validateError($$('#wrFormRoot'))) return;
		const model = $$('#wrFormRoot').dataBind();
		const $btn = $($btnAction.element).block();
		$$.post('save', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			$$('#wrFormRoot').dataBind(r.data);
			const sync = $$('#wrAttachmentsCard').data('wr-att-sync');
			if (typeof sync === 'function') sync();
			$btnAction.baseaction();
		});
	}
	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>
}

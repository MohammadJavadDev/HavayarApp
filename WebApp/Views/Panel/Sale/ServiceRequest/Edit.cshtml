            <div class='col-md-12'>
                <label class='form-label fw-bold'>علت اعزام کارشناس</label>
                <textarea class='form-control' data-bind='reasonSendingExpert' asp-for="ReasonSendingExpert" rows="4"></textarea>
                <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
            </div>

        </div>

        <div class="card border mt-5">
            <div class="card-body">

                <div class="row g-3 align-items-end mb-4">

                    <div class="col-md-4">
                        <label class="form-label fw-bold">مسئول منطقه</label>
                        @(Html.EntitySelector<Personel>(
                            "ResponsibleZoneSelector",
                            c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                            c => new
                            {

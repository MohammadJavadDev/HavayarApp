@using Entities.App.Rpr
@model RepairRequestComment

<div class="card">

    <div class="card-body row">

        <input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />

        <div class='col-md-3'>
            <label class=''>
                تاریخ شروع
            </label>
            <input class='form-control' data-bind='startShamsiDate' data-persionDatePicker="true"
                   persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                   value='@Model?.CreatedOnShamsiDateTime' />
        </div>

        <div class="col-md-12">
            <label>توضیحات</label>
            <textarea class="form-control" asp-for="Comment" rows="5"></textarea>
        </div>
    </div>
</div>


<script>

    self.FormActionButtons.addConsumableItems.onclick(function () {
           const url = '/Panel/Rpr/RepairRequest/RepairRequestPartItems';
           $$.get(url, function(result) {
               let bodyCn = `<div style="overflow-x: hidden; overflow-y: auto; max-height: 70vh;">${result}</div>`;
               $.confirm({
                   title: 'اقلام مصرفی ',
                   columnClass: 'col-md-10',
                   content: bodyCn,
                   rtl: true,
                   buttons: {
                       save: {
                           text: 'ذخیره',
                           btnClass: 'btn-success',
                           action: function() {
                               const $content = this.$content;

                               if (validateError($content)) {
                                   return false;
                               }
                               const self = this;
                               return false;
                           }
                       },
                       cancel: {
                           text: 'انصراف',
                           btnClass: 'btn-secondary'
                       }
                   },
                   onContentReady: function () {
                       var self = this;
                       setTimeout(function () {
                           self.$body.find('select.select2-hidden-accessible').each(function() {
                               const $select = $$(this);
                               const currentData = $select.select2('data');
                               $select.select2('destroy');
                               $select.select2({
                                   dropdownParent: self.$body,
                                   width: '100%',
                                   placeholder: $select.attr('placeholder') || 'انتخاب کنید'
                               });
                               if (currentData && currentData.length > 0) {
                                   $select.val($select.val()).trigger('change');
                               }
                           });
                       }, 100);
                   }
               });
           });
       });

       self.FormActionButtons.addComment.onclick(function () {
           const url = '/Panel/Rpr/RepairRequest/RepairRequestComment';
           $$.get(url, function(result) {
               let bodyCn = `<div style="overflow-x: hidden; overflow-y: auto; max-height: 70vh;">${result}</div>`;
               $.confirm({
                   title: 'لیست کامنت',
                   columnClass: 'col-md-10',
                   content: bodyCn,
                   rtl: true,
                   buttons: {
                       save: {
                           text: 'ذخیره',
                           btnClass: 'btn-success',
                           action: function() {
                               const $content = this.$content;

                               if (validateError($content)) {
                                   return false;
                               }

                               // const model = $content.dataBind();
                               const self = this;

                               // $$.post('/Panel/Sup/OpenOrderRequest/DoLinkVpis', model, function(r) {
                               //     if (!r.isSuccess) {
                               //         toastr.error(`${r.message}`, 'خطا');
                               //         return false;
                               //     }

                               //     toastr.success('لینک با موفقیت ثبت شد');
                               //     self.close();
                               //     page.close()
                               // });

                               return false;
                           }
                       },
                       cancel: {
                           text: 'انصراف',
                           btnClass: 'btn-secondary'
                       }
                   },
                   onContentReady: function () {
                       var self = this;
                       setTimeout(function () {
                           self.$body.find('select.select2-hidden-accessible').each(function() {
                               const $select = $$(this);
                               const currentData = $select.select2('data');
                               $select.select2('destroy');
                               $select.select2({
                                   dropdownParent: self.$body,
                                   width: '100%',
                                   placeholder: $select.attr('placeholder') || 'انتخاب کنید'
                               });
                               if (currentData && currentData.length > 0) {
                                   $select.val($select.val()).trigger('change');
                               }
                           });
                       }, 100);
                   }
               });
           });
       });


    $(document).ready(function() {


        $('form-action-button[action-name="addRepairModal"]').on('click', function(e) {
            e.preventDefault();
            $('#addRepairModal').modal('show');
        });


        $('form-action-button[action-name="confirmationModal"]').on('click', function(e) {
            e.preventDefault();
            $('#confirmationModal').modal('show');
        });

        $('#btnConfirm').on('click', function() {
            $('#addRepairModal').modal('show');
        });

        $('#btnConfirm3').on('click', function() {
            $('#confirmationModal').modal('show');
        });
    });

    function savefn($btnAction) {
        if (validateError($$('.card'))) { return; }
        var model = $$('.card').dataBind();
        const $btn = $(this.element).block();
        $$.post('save',
            model,
            function (r) {
                $btn.block(false);
                if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
                toastr.success('ذخیره سازی با موفقیت انجام شد .');
                $$('.card').dataBind(r.data);
                $btnAction.baseaction();
            })
    }

    self.FormActionButtons.save.onclick(function () { savefn(this) })
    self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
    self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
</script>
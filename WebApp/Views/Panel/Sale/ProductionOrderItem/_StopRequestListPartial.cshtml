@using Entities.App.Prd
@model List<StopRequst>

<div class="row">
	<div class="col-md-12">
		@if (Model != null && Model.Any())
		{
			<div class="table-responsive">
				<table class="table table-striped table-hover">
					<thead>
						<tr>
							<th>ردیف</th>
							<th>تاریخ شروع توقف</th>
							<th>محل مشاهده</th>
							<th>وضعیت تولید</th>
							<th>ساعت کارکرد</th>
							<th>علت توقف</th>
							<th>واحد های مسئول</th>
							<th>مسئولین</th>
							<th>ذینفعان</th>
							<th>ثبت کننده</th>
							<th>تاریخ ثبت</th>
						</tr>
					</thead>
					<tbody>
						@{
							int counter = 1;
						}
						@foreach (var stop in Model.OrderByDescending(s => s.StopStartMiladiDateTime))
						{
							<tr>
								<td>@counter</td>
								<td>@stop.StopStartShamsiDateTime</td>
								<td>@stop.ObservationLocation</td>
								<td>
									<span class="badge badge-warning">@stop.ProductionStatus</span>
								</td>
								<td>@(stop.OperatingHours?.ToString() ?? "-")</td>
								<td>
									@if (!string.IsNullOrWhiteSpace(stop.StopReasonTitles))
									{
										<span class="badge badge-danger">@stop.StopReasonTitles</span>
									}
									else
									{
										<span>-</span>
									}
								</td>
								<td>
									@if (!string.IsNullOrWhiteSpace(stop.ResponsibleUnitTitles))
									{
										<small>@stop.ResponsibleUnitTitles</small>
									}
									else
									{
										<span>-</span>
									}
								</td>
								<td>
									@if (!string.IsNullOrWhiteSpace(stop.ResponsibleUserNames))
									{
										<small>@stop.ResponsibleUserNames</small>
									}
									else
									{
										<span>-</span>
									}
								</td>
								<td>
									@if (!string.IsNullOrWhiteSpace(stop.BeneficiarieUserNames))
									{
										<small>@stop.BeneficiarieUserNames</small>
									}
									else
									{
										<span>-</span>
									}
								</td>
								<td>@stop.CreatedByName</td>
								<td>@stop.CreatedOnShamsiDateTime</td>
							</tr>
							counter++;
						}
					</tbody>
				</table>
			</div>
		}
		else
		{
			<div class="alert alert-info">
				<i class="fa fa-info-circle"></i> هیچ درخواست توقفی ثبت نشده است
			</div>
		}
	</div>
</div>

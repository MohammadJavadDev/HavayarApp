@using Entities.App.Cng
@using Entities.App.SLS
@using Entities.Base
@model WorkReportConsumedPart
@{
	Layout = null;
	string presetCustomerId = null;
	object rawCustomerId = ViewBag.CustomerId;
	if (rawCustomerId != null)
	{
		var text = Convert.ToString(rawCustomerId, System.Globalization.CultureInfo.InvariantCulture);
		if (!string.IsNullOrWhiteSpace(text) && text != "0")
			presetCustomerId = text;
	}
}

<input type="hidden" data-bind="id" value="@Model?.Id" />
<input type="hidden" data-bind="htsId" value="@Model?.HtsId" />

<div class="row g-3">
	<div class="col-md-12 form-group-inline">
		<label class="form-label fw-bold required">مشتری</label>
		@(Html.EntitySelector<Customer>(
			"CngWorkReportConsumedCustomerSelector",
			c => c.IsActive == IsActiveEnum.Active,
			c => new { Id = c.Id, Party_FullName = c.Party.FullName, Code = c.Code },
			c => new { c.Party.FullName, c.Code },
			"{Code} {Party.FullName}",
			"consumedCustomerId",
			"consumedCustomerTitle",
			presetCustomerId,
			true
		))
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-6 form-group-inline">
		<label class="form-label fw-bold">شماره فرم حواله</label>
		<input type="text" class="form-control mb-2" data-role="saleOrderFilter" placeholder="جستجوی شماره یا تاریخ حواله" autocomplete="off" />
		<select class="form-select" data-bind="saleOrderId" size="8">
			<option value="">انتخاب کنید</option>
		</select>
	</div>
	<div class="col-md-6 form-group-inline">
		<label class="form-label fw-bold required">کالا</label>
		<select class="form-select" data-bind="partId" data-required="true">
			<option value="">انتخاب کنید</option>
		</select>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-4 form-group-inline">
		<label class="form-label fw-bold required">مقدار</label>
		<input class="form-control ltr" type="number" step="any" data-bind="mount" data-required="true" value="@Model?.Mount" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-4 form-group-inline">
		<label class="form-label fw-bold">وضعیت داغی</label>
		<input class="form-control" data-bind="hotnessCondition" value="@Model?.HotnessCondition" />
	</div>
	<div class="col-md-12 form-group-inline">
		<label class="form-label fw-bold">توضیح</label>
		<textarea class="form-control" data-bind="comment" rows="2">@Model?.Comment</textarea>
	</div>
</div>

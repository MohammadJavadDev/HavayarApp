@using Common.Utilities
@using Data.SystemAuth
@using Entities.App.Inv;
@using Entities.App.Sale;
@using Entities.App.Sale.Enums;
@using WebApp.Controllers.Dynamic
@inject ISdk sdk
@model ProductionOrderItem
@{

	var newMode = Model.Id == null;

	var listProductionOrderItemBomProductionStepEnum = EnumExtensions.GetEnumValuesWithDisplayNames<ProductionOrderItemBomProductionStepEnum>();
	var listProductionOrderItemStatusEnum = EnumExtensions.GetEnumValuesWithDisplayNames<ProductionOrderItemStatusEnum>();

	var isAdmin = sdk.IsAdministrator;

	// فاز ۶ - رابط کاربری: رشته مهندسی (مکانیک/برق) این قلم توسط ProductionOrderItemController.Edit محاسبه و
	// از طریق ViewBag تامین می‌شود تا منطق تشخیص DeviceType در دو جا (سرور/کلاینت) تکرار نشود
	var isElectricalDiscipline = ViewBag.IsElectricalDiscipline as bool? ?? false;

	//Seed Role => Sale.ProductionOrderItem.AcceptEngineeringMechanical => سفارش ساخت - تایید مهندسی مکانیک
	//Seed Role => Sale.ProductionOrderItem.AcceptEngineeringElectrical => سفارش ساخت - تایید مهندسی برق
	// TODO(Role): Role های بالا را در پنل مدیریت نقش‌ها ایجاد و کاربران واحد مهندسی مکانیک/برق را متناظر انتساب بده
	var canAcceptEngineering = isAdmin || (isElectricalDiscipline
		? sdk.HasRole("Sale.ProductionOrderItem.AcceptEngineeringElectrical")
		: sdk.HasRole("Sale.ProductionOrderItem.AcceptEngineeringMechanical"));

	//Seed Role => Sale.ProductionOrderItem.AcceptIndustrial => سفارش ساخت - تایید صنایع
	// TODO(Role): Role را در پنل مدیریت نقش‌ها ایجاد و کاربران واحد صنایع را به آن انتساب بده
	var canAcceptIndustrial = isAdmin || sdk.HasRole("Sale.ProductionOrderItem.AcceptIndustrial");

	//Seed Role => Sale.ProductionOrderItem.AcceptProjectManager => سفارش ساخت - تایید مدیر پروژه
	// TODO(Role): Role را در پنل مدیریت نقش‌ها ایجاد و مدیران پروژه را به آن انتساب بده
	var canAcceptProjectManager = isAdmin || sdk.HasRole("Sale.ProductionOrderItem.AcceptProjectManager");

	//Seed Role => Sale.ProductionOrderItem.Inquirer => سفارش ساخت - استعلام
	// TODO(Role): Role را در پنل مدیریت نقش‌ها ایجاد و کاربران مسئول استعلام را به آن انتساب بده
	var canInquiry = isAdmin || sdk.HasRole("Sale.ProductionOrderItem.Inquirer");

	//Seed Role => Sale.ProductionOrderItem.MinistryOfIndustryInquirer => سفارش ساخت - استعلام وزارت صنایع
	// TODO(Role): Role را در پنل مدیریت نقش‌ها ایجاد و کاربران مسئول بررسی وزارت صنایع را به آن انتساب بده
	var canMinistryReview = isAdmin || sdk.HasRole("Sale.ProductionOrderItem.MinistryOfIndustryInquirer");

	//Seed Role => Sale.ProductionOrderItem.SupplyCommitteeBoss => سفارش ساخت - رئیس کمیته تامین
	// TODO(Role): Role را در پنل مدیریت نقش‌ها ایجاد و رئیس کمیته تامین را به آن انتساب بده
	var canSupplyCommitteeBoss = isAdmin || sdk.HasRole("Sale.ProductionOrderItem.SupplyCommitteeBoss");

	// مطابق دقیق منطق ProductionOrderItemController.SendToSupplyCommittee: هر یک از سه نقش زیر کافی است
	var canSendToSupplyCommittee = canInquiry || canMinistryReview || canSupplyCommitteeBoss;
}

<div class="card">
	<div class="form-action-buttons">
		<form-action-buttons entity-type="typeof(ProductionOrderItem)">
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-exchange"
				action-name="addComment" title="تغییر وضعیت"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-info" icon-class="fa fa-list"
							action-name="viewComments" title="تاریخچه تغییر وضعیت"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-danger" icon-class="fa fa-stop-circle"
				action-name="addStopRequest" title="ثبت توقف"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-warning" icon-class="fa fa-clock"
				action-name="viewStopRequests" title="لیست توقفات"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-file-xls"
							action-name="exportBomExcell" title="خروجی اکسل Bom"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-user-cog"
				action-name="acceptEngineering" title="تایید/رد مهندسی"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-industry"
				action-name="acceptIndustrial" title="تایید صنایع"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-user-tie"
				action-name="acceptProjectManager" title="تایید/رد مدیر پروژه"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-info" icon-class="fa fa-question-circle"
				action-name="sendToInquiry" title="ارسال به استعلام"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-info" icon-class="fa fa-landmark"
				action-name="sendToMinistryReview" title="ارسال به صنایع"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-warning" icon-class="fa fa-users"
				action-name="sendToSupplyCommittee" title="ارسال به کمیته تامین"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-check-double"
				action-name="committeeAccept" title="تایید کمیته تامین"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-danger" icon-class="fa fa-times-circle"
				action-name="committeeReject" title="رد کمیته تامین"></form-action-button>
		</form-action-buttons>
	</div>

</div>

 
<div class="row my-3">
	<div class="col-md-12">
		<div class="card ">
			<div class="card-body row">

				<div class="col-md-2">
					<label class=''>سفارش ساخت</label>

					@if (newMode)
					{
						@(Html.EntitySelector<ProductionOrder>(
											"ProductionOrderSelector",
											c => c.IsActive == Entities.Base.IsActiveEnum.Active,
											c => new
											{
												Id = c.Id,
												ProductionOrderNumber = (int)c.ProductionOrderNumber,
												NumberSerach = c.ProductionOrderNumber
											},
											c => new { c.ProductionOrderNumber },
											"{ProductionOrderNumber}",
											"ProductionOrderId",
											"ProductionOrderName",
											Model?.ProductionOrderId.ToString(),
											true
											))
					}
					else
					{
						@(Html.EntitySelector<ProductionOrder>(
											"ProductionOrderSelector",
											c => c.IsActive == Entities.Base.IsActiveEnum.Active,
											c => new
											{
												Id = c.Id,
												Number = (int)c.ProductionOrderNumber
											},
											c => new { c.ProductionOrderNumber },
											"{Number}",
											"ProductionOrderId",
											"ProductionOrderName",
											Model?.ProductionOrderId.ToString(),
											false,
											false,
											false,
											true

											))
					}

				

					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				

				<div class="col-md-4">
					<label class=''>کالا</label>

					@if (newMode)
					{
								@(Html.EntitySelector<Part>(
										"PartSelector",
										c => c.IsActive == Entities.Base.IsActiveEnum.Active,
										c => new
										{
											Id = c.Id,
											Name = c.Name,
											Code = c.Code
										},
										c => new { c.Name, c.Code },
										"{Name} {Code}",
										"PartId",
										"PartName",
										Model?.PartId?.ToString(),
										true
										))
					
					}
					else
					{
								@(Html.EntitySelector<Part>(
										"PartSelector",
										c => c.IsActive == Entities.Base.IsActiveEnum.Active,
										c => new
										{
											Id = c.Id,
											Name = c.Name,
											Code = c.Code
										},
										c => new { c.Name, c.Code },
										"{Name} {Code}",
										"PartId",
										"PartName",
										Model?.PartId?.ToString(),
										false,
										false,
										false,
										true
										))
					}
			

					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>
				
				@if (newMode)
				{
					<div class='col-md-3'>
						<label class=''>نوع دستگاه</label>
						<select class='form-control' data-bind='deviceType' asp-for='DeviceType'
							   asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.ProductionOrderItemDeviceTypeEnum))">
						</select>
						<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
					</div>

				
				}
				else
				{
						<div class='col-md-2'>
					<div class="mb-3">
						<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">نوع دستگاه</label>
						<span class='fw-semibold fs-6' data-bind='deviceType'>@(Model?.DeviceType?.ToString() ?? "-")</span>
					</div>
				</div>
				}

				@if (newMode)
				{
				
			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">تعداد / مقدار</label>
						<input class='form-control' data-bind='amount' data-invalidMessage='فقط عداد'
						data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''"
						asp-for='Amount' />
				</div>
			</div>
			}else {
				<div class='col-md-2'>
					<div class="mb-3">
						<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">تعداد / مقدار</label>
						<span class='fw-semibold fs-6' data-bind='amount'>@(Model?.Amount?.ToString() ?? "-")</span>
					</div>
				</div>

				}


				<div class='col-md-2'>
					<div class="d-flex align-items-center py-2">
						<span class='text-muted me-2'>ساخت داخل:</span>
						@if (Model?.IsBuildInside == true)
						{
							<span class="badge badge-success">بله</span>
						}
						else
						{
							<span class="badge badge-secondary">خیر</span>
						}
					</div>
				</div>

			

				<div class='col-md-2'>
					<div class="mb-3">
						<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">نوع تجهیز</label>
						<span class='fw-semibold fs-6' data-bind='equipmentType'>@(Model?.EquipmentType?.ToString() ?? "-")</span>
					</div>
				</div>
			 


			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">تاریخ تحویل توافقی</label>
					<span class='fw-semibold fs-6' data-bind='agreedDeliverDate'>@(Model?.AgreedDeliverDate?.ToString("yyyy/MM/dd") ?? "-")</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">نسخه</label>
					<span class='fw-semibold fs-6' data-bind='revision'>@(Model?.Revision?.ToString() ?? "-")</span>
				</div>
			</div>

				<div class='col-md-2'>
					<div class="d-flex align-items-center py-2">
						<span class='text-muted me-2'>آخرین نسخه:</span>
						@if (Model?.IsLatestVersion == true)
						{
							<span class="badge badge-success">بله</span>
						}
						else
						{
							<span class="badge badge-secondary">خیر</span>
						}
					</div>
				</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">وضعیت بررسی (کارتابل)</label>
					<span class='badge badge-light-primary fs-6 px-3 py-2' data-bind='checkStatus'>@(Model?.CheckStatus?.ToDisplay() ?? "-")</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">مرحله ساخت (فعلی)</label>
					<span class='badge badge-light-info fs-6 px-3 py-2'>@(Model?.ProductionStep.ToDisplay() ?? "-")</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">ورژن</label>
					<span class='fw-semibold fs-6' data-bind='version'>@(string.IsNullOrWhiteSpace(Model?.Version) ? "-" : Model?.Version)</span>
				</div>
			</div>


			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">مدل</label>
					<span class='fw-semibold fs-6' data-bind='partModel'>@(string.IsNullOrWhiteSpace(Model?.PartModel) ? "-" : Model?.PartModel)</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">ایرند / طبقه</label>
					<span class='fw-semibold fs-6' data-bind='airendOrCategory'>@(string.IsNullOrWhiteSpace(Model?.AirendOrCategory) ? "-" : Model?.AirendOrCategory)</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">فشار ورودی</label>
					<span class='fw-semibold fs-6' data-bind='inputPressureBar'>@(Model?.InputPressureBar?.ToString() ?? "-")</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">فشار خروجی</label>
					<span class='fw-semibold fs-6' data-bind='outputPressureBar'>@(Model?.OutputPressureBar?.ToString() ?? "-")</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">ظرفیت</label>
					<span class='fw-semibold fs-6' data-bind='capacity'>@(string.IsNullOrWhiteSpace(Model?.Capacity) ? "-" : Model?.Capacity)</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">مقیاس</label>
					<span class='fw-semibold fs-6' data-bind='scale'>@(string.IsNullOrWhiteSpace(Model?.Scale) ? "-" : Model?.Scale)</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">نوع گاز</label>
					<span class='fw-semibold fs-6' data-bind='gasType'>@(string.IsNullOrWhiteSpace(Model?.GasType) ? "-" : Model?.GasType)</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">دمای بیشینه</label>
					<span class='fw-semibold fs-6' data-bind='maximumTemperature'>@(Model?.MaximumTemperature?.ToString() ?? "-")</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">درصد خلوص</label>
					<span class='fw-semibold fs-6' data-bind='purityPercentage'>@(Model?.PurityPercentage?.ToString() ?? "-")</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">رطوبت نسبی</label>
					<span class='fw-semibold fs-6' data-bind='relativeHumidity'>@(Model?.RelativeHumidity?.ToString() ?? "-")</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">فشار بارومتریک</label>
					<span class='fw-semibold fs-6' data-bind='barometricPressure'>@(Model?.BarometricPressure?.ToString() ?? "-")</span>
				</div>
			</div>

			<div class='col-md-2'>
				<div class="mb-3">
					<label class='text-muted d-block mb-1' style="font-size: 0.9rem;">نوع محرک</label>
					<span class='fw-semibold fs-6' data-bind='movingType'>@(string.IsNullOrWhiteSpace(Model?.MovingType) ? "-" : Model?.MovingType)</span>
				</div>
			</div>

				<div class='col-md-2'>
					<div class="d-flex align-items-center py-2">
						<span class='text-muted me-2'>بازرسی حین ساخت:</span>
						@if (Model?.HasInspection == true)
						{
							<span class="badge badge-success">دارد</span>
						}
						else
						{
							<span class="badge badge-secondary">ندارد</span>
						}
					</div>
				</div>


			</div>
		</div>


	</div>

	<div class="col-md-12  " id="changeDataSection">
		<div class="card h-100">
			<div class="card-body row">
				<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
				<div class='col-md-3'>
					<label class=''>مرحله ساخت</label>
					<select class='form-control' data-bind='productionStep' asp-for='ProductionStep'
						asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.ProductionOrderItemProductionStepEnum))">
					</select>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-3'>
					<label class=''>شماره برنامه ریزی</label>
					<input class='form-control' data-bind='planningNumber' data-invalidMessage='فقط عداد'
						data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''"
						asp-for='PlanningNumber' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-3'>
					<label class=''>سریال</label>
					<input class='form-control' data-bind='serial' asp-for='Serial' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>





				<div class='col-md-3'>
					<label class=''>تاریخ شروع تولید</label>
					<input class='form-control' data-bind='productionStartShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.ProductionStartMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>



				<div class='col-md-3'>
					<label class=''>تاریخ شمسی پایان تولید</label>
					<input class='form-control' data-bind='productionEndShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.ProductionEndMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>



				<div class='col-md-3'>
					<label class=''>تاریخ پایان تست</label>
					<input class='form-control' data-bind='testingEndShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.TestingEndMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>



				<div class='col-md-3'>
					<label class=''>تاریخ آماده سازی</label>
					<input class='form-control' data-bind='preparationShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.PreparationMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>



				<div class='col-md-3'>
					<label class=''>تاریخ تحویل</label>
					<input class='form-control' data-bind='deliveryShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.DeliveryMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-3'>
					<label class=''>تاریخ اخذ</label>
					<input class='form-control' data-bind='sendToIndustrialShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.SendToIndustrialMiladiDate' readonly disabled />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-3'>
					<label class=''>تاریخ اولین تغییر صنایع</label>
					<input class='form-control' data-bind='firstIndustrialChangeShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.FirstIndustrialChangeMiladiDate' readonly disabled />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-3'>
					<label class=''>تاریخ آماده‌سازی مدارک</label>
					<input class='form-control' data-bind='documentPreparationShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.DocumentPreparationMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-3'>
					<label class=''>تاریخ تحویل استاندارد</label>
					<input class='form-control' data-bind='standardDeliveryShamsiDate' data-persionDatePicker="true"
						persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
						value='@Model?.StandardDeliveryMiladiDate' />
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-3'>
					<label class=''>وضعیت</label>
					<select class='form-control' data-bind='status' asp-for='Status'
						asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.ProductionOrderItemStatusEnum))">
					</select>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-3'>
					<label class=''>وضعیت تولید</label>
					<select class='form-control' data-bind='productionStatus' asp-for='ProductionStatus'
						asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.ProductionOrderItemProductionStatusEnum))">
					</select>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-3'>
					<label class=''>نوع سریال</label>
					<select class='form-control' data-bind='serialType' asp-for='SerialType'
						   asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.ProductionOrderItemSerialTypeEnum))">
					</select>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-3'>
					<label class=''>روتین</label>
					<div class="form-check form-switch mt-2">
						<input class="form-check-input" type="checkbox" data-bind='isRoutine' asp-for='IsRoutine' />
					</div>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-8'>
					<label class=''>ملاحظات</label>
					<textarea class='form-control' data-bind='salesConsideration'
						asp-for='SalesConsideration'>@Model?.SalesConsideration</textarea>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-8'>
					<label class=''>ملاحظات مهندسی</label>
					<textarea class='form-control' data-bind='engineeringConsideration'
						asp-for='EngineeringConsideration'>@Model?.EngineeringConsideration</textarea>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

				<div class='col-md-8'>
					<label class=''>ملاحظات صنایع</label>
					<textarea class='form-control' data-bind='planningConsideration'
						asp-for='PlanningConsideration'>@Model?.PlanningConsideration</textarea>
					<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
				</div>

			</div>
		</div>
	</div>
</div>

<div class="card  card-body my-3">
	<div class='col-md-12 '>
		<div class="table-responsive">


		<div class="d-flex justify-content-between align-items-center mb-3">
			<h4 class="mb-0">لیست BOM</h4>
			<button type="button" class="btn btn-primary btn-sm" data-action="addNewBom">
				<i class="fa fa-plus"></i> افزودن BOM
			</button>
		</div>
		<table id="bomTable" class="table table-striped table-bordered" >
			<thead>
				<tr>
					<th class="min-w-50px">#</th>
					<th class="min-w-50px">ردیف</th>
					<th class="min-w-50px">نسخه</th>
					<th class="min-w-100px">کد کالا</th>
					<th class="min-w-500px">نام کالا</th>
					<th class="min-w-150px">تعداد/مقدار</th>
					<th class="min-w-150px">واحد</th>
					<th class="min-w-150px">آخرین نسخه</th>
					<th class="min-w-150px">مرحله ساخت</th>
					<th class="min-w-150px">تعداد تامین شده</th>
					<th class="min-w-150px">وضعیت</th>
					<th class="min-w-150px">توضیحات</th>
					<th class="min-w-300px">توضیحات واحد فروش</th>
					<th class="min-w-150px">نیاز به AVL</th>
					<th class="min-w-150px">زمان ایجاد</th>
					<th class="min-w-150px">ایجاد کننده</th>
					<th class="min-w-150px">زمان ویرایش</th>
					<th class="min-w-150px">ویرایش کننده</th>
				</tr>
			</thead>
			<tbody>
				@if (ViewBag.ProductionOrderItemBomViewData != null)
				{
					int counter = 1;
					@foreach (var item in (List<ProductionOrderItemBomViewModel>)ViewBag.ProductionOrderItemBomViewData)
						{

						 var ProductionStepStr = item?.ProductionStep == null || item?.ProductionStep == 0 ? "" : item?.ProductionStep.ToString();
							var StatusStr = item?.Status == null || item?.Status == 0 ? "" : item?.Status.ToString();

						<tr data-item-id="@(item.Id ?? 0)">
							<td>
								<button class="btn btn-icon btn-warning btn-sm" data-action="openBomModal">
									<i class="fa fa-pencil"></i>
								</button>
							</td>
							<td>@counter</td>
							<td>@item?.Revision</td>
							<td>@item?.PartCode</td>
							<td style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
								title="@item?.PartName">
								@item?.PartName
							</td>


							<td>@item?.Amount</td>
							<td>@item?.PartUnitName</td>
							<td>
								@if (item?.IsLatest == true)
								{
									<span class="badge badge-success">بله</span>
								}
								else
								{
									<span class="badge badge-secondary">خیر</span>
								}
							</td>
								<td>@ProductionStepStr</td>
							<td>@(item?.NumberSupplied?.ToString() ?? "-")</td>
							<td>@StatusStr</td>
							<td>@item?.Description</td>
							<td>@item?.SaleUnitDetails</td>
							<td>
								@if (item?.NeedsAVL == true)
								{
									<span class="badge badge-warning">دارد</span>
								}
								else
								{
									<span class="badge badge-secondary">ندارد</span>
								}
							</td>
							<td class="rtl">@item?.CreatedOnShamsiDateTime</td>
							<td>@item?.CreatedByName</td>
							<td class="rtl">@item?.ModifiedDateShamsiDateTime</td>
							<td>@item?.ModifiedByName</td>
						</tr>
						counter++;
					}
				}
			</tbody>
		</table>

		</div>
	</div>
</div>


<div class="card">

	<div class='card-body row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>
	 
	var listProductionOrderItemBomProductionStepEnum = @Html.Raw(listProductionOrderItemBomProductionStepEnum.JsonSerialize());
	var listProductionOrderItemStatusEnum = @Html.Raw(listProductionOrderItemStatusEnum.JsonSerialize());

	// TODO(Role): نگاه کن به بالای فایل Razor برای فهرست کامل Roleهای مورد نیاز هر پرچم زیر
	var permissions = @Html.Raw(Json.Serialize(new {
		   canAcceptEngineering,
		   canAcceptIndustrial,
		   canAcceptProjectManager,
		   canInquiry,
		   canMinistryReview,
		   canSendToSupplyCommittee,
		   canSupplyCommitteeBoss
	   }));
	var productionOrderItem = @Html.Raw(Json.Serialize(Model));

	// مقادیر عددی دقیقاً منطبق بر Entities.App.Sale.Enums.ProductionOrderItemCheckStatusEnum
	var CHECK_STATUS = {
		IndustrialDashboardInternal: 1904,
		ForeignIndustryCatalog: 1905,
		InquiryNeeded: 1906,
		IndustrialMinistryReviewRequired: 1908,
		SendToSupplyCommitteeChair: 1909,
		MechanicalEngineeringApprovalPending: 2195,
		CommitteeHeadReviewPending: 2202,
		AwaitingProjectManagerApproval: 2258
	};

	function initializePage() {
		for (let btn in self.FormActionButtons) {
			self.FormActionButtons[btn].element.disabled = true;
		}

		self.FormActionButtons.save.element.disabled = false;
		self.FormActionButtons.saveandclose.element.disabled = false;
		self.FormActionButtons.history.element.disabled = false;
		self.FormActionButtons.addComment.element.disabled = false;
		self.FormActionButtons.viewComments.element.disabled = false;
		self.FormActionButtons.addStopRequest.element.disabled = false;
		self.FormActionButtons.viewStopRequests.element.disabled = false;
		self.FormActionButtons.exportBomExcell.element.disabled = false;

		const checkStatus = productionOrderItem.checkStatus;

		// TODO(Role): دکمه تایید/رد مهندسی صرفاً بر اساس permissions.canAcceptEngineering فعال می‌شود که سرور
		// (Razor) بر اساس رشته مکانیک/برق این قلم و نقش متناظر محاسبه کرده است؛ سرور در اکشن AcceptEngineering
		// دوباره همین بررسی را انجام می‌دهد
		if (permissions.canAcceptEngineering && checkStatus == CHECK_STATUS.MechanicalEngineeringApprovalPending) {
			self.FormActionButtons.acceptEngineering.element.disabled = false;
		}

		if (permissions.canAcceptIndustrial && (checkStatus == CHECK_STATUS.IndustrialDashboardInternal || checkStatus == CHECK_STATUS.ForeignIndustryCatalog)) {
			self.FormActionButtons.acceptIndustrial.element.disabled = false;
		}

		if (permissions.canAcceptProjectManager && checkStatus == CHECK_STATUS.AwaitingProjectManagerApproval) {
			self.FormActionButtons.acceptProjectManager.element.disabled = false;
		}

		if (permissions.canInquiry && (checkStatus == CHECK_STATUS.IndustrialDashboardInternal || checkStatus == CHECK_STATUS.ForeignIndustryCatalog)) {
			self.FormActionButtons.sendToInquiry.element.disabled = false;
		}

		if (permissions.canMinistryReview && [CHECK_STATUS.IndustrialDashboardInternal, CHECK_STATUS.ForeignIndustryCatalog, CHECK_STATUS.InquiryNeeded].includes(checkStatus)) {
			self.FormActionButtons.sendToMinistryReview.element.disabled = false;
		}

		if (permissions.canSendToSupplyCommittee && [CHECK_STATUS.IndustrialDashboardInternal, CHECK_STATUS.ForeignIndustryCatalog, CHECK_STATUS.InquiryNeeded, CHECK_STATUS.IndustrialMinistryReviewRequired].includes(checkStatus)) {
			self.FormActionButtons.sendToSupplyCommittee.element.disabled = false;
		}

		if (permissions.canSupplyCommitteeBoss && [CHECK_STATUS.SendToSupplyCommitteeChair, CHECK_STATUS.CommitteeHeadReviewPending].includes(checkStatus)) {
			self.FormActionButtons.committeeAccept.element.disabled = false;
			self.FormActionButtons.committeeReject.element.disabled = false;
		}
	}

	initializePage()

	function currentProductionOrderItemId() {
		return $$("#changeDataSection [data-bind='id']").val();
	}

	//#region Accept/Reject Engineering
	self.FormActionButtons.acceptEngineering.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') {
			toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید');
			return;
		}

		if (!permissions.canAcceptEngineering) {
			toastr.error('شما دسترسی تایید/رد مهندسی این قلم را ندارید');
			return;
		}

		$.confirm({
			title: 'تایید/رد مهندسی',
			content: `
				<div class="row">
					<div class="col-12 mb-3">
						<label class="required">تصمیم</label>
						<select class="form-control" id="engineeringDecisionSelect">
							<option value="1">تایید</option>
							<option value="2">رد</option>
							<option value="3">نیاز به بازنگری</option>
						</select>
					</div>
					<div class="col-12">
						<label>توضیحات</label>
						<textarea class="form-control" id="engineeringDecisionComment" rows="3"></textarea>
					</div>
				</div>`,
			rtl: true,
			buttons: {
				submit: {
					text: 'ثبت',
					btnClass: 'btn-success',
					action: function () {
						const decision = this.$content.find('#engineeringDecisionSelect').val();
						const comment = this.$content.find('#engineeringDecisionComment').val() || '';
						$$.post(`/Panel/ProductionOrderItem/AcceptEngineering/${id}?decision=${decision}&comment=${encodeURIComponent(comment)}`, null, function (r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}
							toastr.success('تصمیم مهندسی با موفقیت ثبت شد');
							appController.refreshCurrentPage();
						});
					}
				},
				cancel: {
					text: 'انصراف',
					btnClass: 'btn-secondary'
				}
			}
		});
	});
	//#endregion

	//#region Accept Industrial
	self.FormActionButtons.acceptIndustrial.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') {
			toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید');
			return;
		}

		if (!permissions.canAcceptIndustrial) {
			toastr.error('شما دسترسی تایید صنایع را ندارید');
			return;
		}

		$.confirm({
			title: 'تایید صنایع',
			content: 'آیا از تایید صنایع و ارسال این قلم به تولید اطمینان دارید؟',
			rtl: true,
			buttons: {
				confirm: {
					text: 'بله',
					btnClass: 'btn-success',
					action: function () {
						$$.post('/Panel/ProductionOrderItem/AcceptIndustrial/' + id, null, function (r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}
							toastr.success('تایید صنایع با موفقیت انجام شد');
							appController.refreshCurrentPage();
						});
					}
				},
				cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
			}
		});
	});
	//#endregion

	//#region Accept/Reject Project Manager
	self.FormActionButtons.acceptProjectManager.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') {
			toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید');
			return;
		}

		if (!permissions.canAcceptProjectManager) {
			toastr.error('شما دسترسی تایید/رد مدیر پروژه را ندارید');
			return;
		}

		$.confirm({
			title: 'تایید/رد مدیر پروژه',
			content: `
				<div class="row">
					<div class="col-12">
						<label class="required">تصمیم</label>
						<select class="form-control" id="pmDecisionSelect">
							<option value="1">تایید</option>
							<option value="2">رد</option>
							<option value="3">نیاز به بازنگری</option>
						</select>
					</div>
				</div>`,
			rtl: true,
			buttons: {
				submit: {
					text: 'ثبت',
					btnClass: 'btn-success',
					action: function () {
						const decision = this.$content.find('#pmDecisionSelect').val();
						$$.post(`/Panel/ProductionOrderItem/AcceptProjectManager/${id}?decision=${decision}`, null, function (r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}
							toastr.success('تصمیم مدیر پروژه با موفقیت ثبت شد');
							appController.refreshCurrentPage();
						});
					}
				},
				cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
			}
		});
	});
	//#endregion

	//#region Send To Inquiry / Ministry Review / Supply Committee / Committee Accept / Reject
	function postSimpleWorkflowAction(actionName, id, successMessage) {
		$$.post(`/Panel/ProductionOrderItem/${actionName}/${id}`, null, function (r) {
			if (!r.isSuccess) {
				toastr.error(`${r.message}`, 'خطا');
				return;
			}
			toastr.success(successMessage);
			appController.refreshCurrentPage();
		});
	}

	function confirmSimpleWorkflowAction(title, content, btnClass, actionName, id, successMessage) {
		$.confirm({
			title: title,
			content: content,
			rtl: true,
			buttons: {
				confirm: {
					text: 'بله',
					btnClass: btnClass,
					action: function () {
						postSimpleWorkflowAction(actionName, id, successMessage);
					}
				},
				cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
			}
		});
	}

	self.FormActionButtons.sendToInquiry.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') { toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید'); return; }
		if (!permissions.canInquiry) { toastr.error('شما دسترسی ارسال به استعلام را ندارید'); return; }
		confirmSimpleWorkflowAction('ارسال به استعلام', 'آیا از ارسال این قلم به استعلام اطمینان دارید؟', 'btn-info', 'SendToInquiry', id, 'با موفقیت به استعلام ارسال شد');
	});

	self.FormActionButtons.sendToMinistryReview.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') { toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید'); return; }
		if (!permissions.canMinistryReview) { toastr.error('شما دسترسی ارسال به بررسی وزارت صنایع را ندارید'); return; }
		confirmSimpleWorkflowAction('ارسال به بررسی وزارت صنایع', 'آیا از ارسال این قلم به بررسی وزارت صنایع اطمینان دارید؟', 'btn-info', 'SendToMinistryReview', id, 'با موفقیت به بررسی وزارت صنایع ارسال شد');
	});

	self.FormActionButtons.sendToSupplyCommittee.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') { toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید'); return; }
		if (!permissions.canSendToSupplyCommittee) { toastr.error('شما دسترسی ارسال به کمیته تامین را ندارید'); return; }
		confirmSimpleWorkflowAction('ارسال به کمیته تامین', 'آیا از ارسال این قلم به رئیس کمیته تامین اطمینان دارید؟', 'btn-warning', 'SendToSupplyCommittee', id, 'با موفقیت به کمیته تامین ارسال شد');
	});

	self.FormActionButtons.committeeAccept.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') { toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید'); return; }
		if (!permissions.canSupplyCommitteeBoss) { toastr.error('شما دسترسی تایید کمیته تامین را ندارید'); return; }
		confirmSimpleWorkflowAction('تایید کمیته تامین', 'آیا از تایید رئیس کمیته تامین و بازگشت این قلم به روند اصلی اطمینان دارید؟', 'btn-success', 'CommitteeAccept', id, 'تایید کمیته تامین با موفقیت ثبت شد');
	});

	self.FormActionButtons.committeeReject.onclick(function () {
		const id = currentProductionOrderItemId();
		if (!id || id == '0') { toastr.error('ابتدا اقلام سفارش ساخت را ذخیره کنید'); return; }
		if (!permissions.canSupplyCommitteeBoss) { toastr.error('شما دسترسی رد کمیته تامین را ندارید'); return; }
		confirmSimpleWorkflowAction('رد کمیته تامین', 'آیا از رد رئیس کمیته تامین اطمینان دارید؟ این عملیات وضعیت را به «منسوخ شده» تغییر می‌دهد.', 'btn-danger', 'CommitteeReject', id, 'رد کمیته تامین با موفقیت ثبت شد');
	});
	//#endregion

	function savefn($btnAction) {
		debugger
		var id = $$("[data-bind='id']").val();
		 

		var model = $$("#changeDataSection").dataBind();
		  
		if(!id || id == 0)
		{
			model.PartId =  $$("[data-bind=PartId]").val();

			if(!model.PartId )
			{
				toastr.error(`کالا برای ایجاد قلم سفارش ثبت نشده .`, 'خطا');
				return;
			}
			model.DeviceType =   $$("[data-bind=DeviceType]").val();

			model.amount = $$("[data-bind=amount]").val();


@using Entities.App.Law
@using Entities.App.Law.Enums
@model JudicialFileResult
<div class="row">
	<input type="hidden" data-bind="id" value="@Model?.Id" />
	<input type="hidden" data-bind="judicialFileId" value="@Model?.JudicialFileId" />
	<div class="col-md-12 form-group-inline">
		<label class="form-label fw-bold required">نتیجه</label>
		<select class="form-control" data-bind="result" data-required="true" asp-for="Result" asp-items="Html.GetEnumSelectList(typeof(JudicialFinalResultEnum))">
			<option value="">انتخاب کنید</option>
		</select>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-12 form-group-inline">
		<label class="form-label fw-bold">توضیحات</label>
		<textarea class="form-control" data-bind="comment" asp-for="Comment" rows="3" maxlength="1024"></textarea>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
</div>

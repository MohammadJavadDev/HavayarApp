@model Entities.App.Crm.CustomerComplaintAction
<div class="row">
	<input type="hidden" data-bind="id" value="@Model?.Id" />
	<input type="hidden" data-bind="complaintId" value="@Model?.ComplaintId" />
	<input type="hidden" data-bind="comment" value="@Model?.Comment" />
	<div class="col-md-6 form-group-inline">
		<label class="required">تاریخ اقدام</label>
		<input class="form-control" data-bind="actionShamsiDate" data-required="true" data-persionDatePicker="true"
			   persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose":true,"initialValue":false}'
			   value="@(Model?.ActionMiladiDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-6 form-group-inline">
		<label>تاریخ اقدام بعدی</label>
		<input class="form-control" data-bind="nextActionShamsiDate" data-persionDatePicker="true"
			   persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose":true,"initialValue":false}'
			   value="@(Model?.NextActionMiladiDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-12 form-group-inline">
		<label class="required">شرح اقدام</label>
		<textarea class="form-control" data-bind="actionDescription" data-required="true" rows="3">@Model?.ActionDescription</textarea>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-12 form-group-inline">
		<label>توضیحات اقدام بعدی</label>
		<textarea class="form-control" data-bind="nextActionDescription" rows="2">@Model?.NextActionDescription</textarea>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
</div>

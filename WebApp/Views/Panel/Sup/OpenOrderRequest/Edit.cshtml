@using Data.SystemAuth
@using Entities.App.FIN;
@using Entities.App.Gnr;
@using Entities.App.Inv;
@using Entities.App.Sale;
@using Entities.App.Sup;
@using Entities.App.Sup.Enums;
@using Entities.Auth;
@using Common.Utilities
@using WebApp.ViewModels.Sup
@inject ISdk sdk
@model OpenOrderRequest
@{

var isAdmin = sdk.IsAdministrator;
var isProjectOrSalesUnit = isAdmin || sdk.HasRole("Sup.OpenOrderRequest.SalesOrProjectAccept");
var isIndustrial = isAdmin || sdk.HasRole("Sup.OpenOrderRequest.Industrial");
var isEngineering = isAdmin || sdk.HasRole("Sup.OpenOrderRequest.EngineeringAccept");
var isSupply = isAdmin || sdk.HasRole("Sup.OpenOrderRequest.Supply");
var hasStopPermission = isAdmin || sdk.HasRole("Sup.OpenOrderRequest.Stop");
var hasStartPermission = isAdmin || sdk.HasRole("Sup.OpenOrderRequest.Start");
var hasSendingPermission = isAdmin || sdk.HasRole("Sup.OpenOrderRequest.Sending");
var hasQueryPermission = isAdmin || sdk.HasRole("Sup.OpenOrderRequest.Query");
var hasTerminatePermission = isAdmin || sdk.HasRole("Sup.OpenOrderRequest.Terminate");
var hasConfigManagePermission = isAdmin || sdk.HasRole("Sup.OpenOrderRequest.ConfigManage");
var attachmentListItems = ViewBag.AttachmentListItems as List<OpenOrderRequestAttachmentListItemVm> ?? new List<OpenOrderRequestAttachmentListItemVm>();
var attachmentDisplayCount = attachmentListItems.Count;

}
<div class="card">
	
</div>
<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
<div class="row">
	<!-- هدر اطلاعات -->
	<div class="col-12 mb-4">
		<div class="card border-0 shadow-sm">
			 
				<div class="d-flex   align-items-center">
					 
					<div class="form-action-buttons w-100">
						<form-action-buttons entity-type="typeof(OpenOrderRequest)"
						save-btn="false"
						save-and-close-btn="false"
						save-and-new-btn="false"
						new-page-btn="false"
						>
							<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-comment"
								action-name="addComment" title="افزودن کامنت"></form-action-button>
													<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-check-circle"
								action-name="engineeringAccept" title="تایید مهندسی"></form-action-button>
							<form-action-button color-class="btn-active-icon-dark btn-color-warning" icon-class="fa fa-handshake"
								action-name="salesOrProjectAccept" title="تایید واحد فروش/پروژه"></form-action-button>
							<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-link"
								action-name="linkVpis" title="لینک با مدارک پروژه"></form-action-button>
							<form-action-button color-class="btn-active-icon-dark btn-color-danger" icon-class="fa fa-stop-circle"
								action-name="stopRequest" title="ثبت توقف"></form-action-button>
							<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-play-circle"
								action-name="triggeringRequest" title="راه اندازی"></form-action-button>
							<form-action-button color-class="btn-active-icon-dark btn-color-info" icon-class="fa fa-truck"
								action-name="inWayStatus" title="در راه"></form-action-button>
							<form-action-button color-class="btn-active-icon-dark btn-color-secondary" icon-class="fa fa-search"
								action-name="statusInquiry" title="استعلام وضعیت"></form-action-button>
							<form-action-button color-class="btn-active-icon-dark btn-color-dark" icon-class="fa fa-times-circle"
								action-name="terminateRequest" title="خاتمه"></form-action-button>
													<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-user-plus"
											action-name="addRequestedPersonel" title="درخواست کنندگان و ذینفعان"></form-action-button>
						<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-user-plus"
											action-name="addSupplier" title="تامیین کننده منتخب"></form-action-button>
					
										</form-action-buttons>
					</div>
					
				</div>
			 
		</div>
	</div>

	<!-- Tab Navigation -->
	<div class="col-12">
		<div class="card border-0 shadow-sm">
			<div class="card-body p-3">
				<ul class="nav nav-tabs nav-line-tabs nav-stretch fs-6 border-0 px-4 pt-4 justify-content-between" role="tablist">
					<li class="nav-item">
						<a class="nav-link active" data-bs-toggle="tab" href="#tab_general_@Model.Id">
							<i class="bi bi-info-circle me-2"></i>اطلاعات کلی
						</a>
					</li>
				 
					<li class="nav-item">
						<a class="nav-link" data-bs-toggle="tab" href="#tab_production_@Model.Id">
							<i class="bi bi-gear me-2"></i>تولید و تامین
						</a>
					</li>
				 
					<li class="nav-item">
						<a class="nav-link" data-bs-toggle="tab" href="#tab_attachments_@Model.Id" id="tab_attachments_link_">
							<i class="bi bi-paperclip me-2"></i>مدیریت پیوست‌ها
							<span class="badge-circle badge badge-light-primary mx-1" id="attachments_count_badge">@attachmentDisplayCount</span>
						</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" data-bs-toggle="tab" href="#tab_comments_@Model.Id" id="tab_comments_link">
							<i class="bi bi-chat-dots me-2"></i>تاریخچه کامنت‌ها
							<span class="badge-circle badge badge-light-primary mx-1">@(Model?.Comments.Count ?? 0)</span>
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>
	<div class="col-md-12 my-1">
 
			<div class="tab-content p-3" id="myTabContent">
					<!-- Tab 1: اطلاعات کلی -->
					<div class="tab-pane fade show active  " id="tab_general_@Model.Id" role="tabpanel">
						<div class="card card-body  g-3  my-1">
							<div class="row">

							 <div class="col-md-6 col-lg-3">
								 <label class="form-label text-muted small">وضعیت</label>
								 @if (!string.IsNullOrWhiteSpace(Model?.Status))
									{
										<span class="badge badge-light-primary fs-6 px-3 py-2">@Model.Status</span>
									}
							else
							{
								<span>-</span>
							}
						</div>
						
							 
							<div class="col-md-6 col-lg-3">
								<label class="form-label text-muted small">شماره حواله فروش</label>
								<div class="fw-semibold">@(Model?.OrderNo?.ToString() ?? "-")</div>
							</div>
							<div class="col-md-6 col-lg-3">
								<label class="form-label text-muted small">تاریخ حواله فروش</label>
								<div class="fw-semibold">@(Model?.OrderShamsiDate ?? "-")</div>
							</div>
							<div class="col-md-6 col-lg-3">
								<label class="form-label text-muted small">تاریخ نیاز</label>
								<div class="fw-semibold">@(Model?.NeedDateShamsiDate ?? "-")</div>
							</div>
							<div class="col-md-6 col-lg-3">
								<label class="form-label text-muted small">تاریخ تایید</label>
								<div class="fw-semibold">@(Model?.OrderConfirmShamsiDate ?? "-")</div>
							</div>
							<div class="col-md-6 col-lg-3">
								<label class="form-label text-muted small">شماره درخواست خرید</label>
								<div class="fw-semibold">@Model?.PurchaseRequestNumber</div>
							</div>
							<div class="col-md-6 col-lg-3">
								<label class="form-label text-muted small">تاریخ درخواست خرید</label>
								<div class="fw-semibold">@(Model?.PurchaseRequestShamsiDate ?? "-")</div>
							</div>
							<div class="col-md-6 col-lg-6">
								<label class="form-label text-muted small">پرسنل درخواست کننده</label>
								<div class="fw-semibold">@(Model?.RequestedPersonel ?? "-")</div>
							</div>
							<div class="col-12">
								<label class="form-label text-muted small">توضیحات سفارش</label>
								<div class="fw-semibold">@(Model?.OrderItemComment ?? "-")</div>
							</div>
								</div>
						</div>

							 <div class="row g-4 ">
							<!-- وضعیت -->

							<div class="col-12">
								<div class="card card-body">
								 <div class="  rounded p-3">
									<h6 class="text-dark mb-3"><i class="bi bi-flag me-2"></i>وضعیت</h6>
									<div class="row g-2">
										<div class="col-md-3 col-6">
											<label class="form-label text-muted small">متوقف شده</label>
											<div>
												@if (Model?.IsStop == true)
												{
													<span class="badge badge-light-danger">بله</span>
												}
												else
												{
													<span class="badge badge-light-success">خیر</span>
												}
											</div>
										</div>
										<div class="col-md-3 col-6">
											<label class="form-label text-muted small">عدم تایید QC</label>
											<div>
												@if (Model?.IsRejectedByInspection == true)
												{
													<span class="badge badge-light-danger">بله</span>
												}
												else
												{
													<span class="badge badge-light-success">خیر</span>
												}
											</div>
										</div>
										<div class="col-md-3 col-6">
											<label class="form-label text-muted small">حذف شده</label>
											<div>
												@if (Model?.IsDeleted == true)
												{
													<span class="badge badge-light-danger">بله</span>
												}
												else
												{
													<span class="badge badge-light-success">خیر</span>
												}
											</div>
										</div>
										<div class="col-md-3 col-6">
											<label class="form-label text-muted small">ویرایش شده</label>
											<div>
												@if (Model?.Changed == true)
												{
													<span class="badge badge-light-warning">بله</span>
												}
												else
												{
													<span class="badge badge-light-secondary">خیر</span>
												}
											</div>
										</div>
									</div>
								</div>
								</div>
							</div>
 
						
						</div>
						<div class="col-12 my-1">
								<div class="  rounded card card-body">
									<h6 class="text-primary mb-3"><i class="bi bi-box-seam me-2"></i>اطلاعات کالا</h6>
									<div class="row g-3">
										<div class="col-md-6">
											<label class="form-label text-muted small">کالا</label>
											<div class="fw-semibold">
												@if (Model?.Part != null)
												{
													<span>@Model.Part.Name  </span>
												}
												else
												{
													<span class="text-muted">-</span>
												}
											</div>
										</div>
										<div class="col-md-2">
											<label class="form-label text-muted small">کد کالا</label>
											<div class="fw-semibold">@(@Model?.Part.Code ?? "-")</div>
										</div>
										<div class="col-md-2">
											<label class="form-label text-muted small">تفصیل</label>
											<div class="fw-semibold">@(Model?.Dl?.Title ?? "-")</div>
										</div>
										<div class="col-md-2">
											<label class="form-label text-muted small">کالای مرتبط</label>
											<div class="fw-semibold">
												@if (Model?.RelatedPart != null)
												{
													<span>@Model.RelatedPart.Name</span>
												}
												else
												{
													<span class="text-muted">-</span>
												}
											</div>
										</div>
									</div>
								</div>
							</div>
						 	<div class="col-12 my-1">
								<div class="  rounded  card card-body">
									<h6 class="text-info mb-3"><i class="bi bi-calculator me-2"></i>اطلاعات تعداد</h6>
									<div class="row g-3">
										<div class="col-md-3 col-6">
											<label class="form-label text-muted small">تعداد نیاز</label>
											<div class="fs-4 fw-bold text-primary">@Model?.RequiredQty</div>
										</div>
										<div class="col-md-3 col-6">
											<label class="form-label text-muted small">تعداد سفارش</label>
											<div class="fs-4 fw-bold text-success">@(Model?.OrderQty?.ToString() ?? "-")</div>
										</div>
										<div class="col-md-3 col-6">
											<label class="form-label text-muted small">تعداد ارسال شده</label>
											<div class="fs-4 fw-bold text-warning">@(Model?.SumSendQty?.ToString() ?? "-")</div>
										</div>
										<div class="col-md-3 col-6">
											<label class="form-label text-muted small">تعداد رسیده شده</label>
											<div class="fs-4 fw-bold text-info">@Model?.FactoredCount</div>
										</div>
									</div>
								</div>
							</div>
							<div class="row g-4" style="padding: 0.1rem 0.8rem;">
							<!-- تاییدات مهندسی -->
							<div class="col-lg-6 card ">
								<div class=" card-body  p-3 h-100">
									<h6 class="text-dark mb-3 pb-2 border-bottom">
										<i class="bi bi-tools me-2"></i>تاییدات مهندسی
									</h6>
									<div class="row g-2">
										<div class="col-6">
											<label class="form-label text-muted small">تایید مهندسی</label>
											<div>
												@if (Model?.EngineeringAccept == true)
												{
													<span class="badge badge-light-success">تایید شده</span>
												}
												else
												{
													<span class="badge badge-light-danger">بدون تایید</span>
												}
											</div>
										</div>
										<div class="col-6">
											<label class="form-label text-muted small">تایید خودکار</label>
											<div>
												@if (Model?.IsAcceptedAutomaticallyByEngineering == true)
												{
													<span class="badge badge-light-success">بله</span>
												}
												else
												{
													<span class="badge badge-light-secondary">خیر</span>
												}
											</div>
										</div>
										<div class="col-12">
											<label class="form-label text-muted small">کاربر تایید</label>
											<div class="fw-semibold">@(Model?.EngineeringAcceptUser?.Name ?? "-")</div>
										</div>
										<div class="col-6">
											<label class="form-label text-muted small">تاریخ تایید</label>
											<div class="small">@(Model?.EngineeringAcceptShamsiDateTime ?? "-")</div>
										</div>
										<div class="col-6">
											<label class="form-label text-muted small">مهندسین درخواستی</label>
											<div class="small">@(Model?.RequestedEngineeringPersonel ?? "-")</div>
										</div>
									</div>
								</div>
							</div>

							<!-- تاییدات واحد فروش -->
							<div class="col-lg-6 card ">
								<div class="card-body  p-3 h-100">
									<h6 class="text-dark mb-3 pb-2 border-bottom">
										<i class="bi bi-shop me-2"></i>تاییدات واحد فروش
									</h6>
									<div class="row g-2">
										<div class="col-6">
											<label class="form-label text-muted small">تایید فروش</label>
											<div>
												@if (Model?.HasSalesUnitConfirmation == true)
												{
													<span class="badge badge-light-success">تایید شده</span>
												}
												else
												{
													<span class="badge badge-light-danger">بدون تایید</span>
												}
											</div>
										</div>
										<div class="col-6">
											<label class="form-label text-muted small">تایید اولیه</label>
											<div>
												@if (Model?.HasSalesUnitPrimitiveApprove == true)
												{
													<span class="badge badge-light-success">بله</span>
												}
												else
												{
													<span class="badge badge-light-secondary">خیر</span>
												}
											</div>
										</div>
										<div class="col-12">
											<label class="form-label text-muted small">کاربر تایید</label>
											<div class="fw-semibold">@(Model?.SalesUnitConfirmationUser?.Name ?? "-")</div>
										</div>
										<div class="col-12">
											<label class="form-label text-muted small">تاریخ تایید</label>
											<div class="small">@(Model?.SalesUnitConfirmationShamsiDateTime ?? "-")</div>
										</div>
										<div class="col-12">
											<label class="form-label text-muted small">کارشناس فروش</label>
											<div class="small">@(Model?.SalesUnitSalesExpert?.Name ?? "-")</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

				  
					<!-- Tab 4: تولید و تامین -->
					<div class="tab-pane fade " id="tab_production_@Model.Id" role="tabpanel">
						<div class="card card-body mb-2">
								<div class="row g-3">
							<div class="col-md-4">
								<label class="form-label text-muted small">شماره سفارش ساخت</label>
								<div class="fw-semibold">@(Model?.ProductionOrderNumber?.ToString() ?? "-")</div>
							</div>
							<div class="col-md-4">
								<label class="form-label text-muted small">تامین کننده</label>
								<div class="fw-semibold">@(Model?.ManCompany?.Party?.FullName ?? "-")</div>
							</div>
							<div class="col-md-4">
								<label class="form-label text-muted small">تاخیر خرید</label>
								<div class="fw-semibold">
									@if (Model?.DelaysBuyDay.HasValue == true)
									{
										<span class="badge badge-light-warning">@Model.DelaysBuyDay روز</span>
									}
									else
									{
										<span class="text-muted">-</span>
									}
								</div>
							</div>
							<div class="col-md-4">
								<label class="form-label text-muted small">درخواست روتین</label>
								<div>
									@if (Model?.IsRoutineRequest == true)
									{
										<span class="badge badge-light-success">بله</span>
									}
									else
									{
										<span class="badge badge-light-secondary">خیر</span>
									}
								</div>
							</div>
						</div>
							</div>
					
							<!-- تاریخ‌های مهم -->
							<div class="col-12">
								<div class="card card-body">
								<h6 class="text-dark mb-3"><i class="bi bi-calendar-event me-2"></i>تاریخ‌های مهم</h6>
								<div class="row g-2">
									<div class="col-md-3 col-sm-6">
										<div class="border-start border-4 border-primary ps-3">
											<label class="form-label text-muted small mb-1">فاکتوردهی</label>
											<div class="fw-semibold small">@(Model?.FactoredShamsiDate ?? "-")</div>
										</div>
									</div>
									<div class="col-md-3 col-sm-6">
										<div class="border-start border-4 border-success ps-3">
											<label class="form-label text-muted small mb-1">سند تحویل</label>
											<div class="fw-semibold small">@(Model?.DeliveryVoucherShamsiDate ?? "-")</div>
										</div>
									</div>
									<div class="col-md-3 col-sm-6">
										<div class="border-start border-4 border-info ps-3">
											<label class="form-label text-muted small mb-1">سند موقت</label>
											<div class="fw-semibold small">@(Model?.TemporaryInventoryVoucherShamsiDate ?? "-")</div>
										</div>
									</div>
									<div class="col-md-3 col-sm-6">
										<div class="border-start border-4 border-warning ps-3">
											<label class="form-label text-muted small mb-1">سند QC</label>
											<div class="fw-semibold small">@(Model?.QcVoucherShamsiDate ?? "-")</div>
										</div>
									</div>
									<div class="col-md-3 col-sm-6">
										<div class="border-start border-4 border-danger ps-3">
											<label class="form-label text-muted small mb-1">سند دائم</label>
											<div class="fw-semibold small">@(Model?.FinalInventoryVoucherShamsiDate ?? "-")</div>
										</div>
									</div>
									<div class="col-md-3 col-sm-6">
										<div class="border-start border-4 border-secondary ps-3">
											<label class="form-label text-muted small mb-1">تامین</label>
											<div class="fw-semibold small">@(Model?.SupplyShamsiDate ?? "-")</div>
										</div>

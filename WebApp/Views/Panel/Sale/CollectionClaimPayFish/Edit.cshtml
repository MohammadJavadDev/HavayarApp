@using Entities.App.Sale
@using Entities.Auth
@using Entities.Base
@model CollectionClaimPayFish

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(CollectionClaimPayFish)">
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-print"
				action-name="printSheet" title="چاپ فیش"></form-action-button>
		</form-action-buttons>
	</div>
	<div class="card-body row">
		<span class="section-box-title">فیش وصول</span>
		<input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
			<div class="col-md-12 form-group-inline">
				<label class="form-label fw-bold required">مطالبه</label>
				@(Html.EntitySelector<CollectionClaim>(
					"PayFishClaimSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, VchNumber = c.VchNumber, DlTitle = c.DlTitle },
					c => new { c.VchNumber, c.DlTitle },
					"{VchNumber} {DlTitle}",
					"collectionClaimId",
					"collectionClaimName",
					Model?.CollectionClaimId?.ToString()
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">مبلغ وصول</label>
				<input class="form-control" data-bind="collectedPrice" asp-for="CollectedPrice" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">مسئول</label>
				@(Html.EntitySelector<User>(
					"PayFishResponsibleSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Name = c.Name },
					c => new { c.Name },
					"{Name}",
					"responsibleId",
					"responsibleName",
					Model?.ResponsibleId?.ToString()
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">تاریخ فیش</label>
				<input class="form-control" data-bind="payFishShamsiDate" data-persionDatePicker="true"
					persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
					value="@Model?.PayFishShamsiDate" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">شماره فیش</label>
				<input class="form-control" data-bind="fishNumber" asp-for="FishNumber" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">غیرقابل وصول</label>
				<input class="form-check-input mt-2" type="checkbox" data-bind="uncollectable" asp-for="Uncollectable" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">تخفیف</label>
				<input class="form-check-input mt-2" type="checkbox" data-bind="hasDiscount" asp-for="HasDiscount" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">نمایندگی</label>
				<input class="form-check-input mt-2" type="checkbox" data-bind="isAgency" asp-for="IsAgency" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-12 form-group-inline">
				<label class="form-label fw-bold">توضیحات</label>
				<textarea class="form-control" data-bind="comment" asp-for="Comment" rows="3"></textarea>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
	</div>
</div>
<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;
		const model = page.$pageEl.dataBind();
		const $btn = $($btnAction.element).block();
		$$.post('save', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			$btnAction.baseaction();
		});
	}
	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
	if (self.FormActionButtons.printSheet) {
		self.FormActionButtons.printSheet.onclick(function () {
			const id = page.$pageEl.dataBind().id;
			if (!id) { toastr.error('ابتدا ذخیره کنید'); return; }
			appController.addPage('/System/ReportBuilder/ViewReportByName/CollectionClaimPayFish?payFishId={\'values\':[\'' + id + '\'],\'condition\':\'=\'}&autoRun=True');
		});
	}
</script>

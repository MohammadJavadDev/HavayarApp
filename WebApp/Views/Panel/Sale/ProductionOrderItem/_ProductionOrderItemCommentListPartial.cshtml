@using Common.Utilities
@using Entities.App.Sale
@model List<ProductionOrderItemComment>

@{
	DateTime? lastChangeDate = null;
}

<div class="row">
	<div class="col-md-12">
		@if (Model != null && Model.Any())
		{
			<div class="table-responsive">
				<table class="table table-striped table-bordered table-hover">
					<thead>
						<tr>
							<th>وضعیت</th>
							<th>توضیحات</th>
							<th>انواع خرابی</th>
							<th>کاربر ثبت‌کننده</th>
							<th>تاریخ ثبت</th>
							<th>بازه زمانی</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var comment in Model.OrderBy(c => c.CreatedOnMiladiDateTime))
						{
							string TimePeriod = "0";
							if (lastChangeDate == null)
							{
								lastChangeDate = comment.CreatedOnMiladiDateTime;
							}
							else
							{
								var difference = comment.CreatedOnMiladiDateTime - lastChangeDate;
								TimePeriod = $"{(int)difference.Value.TotalHours}:{difference.Value.Minutes:D2}";
							}

							<tr>

								<td>
									<span class="badge badge-primary">@comment.ProductionStatus.ToDisplay()</span>
									
								</td>

								<td>@comment.Comment</td>
								<td>
									@if (!string.IsNullOrWhiteSpace(comment.FailureTypeNames))
									{
										<div class="mt-1">
											<span class="badge badge-danger">@comment.FailureTypeNames</span>
										</div>
									}
								</td>

								<td style="white-space: nowrap;">
									<i class="fa fa-user"></i> @comment.CreatedByName
								</td>
							
								<td style="direction: ltr; text-align: right;">@comment.CreatedOnShamsiDateTime</td>


							
								<td>
									@TimePeriod 
									 
								</td>
							
							 
							
								
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		else
		{
			<div class="alert alert-info">
				<i class="fa fa-info-circle"></i> هیچ کامنتی ثبت نشده است
			</div>
		}
	</div>
</div>

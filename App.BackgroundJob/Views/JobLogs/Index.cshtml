@using Common.Utilities
@using Entities.Base.Job
@model IEnumerable<Entities.Base.Job.JobHistory>
@{
    ViewData["Title"] = ViewData["Title"] ?? "تاریخچه زمان‌بندی‌ها";
    ViewData["Icon"] = ViewData["Icon"] ?? "history";
}

@await Html.PartialAsync("_PageHeader")

<div class="row mb-3 g-2 align-items-end">
    <div class="col-md-6">
        <form method="get" class="d-flex gap-2 align-items-end">
            <div class="flex-grow-1">
                <label for="scheduleId" class="form-label">انتخاب جاب</label>
                <select name="scheduleId" id="scheduleId" class="form-select">
                    @foreach (var schedule in ViewBag.Schedules as IEnumerable<Entities.Base.Job.JobSchedule> ?? Enumerable.Empty<JobSchedule>())
                    {
                        <option value="@schedule.Id" selected="@(schedule.Id == ViewBag.SelectedScheduleId)">
                            @(schedule.JobDefinition?.DisplayName ?? "Unknown Job") (@schedule.Id)
                        </option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">نمایش</button>
        </form>
    </div>
    <div class="col-md-6 text-md-start">
        <a href="@Url.Action("Search", "JobLogs")" class="btn btn-outline-info js-soft-nav">
            <i class="fas fa-search me-1"></i> جستجوی پیشرفته
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-filter me-2"></i>فیلتر و جستجو</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-12">
                <label for="generalSearch" class="form-label">جستجو در همه ستون‌ها</label>
                <input type="text" id="generalSearch" class="form-control" placeholder="جستجو...">
            </div>
            <div class="col-md-3">
                <label for="jobNameFilter" class="form-label">نام جاب</label>
                <select id="jobNameFilter" class="form-select">
                    <option value="">همه</option>
                    @{
                        var uniqueJobNames = Model
                            .Where(h => h.JobSchedule?.JobDefinition != null)
                            .Select(h => h.JobSchedule.JobDefinition.DisplayName)
                            .Distinct()
                            .OrderBy(n => n)
                            .ToList();
                    }
                    @foreach (var jobName in uniqueJobNames)
                    {
                        <option value="@jobName">@jobName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="isActiveFilter" class="form-label">وضعیت فعال بودن</label>
                <select id="isActiveFilter" class="form-select">
                    <option value="">همه</option>
                    <option value="true">فعال</option>
                    <option value="false">غیرفعال</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="scheduleTypeFilter" class="form-label">نوع اجرا</label>
                <select id="scheduleTypeFilter" class="form-select">
                    <option value="">همه</option>
                    <option value="@((int)ScheduleType.Interval)">فاصله زمانی</option>
                    <option value="@((int)ScheduleType.Daily)">روزانه</option>
                    <option value="@((int)ScheduleType.Weekly)">هفتگی</option>
                    <option value="@((int)ScheduleType.Hourly)">ساعتی</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="statusFilter" class="form-label">نتیجه اجرا</label>
                <select id="statusFilter" class="form-select">
                    <option value="">همه</option>
                    <option value="success">موفق</option>
                    <option value="failed">ناموفق</option>
                    <option value="running">در حال اجرا</option>
                </select>
            </div>
        </div>
        <div class="mt-3">
            <button type="button" id="clearFilters" class="btn btn-secondary btn-sm">
                <i class="fas fa-times me-1"></i>پاک کردن فیلترها
            </button>
            <span id="resultCount" class="ms-3 text-muted"></span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover text-center mb-0" id="jobLogsTable">
                <thead class="table-dark">
                    <tr>
                        <th>شناسه</th>
                        <th>نام جاب</th>
                        <th>شروع</th>
                        <th>پایان</th>
                        <th>مدت</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Any())
                {
                    @foreach (var history in Model)
                    {
                        var jobName = history.JobSchedule?.JobDefinition?.DisplayName ?? "Unknown";
                        var isActive = history.JobSchedule?.IsActive ?? false;
                        var scheduleType = history.JobSchedule?.ScheduleType ?? ScheduleType.Interval;
                        var isRunning = !history.EndTime.HasValue;
                        var statusKey = isRunning ? "running" : (history.IsSuccess ? "success" : "failed");

                        <tr data-job-name="@jobName"
                            data-is-active="@isActive.ToString().ToLower()"
                            data-schedule-type="@((int)scheduleType)"
                            data-status="@statusKey"
                            data-history-id="@history.Id">
                            <td>@history.Id</td>
                            <td>@jobName</td>
                            <td dir="ltr">@history.StartTime.ToShamsiDateTime()</td>
                            <td dir="ltr">@(history.EndTime.HasValue ? history.EndTime.Value.ToShamsiDateTime() : "—")</td>
                            <td>
                                @if (history.EndTime.HasValue)
                                {
                                    <text>@((history.EndTime.Value - history.StartTime).TotalSeconds.ToString("0.00")) ثانیه</text>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark status-running"><span class="status-pulse"></span>در حال اجرا</span>
                                }
                            </td>
                            <td>
                                @if (isRunning)
                                {
                                    <span class="badge bg-warning text-dark">Running</span>
                                }
                                else if (history.IsSuccess)
                                {
                                    <span class="badge bg-success">موفق</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">ناموفق</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("Details", "JobLogs", new { id = history.Id })" class="btn btn-sm btn-primary js-soft-nav">
                                    <i class="fas fa-eye"></i> جزئیات
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-info" onclick="loadDetailedLogs(@history.Id, @(isRunning ? "true" : "false"))">
                                    <i class="fas fa-list"></i> مشاهده سریع
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">تاریخچه‌ای یافت نشد</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="logModal" tabindex="-1" aria-labelledby="logModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="logModalLabel">جزئیات لاگ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="logModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

		 self.FormActionButtons.exportBomExcell.onclick(function () {
			  
		  var items = [];

		  $$("#bomTable tbody tr").each(function () {

			var rec =   $($(this).find("td")[1]).text()
			var rev =   $($(this).find("td")[2]).text()
			var partCode =   $($(this).find("td")[3]).text()
			var partName =   $($(this).find("td")[4]).text()
			var qty =   $($(this).find("td")[5]).text()
			var unitName =   $($(this).find("td")[6]).text()
			var lastVerion =   $($(this).find("td")[7]).text()
			var produtionStep =   $($(this).find("td")[8]).text()
			var numberSupplied =   $($(this).find("td")[9]).text()
			var status =   $($(this).find("td")[10]).text()
			var description =   $($(this).find("td")[11]).text()
			var saleDescription =   $($(this).find("td")[12]).text()
			var needsAVL =   $($(this).find("td")[13]).text()

			var createdOn =   $($(this).find("td")[14]).text()
			var createdBy =   $($(this).find("td")[15]).text()
			var modifiedOn =   $($(this).find("td")[16]).text()
			var modifiedBy =   $($(this).find("td")[17]).text()
			 
			 

			  items.push({
				 "ردیف": rec,
				 "نسخه": rev,
				 "کدکالا": partCode,
				 "نام کالا": partName,
				 "تعداد/مقدار": formatNumber(qty),
				 "واحد": unitName,
				 "آخرین نسخه": lastVerion,
				 "مرحله ساخت": produtionStep,
				 "تعداد تامین شده": numberSupplied,
				 "وضعیت": status,
				 "توضیحات": description,
				 "توضیحات واحد فروش": saleDescription,
				 "نیاز به AVL": needsAVL,

				 "زمان ایجاد":createdOn ,
				 "ایجاد کننده":createdBy ,
				 "زمان ویرایش": modifiedOn,
				 "ویرایش کننده": modifiedBy,
			 });


		  });

		  if (items.length === 0) {
			 return toastr.warning("هیچ قلمی برای خروجی اکسل یافت نشد");
		  }
		    
		  var worksheet = XLSX.utils.json_to_sheet(items);
		  var workbook = XLSX.utils.book_new();
		  worksheet['!rightToLeft'] = true;

			  var range = XLSX.utils.decode_range(worksheet['!ref']);
			for (var C = range.s.c; C <= range.e.c; ++C) {
			  var cellAddress = XLSX.utils.encode_cell({ r: range.s.r, c: C });
			  if (!worksheet[cellAddress]) continue;
			  worksheet[cellAddress].s = {
			    font: { bold: true },
			    fill: { fgColor: { rgb: "FFD9D9D9" } } // رنگ پس‌زمینه خاکستری روشن
			  };
			}

		  XLSX.utils.book_append_sheet(workbook, worksheet, "ProductionOrderItemBom");

		  var productionOrderName = $$("[data-bind=ProductionOrderName]").val();

		  XLSX.writeFile(workbook, `ProductionOrderItemBom${productionOrderName}.xlsx`);
	   });

	   function formatNumber(input) {
 
		  const num = parseFloat(input);
 
		  if (isNaN(num)) return input;
 
		  return num.toString();
		}

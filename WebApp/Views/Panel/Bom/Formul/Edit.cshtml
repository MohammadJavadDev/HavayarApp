@using Entities.App.Bom;
@using Entities.App.Inv
@using WebFramework.TagHelpers;
@model Formul
<div class="card">
	<div class="form-action-buttons">
		<form-action-buttons entity-type="typeof(Formul)">
			<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-file-xls"
							action-name="exportExcel" title="اکسل bom"></form-action-button>
	</form-action-buttons>
	</div>
	<div class="card-body row">
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class='col-md-6'>
			<label class='required'>عنوان</label>
			<input class='form-control' data-bind='title' required asp-for='Title' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		

		<div class="col-md-6">
			<label class='required'>گروه</label>
			@(Html.EntitySelector<FormulGroup>(
				"GroupSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Title = c.Title
				},
				c => new { c.Title },
				"{Title}",
				"GroupId",
				"GroupName",
				 Model?.GroupId.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		 
		<div class='col-md-12'>
			<div data-tab-item-manager="formulItems" data-item-selector=".entity-item">
				<ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-transparent fs-4 fw-bold mb-5" role="tablist">
					<li class="nav-item" role="presentation">
						<a class="nav-link active" data-bs-toggle="tab" href="#itemsTab" role="tab" aria-selected="true">
							<span class="svg-icon svg-icon-2 me-2"></span>
							اقلام
						</a>
					</li>
				</ul>
				<div class="tab-content">
					<div class="tab-pane fade show active" id="itemsTab" role="tabpanel" data-add-url="/Panel/Bom/Formul/FormulItemPartial">
						<div id='ItemsContainer' class="entity-item-container">
							@if (Model?.Items != null)
							{
								@foreach (var item in Model.Items)
								{
									<div data-item-id="@(item.Id ?? 0)">
										@await Html.PartialAsync("_FormulItemPartial.cshtml", item)
									</div>
								}
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class='card-footer row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>
	function savefn($btnAction) {
		if (validateError($$('.card'))) { return; }
		var model = $$('.card').dataBind();
		const $btn = $(this.element).block();
		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				$$('.card').dataBind(r.data);
				$btnAction.baseaction();
			})
	}

	self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
	 
	 self.FormActionButtons.exportExcel.onclick(function () {
		  
            var items = [];

          $$(".entity-item-row").each(function () {

 
                let partName = $(this).find("[autocomplete=off]").val() || "";
			
			 if(partName)
			 {
			 let usingRate = $(this).find("[data-bind='items.usingRate']").val() || "";

			 let partCodeName = partName.split("||")

                items.push({
				 "Part Code": partCodeName[0],
                    "Part Name": partCodeName[1],
                    "Using Rate": usingRate
                });
			 }
 
              
            });

            if (items.length === 0) {
                return toastr.warning("هیچ قلمی برای خروجی اکسل یافت نشد");
            }
 
            var worksheet = XLSX.utils.json_to_sheet(items);
            var workbook = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(workbook, worksheet, "FormulItemBoms");
 
            XLSX.writeFile(workbook, "FormulItemBoms.xlsx");
        });
</script>

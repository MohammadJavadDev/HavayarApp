@using Entities.App.Rpr
@using Entities.App.Sale
@using Entities.App.Sale.Enums
@using Entities.App.Inv
@model RepairRequestComment

<div class="row">
    <input type="hidden" data-bind="id" value="@Model?.Id" />
    <input type="hidden" data-bind="RepairRequestId" value="@Model?.RepairRequestId" />
    
    <div class="col-md-12">
        <label class="required">هزینه</label>
        <input class="form-control" data-bind="cost" asp-for="Cost"
               data-invalidMessage="فقط عدد"
               data-inputmask="'regex':'^[\u06F0-\u06F90-9.]+$' , 'placeholder' : ''" />
        <div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
    </div>

    <div class="col-md-12">
        <label>توضیحات</label>
        <textarea class="form-control" data-bind="comment" asp-for="Comment" rows="3"></textarea>
        <div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
    </div>

</div>

<div class="card scroll" style="height: 1250px;">
  
    <div class="col-md-6 mt-3">
        <button  class="btn btn-success" style="width:100%" id="save">ذخیره</button>
    </div>
    <div class="card-body ">
          <div class="row">
        <div class="col-md-6">
            <label> نام</label>
            <input type="hidden" class="form-control" value="@Model?.Id" data-bind="id" />
            <input class="form-control" value="@Model?.Name" data-bind="name" data-invalidMessage='فقط حروف لاتین' data-inputmask="'regex':'^[A-Za-z][A-Za-z0-9]*$' , 'placeholder' : ''" />
        </div>
        <div class="col-md-6">
            <label> عنوان</label>
   
            <input class="form-control" value="@Model?.Title" data-bind="title" />
        </div>

        <div class="col-md-6 mt-5">
            <input class="form-control" id="searchController" placeholder="جستجو در دسترسی ها" />
        </div>

        <div class="mt-10">

			<div class="col-md-12 pe-md-10 mb-10 mb-md-0">

                @foreach (var controller in accessControllers)
                { var dataProfiles = _dataTableProfileService.GetDataTableProfileListByEntityName(controller?.EntityType?.FullName ?? controller.Name);
                               
                     

                    <div class="m-0" data-section="controller" data-controllertitle="@controller.DisplayName">

                        <div class="d-flex align-items-center collapsible py-3 toggle mb-0 collapsed" data-bs-toggle="collapse" data-bs-target="#@controller.Name">
				 
						<div class="btn btn-sm btn-icon mw-20px btn-active-color-primary me-5">
							<i class="ki-duotone ki-minus-square toggle-on text-primary fs-1">
								<span class="path1"></span>
								<span class="path2"></span>
							</i>
							<i class="ki-duotone ki-plus-square toggle-off fs-1">
								<span class="path1"></span>
								<span class="path2"></span>
								<span class="path3"></span>
							</i>
						</div>

                                        <h4 class="text-gray-700 fw-bold cursor-pointer mb-0">@controller.DisplayName (@controller.Name)</h4>
					 
					</div>

                        <div id="@controller.Name" class="collapse fs-6 ms-1 row">
                            @if (controller.Actions.Any(c => c.ActionAccessType == ActionAccessType.Api))
                            {
                                <span>عملیات ها</span>
                                <div class="separator separator-dashed mb-4"></div>
                                @foreach (var action in controller.Actions.Where(c => c.ActionAccessType == ActionAccessType.Api).ToArray())
                                             {
                                              var path = action.Path;
                                    <div class="col-md-3 mb-3">
                                        <div class="form-check form-switch form-check-custom form-check-success form-check-solid">
                                                            <input class="form-check-input" type="checkbox" value="" data-accessActionType="@((int)action.ActionAccessType)" data-accessesActionItemtype="@((int)action.ActionAccessItemType)" id="@path" @(Model?.RoleAccesses?.Any(c => c.Path == path) == true ? "checked" : "")
                                                                   data-entityname="@(controller?.EntityType?.FullName ?? controller.Name)" />
                                            <label class="form-check-label" for="path">
                                                                 @action.DisplayName
                                            </label>
                                        </div>

                                    </div>
                                }

                            }
                 
                            @if (controller.Actions.Any(c => c.ActionAccessType == ActionAccessType.View))
                            {
                                <span>صفحات</span>
                                <div class="separator separator-dashed mb-4"></div>
                                @foreach (var action in controller.Actions.Where(c => c.ActionAccessType == ActionAccessType.View).ToArray())
                                {
                                    var path = action.Path;
                                    <div class="col-md-3 mb-3">
                                        <div class="form-check form-switch form-check-custom form-check-success form-check-solid">
                                                            <input class="form-check-input" type="checkbox" value="" data-accessActionType="@((int)action.ActionAccessType)" data-accessesActionItemtype="@((int)@action.ActionAccessItemType)" id="@path" @(Model?.RoleAccesses?.Any(c => c.Path == path) == true ? "checked" : "")
                                                                   data-entityname="@(controller?.EntityType?.FullName ?? controller.Name)" />
                                            <label class="form-check-label" for="path">
                                                                 @action.DisplayName
                                            </label>
                                        </div>

                                    </div>
                                }
                            }

                                        @if (dataProfiles.Any())
                                        {
                                             <span>نماهای داده</span>
                                             <div class="separator separator-dashed mb-4"></div>
                                             @foreach (var action in dataProfiles)
                                             {
                                                  var path = action.Id.ToString();
                                                  <div class="col-md-3 mb-3">
                                                       <div class="form-check form-switch form-check-custom form-check-success form-check-solid">
                                                            <input class="form-check-input" type="checkbox" data-accessActionType="@((int)ActionAccessType.DataProfile)" data-accessesActionItemtype="@((int)@ActionAccessItemType.DataProfile)" value="" id="@path" @(Model?.RoleAccesses?.Any(c => c.Path == path) == true ? "checked" : "")
                                                                   data-entityname="@(controller?.EntityType?.FullName ?? controller.Name)" />
                                                            <label class="form-check-label" for="path">
                                                                 @action.Title
                                                            </label>
                                                       </div>

                                                  </div>
                                             }
                                        }

                                   </div>
				 
		 
					<div class="separator separator-dashed"></div>
			 
				</div>
		        }
			</div>
              
        </div>
          </div>
    </div>
</div>
<script>

     $$("#searchController")
         .on("keyup", function () {

             let searchVal = $(this).val();
             $$("[data-section='controller']").each((i, c) => {
                 let title = $(c).attr("data-controllertitle")
                 if (title.includes(searchVal)) {
                     $(c).removeClass("d-none")
                 }
                 else
                 {
                     $(c).addClass("d-none")
                 }
             })
         });

     $$("#save").click(function () {
         debugger
         var model = $$(".card").dataBind();

         model.RoleAccesses = $$(".form-check-input:checked")
             .map((i,c) => {

                  var actionAccessType = $(c).data("accessactiontype");
                  var actionAccessItemType = $(c).data("accessesactionitemtype");
                  var entityname = $(c).data("entityname");
                 return {
                 path:$(c).attr("id"),
                 actionAccessType ,
                 actionAccessItemType,
                 entityname
                 };
             }).get();
             debugger;
         $$.post("/panel/SaveRole", model, function (r) {
             if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');

             toastr.success("ذخیره سازی با موفقیت انجام شد .");
             $(".card").dataBind(r);
         })
     })

</script>
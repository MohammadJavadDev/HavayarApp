@using System.Globalization
@using Entities.App.Bom
@using Entities.App.Inv
@using Entities.Base
@model ProductFormulItem
@{
	Layout = null;
	var rateText = Model?.UsingRate?.ToString("0.00", CultureInfo.InvariantCulture);
}
<div class="formul-item-form">
	<input type="hidden" data-bind="id" value="@Model?.Id" />
	<input type="hidden" data-bind="productFormulId" value="@Model?.ProductFormulId" />
	<div class="row g-3">
		<div class="col-md-12 form-group-inline">
			<label class="required">قطعه</label>
			@(Html.EntitySelector<Part>(
				"formulItemPartSelector",
				c => c.IsActive == IsActiveEnum.Active,
				c => new { Id = c.Id, Code = c.Code, Name = c.Name },
				c => new { c.Code, c.Name },
				"{Code} || {Name}",
				"partId",
				null,
				Model?.PartId > 0 ? Model.PartId.ToString() : null,
				true
			))
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
		<div class="col-md-6 form-group-inline">
			<label class="required">ضریب مصرف</label>
			<input type="text" class="form-control ltr" data-bind="usingRate" required inputmode="decimal"
				autocomplete="off" placeholder="1.00" value="@rateText" />
			<div class="text-muted fs-8 mt-1">عدد اعشاری، مثل 1.00 یا 0.50 یا 2</div>
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
	</div>
</div>

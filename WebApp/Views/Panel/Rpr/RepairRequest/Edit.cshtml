@using Entities.App.Crm
@using Entities.App.FIN
@using Entities.App.Gnr
@using Entities.App.Hcm
@using Entities.App.Inv
@using Entities.App.Rpr
@using Entities.App.Rpr.Enums
@using Entities.App.Sale
@using Entities.App.SLS
@using Entities.Auth
@using Entities.Base
@model RepairRequest
@{
	var hasAfterSale = ViewBag.HasAfterSaleAccess == true;
	var hasRepairs = ViewBag.HasRepairsAccess == true;
	var hasConfirm = ViewBag.HasConfirmAccess == true;
	var hasImaging = ViewBag.HasImagingAccess == true;
}

<div class="card">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(RepairRequest)">
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-print"
				action-name="printLabel" title="چاپ برچسب تعمیر"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-info" icon-class="fa fa-file"
				action-name="printSheet" title="چاپ شناسنامه"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-info" icon-class="fa fa-cogs"
				action-name="openParts" title="اقلام مصرفی"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-warning" icon-class="fa fa-comment"
				action-name="openComments" title="یادداشت‌ها"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-clock"
				action-name="openManHours" title="نفرساعت"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-paperclip"
				action-name="openAttachments" title="پیوست‌ها"></form-action-button>
			@if (hasConfirm)
			{
				<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-check"
					action-name="confirmPreCheck" title="تایید پیش‌بررسی"></form-action-button>
				<form-action-button color-class="btn-active-icon-dark btn-color-success" icon-class="fa fa-check"
					action-name="confirmPreCheck2" title="تایید پیش‌بررسی ۲"></form-action-button>
				<form-action-button color-class="btn-active-icon-dark btn-color-warning" icon-class="fa fa-check"
					action-name="confirmFinancial" title="تایید پیشنهاد مالی"></form-action-button>
				<form-action-button color-class="btn-active-icon-dark btn-color-warning" icon-class="fa fa-check"
					action-name="confirmFinancial2" title="تایید پیشنهاد مالی ۲"></form-action-button>
				<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-check"
					action-name="confirmFull" title="تایید نهایی"></form-action-button>
				<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-check"
					action-name="confirmFull2" title="تایید نهایی ۲"></form-action-button>
				<form-action-button color-class="btn-active-icon-dark btn-color-info" icon-class="fa fa-paper-plane"
					action-name="sendFinancial" title="ارسال پیشنهاد مالی"></form-action-button>
			}
		</form-action-buttons>
	</div>
</div>

<input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
<input type="hidden" data-bind="partFractionIds" value="@Model?.PartFractionIds" />

<div class="card my-2" id="afterSalesSection">
	<div class="card-body row">
		<span class="section-box-title">خدمات پس از فروش</span>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">شماره</label>
			<input class="form-control" data-bind="idNumber" value="@Model?.IdNumber" readonly />
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold required">مشتری</label>
			@(Html.EntitySelector<Customer>(
						"RepairRequestCustomerSelector",
						c => c.IsActive == IsActiveEnum.Active,
						c => new { Id = c.Id, Party_FullName = c.Party.FullName, Code = c.Code },
						c => new { c.Party.FullName, c.Code },
						"{Party.FullName} {Code}",
						"customerId",
						"customerName",
						Model?.CustomerId?.ToString()
						))
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
		<div class="col-md-2 form-group-inline">
			<label class="form-label fw-bold">تصویربرداری محتوا</label>
			<input class="form-check-input mt-2" type="checkbox" data-bind="hasContentProductionImaging" @(Model?.HasContentProductionImaging == true ? "checked" : "") />
		</div>
		<div class="col-md-2 form-group-inline">
			<label class="form-label fw-bold">تجهیز هوایار</label>
			<input class="form-check-input mt-2" type="checkbox" data-bind="isHavayarEquipment" @(Model?.IsHavayarEquipment == true ? "checked" : "") />
		</div>
	
	 
		<div class="col-md-12 form-group-inline">
			<label class="form-label fw-bold required">تجهیز</label>
			@(Html.EntitySelector<Part>(
				"RepairRequestProductSelector",
				c => c.IsActive == IsActiveEnum.Active,
				c => new { Id = c.Id, Code = c.Code, Name = c.Name },
				c => new { c.Code, c.Name },
				"{Code} {Name}",
				"productId",
				"productName",
				Model?.ProductId?.ToString()
			))
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>

		<div class="col-md-12 form-group-inline">
			<label class="form-label fw-bold ">محصول مادر</label>
				@(Html.EntitySelector<OrderDetailSerial>(
								"RepairRequestMotherProductSelector",
						c => c.IsActive == IsActiveEnum.Active  ,
								c => new { Id = c.Id, Serial = c.Serial, OrderDetailId = c.OrderDetailId, Seq = c.OrderDetail.Seq, Part_Code = c.OrderDetail.Part.Code, Part_Name = c.OrderDetail.Part.Name, CustomerId = c.OrderDetail.Sale_Order.CustomerId },
						c => new { c.OrderDetail.Part.Name, c.Serial, c.OrderDetail.Part.Code },
								"{Part_Name}  | {Part_Code}  |  {Serial}",
								"motherProductId",
								"motherProductName",
								Model?.MotherProductId?.ToString(),
								false,
								false,
								false,
								false,
								@"<div  >
								<span>نام کالا: {Part_Name}</span>
								</br>
								<span>کد کالا: {Part_Code}</span>
								</br>
								<span>سریال : {Serial}</span>
								</div>"
								))
 
			</div>
	  
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">سریال</label>
			<input class="form-control" data-bind="serial" asp-for="Serial" />
		</div>
	
		<div class="col-md-12 form-group-inline">
			<label class="form-label fw-bold">آدرس نمایندگی مشتری</label>
			@(Html.EntitySelector<Customer>(
				"RepairRequestAgencySelector",
				c => c.IsActive == IsActiveEnum.Active,
				c => new { Id = c.Id, Party_FullName = c.Party.FullName, Code = c.Code },
				c => new { c.Party.FullName, c.Code },
				"{Party.FullName} {Code}",
				"customerAgencyId",
				"customerAgencyName",
				Model?.CustomerAgencyId?.ToString()
			))
		</div>
		<div class="col-md-8 form-group-inline">
			<label class="form-label fw-bold">سایت مشتری</label>
			@(Html.EntitySelector<CustomerAddress>(
				"RepairRequestAddressSelector",
				c => c.IsActive == IsActiveEnum.Active,
				c => new { Id = c.Id, Title = c.Title, Address = c.Address, CustomerId = c.CustomerId },
				c => new { c.Title, c.Address },
				"{Title} {Address}",
				"customerAddressId",
				"customerAddressTitle",
				Model?.CustomerAddressId?.ToString()
			))
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">آدرس دستی</label>
			<input class="form-control" data-bind="customerAddressManual" asp-for="CustomerAddressManual" />
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold required">منطقه</label>
			@(Html.EntitySelector<Zone>(
				"RepairRequestZoneSelector",
				c => c.IsActive == IsActiveEnum.Active,
				c => new { Id = c.Id, Title = c.Title },
				c => new { c.Title },
				"{Title}",
				"zoneId",
				"zoneTitle",
				Model?.ZoneId?.ToString()
			))
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold required">مسئول منطقه</label>
			@(Html.EntitySelector<User>(
				"RepairRequestSupervisorSelector",
				c => c.IsActive == IsActiveEnum.Active,
				c => new { Id = c.Id, NameFa = c.NameFa ?? c.Name, Username = c.Username },
				c => new { c.NameFa, c.Name, c.Username },
				"{NameFa}",
				"zoneSupervisorId",
				"zoneSupervisorName",
				Model?.ZoneSupervisorId?.ToString()
			))
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">تلفن مشتری</label>
			<input class="form-control ltr" data-bind="customerPhone" asp-for="CustomerPhone" />
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold required">پذیرش نمایندگی</label>
			<input class="form-control" data-bind="representationReception" data-required="true" asp-for="RepresentationReception" />
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold required">مقصد پس از تعمیر</label>
			<select class="form-control" data-bind="destinationAfterRepair" data-required="true" asp-for="DestinationAfterRepair" asp-items="Html.GetEnumSelectList(typeof(DestinationAfterRepairEnum))">
				<option value="">انتخاب کنید</option>
			</select>
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
		<div class="col-md-2 form-group-inline">
			<label class="form-label fw-bold">گارانتی</label>
			<input class="form-check-input mt-2" type="checkbox" data-bind="isGuarantee" asp-for="IsGuarantee" />
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">مرکز هزینه</label>
			@(Html.EntitySelector<CostCenter>(
				"RepairRequestCostCenterSelector",
				c => c.IsActive == IsActiveEnum.Active,
				c => new { Id = c.Id, Number = c.Number, Title = c.Title },
				c => new { c.Number, c.Title },
				"{Number} {Title}",
				"costCenterId",
				"costCenterTitle",
				Model?.CostCenterId?.ToString()
			))
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold required">تاریخ ورود انبار</label>
			<input class="form-control" data-bind="entryShamsiDate" data-required="true" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.EntryMiladiDate" />
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
		<div class="col-md-8 form-group-inline">
			<label class="form-label fw-bold">آدرس مقصد</label>
			<input class="form-control" data-bind="destinationAddress" asp-for="DestinationAddress" />
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">شرح کار</label>
			<select class="form-control" data-bind="jobDescription" asp-for="JobDescription" asp-items="Html.GetEnumSelectList(typeof(RepairJobDescriptionEnum))">
				<option value="">انتخاب کنید</option>
			</select>
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">شماره پیش‌فاکتور</label>
			<input class="form-control" data-bind="preFactorNumber" asp-for="PreFactorNumber" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">شماره حواله فروش</label>
			<input class="form-control" data-bind="loanFormNumber" asp-for="LoanFormNumber" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">شماره برگشت امانی</label>
			<input class="form-control" data-bind="safekeepingReturnFormNumber" asp-for="SafekeepingReturnFormNumber" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">تاریخ برگشت امانی</label>
			<input class="form-control" data-bind="safekeepingReturnShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.SafekeepingReturnMiladiDate" />
		</div>
		<div class="col-md-12 form-group-inline">
			<label class="form-label fw-bold">خرابی به اظهار مشتری</label>
			<input class="form-control" data-bind="failureReason" asp-for="FailureReason" />
		</div>
		<div class="col-md-12 form-group-inline">
			<label class="form-label fw-bold">توضیحات</label>
			<textarea class="form-control" data-bind="comment" asp-for="Comment" rows="5"></textarea>
		</div>
	</div>
</div>

<div class="card my-2" id="repairsSection">
	<div class="card-body row">
		<span class="section-box-title">تعمیرات</span>
	 

		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">وضعیت</label>
			<select class="form-control" data-bind="status" asp-for="Status" asp-items="Html.GetEnumSelectList(typeof(RepairRequestStatusEnum))">
				<option value="">انتخاب کنید</option>
			</select>
		</div>
		<div class="col-md-6 form-group-inline">
			<label class="form-label fw-bold">تفصیل</label>
			@(Html.EntitySelector<DL>(
				"RepairRequestDlSelector",
				c => c.IsActive == IsActiveEnum.Active,
				c => new { Id = c.Id, Title = c.Title, Code = c.Code },
				c => new { c.Title, c.Code },
				"{Code} {Title}",
				"dlId",
				"dlTitle",
				Model?.DlId?.ToString()
			))
		</div>
		<div class="col-md-8 form-group-inline">
			<label class="form-label fw-bold">کارشناس</label>
			@(Html.EntitySelector<Personel>(
				"RepairRequestExpertSelector",
				c => c.IsActive == IsActiveEnum.Active,
				c => new { Id = c.Id, Name = c.Name, Family = c.Family, Code = c.Code },
				c => new { c.Name, c.Family, c.Code },
				"{Code} {Name} {Family}",
				"expertIds",
				"expertsInText",
				Model?.ExpertIds,
				false,
				true
			))
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
	
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">تاریخ شروع</label>
			<input class="form-control" data-bind="startShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.StartMiladiDate" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">تاریخ پایان</label>
			<input class="form-control" data-bind="endShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.EndMiladiDate" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">تاریخ ورود تعمیر</label>
			<input class="form-control" data-bind="repairEntranceShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.RepairEntranceMiladiDate" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">شماره فرم تحویل</label>
			<input class="form-control" data-bind="deliveryFormNumber" asp-for="DeliveryFormNumber" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">تاریخ تحویل انبار</label>
			<input class="form-control" data-bind="warehouseDeliveryShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.WarehouseDeliveryMiladiDate" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">تاریخ توافقی</label>
			<input class="form-control" data-bind="agreedShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.AgreedMiladiDate" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">تاریخ توافقی ۲</label>
			<input class="form-control" data-bind="agreed2ShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.Agreed2MiladiDate" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">تاریخ توافقی ۳</label>
			<input class="form-control" data-bind="agreed3ShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.Agreed3MiladiDate" />
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">تحویل‌گیرنده</label>
			<input class="form-control" data-bind="deliveringRecipient" asp-for="DeliveringRecipient" />
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">تاریخ درخواست خرید</label>
			<input class="form-control" data-bind="buyRequestShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.BuyRequestMiladiDate" />
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">تاریخ تأمین</label>
			<input class="form-control" data-bind="supplyShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.SupplyMiladiDate" />
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">تاریخ درخواست تست</label>
			<input class="form-control" data-bind="qcRequestShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@Model?.QcRequestMiladiDate" />
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">ایستگاه</label>
			@(Html.EntitySelector<RepairStation>(
				"RepairRequestStationSelector",
				c => c.IsActive == IsActiveEnum.Active,
				c => new { Id = c.Id, Title = c.Title },
				c => new { c.Title },
				"{Title}",
				"stationId",
				"stationTitle",
				Model?.StationId?.ToString()
			))
		</div>
		<div class="col-md-8 form-group-inline">
			<label class="form-label fw-bold">کسر قطعات</label>
			@(Html.EntitySelector<RepairRequestPartFraction>(
				"RepairRequestFractionSelector",
				c => c.IsActive == IsActiveEnum.Active,
				c => new { Id = c.Id, Title = c.Title },
				c => new { c.Title },
				"{Title}",
				"tempFractionId",
				"tempFractionName",
				""
			))
			<button type="button" class="btn btn-sm btn-light-primary mt-1" data-action="addFraction">افزودن کسر</button>
			<input class="form-control mt-1" data-bind="partFractionsInText" asp-for="PartFractionsInText" readonly />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">پیش‌بررسی</label>
			<input class="form-control" data-bind="preCheckShamsiDate" readonly value="@Model?.PreCheckShamsiDate" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">پیش‌بررسی ۲</label>
			<input class="form-control" data-bind="preCheck2ShamsiDate" readonly value="@Model?.PreCheck2ShamsiDate" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">پیشنهاد مالی</label>
			<input class="form-control" data-bind="financialProposalShamsiDate" readonly value="@Model?.FinancialProposalShamsiDate" />
		</div>
		<div class="col-md-3 form-group-inline">
			<label class="form-label fw-bold">تایید نهایی</label>
			<input class="form-control" data-bind="confirmShamsiDate" readonly value="@Model?.ConfirmShamsiDate" />
		</div>
		<div class="col-md-12 form-group-inline">
			<label class="form-label fw-bold">شرح تعمیر</label>
			<textarea class="form-control" data-bind="repairDescription" asp-for="RepairDescription" rows="8"></textarea>
		</div>
	</div>
</div>

<div id="repairContractorsSection" class="my-2">
	<div class="text-muted p-3">پس از ذخیره درخواست تعمیر، پیمانکاران اینجا نمایش داده می‌شود.</div>
</div>
<script>
	const hasAfterSale = @(hasAfterSale ? "true" : "false");
	const hasRepairs = @(hasRepairs ? "true" : "false");
	const hasImaging = @(hasImaging ? "true" : "false");

	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;
		const model = page.$pageEl.dataBind();
		if (hasAfterSale) {
			if (!model.productId) { toastr.error('تجهیز الزامی است', 'خطا'); return; }
			if (!model.customerId) { toastr.error('مشتری الزامی است', 'خطا'); return; }
			if (!model.zoneId) { toastr.error('منطقه الزامی است', 'خطا'); return; }
			if (!model.zoneSupervisorId) { toastr.error('مسئول منطقه الزامی است', 'خطا'); return; }
			if (!model.destinationAfterRepair) { toastr.error('مقصد پس از تعمیر الزامی است', 'خطا'); return; }
			if (!model.entryShamsiDate) { toastr.error('تاریخ ورود انبار الزامی است', 'خطا'); return; }
			if (!model.representationReception) { toastr.error('پذیرش نمایندگی الزامی است', 'خطا'); return; }
		}
		const $btn = $($btnAction.element).block();
		$$.post('save', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			loadRepairContractors();
			$btnAction.baseaction();
		});
	}
	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });

	function setSectionEnabled($section, enabled) {
		$section.find('input, select, textarea, button').prop('disabled', !enabled);
		if (!enabled) $section.css('opacity', '0.65');
	}
	if (!hasAfterSale) setSectionEnabled($$('#afterSalesSection'), false);
	if (!hasRepairs) setSectionEnabled($$('#repairsSection'), false);
	if (hasImaging)
		$$('[data-bind="hasContentProductionImaging"]').prop('disabled', false);

	function setupCustomerDependentSelector(selectorId) {
		const cascadeOpts = {
			filters: function () {
				const customerId = $$('#RepairRequestCustomerSelector').find('.entity-selector-value').val();
				return { CustomerId: customerId || '0' };
			},
			watchDependencies: ['#RepairRequestCustomerSelector']
		};
		const $el = $$(selectorId);
		let inst = $el.data('entitySelector') || $el.data('entitySelectorInstance');
		if (inst) {
			inst.extraFilters = cascadeOpts.filters;
			inst.options.watchDependencies = cascadeOpts.watchDependencies;
			if (typeof inst.watchDependencies === 'function') inst.watchDependencies();
		} else {
			$el.entitySelector(cascadeOpts);
		}
	}
	setupCustomerDependentSelector('#RepairRequestAddressSelector');
	setupCustomerDependentSelector('#RepairRequestMotherProductSelector');
	page.$pageEl.on('change', '[data-bind="customerId"]', function () {
		['#RepairRequestAddressSelector', '#RepairRequestMotherProductSelector'].forEach(function (selectorId) {
			const inst = $$(selectorId).data('entitySelectorInstance')
				|| $$(selectorId).data('entitySelector');
			if (inst && typeof inst.clearAll === 'function') inst.clearAll();
		});
	});

	function appendCsv(hiddenBind, textBind, id, text) {
		if (!id) { toastr.error('ابتدا مورد را انتخاب کنید'); return; }
		const $ids = $$('[data-bind="' + hiddenBind + '"]');
		const $text = $$('[data-bind="' + textBind + '"]');
		const ids = ($ids.val() || '').split(',').map(function (x) { return x.trim(); }).filter(Boolean);
		if (ids.indexOf(String(id)) >= 0) return;
		ids.push(String(id));
		$ids.val(ids.join(','));
		const current = ($text.val() || '').trim();
		$text.val(current ? (current + ' ، ' + text) : text);
	}
	page.$pageEl.on('click', '[data-action="addFraction"]', function () {
		const id = $$('#RepairRequestFractionSelector').find('.entity-selector-value').val();
		const text = $$('#RepairRequestFractionSelector').find('.entity-selector-text').val()
			|| $$('#RepairRequestFractionSelector').find('input[type="text"]').val();
		appendCsv('partFractionIds', 'partFractionsInText', id, text);
	});

	function openChild(path, title) {
		const id = page.$pageEl.dataBind().id;
		if (!id) { toastr.error('ابتدا ذخیره کنید'); return; }
		appController.addPage(path + id, true, title);
	}
	if (self.FormActionButtons.printLabel) {
		self.FormActionButtons.printLabel.onclick(function () {
			const id = page.$pageEl.dataBind().id;
			if (!id) { toastr.error('ابتدا ذخیره کنید'); return; }
			appController.addPage('/System/ReportBuilder/ViewReportByName/RepairRequestLabel?repairRequestId={\'values\':[\'' + id + '\'],\'condition\':\'=\'}&autoRun=True');
		});
	}
	if (self.FormActionButtons.printSheet) {
		self.FormActionButtons.printSheet.onclick(function () {
			const id = page.$pageEl.dataBind().id;
			if (!id) { toastr.error('ابتدا ذخیره کنید'); return; }
			appController.addPage('/System/ReportBuilder/ViewReportByName/RepairRequestID?repairRequestId={\'values\':[\'' + id + '\'],\'condition\':\'=\'}&autoRun=True');
		});
	}
	if (self.FormActionButtons.openParts) self.FormActionButtons.openParts.onclick(function () { openChild('/Panel/Rpr/RepairRequestPart/ListByParentId?repairRequestId=', 'اقلام مصرفی'); });
	if (self.FormActionButtons.openComments) self.FormActionButtons.openComments.onclick(function () { openChild('/Panel/Rpr/RepairRequestComment/ListByParentId?repairRequestId=', 'یادداشت‌ها'); });
	if (self.FormActionButtons.openManHours) self.FormActionButtons.openManHours.onclick(function () { openChild('/Panel/Rpr/RepairRequestManHour/ListByParentId?repairRequestId=', 'نفرساعت'); });
	if (self.FormActionButtons.openAttachments) self.FormActionButtons.openAttachments.onclick(function () { openChild('/Panel/Rpr/RepairRequestAttachment/ListByParentId?repairRequestId=', 'پیوست‌ها'); });

	function loadEmbeddedPartial(selector, url) {
		const $box = $$(selector);
		$box.block();
		page.getPartialView(url, function (r) {
			$box.block(false);
			if (!r) {
				$box.html('<div class="text-danger p-3">خطا در بارگذاری</div>');
				return;
			}
			const decoded = (window.appController && typeof appController.decodePartialResponse === 'function')
				? appController.decodePartialResponse(r)
				: { html: (typeof r === 'string' ? r : ''), scripts: [] };
			$box.html(decoded.html || '');
			const scripts = decoded.scripts || [];
			for (let i = 0; i < scripts.length; i++) {
				try {
					new Function('page', '$$', 'self', scripts[i])(page, $$, self);
				} catch (err) {
					console.error(err);
				}
			}
		});
	}
	function loadRepairContractors() {
		const id = page.$pageEl.dataBind().id;
		if (!id) return;
		loadEmbeddedPartial('#repairContractorsSection', '/Panel/Rpr/RepairRequestContractor/ListByParentId?repairRequestId=' + id);
	}
	loadRepairContractors();

	function confirmDateField(id, label) {
		return '<div class="text-end mb-3">'
			+ '<label class="form-label fw-bold d-block">' + label + '</label>'
			+ '<input id="' + id + '" class="form-control" readonly '
			+ 'data-persionDatePicker="true" '
			+ 'persion-datetimepicker=\'{"format":"YYYY/MM/DD","autoClose":true,"initialValue":false}\' />'
			+ '</div>';
	}
	function runConfirm(type, title, needAgreed) {
		const id = page.$pageEl.dataBind().id;
		if (!id) { toastr.error('ابتدا ذخیره کنید'); return; }
		Swal.fire({
			title: title,
			html: confirmDateField('swalConfirmDate', 'تاریخ')
				+ (needAgreed ? confirmDateField('swalAgreedDate', 'تاریخ توافقی') : ''),
			showCancelButton: true,
			confirmButtonText: 'ثبت',
			cancelButtonText: 'انصراف',
			didOpen: function () {
				if (typeof initPersionDatePicker === 'function')
					initPersionDatePicker($(Swal.getHtmlContainer()));
			},
			willClose: function () {
				$('.datepicker-plot-area, .datepicker-container').hide();
			},
			preConfirm: function () {
				const $box = $(Swal.getHtmlContainer());
				const dateShamsi = $box.find('#swalConfirmDate').val();
				if (!dateShamsi) {
					Swal.showValidationMessage('تاریخ را انتخاب کنید');
					return false;
				}
				return {
					dateShamsi: dateShamsi,
					agreedShamsiDate: needAgreed ? ($box.find('#swalAgreedDate').val() || null) : null
				};
			}
		}).then(function (result) {
			if (!result.isConfirmed) return;
			$$.post('confirm', {
				id: id,
				confirmType: type,
				dateShamsi: result.value.dateShamsi,
				agreedShamsiDate: result.value.agreedShamsiDate
			}, function (r) {
				if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
				toastr.success(title + ' انجام شد');
				appController.refreshCurrentPage();
			});
		});
	}
	if (self.FormActionButtons.confirmPreCheck) self.FormActionButtons.confirmPreCheck.onclick(function () { runConfirm(1, 'تایید پیش‌بررسی'); });
	if (self.FormActionButtons.confirmPreCheck2) self.FormActionButtons.confirmPreCheck2.onclick(function () { runConfirm(5, 'تایید پیش‌بررسی ۲'); });
	if (self.FormActionButtons.confirmFinancial) self.FormActionButtons.confirmFinancial.onclick(function () { runConfirm(2, 'تایید پیشنهاد مالی', true); });
	if (self.FormActionButtons.confirmFinancial2) self.FormActionButtons.confirmFinancial2.onclick(function () { runConfirm(6, 'تایید پیشنهاد مالی ۲'); });
	if (self.FormActionButtons.confirmFull) self.FormActionButtons.confirmFull.onclick(function () { runConfirm(3, 'تایید نهایی'); });
	if (self.FormActionButtons.confirmFull2) self.FormActionButtons.confirmFull2.onclick(function () { runConfirm(7, 'تایید نهایی ۲'); });
	if (self.FormActionButtons.sendFinancial) self.FormActionButtons.sendFinancial.onclick(function () { runConfirm(4, 'ارسال پیشنهاد مالی'); });
</script>

@using Entities.App.Law
@using Entities.App.Law.Enums
@model JudicialFileParty
<div class="row">
	<input type="hidden" data-bind="id" value="@Model?.Id" />
	<input type="hidden" data-bind="judicialFileId" value="@Model?.JudicialFileId" />
	<div class="col-md-12 form-group-inline">
		<label class="form-label fw-bold required">عنوان</label>
		<select class="form-control" data-bind="type" data-required="true" asp-for="Type" asp-items="Html.GetEnumSelectList(typeof(JudicialPartyTypeEnum))">
			<option value="">انتخاب کنید</option>
		</select>
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-12 form-group-inline">
		<label class="form-label fw-bold required">نام و نام خانوادگی / نام شرکت</label>
		<input class="form-control" data-bind="fullname" data-required="true" asp-for="Fullname" maxlength="50" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
</div>

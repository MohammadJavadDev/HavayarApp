@using Entities.App.Trn
@model Certificate

@{
     var participantName = Model?.CourseParticipant?.Participant != null
          ? (Model.CourseParticipant.Participant.FirstName + " " + Model.CourseParticipant.Participant.LastName)
          : (Model?.CourseCompanyParticipant?.Participant != null
               ? (Model.CourseCompanyParticipant.Participant.FirstName + " " + Model.CourseCompanyParticipant.Participant.LastName)
               : null);
     var trackTitle = Model?.CourseParticipantId != null ? "عمومی" : (Model?.CourseCompanyParticipantId != null ? "اختصاصی" : null);
}

<div class="card shadow-sm border-0">

     <div class="form-action-buttons border-bottom p-3">
          <form-action-buttons entity-type="typeof(Certificate)">
          </form-action-buttons>
     </div>

     <div class="card-body">

          <div class="row mb-4">
               <div class="col-12">
                    <h4 class="fw-bold text-dark mb-0">
                         گواهی‌نامه دوره
                    </h4>
               </div>
          </div>

          <input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
          <input class="form-control" data-bind="courseParticipantId" value="@Model?.CourseParticipantId" type="hidden" />
          <input class="form-control" data-bind="courseCompanyParticipantId" value="@Model?.CourseCompanyParticipantId" type="hidden" />

          <div class="row g-3">

               <div class='col-md-4 form-group-inline'>
                    <label class='form-label fw-bold'>شرکت‌کننده</label>
                    <input class='form-control' readonly value="@participantName" />
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class='col-md-4 form-group-inline'>
                    <label class='form-label fw-bold'>مسیر ثبت‌نام</label>
                    <input class='form-control' readonly value="@trackTitle" />
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class='col-md-4 form-group-inline'>
                    <label class='form-label fw-bold'>شماره گواهی</label>
                    <input class='form-control' dir="ltr" readonly data-bind='certificateNo'
                           asp-for='CertificateNo' placeholder="خودکار — پس از ذخیره تولید می‌شود" />
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class='col-md-4 form-group-inline'>
                    <label class='form-label fw-bold'>قالب گواهی</label>
                    <input class='form-control' dir="ltr" readonly data-bind='templateKey'
                           asp-for='TemplateKey' placeholder="خودکار — در لحظه صدور انتخاب می‌شود" />
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class='col-md-4 form-group-inline'>
                    <label class='form-label fw-bold'>تاریخ صدور</label>
                    <input class='form-control' data-bind='issueShamsiDate' data-persionDatePicker="true"
                           persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                           value='@Model?.IssueMiladiDate' />
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class='col-md-12 form-group-inline'>
                    <label class='form-label fw-bold'>توضیحات</label>
                    <textarea class='form-control' data-bind='description'
                              asp-for='Description'>@Model?.Description</textarea>
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

          </div>

     </div>
</div>

<div class="card mt-4 border-0 shadow-sm">
     <div class="card-body">
          <div class="row text-muted">

               <div class="col-md-3">
                    <span class="fw-bold">ایجاد کننده :</span>
                    <span data-bind="createdByName">@Model?.CreatedByName</span>
               </div>

               <div class="col-md-3">
                    <span class="fw-bold">تاریخ ایجاد :</span>
                    <span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
               </div>

               <div class="col-md-3">
                    <span class="fw-bold">ویرایش کننده :</span>
                    <span data-bind="modifiedByName">@Model?.ModifiedByName</span>
               </div>

               <div class="col-md-3">
                    <span class="fw-bold">تاریخ ویرایش :</span>
                    <span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
               </div>

          </div>
     </div>
</div>
<script>
     function savefn($btnAction) {
          if (validateError(page.$pageEl)) return;

          const model = page.$pageEl.dataBind();
          const $btn = $($btnAction.element).block();

          $$.post('save', model, function (r) {
               $btn.block(false);

               if (!r.isSuccess) {
                    toastr.error(r.message, 'خطا');
                    return;
               }

               toastr.success('ذخیره سازی با موفقیت انجام شد');
               page.$pageEl.dataBind(r.data);
               $btnAction.baseaction();
          });
     }

     self.FormActionButtons.save.onclick(function () { savefn(this); });
     self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
     self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>

@using Entities.App.Epms;
@using Entities.App.Gnr
@using Entities.App.Hrm
@using Entities.Auth
@model Proposal
<div class="card">
	<div class="form-action-buttons"><form-action-buttons entity-type="typeof(Proposal)"></form-action-buttons></div>
	<div class="card-body row">
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class='col-md-3'>
			<label class='required'>عنوان</label>
			<input class='form-control' data-bind='title' required asp-for='Title' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>کد</label>
			<input class='form-control' data-bind='code' asp-for='Code' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>



		<div class="col-md-3">
			<label class='required'>واحد درخواست دهنده</label>
			@(Html.EntitySelector<OrgUnit>
						(
							"OrgUnitId",
						 c=>c.IsActive == Entities.Base.IsActiveEnum.Active,
						c => new
						{
							Id = c.Id,
							Title = c.Title,

						},
						c => new { c.Id, c.Title },
						"{Title}",
						"requestedOrgUnitId",
						null,
						Model?.RequestedOrgUnitId.ToString(),
						true
						))
		 

		</div>
		<div class="col-md-3">
			<label class=''>صنعت</label>
			@(Html.EntitySelector<PartyIndustry>
						(
						"PartyIndustryId",
						c => c.IsActive == Entities.Base.IsActiveEnum.Active,
						c => new
						{
							Id = c.Id,
							Title = c.Title,

						},
						c => new { c.Id, c.Title },
						"{Title}",
						"PartyIndustryId",
						null,
						Model?.PartyIndustryId?.ToString()
						)
						)


		</div>

		<div class="col-md-12">
			<label class='required'>کارشناسان فروش</label>
			@(Html.EntitySelector<User>
						(
						"SalesExperts",
						c => c.IsActive == Entities.Base.IsActiveEnum.Active,
						c => new
						{
							Id = c.Id,
							Name = c.Name,

						},
						c => new { c.Id, c.Name },
						"{Name}",
						"SalesExpertIds",
						"SalesExperts",
						string.Join(',', Model?.SalesExpertIds),
						true,
						true
						))


		</div>
		 
		<div class='col-md-3'>
			<label class='required'>نوع پروپوزال درخواستی</label>
			<select class='form-control' data-bind='proposalRequest' asp-for='ProposalRequest'
				asp-items="Html.GetEnumSelectList(typeof(Entities.App.Epms.Enums.ProposalRequestEnum))"
				   required>
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class='required'>وضعیت</label>
			<select class='form-control' data-bind='status' asp-for='Status'
				asp-items="Html.GetEnumSelectList(typeof(Entities.App.Epms.Enums.ProposalStatusEnum))"
				   required>
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>



		<div class='col-md-3'>
			<label class=''>نام مناقصه</label>
			<input class='form-control' data-bind='tenderName' asp-for='TenderName' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>



		<div class="col-md-3">

			<label class=''>مدیر فروش</label>
			@(Html.EntitySelector<User>
						(
						"SalesManagerId",
						c => c.IsActive == Entities.Base.IsActiveEnum.Active,
						c => new
						{
							Id = c.Id,
							Name = c.Name,

						},
						c => new { c.Id, c.Name },
						"{Name}",
						"SalesManagerId",
						null,
						Model?.SalesManagerId?.ToString()
						)
						)
 

		</div>



		<div class='col-md-3'>
			<label class='required'>
				تاریخ شروع شمسی
			</label>
			<input class='form-control' data-bind='startShamsiDate' data-persionDatePicker="true"
				  persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true}'
				value='@Model?.StartMiladiDate'
				  required />
		</div>



		<div class='col-md-3'>
			<label class='required'>
				تاریخ مناقصه شمسی
			</label>
			<input class='form-control' data-bind='tenderShamsiDate' data-persionDatePicker="true"
				persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true}'
				value='@Model?.TenderMiladiDate'
				  required />
		</div>




		<div class="col-md-3">

			<label class=''>سرپرست فروش</label>
			@(Html.EntitySelector<User>
						(
						"PartyIndustryId",
						c => c.IsActive == Entities.Base.IsActiveEnum.Active,
						c => new
						{
							Id = c.Id,
							Name = c.Name,

						},
						c => new { c.Id, c.Name },
						"{Name}",
						"SalesSupervisorId",
						null,
						Model?.SalesSupervisorId?.ToString()
						)
						)
 

		</div>



		<div class='col-md-3'>

			<label class=''>نوع مدرک درخواستی</label>
			@(Html.EntitySelector<VpisType>
						(
						"PartyIndustryId",
						c => c.IsActive == Entities.Base.IsActiveEnum.Active,
						c => new
						{
							Id = c.Id,
							Title = c.Title,

						},
						c => new { c.Id, c.Title },
						"{Title}",
						"VpisTypeId",
						null,
						Model?.VpisTypeId?.ToString()
						)
						)
 
		</div>



		<div class='col-md-3'>
			<label class=''>بازنگری</label>
			<input class='form-control' data-bind='revision' data-invalidMessage='فقط عداد'
				data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='Revision'
				disabled/>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>توضیحات بازنگری</label>
			<input class='form-control' data-bind='revisionDescription' asp-for='RevisionDescription' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>
		<div class='col-md-12'>
			<label class=''>کامنت</label>
			<textarea class='form-control' data-bind='comment' asp-for='Comment'>@Model.Comment</textarea>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-12'>

			<div data-tab-item-manager="proposalItems" data-item-selector=".entity-item">

				<ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-transparent fs-4 fw-bold mb-5"
					role="tablist">
				 
					<li class="nav-item" role="presentation">
						<a class="nav-link active" data-bs-toggle="tab" href="#proposalAttachmentsTab" role="tab"
							aria-selected="false">
							<span class="svg-icon svg-icon-2 me-2">

							</span>
							پیوست
						</a>
					</li>
					<li class="nav-item" role="presentation">
						<a class="nav-link" data-bs-toggle="tab" href="#proposalDocumentsTab" role="tab"
							aria-selected="false">
							<span class="svg-icon svg-icon-2 me-2">

							</span>
							مدارک
						</a>
					</li>
				</ul>

				<div class="tab-content">
					 
					<div class="tab-pane fade show active" id="proposalAttachmentsTab" role="tabpanel"
						data-add-url="/Panel/Proposal/ProposalAttachmentPartial">
						<div id='ProposalAttachmentContainer' class="entity-item-container">
							@if (Model?.ProposalAttachment != null)
							{
								@foreach (var item in Model.ProposalAttachment)
								{
									<div data-item-id="@(item.Id ?? 0)">
										@await Html.PartialAsync("_ProposalAttachmentPartial.cshtml", item)
									</div>
								}
							}
						</div>
					</div>


					<div class="tab-pane fade" id="proposalDocumentsTab" role="tabpanel"
						data-add-url="/Panel/Proposal/ProposalDocumentPartial">
						<div id='ProposalDocumentsContainer' class="entity-item-container">
							@if (Model?.ProposalDocuments != null)
							{
								@foreach (var item in Model.ProposalDocuments)
								{
									<div data-item-id="@(item.Id ?? 0)">
										@await Html.PartialAsync("_ProposalDocumentPartial.cshtml", item)
									</div>
								}
							}
						</div>
					</div>
				</div>


			</div>
		</div>

	</div>
	<div class='card-footer row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>

		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>

		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>

		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>



<script>

	function savefn($btnAction) {
		if (validateError($$('.card'))) { return; }
		var model = $$('.card').dataBind();
		const $btn = $(this.element).block();
		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				$$('.card').dataBind(r.data);
				$btnAction.baseaction();
			})
	}


	self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })




	 

</script>

@model WebApp.Controllers.Dynamic.Inv.PartBookPrintVm
@{
	Layout = null;
}
<style>
	.partlist-print {
		--pl-border: #111;
		--pl-muted: #444;
		font-family: Tahoma, "Segoe UI", Arial, sans-serif;
		color: #111;
		background: #fff;
		max-width: 210mm;
		margin: 0 auto;
		padding: 8px 12px 24px;
		direction: rtl;
	}
	.partlist-print .no-print { margin-bottom: 12px; }
	.partlist-print .no-print button {
		font-family: Tahoma, sans-serif;
		padding: 6px 16px;
		cursor: pointer;
		border: 1px solid #888;
		background: #f5f5f5;
		border-radius: 4px;
	}
	.partlist-print .report-frame {
		border: 2px solid var(--pl-border);
		padding: 0;
	}
	.partlist-print .page-header {
		display: grid;
		grid-template-columns: 1.1fr 1.4fr 1.1fr;
		border-bottom: 2px solid var(--pl-border);
		min-height: 88px;
		direction: ltr;
	}
	.partlist-print .page-header > div {
		padding: 10px 12px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 6px;
	}
	.partlist-print .hdr-meta {
		border-right: 2px solid var(--pl-border);
		font-size: 12px;
	}
	.partlist-print .hdr-meta .row-line {
		display: flex;
		align-items: baseline;
		gap: 6px;
	}
	.partlist-print .hdr-meta .lbl { color: var(--pl-muted); white-space: nowrap; }
	.partlist-print .hdr-meta .val { font-weight: bold; }
	.partlist-print .hdr-title {
		border-right: 2px solid var(--pl-border);
		text-align: center;
		font-family: "Times New Roman", Times, serif;
		font-size: 26px;
		font-weight: bold;
		color: #555;
		letter-spacing: 0.5px;
	}
	.partlist-print .hdr-logo {
		align-items: center;
	}
	.partlist-print .hdr-logo img {
		max-width: 180px;
		max-height: 56px;
		object-fit: contain;
	}
	.partlist-print .section-block {
		padding: 16px 20px 20px;
		page-break-inside: avoid;
	}
	.partlist-print .section-block + .section-block {
		border-top: 2px solid var(--pl-border);
		page-break-before: always;
	}
	.partlist-print .section-title {
		text-align: center;
		font-size: 18px;
		font-weight: bold;
		margin: 4px 0 12px;
		direction: rtl;
	}
	.partlist-print .section-image {
		display: flex;
		justify-content: center;
		margin: 0 auto 16px;
	}
	.partlist-print .section-image img {
		max-width: 100%;
		width: 78%;
		max-height: 420px;
		object-fit: contain;
		display: block;
	}
	.partlist-print .parts-table {
		width: 92%;
		margin: 0 auto;
		border-collapse: collapse;
		font-size: 12px;
		direction: ltr;
	}
	.partlist-print .parts-table th,
	.partlist-print .parts-table td {
		border: 1px solid #222;
		padding: 7px 8px;
		text-align: center;
		vertical-align: middle;
	}
	.partlist-print .parts-table thead th {
		font-weight: bold;
		background: #f7f7f7;
	}
	.partlist-print .parts-table .col-ref { width: 70px; }
	.partlist-print .parts-table .col-code { width: 140px; }
	.partlist-print .parts-table .col-qty { width: 70px; }
	.partlist-print .parts-table .col-desc { text-align: center; }
	.partlist-print .report-footer {
		border-top: 2px solid var(--pl-border);
		padding: 14px 18px 16px;
		font-size: 12px;
		line-height: 1.55;
		direction: ltr;
		text-align: left;
		color: #222;
	}
	.partlist-print .report-footer div { margin: 0 0 2px; }
	.partlist-print .empty-msg {
		padding: 24px;
		text-align: center;
		font-size: 14px;
		direction: rtl;
	}
	@@media print {
		body * { visibility: hidden !important; }
		.partlist-print,
		.partlist-print * { visibility: visible !important; }
		.partlist-print {
			position: absolute;
			left: 0;
			top: 0;
			width: 100%;
			max-width: none;
			margin: 0;
			padding: 0;
		}
		.partlist-print .no-print { display: none !important; }
		.partlist-print .report-frame { border-width: 2px; }
		.partlist-print .section-block + .section-block {
			page-break-before: always;
		}
		.partlist-print .section-block,
		.partlist-print .parts-table tr {
			page-break-inside: avoid;
		}
		@@page {
			size: A4;
			margin: 10mm 8mm;
		}
	}
</style>

<div class="partlist-print">
	<div class="no-print">
		<button type="button" data-action="printPartList">چاپ</button>
	</div>

	<div class="report-frame">
		<header class="page-header">
			<div class="hdr-meta">
				<div class="row-line">
					<span class="lbl">Part Code:</span>
					<span class="val">@(Model.ProductCode ?? "")</span>
				</div>
				<div class="row-line">
					<span class="lbl">Part Model:</span>
					<span class="val">@(Model.ProductModel ?? "")</span>
				</div>
			</div>
			<div class="hdr-title">Part Book</div>
			<div class="hdr-logo">
				<img src="/panelLib/media/havayar_logo_sign.svg" alt="Havayar" />
			</div>
		</header>

		@if (Model.Sections == null || Model.Sections.Count == 0)
		{
			<div class="empty-msg">ردیف قابل چاپی یافت نشد.</div>
		}
		else
		{
			foreach (var sec in Model.Sections)
			{
				<section class="section-block">
					<div class="section-title">@sec.Title</div>
					<div class="section-image">
						@if (!string.IsNullOrWhiteSpace(sec.PictureUrl))
						{
							<img src="@sec.PictureUrl" alt="" />
						}
					</div>
					@if (sec.Items != null && sec.Items.Count > 0)
					{
						<table class="parts-table">
							<thead>
								<tr>
									<th class="col-ref">Ref.No</th>
									<th class="col-code">Part Num</th>
									<th class="col-qty">Qty</th>
									<th class="col-desc">Description</th>
								</tr>
							</thead>
							<tbody>
							@foreach (var item in sec.Items)
							{
								<tr>
									<td>@item.Order</td>
									<td>@item.PartCode</td>
									<td>@(item.UsingRate % 1 == 0 ? ((int)item.UsingRate).ToString() : item.UsingRate.ToString("0.##"))</td>
									<td class="col-desc">@item.LatinName</td>
								</tr>
							}
							</tbody>
						</table>
					}
				</section>
			}
		}

		<footer class="report-footer">
			<div>Office Address : No. 12, 14th St, Gandi St., Tehran, Iran</div>
			<div>Phone :(+9821) 8820 2424</div>
			<div>Plant Address: Baharestan Complex, Karaj, Iran</div>
			<div>Phone :(+9826) 3476 0145~151</div>
			<div>Fax : (+9821) 8820 2425</div>
			<div>Website: www.havayar.com</div>
		</footer>
	</div>
</div>

<script>
	$$('[data-action="printPartList"]').on('click', function () {
		window.print();
	});
</script>

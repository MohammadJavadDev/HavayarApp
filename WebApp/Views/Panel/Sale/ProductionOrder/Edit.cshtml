								Model?.SalesAgencyId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class="col-md-3">
							<label class=''>شهر نصب</label>
							@(Html.EntitySelector<Region>(
								"InstallationCitySelector",
								c => c.IsActive == Entities.Base.IsActiveEnum.Active,
								c => new
								{
									Id = c.Id, Name = c.Name
								},
								c => new { c.Name },
								"{Name}",
								"InstallationCityId",
								"InstallationCityName",
								Model?.InstallationCityId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='isNeedInspectionBeforePacking' class="form-check-input" type="checkbox" asp-for='IsNeedInspectionBeforePacking' />
								<label class="form-check-label" asp-for='IsNeedInspectionBeforePacking'>
									نیاز به بازرسی قبل از بسته‌بندی
								</label>
							</div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='hasContractor' class="form-check-input" type="checkbox" asp-for='HasContractor' />
								<label class="form-check-label" asp-for='HasContractor'>
									دارای پیمانکار
								</label>
							</div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='compressorHouseIsReady' class="form-check-input" type="checkbox" asp-for='CompressorHouseIsReady' />
								<label class="form-check-label" asp-for='CompressorHouseIsReady'>
									کمپرسورخانه آماده است
								</label>
							</div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='installationIsByHy' class="form-check-input" type="checkbox" asp-for='InstallationIsByHy' />
								<label class="form-check-label" asp-for='InstallationIsByHy'>
									نصب بعهده هوایار
								</label>
							</div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='hasFinancialGuarantee' class="form-check-input" type="checkbox" asp-for='HasFinancialGuarantee' />
								<label class="form-check-label" asp-for='HasFinancialGuarantee'>
									دارای تعهدات مالی
								</label>
							</div>
						</div>

						<div class='col-md-3'>
							<label class=''>توضیحات فروش</label>
							<input class='form-control' data-bind='salesComment'  asp-for='SalesComment' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>توضیحات </label>
							<input class='form-control' data-bind='comment'  asp-for='Comment' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>


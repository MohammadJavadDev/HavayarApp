@{
     ViewData["Title"] = "طراح گزارش";
 
}

<link href="~/panellib/css/query-designer.css" rel="stylesheet" />

<script>
     window.__reportId = @(ViewBag.ReportId != null ? ViewBag.ReportId : "null");
     window.__reportMode = "@(ViewBag.ReportMode ?? "")";
</script>

<div class="row mb-2 p-3">
     <div class="col-md-6">
          <label for="reportName" class="form-label">
               <strong>نام گزارش (یکتا)</strong>
               <span class="text-danger">*</span>
          </label>
          <input type="text" id="reportName" class="form-control form-control-sm" placeholder="مثال: rpt_users_list" required>
     </div>
     <div class="col-md-6">
          <label for="reportTitle" class="form-label">
               <strong>عنوان نمایشی</strong>
               <span class="text-danger">*</span>
          </label>
          <input type="text" id="reportTitle" class="form-control form-control-sm" placeholder="مثال: لیست کاربران" required>
     </div>
</div>

<div class="container-fluid h-100">
     <!-- انتخاب حالت -->
     <div id="modeSelection" class="mode-selection py-5">
          <h4 class="text-center mb-4">نوع ایجاد گزارش را انتخاب کنید</h4>
          <div class="row justify-content-center g-4">
               <div class="col-md-5">
                    <div class="card mode-card h-100 cursor-pointer" data-mode="design">
                         <div class="card-body text-center py-5">
                              <i class="bi bi-diagram-3 display-4 text-primary mb-3"></i>
                              <h5 class="card-title">طراحی بصری</h5>
                              <p class="card-text text-muted">جداول، روابط و فیلترها را به صورت بصری طراحی کنید</p>
                         </div>
                    </div>
               </div>
               <div class="col-md-5">
                    <div class="card mode-card h-100 cursor-pointer" data-mode="write">
                         <div class="card-body text-center py-5">
                              <i class="bi bi-code-slash display-4 text-success mb-3"></i>
                              <h5 class="card-title">نوشتن Query</h5>
                              <p class="card-text text-muted">مستقیماً Query SQL را بنویسید</p>
                         </div>
                    </div>
               </div>
          </div>
     </div>

     <!-- محتوای اصلی - حالت طراحی -->
     <div id="designModeContent" class="d-none">
          <div class="row h-100">
               <!-- Sidebar - لیست جداول -->
               <div class="col-md-3 border-start designer-sidebar">
                    <div class="sidebar-header p-3 border-bottom">
                         <h5 class="mb-3">
                              <i class="bi bi-list-ul"></i>
                              جداول و ویوها
                         </h5>
                         <div class="input-group input-group-sm">
                              <input type="text"
                                     id="tableSearch"
                                     class="form-control"
                                     placeholder="جستجوی جدول..."
                                     autocomplete="off">
                              <span class="input-group-text">
                                   <i class="bi bi-search"></i>
                              </span>
                         </div>
                    </div>
                    <div class="sidebar-body p-2" style="max-height: 45vh;">
                         <div id="tablesList">
                              <!-- لیست جداول به صورت دینامیک بارگذاری می‌شود -->
                              <div class="text-center p-3">
                                   <div class="spinner-border spinner-border-sm text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                   </div>
                                   <p class="text-muted mt-2 mb-0">در حال بارگذاری جداول...</p>
                              </div>
                         </div>
                    </div>

                    <div class="sidebar-footer p-3 border-top bg-light">
                         <h6 class="mb-2">
                              <i class="bi bi-filter"></i>
                              فیلترها
                         </h6>
                         <div id="filtersListContainer" class="filters-list-container">
                              <div id="filtersList" class="filters-list">
                                   <!-- فیلترها به صورت دینامیک اضافه می‌شوند -->
                              </div>
                              <div id="filtersEmpty" class="text-muted small text-center py-2">
                                   فیلتری اضافه نشده
                              </div>
                         </div>
                    </div>
                    <div class="sidebar-parameters p-3 border-top bg-light" style="max-height: 28vh; overflow-y: auto;">
                         <h6 class="mb-2">
                              <i class="bi bi-input-cursor-text"></i>
                              پارامترها
                         </h6>
                         <p class="small text-muted mb-2">در فیلترها یا Query از <code>@@ParamName</code> استفاده کنید</p>
                         <div class="mb-2">
                              <button type="button" id="btnAddParameter" class="btn btn-outline btn-outline-primary w-100">
                                   <i class="bi bi-plus"></i> پارامتر جدید
                              </button>
                         </div>
                         <div id="parametersList" class="parameters-list small">
                              <!-- پارامترهای داینامیک -->
                         </div>
                         <div id="parametersEmpty" class="text-muted text-center py-2">
                              پارامتر داینامیکی تعریف نشده
                         </div>
                         <details class="mt-2">
                              <summary class="small cursor-pointer">پارامترهای از پیش تعریف شده</summary>
                              <div id="builtInParamsList" class="mt-1 small text-muted" style="max-height: 120px; overflow-y: auto;">
                                   <div class="text-center py-2">در حال بارگذاری...</div>
                              </div>
                         </details>
                    </div>
               </div>

               <!-- Main Content -->
               <div class="col-md-9 d-flex flex-column">
                    <!-- Toolbar -->
                    <div class="designer-toolbar border-bottom p-2 bg-light">
                         <div class="d-flex justify-content-between align-items-center">
                              <div class="btn-group btn-group-sm" role="group">
                                   <button type="button" id="btnZoomOut" class="btn btn-outline-secondary" title="کوچک‌نمایی">
                                        <i class="bi bi-zoom-out"></i>
                                   </button>
                                   <button type="button" id="btnFitView" class="btn btn-outline-secondary" title="نمای کامل">
                                        <i class="bi bi-arrows-angle-expand"></i>
                                   </button>
                                   <button type="button" id="btnZoomIn" class="btn btn-outline-secondary" title="بزرگ‌نمایی">
                                        <i class="bi bi-zoom-in"></i>
                                   </button>
                              </div>

                              <div class="btn-group btn-group-sm" role="group">
                                   <button type="button" id="btnClearDiagram" class="btn btn-outline-danger" title="پاک کردن دیاگرام">
                                        <i class="bi bi-trash"></i>
                                        پاک کردن
                                   </button>
                              </div>
                         </div>
                    </div>

                    <!-- محتوای اصلی - یک نمای واحد -->
                    <div class="flex-grow-1 border border-top-0 p-3 d-flex flex-column" style="min-height: 0;">
                         <!-- ۱. دیاگرام -->
                         <div class="diagram-container position-relative mb-3" style="max-height: 74vh; min-height: 200px;">
                              <div class="diagram-scroll-wrapper h-100">
                                   <div id="diagramCanvas" class="position-relative">
                                        <div class="empty-state">
                                             <i class="bi bi-diagram-3 text-muted" style="font-size: 4rem;"></i>
                                             <h5 class="text-muted mt-3">دیاگرام خالی است</h5>
                                             <p class="text-muted">جداول را از سمت راست به اینجا بکشید</p>
                                        </div>
                                   </div>
                              </div>
                         </div>

                         <!-- ۲. تنظیمات ستون‌ها -->
                         <div class="mb-3 flex-shrink-0">

                              <h6 class="mb-2">
                                   <i class="bi bi-gear"></i>
                                   تنظیمات ستون‌ها
                              </h6>
                              <div class="table-responsive">
                                   <table id="columnsTable" class="table table-sm table-bordered mb-0">
                                        <thead class="table-light" style="position: sticky; top: 0; background: #f8f9fa; z-index: 1;">
                                             <tr>
                                                  <th style="width: 18%;">ستون</th>
                                                  <th style="width: 15%;">عنوان نمایشی</th>
                                                  <th style="width: 12%;">نوع</th>
                                                  <th style="width: 10%;">Group By</th>
                                                  <th style="width: 12%;">Aggregate</th>
                                                  <th style="width: 12%;">مرتب‌سازی</th>
                                                  <th style="width: 8%;">ترتیب</th>
                                             </tr>
                                        </thead>
                                        <tbody id="columnsTableBody">
                                             <tr>
                                                  <td colspan="7" class="text-center text-muted">
                                                       ستونی انتخاب نشده است
                                                  </td>
                                             </tr>
                                        </tbody>
                                   </table>
                              </div>
                         </div>

                         <!-- ۳. نمایش کد SQL -->
                         <div class="flex-grow-1 d-flex flex-column" style="min-height: 0;">
                              <div class="mb-2 d-flex justify-content-between align-items-center">
                                   <span class="fw-bold"><i class="bi bi-code-slash"></i> Query SQL</span>
                                   <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" id="btnValidateQuery" class="btn btn-outline btn-outline-success">
                                             <i class="bi bi-check-circle"></i> اعتبارسنجی
                                        </button>
                                        <button type="button" id="btnPreviewQuery" class="btn btn-outline btn-outline-info">
                                             <i class="bi bi-eye"></i> پیش‌نمایش
                                        </button>
                                   </div>
                              </div>
                              <textarea id="queryEditor"
                                        class="form-control font-monospace flex-grow-1"
                                        dir="ltr"
                                        placeholder="Query به صورت خودکار ساخته می‌شود یا می‌توانید دستی ویرایش کنید..."
                                        style="min-height: 120px;"></textarea>
                              <div class="alert alert-info py-2 mt-2 mb-0 small" role="alert">
                                   <i class="bi bi-info-circle"></i>
                                   Query به صورت خودکار با هر تغییر بروزرسانی می‌شود.
                              </div>
                              <div class="mt-3 d-flex justify-content-between">
                                   <button type="button" id="btnCancel" class="btn btn-secondary">
                                        <i class="bi bi-x-circle"></i> انصراف
                                   </button>
                                   <button type="button" id="btnSaveReport" class="btn btn-success">
                                        <i class="bi bi-save"></i> ذخیره گزارش
                                   </button>
                              </div>
                         </div>
                    </div>
               </div>
          </div>
     </div>

     <!-- محتوای حالت نوشتن Query -->
     <div id="writeModeContent" class="d-none p-4">
          <div class="mb-3">
               <label for="queryEditorWrite" class="form-label">Query SQL</label>
               <textarea id="queryEditorWrite" class="form-control font-monospace" rows="12" dir="ltr" placeholder="SELECT * FROM ..."></textarea>
          </div>
          <div class="btn-group mb-3">
               <button type="button" id="btnValidateQueryWrite" class="btn btn-outline btn-outline-success">اعتبارسنجی</button>
               <button type="button" id="btnPreviewQueryWrite" class="btn btn-outline btn-outline-info">پیش‌نمایش</button>
          </div>
          <div id="writeModeColumnsSection" class="mb-3 d-none">
               <h6 class="mb-2"><i class="bi bi-gear"></i> تنظیمات ستون‌ها (پس از پیش‌نمایش)</h6>
               <p class="text-muted small mb-2">پس از گرفتن پیش‌نمایش، نوع و عنوان نمایشی هر ستون را مشخص کنید.</p>
               <div class="table-responsive">
                    <table id="writeModeColumnsTable" class="table table-sm table-bordered mb-0">
                         <thead class="table-light">
                              <tr>
                                   <th style="width: 22%;">ستون</th>
                                   <th style="width: 25%;">عنوان نمایشی</th>
                                   <th style="width: 20%;">نوع</th>
                              </tr>
                         </thead>
                         <tbody id="writeModeColumnsTableBody"></tbody>
                    </table>
               </div>
          </div>
          <div class="mt-3">
               <button type="button" id="btnSaveReportWrite" class="btn btn-success btn-lg">
                    <i class="bi bi-save"></i> ذخیره گزارش
               </button>
               <button type="button" id="btnChangeMode" class="btn btn-outline btn-outline-secondary ms-2">تغییر حالت</button>
          </div>
     </div>
</div>

<!-- Modal: Filter -->
<div class="modal fade" id="filterModal" tabindex="-1">
     <div class="modal-dialog modal-lg">
          <div class="modal-content">
               <div class="modal-header">
                    <h5 class="modal-title">
                         <i class="bi bi-filter"></i>
                         افزودن فیلتر
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
               </div>
               <div class="modal-body">
                    <input type="hidden" id="filterEditId" value="">
                    <input type="hidden" id="filterTableRef">
                    <input type="hidden" id="filterTableName">
                    <input type="hidden" id="filterColumnName">
                    <input type="hidden" id="filterDataType">
                    <div class="row">
                         <div class="col-md-7">
                              <div class="mb-3">
                                   <label class="form-label">ستون:</label>
                                   <input type="text" id="filterColumnDisplay" class="form-control" readonly>
                              </div>
                              <div class="mb-3">
                                   <label for="filterOperator" class="form-label">عملگر:</label>
                                   <select id="filterOperator" class="form-select">
                                        <option value="equals">برابر (=)</option>
                                        <option value="notequals">نابرابر (!=)</option>
                                        <option value="greater">بزرگتر (&gt;)</option>
                                        <option value="greaterorequal">بزرگتر مساوی (&gt;=)</option>
                                        <option value="less">کوچکتر (&lt;)</option>
                                        <option value="lessorequal">کوچکتر مساوی (&lt;=)</option>
                                        <option value="like">شامل (LIKE)</option>
                                        <option value="notlike">شامل نباشد (NOT LIKE)</option>
                                        <option value="in">در لیست (IN)</option>
                                        <option value="notin">خارج از لیست (NOT IN)</option>
                                        <option value="isnull">خالی (IS NULL)</option>
                                        <option value="isnotnull">خالی نباشد (IS NOT NULL)</option>
                                   </select>
                              </div>
                              <div id="filterValueGroup" class="mb-3">
                                   <label for="filterValue" class="form-label">مقدار:</label>
                                   <input type="text" id="filterValue" class="form-control" placeholder="مقدار یا @@ParamName برای پارامتر">
                              </div>
                              <div class="mb-3">
                                   <label for="filterLogicalOperator" class="form-label">عملگر منطقی:</label>
                                   <select id="filterLogicalOperator" class="form-select">
                                        <option value="AND">و (AND)</option>
                                        <option value="OR">یا (OR)</option>
                                   </select>
                                   <div class="form-text">برای اولین فیلتر تاثیری ندارد</div>
                              </div>
                         </div>
                         <div class="col-md-5 border-start">
                              <h6 class="mb-2"><i class="bi bi-input-cursor-text"></i> پارامترها</h6>
                              <p class="small text-muted mb-2">درج پارامتر در مقدار:</p>
                              <div id="filterParamsList" class="filter-params-list" style="max-height: 220px; overflow-y: auto;">
                                   <!-- به صورت دینامیک -->
                              </div>
                         </div>
                    </div>
               </div>
               <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" id="btnSaveFilter" class="btn btn-primary">
                         <i class="bi bi-plus-circle"></i>
                         <span id="btnSaveFilterText">افزودن</span>
                    </button>
               </div>
          </div>
     </div>
</div>

<!-- Modal: Parameter Values (for Preview) -->
<div class="modal fade" id="parameterValuesModal" tabindex="-1">
     <div class="modal-dialog">
          <div class="modal-content">
               <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-input-cursor-text"></i> مقادیر پارامترها</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
               </div>
               <div class="modal-body">
                    <p class="text-muted small">پارامترهای زیر مقدار ندارند. لطفاً مقدار وارد کنید:</p>
                    <div id="parameterValuesForm">
                         <!-- به صورت دینامیک -->
                    </div>
               </div>
               <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" id="btnConfirmParameterValues" class="btn btn-primary">اجرا پیش‌نمایش</button>
               </div>
          </div>
     </div>
</div>

<!-- Modal: Parameter -->
<div class="modal fade" id="parameterModal" tabindex="-1">
     <div class="modal-dialog">
          <div class="modal-content">
               <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-input-cursor-text"></i> پارامتر</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
               </div>
               <div class="modal-body">
                    <input type="hidden" id="paramEditId" value="">
                    <div class="mb-3">
                         <label for="paramName" class="form-label">نام پارامتر <span class="text-danger">*</span></label>
                         <div class="input-group">
                              <span class="input-group-text">@@</span>
                              <input type="text" id="paramName" class="form-control" placeholder="MyParam" pattern="[a-zA-Z_][a-zA-Z0-9_]*" dir="ltr">
                         </div>
                         <div class="form-text">فقط حروف، اعداد و _ (بدون @@)</div>
                    </div>
                    <div class="mb-3">
                         <label for="paramDisplayName" class="form-label">عنوان نمایشی</label>
                         <input type="text" id="paramDisplayName" class="form-control" placeholder="مثال: از تاریخ">
                    </div>
                    <div class="mb-3">
                         <label for="paramDefaultValue" class="form-label">مقدار پیش‌فرض</label>
                         <input type="text" id="paramDefaultValue" class="form-control" placeholder="اختیاری">
                    </div>
               </div>
               <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" id="btnSaveParameter" class="btn btn-primary">ذخیره</button>
               </div>
          </div>
     </div>
</div>

<!-- Modal: Preview -->
<div class="modal fade" id="previewModal" tabindex="-1">
     <div class="modal-dialog modal-xl">
          <div class="modal-content">
               <div class="modal-header">
                    <h5 class="modal-title">
                         <i class="bi bi-eye"></i>
                         پیش‌نمایش نتایج
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
               </div>
               <div class="modal-body">
                    <div id="previewContent" style="    max-height: 61vh;">
                         <!-- محتوا به صورت دینامیک بارگذاری می‌شود -->
                    </div>
               </div>
               <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
               </div>
          </div>
     </div>
</div>

<!-- Templates -->
<template id="tableBoxTemplate">
     <div class="table-box">
          <div class="table-box-header d-flex justify-content-between align-items-center">
               <div style="display: flex;flex-direction: column;">
                    <strong class="table-displayname">-</strong>
                    <span class="table-name"></span>
               </div>
               <button type="button" class="btn-close" aria-label="Close"></button>
          </div>
          <div class="table-box-body">
               <div class="columns-list"></div>
          </div>
     </div>
</template>

<template id="columnItemTemplate">
     <div class="column-item">
          <div class="column-endpoint-left" title="نقطه اتصال (سمت چپ)"></div>
          <div class="form-check d-flex align-items-center flex-grow-1">
               <input class="form-check-input column-checkbox me-2" type="checkbox">
               <div class="form-check-label d-flex justify-content-between align-items-center flex-grow-1">
                    <div style="display: flex;flex-direction: column;">
                         <span class="column-displayname fw-bold text-dark fs-5">-</span>
                         <span class="column-name"></span>
                    </div>
                    <span class="badge bg-secondary column-type"></span>
               </div>
          </div>
          <button class="btn btn-sm btn-outline-primary btn-add-filter ms-2" title="افزودن فیلتر">
               <i class="bi bi-filter"></i>
          </button>
          <div class="column-endpoint-right" title="نقطه اتصال (سمت راست)"></div>
     </div>
</template>

<script src="~/panellib/js/jsplumb.min.js"></script>

 <script>

   let  queryDesigner = new QueryDesigner();

     $$('#queryEditor').on('input', function () {
          this.style.height = 'auto';
          this.style.height = this.scrollHeight + 'px';
     }).trigger('input');

 </script>
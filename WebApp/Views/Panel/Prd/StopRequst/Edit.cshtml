@using Entities.App.Hrm
@using Entities.App.Prd;
@using Entities.App.Prd.Enums
@using Entities.App.Sale;
@using Entities.Auth
@model StopRequst

<div class="card">
	<div class="form-action-buttons"><form-action-buttons entity-type="typeof(StopRequst)"></form-action-buttons></div>

</div>
<div class="card">

	<div class="card-body row">
		<div class="col-12 mb-4">
			<h3 class="fw-bold text-dark">اطلاعات اصلی</h3>
		</div>
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class="col-md-6">
			<label class=''>قلم سفارش ساخت</label>
			@(Html.EntitySelector<ProductionOrderItem>(
				"ProductionOrderItemSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id,
					ProductionOrder_ProductionOrderNumber = c.ProductionOrder.ProductionOrderNumber
				},
				c => new { c.ProductionOrder },
				"{ProductionOrder.ProductionOrderNumber}",
				"ProductionOrderItemId",
				"ProductionOrderItemName",
				Model?.ProductionOrderItemId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>تاریخ شروع توقف</label>
			<input class='form-control'  data-bind='stopStartDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD HH:mm:ss","autoClose": true,"initialValue": false,"timePicker":{"enabled": true}}' value='@Model?.StopStartMiladiDateTime' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>محل مشاهده</label>
			<select class='form-control' data-bind='observationLocation' asp-for='ObservationLocation' asp-items="Html.GetEnumSelectList(typeof(StopRequstObservationLocationEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>وضعیت تولید</label>
			<select class='form-control' data-bind='productionStatus' asp-for='ProductionStatus' asp-items="Html.GetEnumSelectList(typeof(StopRequstProductionStatusEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>
		 
		<div class='col-md-6'>
			<label class=''>ساعت کارکرد دستگاه</label>
			<input class='form-control'  data-bind='operatingHours'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='OperatingHours' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>
		<div class="col-md-6">
			<label class=''>علت توقف</label>
			<select class='form-control' id="stopReasonSelect" multiple asp-items="Html.GetEnumSelectList(typeof(StopRequstStopReasonEnum))">

			 </select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label>واحد های مسئول توقف</label>
			@(Html.EntitySelector<OrgUnit>(
				 "ResponsibleUnitIdsSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id,
				    Title = c.Title
				},
					 c => new { c.Title },
				 "{Title}",
				 "ResponsibleUnitIds",
				"ResponsibleUnitTitles",
						Model?.ResponsibleUnitIds?.ToString(),
				false,
				true
			))
			 
		 </div>

		 		<div class="col-md-6">
			<label> مسئول های توقف</label>
			@(Html.EntitySelector<User>(
				 "ResponsibleUnitIdsSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id,
							Name = c.Name
				},
						c => new { c.Name },
				"{Name}",
				"ResponsibleUserIds",
				"ResponsibleUserNames",
						Model?.ResponsibleUserIds?.ToString(),
				false,
				true
			))
			 
		 </div>

		 
		 		<div class="col-md-6">
			<label> ذینفعان</label>
			@(Html.EntitySelector<User>(
						"BeneficiarieUserIdsSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id,
							Name = c.Name
				},
						c => new { c.Name },
				"{Name}",
						"BeneficiarieUserIds",
						"BeneficiarieUserNames",
						Model?.BeneficiarieUserIds?.ToString(),
				false,
				true
			))
			 
		 </div>

	</div>
</div>

<div class="card">
 
	<div class='card-body row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>

	$$("#stopReasonSelect").select2();

	function savefn($btnAction) {
		if (validateError(page.$pageEl)) { return; }
		var model = page.$pageEl.dataBind();
		const $btn = $(this.element).block();


		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				page.$pageEl.dataBind(r.data);
				$btnAction.baseaction();
			})
	}

	self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
</script>

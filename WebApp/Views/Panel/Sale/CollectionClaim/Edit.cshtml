@using Entities.App.FIN
@using Entities.App.Sale
@using Entities.App.SLS
@using Entities.Base
@model CollectionClaim

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(CollectionClaim)">
			<form-action-button color-class="btn-active-icon-dark btn-color-info" icon-class="fa fa-money-bill"
				action-name="openPayFish" title="فیش وصول"></form-action-button>
		</form-action-buttons>
	</div>
	<div class="card-body row">
		<span class="section-box-title">سند وصول</span>
		<input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold required">مشتری</label>
				@(Html.EntitySelector<Customer>(
					"CollectionClaimCustomerSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Party_FullName = c.Party.FullName, Code = c.Code },
					c => new { c.Party, c.Code },
					"{Party.FullName} {Code}",
					"customerId",
					"customerName",
					Model?.CustomerId?.ToString()
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">تفصیل</label>
				@(Html.EntitySelector<DL>(
					"CollectionClaimDlSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Title = c.Title, Code = c.Code },
					c => new { c.Title, c.Code },
					"{Code} {Title}",
					"dlId",
					"dlTitleBound",
					Model?.DlId?.ToString()
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">شماره سند</label>
				<input class="form-control" data-bind="vchNumber" asp-for="VchNumber" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">تاریخ سند</label>
				<input class="form-control" data-bind="vchShamsiDate" data-persionDatePicker="true"
					persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
					value="@Model?.VchMiladiDate" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">بدهکار</label>
				<input class="form-control" data-bind="debit" asp-for="Debit" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">بستانکار</label>
				<input class="form-control" data-bind="credit" asp-for="Credit" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold">عنوان تفصیل</label>
				<input class="form-control" data-bind="dlTitle" asp-for="DlTitle" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-12 form-group-inline">
				<label class="form-label fw-bold">شرح سند</label>
				<textarea class="form-control" data-bind="vchDescription" asp-for="VchDescription" rows="3"></textarea>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
	</div>
</div>
<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;
		const model = page.$pageEl.dataBind();
		const $btn = $($btnAction.element).block();
		$$.post('save', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			$btnAction.baseaction();
		});
	}
	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
	if (self.FormActionButtons.openPayFish) {
		self.FormActionButtons.openPayFish.onclick(function () {
			const id = page.$pageEl.dataBind().id;
			if (!id) { toastr.error('ابتدا ذخیره کنید'); return; }
			appController.addPage('/Panel/Sale/CollectionClaimPayFish/List?collectionClaimId=' + id, true, 'فیش وصول');
		});
	}
</script>

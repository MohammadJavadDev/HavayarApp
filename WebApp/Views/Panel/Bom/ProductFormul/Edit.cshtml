@using Entities.App.Bom;
@using Entities.App.Inv
@using WebFramework.TagHelpers;
@model ProductFormul
<div class="card">
	<div class="form-action-buttons"><form-action-buttons entity-type="typeof(ProductFormul)"></form-action-buttons></div>
	<div class="card-body row">
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class="col-md-6">
			<label class='required'>محصول</label>
			@(Html.EntitySelector<Part>(
				"ProductSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Code = c.Code, Name = c.Name
				},
				c => new { c.Code, c.Name },
				"{Code} {Name}",
				"ProductId",
				"ProductName",
				Model?.ProductId.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>قطعه</label>
			@(Html.EntitySelector<Part>(
				"PartSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Code = c.Code, Name = c.Name
				},
				c => new { c.Code, c.Name },
				"{Code} {Name}",
				"PartId",
				"PartName",
				Model?.PartId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>گروه محصول</label>
			@(Html.EntitySelector<ProductGroup>(
				"ProductNameGroupSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, FirstName = c.FirstName
				},
				c => new { c.FirstName },
				"{FirstName}",
				"ProductNameGroupId",
				"ProductNameGroupName",
				Model?.ProductNameGroupId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>ضریب مصرفی</label>
			<input class='form-control'  data-bind='usingRate'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='UsingRate' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class='required'>توضیحات</label>
			<input class='form-control' data-bind='comment' required asp-for='Comment' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-12'>
			<div data-tab-item-manager="productFormulItems" data-item-selector=".entity-item">
				<ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-transparent fs-4 fw-bold mb-5" role="tablist">
					<li class="nav-item" role="presentation">
						<a class="nav-link active" data-bs-toggle="tab" href="#moviesTab" role="tab" aria-selected="true">
							<span class="svg-icon svg-icon-2 me-2"></span>
							افلام
						</a>
					</li>
				</ul>
				<div class="tab-content">
					<div class="tab-pane fade show active" id="ItemsTab" role="tabpanel" data-add-url="/Panel/ProductFormul/ProductFormulItemPartial">
						<div id='ItemsContainer' class="entity-item-container">
							@if (Model?.Items != null)
							{
								@foreach (var item in Model.Items)
								{
									<div data-item-id="@(item.Id ?? 0)">
										@await Html.PartialAsync("_ProductFormulItemPartial.cshtml", item)
									</div>
								}
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class='card-footer row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>
	function savefn($btnAction) {
		if (validateError($$('.card'))) { return; }
		var model = $$('.card').dataBind();
		const $btn = $(this.element).block();
		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				$$('.card').dataBind(r.data);
				$btnAction.baseaction();
			})
	}

	self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
</script>

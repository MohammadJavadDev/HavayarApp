@using Entities.Base
@model GeneralSetting
@{
	var isNew = Model?.Id == null || Model.Id == 0;
	var isSecret = Model?.IsSecret == true;
}
<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(GeneralSetting)"></form-action-buttons>
	</div>
	<div class="card-body row">
		<input type="hidden" data-bind="id" value="@Model?.Id" />

		<div class="col-md-6 form-group-inline">
			<label class="required">کلید</label>
			<input class="form-control" dir="ltr" data-bind="settingKey" data-required="true" required value="@Model?.SettingKey" @(isNew ? "" : "readonly") />
			<div data-invalidmessagespan class="my-1 mx-1"> <span class="text-danger"></span> </div>
		</div>

		<div class="col-md-6 form-group-inline">
			<label>عنوان</label>
			<input class="form-control" data-bind="title" maxlength="200" value="@Model?.Title" />
			<div data-invalidmessagespan class="my-1 mx-1"> <span class="text-danger"></span> </div>
		</div>

		<div class="col-md-12 form-group-inline">
			<label>مقدار</label>
			@if (isSecret)
			{
				<input class="form-control" dir="ltr" type="password" autocomplete="new-password" data-bind="settingValue"
					   placeholder="مقدار فعلی نمایش داده نمی‌شود؛ برای تغییر، مقدار جدید را وارد کنید (خالی = بدون تغییر)" />
			}
			else
			{
				<textarea class="form-control" dir="ltr" rows="3" data-bind="settingValue">@Model?.SettingValue</textarea>
			}
			<div data-invalidmessagespan class="my-1 mx-1"> <span class="text-danger"></span> </div>
		</div>

		<div class="col-md-12 form-group-inline">
			<label>توضیحات</label>
			<textarea class="form-control" rows="2" maxlength="1000" data-bind="description">@Model?.Description</textarea>
		</div>

		<div class="col-md-4 d-flex align-items-center mt-4">
			<div class="form-check form-switch form-check-custom form-check-solid">
				<input data-bind="isSecret" class="form-check-input" type="checkbox" id="chkIsSecret" @(isSecret ? "checked" : "") />
				<label class="form-check-label ms-3" for="chkIsSecret">محرمانه (رمز / کلید API)</label>
			</div>
		</div>
	</div>
	<div class="card-footer row">
		<div class="col-md-3"><span>ایجاد کننده :</span> <span data-bind="createdByName">@Model?.CreatedByName</span></div>
		<div class="col-md-3"><span>تاریخ ایجاد :</span> <span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span></div>
		<div class="col-md-3"><span>ویرایش کننده :</span> <span data-bind="modifiedByName">@Model?.ModifiedByName</span></div>
		<div class="col-md-3"><span>تاریخ ویرایش :</span> <span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span></div>
	</div>
</div>

<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;

		const model = page.$pageEl.dataBind();
		const $btn = $($btnAction.element).block();

		$$.post('save', model, function (r) {
			$btn.block(false);

			if (!r.isSuccess) {
				toastr.error(r.message, 'خطا');
				return;
			}

			toastr.success('ذخیره سازی با موفقیت انجام شد. تغییر تنظیمات حداکثر تا ۳۰ ثانیه بعد در سیستم اعمال می‌شود.');
			// مقدار محرمانه هرگز برنمی‌گردد؛ فیلد مقدار را خالی می‌کنیم تا دوباره ذخیره‌شدنِ اشتباهی رخ ندهد.
			page.$pageEl.dataBind(r.data);
			$btnAction.baseaction();
		});
	}

	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>

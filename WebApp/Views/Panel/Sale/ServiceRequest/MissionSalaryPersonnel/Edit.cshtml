@using Entities.App.Hcm
@using Entities.App.Sale;
@model MissionSalaryPersonnel

<div class="card shadow-sm border-0">
    <div class="form-action-buttons border-bottom p-3">
        <form-action-buttons entity-type="typeof(SaleMission)"></form-action-buttons>
    </div>

    <div class="card-body">
        <div class="row mb-4">
            <div class="col-12">
                <h4 class="fw-bold text-dark mb-0">حق ماموریت پرسنل</h4>
            </div>
        </div>

        <input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />

        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">پرسنل</label>
                <div class="d-block">
                    @(Html.EntitySelector<Personel>(
                        "PersonelIdSelector",
                        c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                        c => new { Id = c.Id, Name = c.Name, Family = c.Family },
                        c => new { c.Name, c.Family },
                        "{Name} {Family}",
                        "PersonelId",
                        Model?.Personel?.Name,
                        Model?.PersonelId?.ToString()
                    ))
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">هزینه صبحانه</label>
                <input class="form-control money-format" data-bind="breakfastFee" asp-for="BreakfastFee" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">هزینه ناهار</label>
                <input class="form-control money-format" data-bind="lunchFee" asp-for="LunchFee" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">هزینه شام</label>
                <input class="form-control money-format" data-bind="dinnerFee" asp-for="DinnerFee" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">حق شب</label>
                <input class="form-control money-format" data-bind="nightRight" asp-for="NightRight" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">حق ماموریت</label>
                <input class="form-control money-format" data-bind="missionRight" asp-for="MissionRight" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">مبلغ اضافه کاری</label>
                <input class="form-control money-format" data-bind="workOvertimeFee" asp-for="WorkOvertimeFee" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">حق تعطیل کاری</label>
                <input class="form-control money-format" data-bind="missionHolidayRight" asp-for="MissionHolidayRight" />
            </div>

            <div class="col-md-3">
                <label class="form-label fw-bold">حقوق روزانه</label>
                <input class="form-control money-format" data-bind="dailySalary" asp-for="DailySalary" />
            </div>
        </div>
    </div>

    <div class="card mt-4 border-0 shadow-sm">
        <div class="card-body">
            <div class="row text-muted">
                <div class="col-md-3">
                    <span class="fw-bold">ایجاد کننده :</span>
                    <span data-bind="createdByName">@Model?.CreatedByName</span>
                </div>
                <div class="col-md-3">
                    <span class="fw-bold">تاریخ ایجاد :</span>
                    <span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
                </div>
                <div class="col-md-3">
                    <span class="fw-bold">ویرایش کننده :</span>
                    <span data-bind="modifiedByName">@Model?.ModifiedByName</span>
                </div>
                <div class="col-md-3">
                    <span class="fw-bold">تاریخ ویرایش :</span>
                    <span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        function numberWithCommas(x) {
            return x.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        }

        $(document).on('input', '.money-format', function (e) {
            let value = $(this).val().replace(/,/g, '');
            if (!isNaN(value) && value !== "") {
                $(this).val(numberWithCommas(value));
            }
        });

        $('.money-format').each(function () {
            let value = $(this).val().replace(/,/g, '');
            if (value !== "") {
                $(this).val(numberWithCommas(value));
            }
        });
    });

    function savefn($btnAction) {
        if (validateError(page.$pageEl)) return;

        const model = page.$pageEl.dataBind();

        for (let key in model) {
            if (typeof model[key] === 'string') {
                model[key] = model[key].replace(/,/g, '');
            }
        }

        model.ServiceRequestId = sessionStorage.getItem("ServiceRequestId");
        const $btn = $(this.element).block();

        $$.post('save', model, function (r) {
            $btn.block(false);
            if (!r.isSuccess) {
                toastr.error(r.message, 'خطا');
                return;
            }
            toastr.success('ذخیره سازی با موفقیت انجام شد');
            page.$pageEl.dataBind(r.data);

            $('.money-format').trigger('input');

            $btnAction.baseaction();
        });
    }

    self.FormActionButtons.save.onclick(function () { savefn(this); });
    self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
    self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>

@using Entities.App.Inv;
@using Entities.App.Sup;
@using Entities.App.Sup.Enums;
@using Entities.Auth;
@using WebApp.Controllers.Dynamic;
@model  BuyCategory
@{
	// Q2 = (a): راهکاران مرجع کامل است — دسته، اقلام، متولی خرید و lead time در این سامانه فقط‌خواندنی‌اند (جاب همگام‌سازی ساعتی برقرار می‌ماند).
	// این صفحه فقط نمایش است: بدون ذخیره، بدون افزودن/حذف قلم.
	var isSynced = Model?.HamkaranId != null;
	var itemCount = Model?.Items?.Count ?? 0;
	var renderItems = itemCount <= BuyCategoryController.MaxInlineItems;
	var typeTitle = Model?.Type switch
	{
		BuyCategoryTypeEnum.Purchase => "خرید",
		BuyCategoryTypeEnum.Build => "ساخت",
		_ => "-"
	};
}
<div class="card">
	<div class="form-action-buttons">
		<form-action-buttons entity-type="typeof(BuyCategory)" new-page-btn="false" save-btn="false" save-and-new-btn="false" save-and-close-btn="false">
			<button type="button" class="btn-sm btn btn-icon btn-active-icon-dark btn-color-danger" data-action="closePage" data-bs-toggle="tooltip" data-bs-placement="top" title="بستن">
				<i class="fa-light fa-xmark" style="padding-right: 2px;padding-top: 2px;"></i>
			</button>
		</form-action-buttons>
	</div>
</div>
<div class="card">
	<div class="card-body row">
		<div class="col-12 mb-4 d-flex align-items-center gap-3 flex-wrap">
			<h3 class="fw-bold text-dark mb-0">اطلاعات اصلی</h3>
			@if (isSynced)
			{
				<span class="badge badge-light-info fs-7" data-bs-toggle="tooltip" title="این دسته از راهکاران (USR3.Sup_BuyCategory) هر ساعت همگام‌سازی می‌شود.">
					همگام از راهکاران — کد @Model?.HamkaranId
				</span>
			}
			<span class="badge badge-light-warning fs-7" data-bs-toggle="tooltip" title="مرجع دسته‌های خرید راهکاران است (تصمیم Q2). ویرایش عنوان، نوع، متولی خرید، زمان تامین و اقلام فقط در راهکاران انجام می‌شود.">
				فقط‌خواندنی — ویرایش در راهکاران
			</span>
		</div>

		<div class='col-md-6 form-group-inline'>
			<label class=''>عنوان</label>
			<input class='form-control' value='@Model?.Title' readonly disabled />
		</div>

		<div class='col-md-6 form-group-inline'>
			<label class=''>نوع</label>
			<input class='form-control' value='@typeTitle' readonly disabled />
		</div>

		<div class="col-md-6 form-group-inline">
			<label class=''>متولی خرید</label>
			<input class='form-control' value='@(Model?.PurchaseResponsible?.Name ?? "-")' readonly disabled />
		</div>

		<div class='col-md-3 form-group-inline'>
			<label class=''>زمان تامین روتین (روز)</label>
			<input class='form-control' value='@(Model?.RoutineLeadTimeInDay?.ToString() ?? "-")' readonly disabled />
		</div>

		<div class='col-md-3 form-group-inline'>
			<label class=''>زمان تامین غیرروتین (روز)</label>
			<input class='form-control' value='@(Model?.NonRoutineLeadTimeInDay?.ToString() ?? "-")' readonly disabled />
		</div>
	</div>
</div>

<div class="card">
	<div class="card-body">
		<div class="mb-4 d-flex align-items-center gap-3 flex-wrap">
			<h3 class="fw-bold text-dark mb-0">اقلام دسته</h3>
			<span class="badge badge-light fs-7">@itemCount قلم</span>
			<span class="badge badge-light-warning fs-7">فقط‌خواندنی — اقلام از راهکاران همگام می‌شوند</span>
		</div>

		@if (!renderItems)
		{
			<div class="alert alert-info d-flex align-items-center justify-content-between mb-0">
				<span>
					این دسته <b>@itemCount</b> قلم دارد؛ برای جلوگیری از سنگین شدن صفحه، اقلام در اینجا نمایش داده نمی‌شوند
					(حد نمایش درون‌خطی: @BuyCategoryController.MaxInlineItems قلم). اقلام را از صفحه «اقلام دسته های خرید» مشاهده کنید.
				</span>
				<button type="button" class="btn btn-sm btn-light-primary" data-action="openItemsList">مشاهده اقلام دسته</button>
			</div>
		}
		else if (itemCount == 0)
		{
			<div class="text-muted">قلمی برای این دسته ثبت نشده است.</div>
		}
		else
		{
			<div class="table-responsive">
				<table class="table table-striped table-row-bordered gy-2 align-middle">
					<thead>
						<tr class="fw-bold fs-6 text-muted">
							<th style="width:50px;">#</th>
							<th>کد کالا</th>
							<th>نام کالا</th>
							<th>زمان در راه</th>
							<th>تامین کننده</th>
							<th>توضیحات</th>
						</tr>
					</thead>
					<tbody>
						@{ var rowNo = 0; }
						@foreach (var item in Model!.Items)
						{
							rowNo++;
							var supplierTitle = item.Supplier switch
							{
								BuyCategoryItemSupplierEnum.ForeignTrade => "بازرگانی خارجی",
								BuyCategoryItemSupplierEnum.SupplyAndPurchase => "تامین و خرید",
								_ => "-"
							};
							<tr>
								<td>@rowNo</td>
								<td>@(item.Part?.Code ?? "-")</td>
								<td>@(item.Part?.Name ?? "-")</td>
								<td>@(item.TimeInWay?.ToString() ?? "-")</td>
								<td>@supplierTitle</td>
								<td>@(item.Comments ?? "-")</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
</div>

<div class="card">
	<div class='card-body row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span>@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span>@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span>@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش / آخرین همگام‌سازی :</span>
			<span>@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>
	// صفحه فقط‌نمایش (Q2 = a) — بدون ذخیره
	page.$pageEl.on('click', '[data-action="closePage"]', function () {
		appController.closeCurrentPage();
	});

	page.$pageEl.on('click', '[data-action="openItemsList"]', function () {
		appController.addPage('/panel/sup/buycategoryitem/list', true, 'اقلام دسته های خرید');
	});
</script>

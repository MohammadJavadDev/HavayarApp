@using Common.Utilities
@using Entities.App.Edms
@using Entities.App.Edms.Enums
@model WebApp.ViewModels.Edms.DocumentGroupEditViewModel

@{
	bool canEditDocument = false;
	var currentId = Model?.Current?.Id ?? 0;
	var groupReady = (Model?.ProjectId.HasValue == true && Model.ProjectId.Value != 0) && (Model?.DocumentVpisId.HasValue == true && Model.DocumentVpisId.Value != 0);
	
	if (ViewData["CanEditDocument"] != null)
	{
		canEditDocument =(bool) ViewData["CanEditDocument"];
	}

	var initialActionFlags = ViewData["ActionFlags"] as WebApp.ViewModels.Edms.DocumentEditActionFlags
		?? new WebApp.ViewModels.Edms.DocumentEditActionFlags();
	var currentDocument = Model?.Current;
	var isEmptyReplySheet = currentDocument?.IsLatest == true
		&& currentDocument.ReplySheetId == null
		&& currentDocument.SecondReplySheetId != null
		&& currentDocument.Status is DocumentStatusEnums.ApproveByApprover or DocumentStatusEnums.ApprovedByDcc;
}
<div class="card my-1">
	<div class="form-action-buttons">
		<form-action-buttons entity-type="typeof(Document)">
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-code-branch"
							action-name="newRevision" title="ایجاد ریویژن جدید"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-info" icon-class="fa fa-rotate"
							action-name="reloadRevisions" title="به‌روزرسانی لیست ریویژن‌ها"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-note"
							action-name="addComment" title="افزودن کامنت"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="ki-abstract-27 ki-outline"
							action-name="addReplySheet" title="افزودن ReplySheet"></form-action-button>

			<form-action-button color-class="btn-active-icon-dark btn-color-danger" icon-class="fa fa-rotate-left"
							action-name="deleteLastComment" title="حذف آخرین کامنت"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-success d-none" icon-class="ki-file-down ki-outline"
							action-name="downloadTransmittal" title="دانلود فایل ترانسمیتال"></form-action-button>
			<form-action-button color-class="btn-active-icon-dark btn-color-success d-none" icon-class="ki-file-down ki-outline"
							action-name="downloadReplyTransmittal" title="دانلود فایل ترانسمیتال ReplySheet"></form-action-button>
		</form-action-buttons>
	</div>
</div>

<div class="card my-1" id="documentGroupHeader">
	<div class="card-body border-0 pt-6 pb-4">
		<div class="d-flex flex-row flex-wrap align-items-center gap-3" dir="ltr">
			<span class="doc-header-copy" data-copy-header title="برای کپی کلیک کنید">
				<span class="doc-header-copy-label">پروژه:</span>
				<span class="fw-bold fs-4" dir="ltr" data-copy-value data-header-project-title>@(Model?.Project?.Name ?? "-")</span>
				<i class="fa fa-copy doc-header-copy-icon" aria-hidden="true"></i>
			</span>
			<span class="doc-header-copy" data-copy-header title="برای کپی کلیک کنید">
				<span class="doc-header-copy-label">سند:</span>
				<span class="fw-bold fs-4" dir="ltr" data-copy-value data-header-document-title>@(Model?.DocumentVpis?.Title ?? "-")</span>
				<i class="fa fa-copy doc-header-copy-icon" aria-hidden="true"></i>
			</span>
			<span class="doc-header-copy" data-copy-header data-header-document-code-wrapper title="برای کپی کلیک کنید" style="@(string.IsNullOrWhiteSpace(Model?.DocumentVpis?.Code) ? "display:none;" : "")">
				<span class="doc-header-copy-label">کد:</span>
				<span class="fw-bold fs-4" dir="ltr" data-copy-value data-header-document-code>@(Model?.DocumentVpis?.Code ?? "")</span>
				<i class="fa fa-copy doc-header-copy-icon" aria-hidden="true"></i>
			</span>
		</div>
	</div>
</div>
<style>
	#documentGroupHeader .doc-header-copy {
		direction: ltr;
		unicode-bidi: isolate;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		max-width: 100%;
		padding: 0.35rem 0.75rem;
		border-radius: 0.5rem;
		border: 1px solid transparent;
		background-color: transparent;
		transition: background-color .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease;
	}
	#documentGroupHeader .doc-header-copy:hover {
		background-color: #f1faff;
		border-color: #b6e3ff;
		box-shadow: 0 2px 8px rgba(0, 158, 247, 0.14);
		transform: translateY(-1px);
	}
	#documentGroupHeader .doc-header-copy:active {
		transform: translateY(0);
		background-color: #e8f6ff;
	}
	#documentGroupHeader .doc-header-copy.is-copied {
		background-color: #e8fff3;
		border-color: #a3f0c8;
	}
	#documentGroupHeader .doc-header-copy-label {
		color: #7e8299;
		white-space: nowrap;
	}
	#documentGroupHeader [data-copy-value] {
		direction: ltr;
		unicode-bidi: isolate;
		text-align: left;
	}
	#documentGroupHeader .doc-header-copy-icon {
		opacity: 0;
		color: #009ef7;
		font-size: 0.9rem;
		transition: opacity .18s ease;
	}
	#documentGroupHeader .doc-header-copy:hover .doc-header-copy-icon,
	#documentGroupHeader .doc-header-copy.is-copied .doc-header-copy-icon {
		opacity: 1;
	}
</style>
 
<div class=" ">
	 

	<div class=" ">
		@if (!groupReady)
		{
			<div class="card card-flush mb-5" id="NewDocumentGroupCard">
				<div class="card-header pt-5">
					<div class="card-title d-flex flex-column">
						<span class="fs-6 fw-bold">ثبت مدرک جدید</span>
						<span class="text-muted fs-8">برای شروع، پروژه و سند (Vpis) را انتخاب کنید</span>
					</div>
				</div>
				<div class="card-body row g-4">
					<div class="col-md-6 form-group-inline">
						<label class="form-label required">پروژه</label>
						@(Html.EntitySelector<Project>
									(
									"NewDocProjectSelector",
									c => c.IsActive == Entities.Base.IsActiveEnum.Active,
									c => new { Id = c.Id, Title = c.Title },
									c => new { c.Title },
									"{Title}",
									"newProjectId",
									null,
									null,
									required: true
									))
					</div>

					<div class="col-md-6 form-group-inline">
						<label class="form-label required">سند (Vpis)</label>
						@(Html.EntitySelector<ProjectVpis>
									(
									"NewDocVpisSelector",
									c => c.IsActive == Entities.Base.IsActiveEnum.Active,
									c => new { Id = c.Id, Code = c.Code, Title = c.Title },
									c => new { c.Code, c.Title },
									"{Code} - {Title}",
									"newDocumentVpisId",
									null,
									null,
									required: true
									))
					</div>

					<div class="col-12 d-flex flex-wrap gap-2">
						<button type="button" class="btn btn-primary" data-action="start-new-document">
							شروع ثبت
						</button>
						<button type="button" class="btn btn-light" data-action="clear-new-document">
							پاک کردن انتخاب‌ها
						</button>
					</div>
				</div>
			</div>
		}

		<div class="row g-5">
			<div class="col-lg-3">
				<div id="DocumentVpisSummaryContainer">
					@await Html.PartialAsync("_DocumentVpisSummaryPartial.cshtml", Model?.DocumentVpis)
				</div>

				<div class="card card-flush  ">
					<div class="card-header pt-5">
						<div class="card-title d-flex flex-column">
							<span class="fs-5 fw-bold">ریویژن‌ها</span>
							<span class="text-muted fs-7" id="revisionsTotalCount">@(Model?.Revisions?.Count ?? 0) مورد</span>
						</div>
					</div>
					<div class="card-body pt-3 p-0" id="RevisionsListContainer">
						@await Html.PartialAsync(
							"_DocumentRevisionsListPartial.cshtml",
							Model?.Revisions ?? new List<WebApp.ViewModels.Edms.DocumentRevisionSummaryViewModel>(),
							new ViewDataDictionary(ViewData) { ["CurrentId"] = currentId }
						)
					</div>
				</div>
			</div>

			<div class="col-lg-9">
				<div id="RevisionEditorContainer">
					@if (!groupReady)
					{
						<div class="alert alert-warning m-0">
							برای شروع ثبت یا مشاهده ریویژن‌ها، ابتدا پروژه و سند (Vpis) را انتخاب کنید.
						</div>
					}
					else
					{
						@await Html.PartialAsync("_DocumentRevisionEditorPartial.cshtml", Model.Current, ViewData)
					}
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	function setFormButtonVisible(btn, visible) {
		if (!btn || !btn.element) return;
		const $el = $(btn.element);
		if (visible) {
			$el.removeClass('d-none').disabled(false).prop('hidden', false);
		} else {
			$el.addClass('d-none').disabled(true).prop('hidden', true);
		}
	}

	function applyDocumentActionButtons(flags) {
		flags = flags || {};

		// Always hidden in this flow
		setFormButtonVisible(self.FormActionButtons.save, false);
		setFormButtonVisible(self.FormActionButtons.saveandnew, false);
		setFormButtonVisible(self.FormActionButtons.reloadRevisions, false);
		setFormButtonVisible(self.FormActionButtons.deleteLastComment, !!flags.canDeleteLastComment);

		// History always visible
		setFormButtonVisible(self.FormActionButtons.history, true);

		setFormButtonVisible(self.FormActionButtons.saveandclose, !!flags.canSaveAndClose);
		setFormButtonVisible(self.FormActionButtons.addComment, !!flags.canAddComment);
		setFormButtonVisible(self.FormActionButtons.newRevision, !!flags.canNewRevision);
		setFormButtonVisible(self.FormActionButtons.addReplySheet, !!flags.canAddReplySheet);
		syncTransmittalDownload();
	}

	function syncTransmittalDownload() {
		const attachmentId = Number($$('#DocumentRevisionEditor').attr('data-transmittal-attachment-id') || 0);
		const replyAttachmentId = Number($$('#DocumentRevisionEditor').attr('data-reply-transmittal-attachment-id') || 0);
		setFormButtonVisible(self.FormActionButtons.downloadTransmittal, attachmentId > 0);
		setFormButtonVisible(self.FormActionButtons.downloadReplyTransmittal, replyAttachmentId > 0);
	}

	function readActionFlagsFromEditor() {
		const $flags = $$('#documentActionFlags');
		if (!$flags.length) return {};
		try {
			return JSON.parse($flags.text());
		} catch (e) {
			return {};
		}
	}

	function refreshActionButtons() {
		applyDocumentActionButtons(readActionFlagsFromEditor());
	}

	function getGroupKey() {
		// 1) Prefer current editor values (after partial load)
		const $editor = $$('#RevisionEditorContainer');
		let projectId = parseInt(($editor.find('[data-bind="projectId"]').val() || '0'), 10) || 0;
		let documentVpisId = parseInt(($editor.find('[data-bind="documentVpisId"]').val() || '0'), 10) || 0;

		// 2) Fallback to new-document selectors (when page opened without id)
		if (!projectId || !documentVpisId) {
			const $new = $$('#NewDocumentGroupCard');
			if ($new.length) {
				if (!projectId) projectId = parseInt(($new.find('[data-bind="newProjectId"]').val() || '0'), 10) || 0;
				if (!documentVpisId) documentVpisId = parseInt(($new.find('[data-bind="newDocumentVpisId"]').val() || '0'), 10) || 0;
			}
		}

		return { projectId, documentVpisId };
	}

	function getCurrentRevisionId() {
		const $editor = $$('#RevisionEditorContainer');
		return parseInt(($editor.find('[data-bind="id"]').val() || '0'), 10) || 0;
	}

	function updateHeaderForNewSelection() {
		 
		const $new = $$('#NewDocumentGroupCard');
		if (!$new.length) return;

		const projectTitle = ($new.find('#NewDocProjectSelector .entity-selector-input').val() || '-').toString();
		const docTitle = ($new.find('#NewDocVpisSelector .entity-selector-input').val() || '-').toString();

		$$('[data-header-project-title]').text(projectTitle);
		$$('[data-header-document-title]').text(docTitle);

		// We don't have code here reliably; hide it for now (will be shown if server had it)
		$$('[data-header-document-code-wrapper]').hide();
	}

	function startNewDocument() {
		const $new = $$('#NewDocumentGroupCard');
		if (!$new.length) return toastr.error('امکان ثبت مدرک جدید در این حالت وجود ندارد.', 'خطا');

		if (validateError($new)) { return; }

		const projectId = parseInt(($new.find('[data-bind="newProjectId"]').val() || '0'), 10) || 0;
		const documentVpisId = parseInt(($new.find('[data-bind="newDocumentVpisId"]').val() || '0'), 10) || 0;
		if (!projectId || !documentVpisId) return toastr.error('پروژه و سند (Vpis) الزامی است.', 'خطا');

		updateHeaderForNewSelection();

		// Load Vpis summary card
		const $vpisContainer = $$('#DocumentVpisSummaryContainer');
		if ($vpisContainer.length) {
			page.getPartialView(`/Panel/Edms/Document/DocumentVpisSummaryPartial?documentVpisId=${documentVpisId}`, function (html) {
				if (html) $vpisContainer.html(html);
			});
		}

		// Create first revision editor (revision 0 for new group)
		const $container = $$('#RevisionEditorContainer');
		$container.block();

		page.getPartialView(`/Panel/Edms/Document/NewRevisionEditorPartial?projectId=${projectId}&documentVpisId=${documentVpisId}`, function (html) {
			$container.block(false);
			if (!html) return toastr.error('خطا در ایجاد فرم مدرک جدید', 'خطا');

			$container.html(html);
			initItemsForms($container);

			if (window.appController && typeof window.appController.initTabItemManager === 'function') {
				self.TabItemManagers = window.appController.initTabItemManager(page.$pageEl, page);
			}

			refreshActionButtons();
			reloadRevisionsList(getCurrentRevisionId());

			// Keep the card but collapse it to reduce clutter
			$new.addClass('d-none');
		});
	}

	function saveCurrentRevision($btnAction) {
		const $editor = $$('#DocumentRevisionEditor');
		const canEditDocument = '@canEditDocument'
		if ($editor.length === 0) return toastr.error('فرم ریویژن یافت نشد.', 'خطا');

		if (validateError($editor)) { return; }

		const model = $editor.dataBind();
		const hour = Number(model?.hourPrePerson);
		if (!hour || hour <= 0) {
			toastr.error('نفر ساعت الزامی است.', 'خطا');
			return;
		}
		const publication = (model?.publicationShamsiDate || '').toString().trim();
		if (!publication) {
			toastr.error('تاریخ انتشار/ارسال الزامی است.', 'خطا');
			return;
		}
		const pid = parseInt((model?.projectId || '0'), 10) || 0;
		const vid = parseInt((model?.documentVpisId || '0'), 10) || 0;
		if (!pid || !vid) return toastr.error('برای ذخیره، پروژه و سند (Vpis) باید مشخص باشد.', 'خطا');

		const $btn = $(this.element).block();

		$$.post('save/'+canEditDocument, model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');

			toastr.success('ذخیره‌سازی با موفقیت انجام شد.');
	 
			$editor.dataBind(r.data);
			 
			reloadRevisionsList(r.data?.id);

			$btnAction.baseaction();
		});
	}

	function openReplySheetModal() {
		const id = getCurrentRevisionId();
		if (!id) {
			toastr.error('شناسه مدرک جهت افزودن ReplySheet یافت نشد.', 'خطا');
			return;
		}

		page.getPartialView(`ReplySheetPartial?documentId=${id}`, function (v) {
			if (!v) return toastr.error('خطا در بارگذاری فرم ReplySheet', 'خطا');

			let $content = $(`${v}`).addClass('col-md-12 align-items-center');
			let $conf = $.confirm({
				title: 'افزودن ReplySheet',
				content: $content,
				rtl: true,
				type: 'blue',
				columnClass: 'col-md-8',
				typeAnimated: true,
				buttons: {
					acc: {
						text: 'ثبت ReplySheet',
						btnClass: 'btn btn-success',
						action: function () {
							if (validateError(this.$content)) return false;

							const model = this.$content.dataBind();
							const fileId = parseInt((model?.replySheetFileId || '0'), 10) || 0;
							if (!fileId) {
								toastr.error('فایل ReplySheet الزامی است.', 'خطا');
								return false;
							}

							$$.post(`AddReplySheet?documentId=${id}&replySheetFileId=${fileId}`, {}, function (r) {
								if (!r.isSuccess) return toastr.error(r.message, 'خطا');

								toastr.success('ReplySheet با موفقیت ثبت شد.');
								$conf.close();
								reloadRevisionsList(id);
							});

							return false;
						}
					},
					close: {
						text: 'بستن',
						btnClass: 'btn btn-danger',
						action: function () { }
					}
				}
			});

			initFileUploaders($content);
		});
	}

	function reloadRevisionsList(currentRevisionId) {
		const key = getGroupKey();
		if (!key.projectId || !key.documentVpisId) return;

		const url = `RevisionsListPartial?projectId=${key.projectId}&documentVpisId=${key.documentVpisId}&currentId=${currentRevisionId || 0}`;
		const $container = $$('#RevisionsListContainer');
		$container.block();
		page.getPartialView(url, function (html) {
			$container.block(false);
			if (!html) return toastr.error('خطا در به‌روزرسانی لیست ریویژن‌ها', 'خطا');
			$container.html(html);
			var totalCount = $("#RevisionsListContainer div[data-revision-id]").length;
			 $$("#revisionsTotalCount").text(`${totalCount} مورد`)
			 loadRevisionEditor(currentRevisionId)
		});
	}

	function loadRevisionEditor(revisionId,revisionNum = 0) {
		if (!revisionId) return;
		 
		const $container = $$('#RevisionEditorContainer');
		$container.block();

		page.getPartialView(`/Panel/Edms/Document/RevisionEditorPartial?id=${revisionId}&canEditDocument=@canEditDocument`, function (html) {
			$container.block(false);
			if (!html) return toastr.error('خطا در دریافت اطلاعات ریویژن', 'خطا');

			$container.html(html);
			initItemsForms($container);

			// Re-init tab item managers (comments table, add/remove, etc.)
			if (window.appController && typeof window.appController.initTabItemManager === 'function') {
				self.TabItemManagers = window.appController.initTabItemManager(page.$pageEl, page);
			}

			refreshActionButtons();

			// Mark active in list
			$$('.js-revision-item').removeClass('border-primary revision-selected').addClass('border-gray-200');
			$$(`.js-revision-item[data-revision-id="${revisionId}"]`).removeClass('border-gray-200').addClass('border-primary revision-selected');
				$$(`[data-watch]`).each((c,i)=>{
				    if($(i).data("watch") == revisionId){
					  $(i) .find("span").removeClass("d-none")
				    }
				    else
				    {
						$(i) .find("span").addClass("d-none")
				    }
				})
		});
	}

	function newRevision() {
		const key = getGroupKey();
		if (!key.projectId || !key.documentVpisId) return startNewDocument();

		const $container = $$('#RevisionEditorContainer');
		$container.block();

		page.getPartialView(`/Panel/Edms/Document/NewRevisionEditorPartial?projectId=${key.projectId}&documentVpisId=${key.documentVpisId}`, function (html) {
			$container.block(false);
			if (!html) return toastr.error('خطا در ایجاد ریویژن جدید', 'خطا');

			$container.html(html);
			initItemsForms($container);

			if (window.appController && typeof window.appController.initTabItemManager === 'function') {
				self.TabItemManagers = window.appController.initTabItemManager(page.$pageEl, page);
			}

			refreshActionButtons();
		});
	}

	// Wire default save buttons to save only the active revision editor
	self.FormActionButtons.save.onclick(function () { saveCurrentRevision.call(this, this) });
	self.FormActionButtons.saveandnew.onclick(function () { saveCurrentRevision.call(this, this) });
	self.FormActionButtons.saveandclose.onclick(function () { saveCurrentRevision.call(this, this) });
	self.FormActionButtons.addReplySheet.onclick(function () { openReplySheetModal(); });

	// Custom actions
	self.FormActionButtons.downloadTransmittal.onclick(function () {
		const attachmentId = $$('#DocumentRevisionEditor').attr('data-transmittal-attachment-id');
		if (!attachmentId || attachmentId === '0') return;
		window.open('/File/download/' + attachmentId, '_blank', 'noopener');
	});
	if (self.FormActionButtons.downloadReplyTransmittal) {
		self.FormActionButtons.downloadReplyTransmittal.onclick(function () {
			const attachmentId = $$('#DocumentRevisionEditor').attr('data-reply-transmittal-attachment-id');
			if (!attachmentId || attachmentId === '0') return;
			window.open('/File/download/' + attachmentId, '_blank', 'noopener');
		});
	}

	self.FormActionButtons.newRevision.onclick(function () { newRevision(); });
	self.FormActionButtons.reloadRevisions.onclick(function () { reloadRevisionsList(getCurrentRevisionId()); });

	function copyDocumentHeaderText(text) {
		text = (text || '').trim();
		if (!text) {
			toastr.warning('متنی برای کپی وجود ندارد');
			return;
		}

		const done = function () { toastr.success('متن کپی شد'); };
		if (navigator.clipboard && window.isSecureContext) {
			navigator.clipboard.writeText(text).then(done).catch(function () {
				copyDocumentHeaderTextFallback(text, done);
			});
			return;
		}
		copyDocumentHeaderTextFallback(text, done);
	}

	function copyDocumentHeaderTextFallback(text, done) {
		const area = document.createElement('textarea');
		area.value = text;
		area.setAttribute('readonly', 'readonly');
		area.style.position = 'fixed';
		area.style.left = '-9999px';
		document.body.appendChild(area);
		area.select();
		const copied = document.execCommand('copy');
		document.body.removeChild(area);
		if (copied) done();
		else toastr.error('کپی متن انجام نشد', 'خطا');
	}

	$$('#documentGroupHeader').on('click', '[data-copy-header]', function () {
		const $item = $(this);
		const text = $item.find('[data-copy-value]').first().text();
		copyDocumentHeaderText(text);
		$$('#documentGroupHeader [data-copy-header]').removeClass('is-copied');
		$item.addClass('is-copied');
		window.setTimeout(function () { $item.removeClass('is-copied'); }, 1200);
	});

	// Revision list click
	$$('#RevisionsListContainer').on('click', '.js-open-revision', function () {
		const id = $(this).data('revision-id');
		const num = $(this).data('revision-num');
		loadRevisionEditor(id,num);
	});

	// Initial button visibility
	applyDocumentActionButtons(@Html.Raw(Json.Serialize(initialActionFlags)));

	// New-document actions
	$$('#NewDocumentGroupCard').on('click', '[data-action="start-new-document"]', function () {
		startNewDocument();
	});
	$$('#NewDocumentGroupCard').on('click', '[data-action="clear-new-document"]', function () {
		const $new = $$('#NewDocumentGroupCard');
		$new.find('[data-bind="newProjectId"]').val('').change();
		$new.find('#NewDocProjectSelector .entity-clear').trigger('click');
		$new.find('[data-bind="newDocumentVpisId"]').val('').change();
		$new.find('#NewDocVpisSelector .entity-clear').trigger('click');

		$$('[data-header-project-title]').text('-');
		$$('[data-header-document-title]').text('-');
		$$('[data-header-document-code-wrapper]').hide();
	});
	
	 self.FormActionButtons.addComment.onclick(function () {
			
			const id = $$("#DocumentRevisionEditor").find("[data-bind=id]").val();

			if(!id){
				error2("شناسه مدرک جهت افزودن کامنت یافت نشد.");
				return;
			}

			var currentStatus =$$("#docStatus").val() ;
			var projectId = $$("#projectId").val() ;
			var allowCommentDate = String(currentStatus) === "NotReview" || String(currentStatus) === "18";
			var dateQuery = allowCommentDate ? "&allowCommentDate=true" : "";

		page.getPartialView(`DocumentCommentPartialEdit?documentId=${id}&projectId=${projectId}&currentStatus=${currentStatus}&canEdit=true${dateQuery}`, function (v) {

			let $content = $(`${v}`).addClass("col-md-12 align-items-center")
		let $conf =	$.confirm({
				title: 'افزودن کامنت',
				content: $content,
				rtl: true,
				type: 'green',
				columnClass: "col-md-12",
				typeAnimated: true,
				buttons: {
					acc: {
						text: 'افزودن کامنت',
						btnClass: 'btn  btn-success',
						action: function () {
 
							let model =this.$content.dataBind().comments[0];
							$$.post("AddNewComment",model,function(r){
								if(!r.isSuccess)return error2(r.message);

								 reloadRevisionsList(getCurrentRevisionId());
								 toastr.success("کامنت جدید به مدرک اضافه شد")
								 $conf.close();
								 appController.closeCurrentPage();
							})

							return false;
						}
					},
					close:
					{
						text: 'بستن',
						btnClass: 'btn  btn-danger',
						action: function () {
						}
					}
				}
			});

			const holdStatus = "16";
			const toggleHoldFields = function () {
				const isHold = String($content.find('[data-comment-status]').val()) === holdStatus;
				const $hold = $content.find('[data-hold-fields]');
				$hold.toggleClass('d-none', !isHold);
				if (!isHold) {
					$hold.find('.entity-clear').trigger('click');
					$hold.find('[data-bind="comments.holdOwnerId"]').val('');
					$hold.find('[data-bind="comments.legalHolder"]').val('');
				}
			};
			$content.find('[data-comment-status]').on('change', toggleHoldFields);
			toggleHoldFields();

			initFileUploaders($content)
			if (allowCommentDate && typeof initPersionDatePicker === "function")
				initPersionDatePicker($content);
		});


	})

	self.FormActionButtons.deleteLastComment.onclick(function () {
		const id = $$("#DocumentRevisionEditor").find("[data-bind=id]").val();

		if (!id) {
			error2("شناسه مدرک جهت حذف آخرین کامنت یافت نشد.");
			return;
		}

		const $btn = $(this.element);

		Swal.fire({
			title: 'حذف آخرین کامنت',
			text: 'آخرین کامنت این ریویژن حذف و اثر آن وضعیت (مثل ترانسمیتال یا تاریخ‌های بررسی/تایید) برگردانده می‌شود. اگر این کامنت Issue و تنها کامنت ریویژن باشد، خود ریویژن حذف و مدرک صادرنشده می‌شود. ادامه می‌دهید؟',
			icon: 'warning',
			showCancelButton: true,
			confirmButtonText: 'بله، حذف شود',
			cancelButtonText: 'انصراف'
		}).then(function (result) {
			if (!result.isConfirmed) return;

			$btn.block();
			$$.post(`DeleteLastComment?documentId=${id}`, {}, function (r) {
				$btn.block(false);

				if (!r.isSuccess) {
					toastr.error(r.message, 'خطا');
					return;
				}

				toastr.success('آخرین کامنت حذف شد');

				if (r.data && r.data.revisionDeleted) {
					appController.closeCurrentPage();
					appController.addPage(`/Panel/Edms/Document/EditAsGroup?projectId=${r.data.projectId}&documentVpisId=${r.data.documentVpisId}`);
					return;
				}

				appController.refreshCurrentPage();
			});
		});
	});


</script>

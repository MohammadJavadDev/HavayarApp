                    <textarea class="form-control" data-bind="opinionofAfterSalesServiceSupervisor" rows="5" asp-for="OpinionofAfterSalesServiceSupervisor" rows="1"></textarea>
               </div>

               <div class="col-md-12">
                    <label class='form-label fw-bold'>نظر مدير خدمات پس از فروش</label>
                    <textarea class="form-control" data-bind="afterSalesServiceManagersOpinion" rows="5" asp-for="AfterSalesServiceManagersOpinion" rows="1"></textarea>
               </div>

               <div class="col-md-12">
                    <label class='form-label fw-bold'>توضیحات کارشناس</label>

@using Entities.App.Bom;
@using Entities.App.Inv
@model FormulChangeRequest

<div class="card  ">
	<div class="form-action-buttons"><form-action-buttons entity-type="typeof(FormulChangeRequest)"></form-action-buttons></div>
</div>
<div class="card">
	<div class="card-body row">
		<div class="col-12 mb-4">
			<h3 class="fw-bold text-dark">اطلاعات اصلی</h3>
		</div>
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class='col-md-6'>
			<label class=''>نوع عملیات</label>
			<select class='form-control' data-bind='operationType'  asp-for='OperationType' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Bom.Enums.FormulChangeRequestOperationTypeEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>قطعه</label>
			@(Html.EntitySelector<Part>(
				"PartSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Code = c.Code, Name = c.Name
				},
				c => new { c.Code, c.Name },
				"{Code} {Name}",
				"PartId",
				"PartName",
				Model?.PartId?.ToString(),
				true
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>
		
		<div class="col-md-6">
			<label class=''>گروه محصول</label>
			@(Html.EntitySelector<ProductGroup>(
				"ProductGroupSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id,  Name = c.Name
				},
				c => new {   c.Name },
				" {Name}",
				"ProductGroupId",
				 null,
				Model?.ProductGroupId.ToString(),
				true
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		

		<div class="col-md-6">
			<label class=''>قطعه جایگزین</label>
			@(Html.EntitySelector<Part>(
				"ReplacementPartSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Code = c.Code, Name = c.Name
				},
				c => new { c.Code, c.Name },
				"{Code} {Name}",
				"ReplacementPartId",
				"ReplacementPartName",
				Model?.ReplacementPartId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>توضیحات</label>
			<input class='form-control' data-bind='description'  asp-for='Description' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<fileuploader
				bind="attachmentId" 
				accepted-file-types=".rar,.zip,.pdf,.excel,.word"
				file-id="@Model?.AttachmentId"
				file-entity="@Model?.Attachment"
				entity-prop-name="Attachment"
				entity-type="FormulChangeRequest"
				max-file-size="10"
				label="پیوست"></fileuploader>
		</div>
		 

		<div class='col-md-6'>
			<label class=''>وضعیت</label>
			<select class='form-control' data-bind='status'  asp-for='Status' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Bom.Enums.FormulChangeRequestStatusEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	</div>
</div>

 

<div class="card">
	 
	<div class='card-body row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) { return; }
		var model = page.$pageEl.dataBind();
		const $btn = $(this.element).block();
		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				page.$pageEl.dataBind(r.data);
				$btnAction.baseaction();
			})
	}

	self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
</script>

@using WebFramework.ViewModels.ImportDefinitionsViewModels
@model  ImportDataViewModel
 

<div class="container-fluid py-4" dir="rtl">
 
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1">
                <i class="fas fa-file-excel text-success me-2"></i>ورود اطلاعات از اکسل
            </h4>
            <small class="text-muted">اطلاعات را از طریق فایل اکسل وارد سیستم کنید</small>
        </div>
        <a asp-controller="ImportDefinition" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-cog me-1"></i> مدیریت تعریف‌ها
        </a>
    </div>

    <div class="row g-4">
          
        <div class="col-lg-8">
              
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex align-items-center gap-2">
                         <span class="badge bg-primary rounded-circle" style="width:28px;height:28px;line-height:20px;font-size:14px;place-content: center;">۱</span>
                    <span class="fw-semibold">انتخاب نوع ورود اطلاعات</span>
                </div>
                <div class="card-body">
                    <div class="row align-items-end g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">تعریف ورود اطلاعات</label>
                            <select id="selDefinition" class="form-select form-select-lg">
                                <option value="">-- انتخاب کنید --</option>
                                @foreach (var d in Model.Definitions)
                                {
                                    <option value="@d.Id"
                                            selected="@(Model.SelectedDefinitionId == d.Id)"
                                            data-entity="@d.FullNameEntity">
                                        @d.Title
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <a id="btnDownloadSample" class="btn btn-outline-success w-100 btn-lg" disabled>
                                <i class="fas fa-download me-2"></i>دانلود نمونه اکسل
                            </a>
                        </div>
                    </div>

          
                    <div id="defInfo" class="mt-3 d-none">
                        <div class="alert alert-info py-2 mb-0">
                            <strong>ستون‌های این ورود اطلاعات:</strong>
                            <div id="defColumns" class="mt-2 d-flex flex-wrap gap-2"></div>
                        </div>
                    </div>
                </div>
            </div>

 
            <div class="card shadow-sm mb-4" id="cardUpload" style="opacity:.5;pointer-events:none">
                <div class="card-header d-flex align-items-center gap-2">
                         <span class="badge bg-primary rounded-circle" style="width:28px;height:28px;line-height:20px;font-size:14px;place-content: center;">۲</span>
                    <span class="fw-semibold">آپلود فایل اکسل</span>
                </div>
                <div class="card-body">
                    <div class="upload-area border-2 border-dashed rounded p-5 text-center"
                         id="uploadArea" style="border-color:#dee2e6;cursor:pointer">
                        <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3 d-block"></i>
                        <p class="mb-1 fw-semibold">فایل اکسل را اینجا بکشید یا کلیک کنید</p>
                        <small class="text-muted">فرمت‌های پشتیبانی‌شده: .xlsx, .xls</small>
     
                    </div>
                         <input type="file" id="fileInput" accept=".xlsx,.xls" class="d-none" />

                    <div id="fileInfo" class="mt-3 d-none">
                        <div class="d-flex align-items-center gap-3 p-3 bg-light rounded">
                            <i class="fas fa-file-excel fa-2x text-success"></i>
                            <div class="flex-grow-1">
                                <div class="fw-semibold" id="fileName"></div>
                                <small class="text-muted" id="fileSize"></small>
                            </div>
                            <button id="btnClearFile" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

 
            <div class="card shadow-sm mb-4" id="cardMapping" style="opacity:.5;pointer-events:none">
                <div class="card-header d-flex align-items-center gap-2">
                         <span class="badge bg-primary rounded-circle" style="width:28px;height:28px;line-height:20px;font-size:14px;place-content: center;">۳</span>
                    <span class="fw-semibold">مپ کردن ستون‌های اکسل</span>
               
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        در صورتی که عنوان ستون‌های اکسل با عنوان تعریف‌شده متفاوت است، اینجا مپ کنید.
                    </p>
                    <div class="table-responsive">
                              <table class="table table-sm table-bordered" id="mappingTable">
                            <thead class="table-light">
                                <tr>
                                    <th>فیلد تعریف‌شده</th>
                                    <th>نوع</th>
                                    <th>الزامی</th>
                                    <th>ستون اکسل متناظر</th>
                                </tr>
                            </thead>
                            <tbody id="mappingBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>

          
            <div class="d-grid" id="divImportBtn" style="opacity:.5;pointer-events:none">
                <button id="btnImport" class="btn btn-primary btn-lg py-3">
                    <i class="fas fa-play-circle me-2"></i>شروع ورود اطلاعات
                </button>
            </div>
        </div>

  
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h6 class="fw-bold mb-3"><i class="fas fa-info-circle text-primary me-2"></i>راهنمای سریع</h6>
                    <ol class="ps-3 small text-muted">
                        <li class="mb-2">نوع ورود اطلاعات را انتخاب کنید</li>
                        <li class="mb-2">نمونه اکسل را دانلود کنید</li>
                        <li class="mb-2">ستون‌های مشخص‌شده را پر کنید</li>
                        <li class="mb-2">فایل را آپلود کنید</li>
                        <li class="mb-2">در صورت لزوم ستون‌ها را مپ کنید</li>
                        <li>دکمه «شروع ورود» را بزنید</li>
                    </ol>
                    <div class="alert alert-warning mt-3 py-2 small mb-0">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        ستون‌هایی که با <span class="text-danger fw-bold">*</span> مشخص شده‌اند الزامی هستند.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

 
<div class="modal fade" id="resultModal" tabindex="-1" dir="rtl" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-chart-bar me-2"></i>گزارش ورود اطلاعات</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
 
                <div class="row g-3 mb-4">
                    <div class="col-3">
                        <div class="card text-center border-0 bg-light">
                            <div class="card-body py-3">
                                <div class="fs-1 fw-bold text-dark" id="rTotal">0</div>
                                <small class="text-muted">کل ردیف‌ها</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card text-center border-0 bg-success bg-opacity-10">
                            <div class="card-body py-3">
                                <div class="fs-1 fw-bold text-success" id="rSuccess">0</div>
                                <small class="text-success">موفق</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card text-center border-0 bg-danger bg-opacity-10">
                            <div class="card-body py-3">
                                <div class="fs-1 fw-bold text-danger" id="rFailed">0</div>
                                <small class="text-danger">ناموفق</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="card text-center border-0 bg-info bg-opacity-10">
                            <div class="card-body py-3">
                                <div class="fs-1 fw-bold text-info" id="rPercent">0%</div>
                                <small class="text-info">درصد موفقیت</small>
                            </div>
                        </div>
                    </div>
                </div>

 
                <div class="progress mb-4" style="height:12px;border-radius:6px">
                    <div id="rProgressBar" class="progress-bar bg-success" style="width:0%"></div>
                </div>

 
                <div id="rErrorSection" class="d-none">
                    <h6 class="fw-bold text-danger mb-3">
                        <i class="fas fa-exclamation-triangle me-2"></i>خطاهای رخ داده
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead class="table-danger">
                                <tr>
                                    <th width="80" class="text-center">شماره ردیف</th>
                                    <th>پیام خطا</th>
                                </tr>
                            </thead>
                            <tbody id="rErrorBody"></tbody>
                        </table>
                    </div>
                </div>

                <div id="rAllSuccess" class="text-center py-4 d-none">
                    <i class="fas fa-check-circle fa-4x text-success mb-3 d-block"></i>
                    <h5 class="text-success fw-bold">همه ردیف‌ها با موفقیت وارد شدند!</h5>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="btnNewImport" data-bs-dismiss="modal">
                    <i class="fas fa-redo me-2"></i>ورود اطلاعات جدید
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

 
<div id="loadingOverlay" class="d-none position-fixed top-0 start-0 w-100 h-100"
     style="background:rgba(0,0,0,.5);z-index:9999">
    <div class="d-flex align-items-center justify-content-center h-100">
        <div class="text-center text-white">
            <div class="spinner-border mb-3" role="status" style="width:3rem;height:3rem"></div>
            <h5>در حال پردازش...</h5>
            <small>لطفاً صبر کنید</small>
        </div>
    </div>
</div>

 
<script>
 
    let definitionColumns = [];   
    let excelHeaders      = [];    
    let selectedFile      = null;  
 
    $$('#selDefinition').on('change', function () {
        const defId = $(this).val();

        if (!defId) {
            resetAll();
            return;
        }

 
        $$('#btnDownloadSample')
            .prop('disabled', false)
             .attr('href', `/panel/importData/downloadSample/${defId}`)
            

 
         $$.get(`/panel/importDefinition/getColumns/${defId}`, function (cols) {
               if(!cols.isSuccess) return error2(cols.message);
            definitionColumns = cols.data;

 
             let badges = definitionColumns.map(c => {
                let badge = `<span class="badge ${c.isRequired ? 'bg-danger' : 'bg-secondary'}">
                    ${c.displayName}${c.isRequired ? ' *' : ''}
                    <small class="ms-1 opacity-75">${c.dataType}</small>
                </span>`;
                return badge;
            }).join('');
            $$('#defColumns').html(badges);
            $$('#defInfo').removeClass('d-none');

 
            enableStep('cardUpload');
        });
    });
 
    $$('#uploadArea').click( function () {
         debugger
        $$('#fileInput').trigger('click');
    });
 
    $$('#uploadArea').on('dragover', function (e) {
        e.preventDefault();
        $(this).addClass('border-primary bg-light');
    }).on('dragleave', function () {
        $(this).removeClass('border-primary bg-light');
    }).on('drop', function (e) {
        e.preventDefault();
        $(this).removeClass('border-primary bg-light');
        const file = e.originalEvent.dataTransfer.files[0];
        if (file) processFile(file);
    });

    $$('#fileInput').on('change', function () {
        if (this.files[0]) processFile(this.files[0]);
    });

    $$('#btnClearFile').on('click', function () {
        selectedFile = null;
        excelHeaders = [];
        $$('#fileInput').val('');
        $$('#fileInfo').addClass('d-none');
        $$('#uploadArea').removeClass('d-none');
        disableStep('cardMapping');
        disableStep('divImportBtn');
        $$('#mappingBody').empty();
    });

    function processFile(file) {
        if (!file.name.match(/\.(xlsx|xls)$/i)) {
            alert('لطفاً فقط فایل اکسل (.xlsx یا .xls) آپلود کنید.');
            return;
        }

        selectedFile = file;
        $$('#fileName').text(file.name);
        $$('#fileSize').text(formatSize(file.size));
        $$('#fileInfo').removeClass('d-none');
        $$('#uploadArea').addClass('d-none');

        // خواندن هدرهای اکسل از سرور
        const fd = new FormData();
        fd.append('excelFile', file);


        $.ajax({
             url: '/panel/importData/getExcelHeaders',
            type: 'POST',
            data: fd,
            processData: false,
            contentType: false,
            headers: { 'RequestVerificationToken': getAntiForgeryToken() },
            success: function (headers) {
                excelHeaders = headers;
                buildMappingTable();
                enableStep('cardMapping');
                enableStep('divImportBtn');
            },
            error: function (xhr) {
                alert('خطا در خواندن اکسل: ' + xhr.responseText);
            }
        });
    }

 
    function buildMappingTable() {
        const tbody = $$('#mappingBody').empty();

        definitionColumns.forEach(col => {
            // بررسی تطابق خودکار
            const autoMatch = excelHeaders.find(h => h.replace("*","").trim() === col.displayName) || '';

            let opts = `<option value="">-- انتخاب --</option>`;
            excelHeaders.forEach(h => {
                opts += `<option value="${h}" ${h === autoMatch ? 'selected' : ''}>${h}</option>`;
            });

            tbody.append(`
            <tr>
                <td>
                    <span class="fw-semibold">${col.displayName}</span>
                    <small class="text-muted d-block font-monospace">@@${col.columnName}</small>
                </td>
                <td><span class="badge bg-light text-dark">${col.dataType}</span></td>
                <td class="text-center">
                    ${col.isRequired
                        ? '<span class="badge bg-danger">الزامی</span>'
                        : '<span class="badge bg-light text-muted">اختیاری</span>'}
                </td>
                <td>
                    <select class="form-select form-select-sm col-mapping-select"
                            data-col="${col.columnName}">
                        ${opts}
                    </select>
                </td>
            </tr>`);
        });
    }

    // ==============================================================
    // شروع ورود اطلاعات
    // ==============================================================
    $$('#btnImport').on('click', function () {
        if (!selectedFile) { alert('لطفاً فایل اکسل را انتخاب کنید.'); return; }
        const defId = $$('#selDefinition').val();
         if (!defId || defId == 0) { alert('لطفاً نوع ورود اطلاعات را انتخاب کنید.'); return; }

        // ساخت mapping
        const mapping = {};
        $$('.col-mapping-select').each(function () {
            const colName   = $(this).data('col');
            const excelCol  = $(this).val();
            if (excelCol) mapping[excelCol] = colName;
        });

        const fd = new FormData();
        fd.append('excelFile', selectedFile);
        fd.append('importDefinitionId', defId);
        fd.append('columnMappingJson', JSON.stringify(mapping));

        showLoading(true);

        $.ajax({
             url: '/panel/importData/import',
            type: 'POST',
            data: fd,
            processData: false,
            contentType: false,
 
            success: function (res) {
                showLoading(false);
                showResults(res);
            },
            error: function (xhr) {
                showLoading(false);
                let msg = 'خطایی رخ داد.';
                try { msg = JSON.parse(xhr.responseText).message || msg; } catch {}
                alert(msg);
            }
        });
    });

    // ==============================================================
    // نمایش نتایج در Modal
    // ==============================================================
    function showResults(res) {
           if(!res.isSuccess) return errro2(res.message);

                res = res.data;
        const successPct = res.totalRows > 0
            ? Math.round(res.successRows / res.totalRows * 100) : 0;

        $$('#rTotal').text(res.totalRows);
        $$('#rSuccess').text(res.successRows);
        $$('#rFailed').text(res.failedRows);
        $$('#rPercent').text(successPct + '%');
        $$('#rProgressBar').css('width', successPct + '%')
            .removeClass('bg-success bg-warning bg-danger')
            .addClass(successPct === 100 ? 'bg-success'
                     : successPct > 50  ? 'bg-warning' : 'bg-danger');

        if (res.failedRows > 0 && res.failedDetails && res.failedDetails.length > 0) {
            $$('#rErrorSection').removeClass('d-none');
            $$('#rAllSuccess').addClass('d-none');
            const tbody = $$('#rErrorBody').empty();
            res.failedDetails.forEach(d => {
                tbody.append(`
                    <tr>
                        <td class="text-center fw-bold text-danger">${d.rowNumber}</td>
                        <td class="text-danger">${d.errorMessage || ''}</td>
                    </tr>`);
            });
        } else if (res.totalRows > 0) {
            $$('#rErrorSection').addClass('d-none');
            $$('#rAllSuccess').removeClass('d-none');
        }

        new bootstrap.Modal('#resultModal').show();
    }

    // ==============================================================
    // بعد از بستن modal: آماده ورود جدید
    // ==============================================================
    $$('#btnNewImport').on('click', function () {
        resetFileOnly();
    });

    // ==============================================================
    // توابع کمکی
    // ==============================================================
    function enableStep(id) {
        $(`#${id}`).css({ opacity: 1, 'pointer-events': 'auto' });
    }
    function disableStep(id) {
        $(`#${id}`).css({ opacity: '.5', 'pointer-events': 'none' });
    }
    function resetAll() {
        disableStep('cardUpload');
        disableStep('cardMapping');
        disableStep('divImportBtn');
        $$('#defInfo').addClass('d-none');
        $$('#btnDownloadSample').prop('disabled', true);
        resetFileOnly();
    }
    function resetFileOnly() {
        selectedFile = null;
        excelHeaders = [];
        $$('#fileInput').val('');
        $$('#fileInfo').addClass('d-none');
        $$('#uploadArea').removeClass('d-none');
        disableStep('cardMapping');
        disableStep('divImportBtn');
        $$('#mappingBody').empty();
    }
    function formatSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }
    function getAntiForgeryToken() {
        return $$('input[name="__RequestVerificationToken"]').val() || '';
    }
    function showLoading(show) {
        $$('#loadingOverlay').toggleClass('d-none', !show);
    }

    // مقداردهی اولیه
    const preSelected = '@(Model.SelectedDefinitionId?.ToString() ?? "")';
    if (preSelected) {
        $$('#selDefinition').val(preSelected).trigger('change');
    }
 
</script>

 

@using Entities.App.Sale;
@model SaleReport

<div class="card shadow-sm border-0">

     <div class="form-action-buttons border-bottom p-3">
          <form-action-buttons entity-type="typeof(SaleReport)"></form-action-buttons>
     </div>

     <div class="card-body">

          <div class="row mb-4">
               <div class="col-12">
                    <h4 class="fw-bold text-dark mb-0">
                         گزارش کار
                    </h4>
               </div>
          </div>

          <input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />

          <div class="row g-3">

               <div class="col-md-3">
                    <label class="form-label fw-bold">ماموریت</label>

                    <select class="form-control" data-bind="saleMissionIds" id="SaleMissionIdSelector">
                         <option value="">-- انتخاب ماموریت --</option>
                    </select>

                    <div data-invalidmessagespan class="mt-1">
                         <span class="text-danger"></span>
                    </div>
               </div>

               <div class="col-md-3">
                    <label class="form-label fw-bold">گزارش مشابه</label>

                    <div class="input-group">
                         <select class="form-control" data-bind="sameReportId" id="SameReportIdSelector">
                              <option value="">-- انتخاب گزارش مشابه --</option>
                         </select>

                         <button type="button"
                                 class="btn btn-primary"
                                 id="btnGetSameReport"
                                 title="دریافت گزارش مشابه">
                              <i class="fas fa-download"></i>
                              دریافت
                         </button>
                    </div>

                    <div data-invalidmessagespan class="mt-1">
                         <span class="text-danger"></span>
                    </div>
               </div>

               <div class="col-md-3">
                    <label class="form-label fw-bold">شماره گزارش</label>

                    <input class="form-control"
                           data-bind="reportNumber"
                           asp-for="ReportNumber" />

                    <div data-invalidmessagespan class="mt-1">
                         <span class="text-danger"></span>
                    </div>
               </div>

               <div class="col-md-3">
                    <label class="form-label fw-bold">محصول</label>

                    <select class="form-control" data-bind="saleReportProductsId" id="saleReportProductsIdIdSelector">
                         <option value="">-- انتخاب نمایید --</option>
                    </select>

                    <div data-invalidmessagespan class="mt-1">
                         <span class="text-danger"></span>
                    </div>
               </div>

               <div class='col-md-3'>
                    <label class='form-label fw-bold'>
                         تاریخ شروع
                    </label>
                    <input class='form-control' data-bind='serviceStartShamsiDate' data-persionDatePicker="true"
                           persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                           value='@Model?.ServiceStartMiladiDate' />
               </div>
               <div class='col-md-3'>
                    <label class='form-label fw-bold'>
                         ساعت شروع
                    </label>
                    <input class='form-control time-input'
                           data-bind='serviceStartTime'
                           maxlength="4"
                           value='@Model?.ServiceStartTime' />
                    <small class="text-muted">عدد را بدون دو نقطه وارد کنید (مثال: 0700)</small>
               </div>

               <div class='col-md-3'>
                    <label class='form-label fw-bold'>
                         تاریخ پایان
                    </label>
                    <input class='form-control' data-bind='serviceEndShamsiDate' data-persionDatePicker="true"
                           persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                           value='@Model?.ServiceEndMiladiDate' />
               </div>

               <div class='col-md-3'>
                    <label class='form-label fw-bold'>
                         ساعت پایان
                    </label>
                    <input class='form-control time-input'
                           data-bind='serviceEndTime'
                           maxlength="4"
                           value='@Model?.ServiceEndTime' />
                    <small class="text-muted">عدد را بدون دو نقطه وارد کنید (مثال: 1700)</small>
               </div>

               <div class="col-md-3">
                    <label class="form-label fw-bold">شرح خرابی</label>

                    @(Html.EntitySelector<FailureTypeSale>(
                                        "FailureTypeIdSelector",
                                        c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                                        c => new
                                        {
                                             Id = c.Id,
                                             Title = c.Title,
                                             Code = c.Code
                                        },
                                        c => new { c.Title, c.Code },
                                        "{Code} {Title}",
                                        "FailureTypeId",
                                        Model?.FailureType?.Title,
                                        Model?.FailureTypeId?.ToString()
                                        ))

                    <div data-invalidmessagespan class="mt-1">
                         <span class="text-danger"></span>
                    </div>
               </div>

               <div class="col-md-3">
                    <label class="form-label fw-bold">کد های عملیاتی</label>

                    @(Html.EntitySelector<RepairsType>(
                                        "RepairsTypeIdSelector",
                                        c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                                        c => new
                                        {
                                             Id = c.Id,
                                             Title = c.Title,
                                             Code = c.Code
                                        },
                                        c => new { c.Title, c.Code },
                                        "{Code} {Title}",
                                        "RepairsTypeId",
                                        Model?.RepairsType?.Title,
                                        Model?.RepairsTypeId?.ToString(),
                                        false,
                                        true
                                        ))

                    <div data-invalidmessagespan class="mt-1">
                         <span class="text-danger"></span>
                    </div>
               </div>

               <div class="col-md-3">
                    <label class="form-label fw-bold">شرح موانع اجرایی</label>
                    <textarea class="form-control" data-bind="executiveBarriersDescription" asp-for="ExecutiveBarriersDescription" rows="2"></textarea>
               </div>

               <div class='col-md-3'>
                    <label class="form-label fw-bold">ساعت کارکرد</label>
                    <input class='form-control' data-bind='totalRunTime' asp-for='TotalRunTime' />
               </div>

               <div class='col-md-3'>
                    <label class="form-label fw-bold">ساعت کارکرد زیر بار</label>
                    <input class='form-control' data-bind='workHoursUnderload' asp-for='WorkHoursUnderload' />
               </div>

               <div class='col-md-3'>
                    <label class="form-label fw-bold"> شدت جریان زیر بار</label>
                    <input class='form-control' data-bind='flowIntensityUnderload' asp-for='FlowIntensityUnderload' />
               </div>

               <div class='col-md-3'>
                    <label class="form-label fw-bold"> شدت جریان بدون بار</label>
                    <input class='form-control' data-bind='flowIntensityWithoutload' asp-for='FlowIntensityWithoutload' />
               </div>

               <div class='col-md-3'>
                    <label class="form-label fw-bold">حداکثر فشار کاری</label>
                    <input class='form-control' data-bind='maximumWorkingPressure' asp-for='MaximumWorkingPressure' />
               </div>

               <div class='col-md-3'>
                    <label class="form-label fw-bold">حداقل فشار کاری</label>
                    <input class='form-control' data-bind='minimumWorkingPressure' asp-for='MinimumWorkingPressure' />
               </div>

               <div class='col-md-3'>
                    <label class="form-label fw-bold">دمای محیط</label>
                    <input class='form-control' data-bind='environmentTemperature' asp-for='EnvironmentTemperature' />
               </div>

               <div class='col-md-3'>
                    <label class="form-label fw-bold">دمای دستگاه</label>
                    <input class='form-control' data-bind='deviceTemperature' asp-for='DeviceTemperature' />
               </div>

               <div class='col-md-3'>
                    <label class="form-label fw-bold">ولتاژ تابلو برق</label>
                    <input class='form-control' data-bind='voltagePowerGrid' asp-for='VoltagePowerGrid' />
               </div>

               <div class='col-md-3'>
                    <label class="form-label fw-bold">مقدار دیوپوینت درایر</label>
                    <input class='form-control' data-bind='amountDryerDyupoint' asp-for='AmountDryerDyupoint' />
               </div>



               <div class='col-md-3'>
                    <label class='form-label fw-bold'>نتیجه</label>
                    <select class='form-control' data-bind='missionResult' asp-for='MissionResult' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.MissionResultEnum))">
                    </select>
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class='col-md-3'>
                    <label class='form-label fw-bold'>تعویض برد</label>
                    <input class='form-control' data-bind='oldRunTime' asp-for='OldRunTime' />
               </div>



               <div class="col-md-3">
                    <fileuploader bind="SaleReportAttachmentId" file-id="@Model?.SaleReportAttachmentId" file-entity="@Model?.SaleReportAttachment"

{
     "Logging": {
          "LogLevel": {
               "Default": "Information",
               "Microsoft.AspNetCore": "Warning"
          }
     },
     "ConnectionStrings": {
          "Db": "Data Source=PortalSRV\\PORTAL; Initial Catalog=HavayarApp; User Id=sa;  Password=Sql123456$$;TrustServerCertificate=True"
     },
     "Urls": "https://portal.havayar.com:62350;http://portal.havayar.com:62351",
     "WebAppBaseUrl": "https://portal.havayar.com",
     "AllowedOrigins": [
          "https://localhost:7073",
          "http://localhost:7073",
          "https://portal.havayar.com",

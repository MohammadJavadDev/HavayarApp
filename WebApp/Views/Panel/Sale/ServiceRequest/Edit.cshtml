                                Name = c.Name + " " + c.Family,
                                Code = c.Code
                            },
                            c => new { c.Name, c.Family },
                            "{Name}",
                            "ResponsibleZoneId",
                            Model?.ResponsibleZone != null
                                ? Model.ResponsibleZone.Name + " " + Model.ResponsibleZone.Family
                                : "",
                            Model?.ResponsibleZoneId?.ToString()
                        ))
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">نام منطقه</label>
                        @(Html.EntitySelector<Region>(
                            "DispachZoneSelector",
                            c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                            c => new
                            {
                                Id = c.Id,
                                Name = c.Name,
                                Code = c.Code
                            },
                            c => new { c.Name },
                            "{Name}",
                            "DispachZoneId",
                            Model?.DispachZone?.Name,
                            Model?.DispachZoneId?.ToString()
                        ))
                    </div>

                    <div class='col-md-4'>
                        <label class="form-label fw-bold">نام کارشناس</label>

                        @(Html.EntitySelector<Personel>
                                    (
                                    "ExpertNameIdSelector",
                                    c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                                    c => new
                                    {
                                        Id = c.Id,
                                        Name = c.Name + " " + c.Family,

                                    },
                                    c => new { c.Id, c.Name, c.Family },
                                    "{Name}",
                                    "ExpertNameId",
                                    "ExpertName",
                                    Model?.ExpertNameId,

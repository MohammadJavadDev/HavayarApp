@using Entities.App.Prd
@model List<StopRequstAttachment>

@if (Model != null && Model.Any())
{
	<div class="table-responsive">
		<table class="table table-striped table-bordered table-hover">
			<thead>
				<tr>
					<th>عملیات</th>
					<th>نام فایل</th>
					<th>توضیحات</th>
					<th>کاربر</th>
					<th>تاریخ</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var a in Model.OrderByDescending(x => x.CreatedOnMiladiDateTime))
				{
					<tr>
						<td>
							@if (a.AttachmentId != null)
							{
								<a href="/File/download/@a.AttachmentId" class="btn btn-sm btn-primary"><i class="fa fa-download"></i></a>
							}
						</td>
						<td>@(a.Attachment?.OriginalName ?? "-")</td>
						<td>@a.Comment</td>
						<td>@a.CreatedByName</td>
						<td style="direction:ltr;text-align:right">@a.CreatedOnShamsiDateTime</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
else
{
	<div class="alert alert-info mb-0"><i class="fa fa-info-circle"></i> هیچ پیوستی ثبت نشده است</div>
}

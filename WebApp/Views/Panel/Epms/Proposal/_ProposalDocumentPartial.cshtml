@using Entities.App.Epms
@model ProposalDocument
<div class="entity-item">

	<input class='form-control' type="hidden" data-bind='ProposalDocuments.id' value='@Model?.Id' />



	<div class='col-md-3'>

		<fileuploader bind="ProposalDocuments.attachmentId" accepted-file-types=".rar,.zip"
				    file-id="@Model?.AttachmentId"
				    file-entity="@Model?.Attachment" entity-prop-name="AttachmentId"
				    entity-type="ProposalDocument"
				    max-file-size="10"
					></fileuploader>
	 
	</div>

	<div class='col-md-3'>
		<label class=''>آخرین وضعیت</label>
		<select class='form-control' data-bind='ProposalDocuments.lastCommentStatus' asp-for='LastCommentStatus'
			asp-items="Html.GetEnumSelectList(typeof(Entities.App.Epms.Enums.ProposalDocumentStatusEnum))">
		</select>
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>

	<div class='col-md-3'>
		<label class=''>بازنگری</label>
		<input class='form-control' data-bind='ProposalDocuments.revision' data-invalidMessage='فقط عداد'
			data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" value='@Model?.Revision' />
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>

	<div class='col-md-3'>
		<label class=''>نفر ساعت به دقیقه</label>
		<input class='form-control' data-bind='ProposalDocuments.consumedManHours' data-invalidMessage='فقط عداد'
			data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" value='@Model?.ConsumedManHours' />
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>





</div>

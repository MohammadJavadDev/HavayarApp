@using Entities.App.Epms
@model ProposalActivityComment
<div class="entity-item">
	<div class='align-content-center'>
		<a href="#" class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm" data-action="removeItem">
			<i class="ki-duotone ki-trash fs-2">
				<span class="path1"></span>
				<span class="path2"></span>
				<span class="path3"></span>
				<span class="path4"></span>
				<span class="path5"></span>
			</i>
		</a>
	</div>
	<input class='form-control' type="hidden" data-bind='ProposalActivityComments.id' value='@Model?.Id' />



	<div class='col-md-6'>
		<label class='required'>وضعیت سند</label>
		<select class='form-control' data-bind='ProposalActivityComments.status' required asp-for='Status' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Edms.Enums.DocumentStatusEnums))">
		</select>
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>

	<div class='col-md-6'>
		<label class=''>کامنت</label>
		<input class='form-control' data-bind='ProposalActivityComments.comment' value='@Model?.Comment' />
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>
	 
</div>

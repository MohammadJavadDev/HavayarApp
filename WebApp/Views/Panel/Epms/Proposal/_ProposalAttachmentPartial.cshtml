@using Entities.App.Epms
@model ProposalAttachment
<div class="entity-item">

	<input class='form-control' type="hidden" data-bind='ProposalAttachment.id' value='@Model?.Id' />

	<div class='col-md-3'>
		<label class=''>بازنگری</label>
		<input class='form-control' data-bind='ProposalAttachment.revision' data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" value='@Model?.Revision' />
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>
	 
	<div class='col-md-3'>
		<fileuploader bind="ProposalAttachment.AttachmentId"
				    accepted-file-types=".rar,.zip"
				    file-id="@Model?.AttachmentId"
				    file-entity="@Model?.Attachment"
				    entity-prop-name="Attachment"
				    entity-type="@typeof(ProposalAttachment).FullName"></fileuploader>
	</div>



</div>

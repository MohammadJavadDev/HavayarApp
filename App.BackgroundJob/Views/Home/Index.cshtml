@{
    ViewData["Title"] = ViewData["Title"] ?? "تولید کلاس از دیتابیس";
    ViewData["Icon"] = ViewData["Icon"] ?? "database";
}

@await Html.PartialAsync("_PageHeader")

<div class="row g-4">
     <div class="col-lg-4">
          <div class="card">
               <div class="card-header">
                    <h5>
                         <i class="fas fa-list me-2"></i>
                         جداول و ویوهای دیتابیس
                    </h5>
               </div>
               <div class="card-body">
                    <div class="mb-3">
                         <input type="text" id="searchBox" class="form-control search-box"
                                placeholder="جستجو... (مثال: inv.part)">
                         <small class="text-muted">می‌توانید با schema جستجو کنید: schema.table</small>
                    </div>
                    <div class="stats-bar" id="statsBar" style="display: none;">
                         <div class="stat-item">
                              <i class="fas fa-table"></i>
                              <span>جداول: <span class="stat-number" id="tableCount">0</span></span>
                         </div>
                         <div class="stat-item">
                              <i class="fas fa-eye"></i>
                              <span>ویوها: <span class="stat-number" id="viewCount">0</span></span>
                         </div>
                    </div>
                    <div class="loading-spinner text-center" id="loadingSpinner">
                         <div class="spinner-border text-primary" role="status">
                              <span class="visually-hidden">در حال بارگذاری...</span>
                         </div>
                    </div>
                    <div class="objects-list-container" id="objectsList"></div>
               </div>
          </div>
     </div>

     <div class="col-lg-8">
          <div class="card">
               <div class="card-header">
                    <h5>
                         <i class="fas fa-code me-2"></i>
                         کد C# تولید شده
                    </h5>
               </div>
               <div class="card-body p-0">
                    <div id="codeContainer">
                         <div class="empty-state">
                              <i class="fas fa-hand-pointer"></i>
                              <h4>یک جدول یا ویو انتخاب کنید</h4>
                              <p>برای مشاهده کد C# مربوطه، روی یکی از جداول یا ویوها کلیک کنید</p>
                         </div>
                    </div>
               </div>
          </div>
     </div>
</div>

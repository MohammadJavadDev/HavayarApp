@using Entities.App.FIN;
@using Entities.App.Gnr;
@using Entities.App.Sale;
@using Entities.App.SLS;
@using Entities.App.Sale.Enums
@using Entities.App.Pln;
@using Entities.Auth;
@using Common.Utilities
@using Data.SystemAuth
@inject ISdk sdk
@model ProductionOrder
@{
	var isAdmin = sdk.IsAdministrator;

	// تایید مالی فقط در راهکاران انجام می‌شود (مثل HTS) و با Job همگام می‌شود؛ دکمه پنل حذف شد (2026-09-17).

	//Seed Role => Sale.ProductionOrder.Obsolete => سفارش ساخت - منسوخ‌سازی
	var canObsolete = isAdmin || sdk.HasRole("Sale.ProductionOrder.Obsolete");

	var delays = ViewBag.ProductionOrderDelayViewData as List<ProductionOrderDelay> ?? new List<ProductionOrderDelay>();
	var showObsolete = canObsolete && Model?.State == ProductionOrderStateEnum.FinancialApproval;
}
<div class="card">
	<div class="form-action-buttons">
		<form-action-buttons entity-type="typeof(ProductionOrder)">
			<form-action-button color-class="btn-active-icon-dark btn-color-primary" icon-class="fa fa-print"
				action-name="printProductionOrder" title="چاپ سفارش ساخت"></form-action-button>
			@if (showObsolete)
			{
			<form-action-button color-class="btn-active-icon-dark btn-color-dark" icon-class="fa fa-ban"
				action-name="obsolete" title="منسوخ کردن"></form-action-button>
			}
		</form-action-buttons>
	</div>
</div>
<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />

<div class="row">
	<div class="col-12 mb-2">
		<label class="form-label text-muted small">وضعیت</label>
		<div>
			<span class="badge badge-light-primary fs-6 px-3 py-2" data-bind="stateDisplay">@(Model?.State.ToDisplay() ?? "-")</span>
		</div>
	</div>

	<!-- Tab Navigation -->
	<div class="col-12">
		<div class="card border-0 shadow-sm">
			<div class="card-body p-3">
				<ul class="nav nav-tabs nav-line-tabs nav-stretch fs-6 border-0 px-4 pt-4 justify-content-between" role="tablist">
					<li class="nav-item">
						<a class="nav-link active" data-bs-toggle="tab" href="#tab_general_@Model.Id">
							<i class="bi bi-info-circle me-2"></i>اطلاعات کلی
						</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" data-bs-toggle="tab" href="#tab_history_@Model.Id">
							<i class="bi bi-chat-dots me-2"></i>تاریخچه
							<span class="badge-circle badge badge-light-primary mx-1">@(Model?.Comments.Count ?? 0)</span>
						</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" data-bs-toggle="tab" href="#tab_attachments_@Model.Id">
							<i class="bi bi-paperclip me-2"></i>پیوست‌ها
						</a>
					</li>
					<li class="nav-item">
						<a class="nav-link" data-bs-toggle="tab" href="#tab_delays_@Model.Id">
							<i class="bi bi-clock-history me-2"></i>تاخیرات
							<span class="badge-circle badge badge-light-warning mx-1">@delays.Count</span>
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<div class="col-md-12 my-1">
		<div class="tab-content p-3" id="myTabContent">

			<!-- Tab 1: اطلاعات کلی -->
			<div class="tab-pane fade show active" id="tab_general_@Model.Id" role="tabpanel">
				<div class="card">
					<div class="card-body row">
						<div class="col-12 mb-4">
							<h3 class="fw-bold text-dark">اطلاعات اصلی</h3>
						</div>

						<div class='col-md-6'>
							<label class='required'>وضعیت</label>
							<select class='form-control' data-bind='state' disabled asp-for='State' asp-items="Html.GetEnumSelectList(typeof(ProductionOrderStateEnum))">
							</select>
							<div class="form-text text-muted">
								<!-- وضعیت گردش‌کار فقط از طریق دکمه‌های «تایید مالی»/«منسوخ کردن» بالا تغییر می‌کند -->
								تغییر وضعیت صرفاً از طریق دکمه‌های عملیات بالا امکان‌پذیر است
							</div>
						</div>
						<div class='col-md-3'>
							<label class='required'>شماره سفارش ساخت</label>
							<input class='form-control' data-bind='number' required asp-for='Number' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>
						<div class='col-md-3'>
							<label class=''>نسخه</label>
							<input class='form-control'  data-bind='revision'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='Revision' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>


						<div class="col-md-3">
							<label class=''>قرارداد</label>
							@(Html.EntitySelector<Contract>(
								"ContractSelector",
								c => c.IsActive == Entities.Base.IsActiveEnum.Active,
								c => new
								{
									Id = c.Id, Title = c.Title
								},
								c => new { c.Title },
								"{Title}",
								"ContractId",
								"ContractName",
								Model?.ContractId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class="col-md-3">
							<label class=''>تفصیل پروژه</label>
							@(Html.EntitySelector<DL>(
								"ProjectDlSelector",
								c => c.IsActive == Entities.Base.IsActiveEnum.Active,
								c => new
								{
									Id = c.Id, Title = c.Title
								},
								c => new { c.Title },
								"{Title}",
								"ProjectDlId",
								"ProjectDlName",
								Model?.ProjectDlId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>
						<div class='col-md-3'>
							<label class=''>کد تفصیل پروژه</label>
							<input class='form-control'  data-bind='projectDlCode'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='ProjectDlCode' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class="col-md-12 my-3">

						</div>

						<div class='col-md-3'>
							<label class=''>کاربر نهایی</label>
							<input class='form-control' data-bind='endUser'  asp-for='EndUser' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>تاریخ شروع پروژه</label>
							<input class='form-control'  data-bind='projectStartDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true,"timePicker":{"enabled": true}}' value='@Model?.ProjectStartDate' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>تاریخ متره</label>
							<input class='form-control'  data-bind='metreDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true,"timePicker":{"enabled": true}}' value='@Model?.MetreDate' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>شماره متر</label>
							<input class='form-control' data-bind='metreNumber'  asp-for='MetreNumber' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>تاریخ تحویل موافقت‌شده</label>
							<input class='form-control'  data-bind='agreedDeliveryDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD ","autoClose": true,"initialValue": true,"timePicker":{"enabled": true}}' value='@Model?.AgreedDeliveryDate' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class="col-md-3">
							<label class=''>مدیر فروش</label>
							@(Html.EntitySelector<User>(
								"SalesManagerSelector",
								c => c.IsActive == Entities.Base.IsActiveEnum.Active,
								c => new
								{
									Id = c.Id, Name = c.Name
								},
								c => new { c.Name },
								"{Name}",
								"SalesManagerId",
								"SalesManagerName",
								Model?.SalesManagerId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class="col-md-3">
							<label class=''>مدیر پروژه</label>
							@(Html.EntitySelector<User>(
								"ProjectManagerSelector",
								c => c.IsActive == Entities.Base.IsActiveEnum.Active,
								c => new
								{
									Id = c.Id, Name = c.Name
								},
								c => new { c.Name },
								"{Name}",
								"ProjectManagerId",
								"ProjectManagerName",
								Model?.ProjectManagerId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class="col-md-3">
							<label class=''>کارشناس فروش جایگزین</label>
							@(Html.EntitySelector<User>(
								"AlternativeExpertSelector",
								c => c.IsActive == Entities.Base.IsActiveEnum.Active,
								c => new
								{
									Id = c.Id, Name = c.Name
								},
								c => new { c.Name },
								"{Name}",
								"AlternativeExpertId",
								"AlternativeExpertName",
								Model?.AlternativeExpertId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class="col-md-3">
							<label class=''>نمایندگی فروش</label>
							@(Html.EntitySelector<Customer>(
								"SalesAgencySelector",
								c => c.IsActive == Entities.Base.IsActiveEnum.Active,
								c => new
								{
									Id = c.Id, Party_FullName = c.Party.FullName
								},
								c => new { c.Party.FullName },
								"{Party.FullName}",
								"SalesAgencyId",
								"SalesAgencyName",
								Model?.SalesAgencyId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class="col-md-3">
							<label class=''>شهر نصب</label>
							@(Html.EntitySelector<Region>(
								"InstallationCitySelector",
								c => c.IsActive == Entities.Base.IsActiveEnum.Active,
								c => new
								{
									Id = c.Id, Name = c.Name
								},
								c => new { c.Name },
								"{Name}",
								"InstallationCityId",
								"InstallationCityName",
								Model?.InstallationCityId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='isNeedInspectionBeforePacking' class="form-check-input" type="checkbox" asp-for='IsNeedInspectionBeforePacking' />
								<label class="form-check-label" asp-for='IsNeedInspectionBeforePacking'>
									نیاز به بازرسی قبل از بسته‌بندی
								</label>
							</div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='hasContractor' class="form-check-input" type="checkbox" asp-for='HasContractor' />
								<label class="form-check-label" asp-for='HasContractor'>
									دارای پیمانکار
								</label>
							</div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='compressorHouseIsReady' class="form-check-input" type="checkbox" asp-for='CompressorHouseIsReady' />
								<label class="form-check-label" asp-for='CompressorHouseIsReady'>
									کمپرسورخانه آماده است
								</label>
							</div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='installationIsByHy' class="form-check-input" type="checkbox" asp-for='InstallationIsByHy' />
								<label class="form-check-label" asp-for='InstallationIsByHy'>
									نصب بعهده هوایار
								</label>
							</div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='hasFinancialGuarantee' class="form-check-input" type="checkbox" asp-for='HasFinancialGuarantee' />
								<label class="form-check-label" asp-for='HasFinancialGuarantee'>
									دارای تعهدات مالی
								</label>
							</div>
						</div>

						<div class='col-md-3'>
							<label class=''>توضیحات فروش</label>
							<input class='form-control' data-bind='salesComment'  asp-for='SalesComment' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>توضیحات </label>
							<input class='form-control' data-bind='comment'  asp-for='Comment' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='centrifugeHasCompressor' class="form-check-input" type="checkbox" asp-for='CentrifugeHasCompressor' />
								<label class="form-check-label" asp-for='CentrifugeHasCompressor'>
									کمپرسور سانتریفیوژ دارد
								</label>
							</div>
						</div>

						<div class='col-md-3'>
							<label class=''>تعداد</label>
							<input class='form-control'  data-bind='centrifugeCompressorCount'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='CentrifugeCompressorCount' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>ولتاژ الکتروموتور</label>
							<input class='form-control'  data-bind='centrifugeElectromotorVoltage'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='CentrifugeElectromotorVoltage' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>


						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='hasGA' class="form-check-input" type="checkbox" asp-for='HasGA' />
								<label class="form-check-label" asp-for='HasGA'>
									GA
								</label>
							</div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='delayNotCalculated' class="form-check-input" type="checkbox" asp-for='DelayNotCalculated' />
								<label class="form-check-label" asp-for='DelayNotCalculated'>
									پروژه‌ای (خروج از سیکل تأخیرات)
								</label>
							</div>
						</div>


						<div class='col-md-3'>
							<label class=''>نوع بسته بندی</label>
							<input class='form-control'  data-bind='packingType'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='PackingType' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>نحوه تحویل</label>
							<input class='form-control'  data-bind='deliveryType'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='DeliveryType' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>نوع محصول</label>
							<input class='form-control'  data-bind='productType'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='ProductType' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>نحوه راه اندازی</label>
							<input class='form-control'  data-bind='centrifugeSetupType'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='CentrifugeSetupType' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='isNeedProjectManager' class="form-check-input" type="checkbox" asp-for='IsNeedProjectManager' />
								<label class="form-check-label" asp-for='IsNeedProjectManager'>
									نیاز به مدیر پروژه
								</label>
							</div>
						</div>

						<div class='col-md-3'>
							<label class=''>شماره سفارش ساخت</label>
							<input class='form-control'  data-bind='productionOrderNumber'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='ProductionOrderNumber' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>



						<div class="col-md-3">

							<label class=''>کاربر کارشناس فروش</label>
							@(Html.EntitySelector<User>(
								"SalesExpertSelector",
								c => c.IsActive == Entities.Base.IsActiveEnum.Active,
								c => new
								{
									Id = c.Id, Name = c.Name
								},
								c => new { c.Name },
								"{Name}",
								"SalesExpertId",
								"SalesExpertName",
								Model?.SalesExpertId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>صنعت مشتری</label>
							<input class='form-control' data-bind='customerIndustry'  asp-for='CustomerIndustry' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						@* معادل SalesBranchId فرم/گرید HTS (صفحه ۴۶۳) *@
						<div class="col-md-3">
							<label class=''>شعبه / دپارتمان فروش</label>
							@(Html.EntitySelector<Branch>(
								"BranchSelector",
								c => c.IsActive == Entities.Base.IsActiveEnum.Active,
								c => new
								{
									Id = c.Id, Title = c.Title
								},
								c => new { c.Title },
								"{Title}",
								"BranchId",
								"BranchName",
								Model?.BranchId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						@* معادل DeliveryLocation فرم HTS *@
						<div class='col-md-3'>
							<label class=''>محل تحویل</label>
							<input class='form-control' data-bind='deliveryLocation' asp-for='DeliveryLocation' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>پروژه مهندسی</label>
							<input class='form-control'  data-bind='edmsProject'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='EdmsProject' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>

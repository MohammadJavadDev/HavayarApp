@using WebFramework.TagHelpers;
@model ServiceRequestDetail

<div class="card">

     <div class="card  card-body my-3">
          <div class='row '>
               <div class='col-md-6'>
                    <label class=''>نوع محصول</label>
                    <select class='form-control' data-bind='productType' asp-for='ProductType' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.ProductTypeEnum))">
                    </select>
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class="col-md-6">
                    <label>محصول مرتبط</label>
                    @(Html.EntitySelector<OrderDetailSerial>(
                                        "OrderDetailSelector",
                                        c => c.IsActive == Entities.Base.IsActiveEnum.Active && c.OrderDetailId != null,
                                        c => new
                                        {
                                             Id = c.OrderDetailId,
                                             Code = c.OrderDetail.Part.Code,
                                             Name = c.OrderDetail.Part.Name,
                                             Serial = c.Serial
                                        },
                                        c => new
                                        {
                                             c.Id,
                                             c.OrderDetail.Part.Code,
                                             c.OrderDetail.Part.Name,
                                             c.Serial
                                        },
                                        "{Id} -  {Code} |  {Name} | سریال: {Serial}",
                                        "OrderDetailId",
                                        "OrderDetailName",
                                        Model?.OrderDetailId.ToString()
                                        ))
               </div>

               <div class="col-md-6">
                    <label>سریال مرتبط</label>
                    <select id="ProductionOrderItemId" name="ProductionOrderItemId" class="form-control">
                         <option value="">انتخاب کنید</option>
                    </select>
               </div>

               <div class='col-md-6'>
                    <label class=''>نوع درخواست</label>
                    <select class='form-control' data-bind='requestType' asp-for='RequestType' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.SaleRequestTypeEnum))">
                    </select>
                    <div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
               </div>

               <div class='col-md-6'>
                    <label class=''>
                         تاریخ  ابلاغ
                    </label>
                    <input class='form-control' data-bind='noticeShamsiDate' data-persionDatePicker="true"
                           persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
                           value='@Model?.NoticeMiladiDate' />
               </div>

               <div class='col-md-6'>
                    <label class=''>
                         ساعت ابلاغ
                    </label>
                    <input class='form-control' data-bind='noticeTime' data-persionDatePicker="true"
                           persion-datetimepicker='{"format": "HH:mm","autoClose": true,"initialValue": false,"onlyTimePicker": true}'
                           value='@Model?.NoticeTime' />
               </div>

          </div>
     </div>

</div>

<div class='card-footer row'>
     <div class='col-md-3'>
          <span>ایجاد کننده :</span>
          <span>@Model?.CreatedByName</span>
     </div>
     <div class='col-md-3'>
          <span>تاریخ ایجاد :</span>
          <span>@Model?.CreatedOnShamsiDateTime</span>
     </div>
     <div class='col-md-3'>
          <span>ویرایش کننده :</span>
          <span>@Model?.ModifiedByName</span>
     </div>
     <div class='col-md-3'>
          <span>تاریخ ویرایش :</span>
          <span>@Model?.ModifiedDateShamsiDateTime</span>
     </div>
</div>
<script>
     $(function() {
         var serviceRequestId = '@ViewBag.serviceRequestId';
         var lastPartId = $('#id').val();
         var serialRequest = null;

         function resetSerials() {
             $('#ProductionOrderItemId')
                 .empty()
                 .append('<option value="">انتخاب کنید</option>');
         }

         function normalizeItems(items) {
             if (!items) return [];
             return Array.isArray(items) ? items : [items];
         }

         function fillSerials(items) {
             var list = normalizeItems(items);
             var $serial = $('#ProductionOrderItemId');

             $serial.empty();

             if (!list.length) {
                 $serial.append($('<option></option>').val('').text('بدون سریال...')
                 );
                 return;
             }

             $.each(list, function(i, item) {
                 var id = item.id || item.Id;
                 var text = item.serial || item.Serial;

                 if (id == null || !text) return;

                 $serial.append(
                     $('<option></option>')
                         .val(id)
                         .text('سریال :' + '' + text)
                 );
             });

             $serial.prop('selectedIndex', 0).trigger('change');
         }

         function loadSerials() {
             var partId = $('input[name="OrderDetailSelector"]').val();

             resetSerials();

             if (!serviceRequestId || !partId) {
                 return;
             }

             if (serialRequest) {
                 serialRequest.abort();
             }

             serialRequest = $.ajax({
                 url: '/Panel/Sale/ServiceRequest/GetOrderDetailSerials',
                 type: 'GET',
                 data: {
                     serviceRequestId: serviceRequestId,
                     partId: partId
                 },
                 success: function(result) {
                     fillSerials(result ? result.items : null);
                 },
                 error: function(xhr, status) {
                     if (status !== 'abort') {
                         console.log('GetOrderDetailSerials error:', xhr);
                     }
                 },
                 complete: function() {
                     serialRequest = null;
                 }
             });
         }

         function checkPartChanged() {
             var currentPartId = $('input[name="OrderDetailSelector"]').val();

             if (currentPartId !== lastPartId) {
                 lastPartId = currentPartId;
                 loadSerials();
             }
         }

         resetSerials();

         if (lastPartId) {
             loadSerials();
         }

         $(document).on('change', '#PartId', function() {
             checkPartChanged();
         });

         $(document).on('change input blur', '#PartName', function() {
             setTimeout(checkPartChanged, 200);
         });

         $(document).on('click', '#OrderDetailSelector, #OrderDetailSelector *', function() {
             setTimeout(checkPartChanged, 300);
         });

         setInterval(checkPartChanged, 400);
     });
</script>








@using Entities.App.Trn
@using WebApp.Controllers.Dynamic
@model CourseParticipantListByParentViewModel

@{
     var tableId = "courseParticipantTable_" + Model.CourseId;
}

<div class="card" id="courseParticipantListPage" data-course-id="@Model.CourseId">
     <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold">
               <i class="fa fa-users ms-2"></i>
               شرکت‌کنندگان دوره (@Model.CourseTitle)
          </h5>
          <div>
               <button type="button" class="btn btn-sm btn-primary" id="btnNewCourseParticipant">
                    <i class="fa fa-plus ms-1"></i>
                    ثبت‌نام جدید
               </button>
          </div>
     </div>
     <div class="card-body">
          <table id="@tableId" class="table table-striped table-row-bordered gy-2 w-100">
               <thead>
                    <tr class="fw-bold fs-6 text-muted">
                         <th>کد آموزش</th>
                         <th>شرکت</th>
                         <th>شرکت‌کننده</th>
                         <th>نمره</th>
                         <th>جایگاه</th>
                         <th>وضعیت ثبت‌نام</th>
                         <th style="width:120px;">عملیات</th>
                    </tr>
               </thead>
               <tbody></tbody>
          </table>
     </div>
</div>
<script>
     const courseId = '@Model.CourseId';
     const tableSelector = '#@tableId';
     const listApiUrl = '/Panel/Trn/CourseParticipant/GetListByParentId?courseId=' + courseId;

     const registerStatusTitles = { 624: 'رزرو', 625: 'قطعی' };

     function escapeHtml(text) {
          if (text === null || text === undefined) return '-';
          return String(text)
               .replace(/&/g, '&amp;')
               .replace(/</g, '&lt;')
               .replace(/>/g, '&gt;')
               .replace(/"/g, '&quot;');
     }

     function deleteCourseParticipant(id) {
          Swal.fire({
               title: 'حذف ردیف',
               text: 'آیا از حذف این ثبت‌نام مطمئن هستید؟',
               icon: 'warning',
               showCancelButton: true,
               confirmButtonText: 'بله',
               cancelButtonText: 'خیر'
          }).then(function (result) {
               if (!result.isConfirmed) return;

               $$.get('/Panel/Trn/CourseParticipant/Delete?id=' + id, function (response) {
                    if (response && response.isSuccess === false) {
                         toastr.error(response.message || 'خطا در حذف رکورد');
                         return;
                    }
                    toastr.success('رکورد با موفقیت حذف شد');
                    reloadCourseParticipantList();
               });
          });
     }

     function reloadCourseParticipantList() {
          const dt = window['@tableId'];
          if (dt && dt.ajax) {
               dt.ajax.reload(null, false);
          }
     }

     const table = $$(tableSelector).DataTable({
          serverSide: false,
          autoWidth: false,
          scrollX: true,
          pageLength: 10,
          lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, 'همه']],
          order: [[0, 'asc']],
          language: { url: '/panelLib/plugins/custom/datatables/fa.json' },
          ajax: {
               url: listApiUrl,
               type: 'GET',
               dataSrc: function (json) {
                    if (json && json.isSuccess === false) {
                         toastr.error(json.message || 'خطا در دریافت اطلاعات');
                         return [];
                    }
                    return (json && json.data) ? json.data : (Array.isArray(json) ? json : []);
               }
          },
          columns: [
               { data: 'trainingCode', render: function (d) { return escapeHtml(d); } },
               { data: 'companyTitle', render: function (d) { return escapeHtml(d); } },
               { data: null, render: function (d, t, row) { return escapeHtml(((row.firstName || '') + ' ' + (row.lastName || '')).trim()); } },
               { data: 'cngScore', render: function (d) { return escapeHtml(d); } },
               { data: 'place', render: function (d) { return escapeHtml(d); } },
               { data: 'participantRegisterStatus', render: function (d) { return escapeHtml(registerStatusTitles[d] || d); } },
               {
                    data: null,
                    orderable: false,
                    className: 'text-center',
                    render: function (d, t, row) {
                         return '<button type="button" class="btn btn-sm btn-icon btn-light-warning btn-edit-row" data-id="' + row.id + '" title="ویرایش"><i class="fa fa-edit"></i></button> '
                              + '<button type="button" class="btn btn-sm btn-icon btn-light-danger btn-delete-row" data-id="' + row.id + '" title="حذف"><i class="fa fa-trash"></i></button>';
                    }
               }
          ]
     });

     window['@tableId'] = table;

     $$('#btnNewCourseParticipant').on('click', function () {
          appController.addPage('/Panel/Trn/CourseParticipant/New?courseId=' + courseId);
     });

     $$(tableSelector).on('click', '.btn-edit-row', function () {
          const id = $(this).data('id');
          appController.addPage('/Panel/Trn/CourseParticipant/Edit?id=' + id);
     });

     $$(tableSelector).on('click', '.btn-delete-row', function () {
          const id = $(this).data('id');
          deleteCourseParticipant(id);
     });
</script>

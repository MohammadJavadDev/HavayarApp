@using Common.System
@using Data.SystemAuth
@inject ISdk sdk;
@{
	sdk.RefreshUserRole();
	var userProfileImage = "";
	if (sdk?.CurrentUser?.ProfileImage != null)
		userProfileImage = "/file/profile-image/" + sdk?.CurrentUser?.ProfileImage;
	else
		userProfileImage = "/panellib/media/blank.png";
}


<div id="kt_app_header" class="app-header" data-kt-sticky="true" data-kt-sticky-activate="{default: true, lg: true}" data-kt-sticky-name="app-header-minimize" data-kt-sticky-offset="{default: '200px', lg: '0'}" data-kt-sticky-animation="false">
					 
    <div class="app-container container-fluid d-flex align-items-stretch justify-content-between" id="kt_app_header_container">
						 
        <div class="d-flex align-items-center d-lg-none ms-n3 me-1 me-md-2" title="مشاهده">
            <div class="btn btn-icon btn-active-color-primary w-35px h-35px" id="kt_app_sidebar_mobile_toggle">
                <i class="ki-duotone ki-abstract-14 fs-2 fs-md-1">
                    <span class="path1"></span>
                    <span class="path2"></span>
                </i>
            </div>
        </div>
 
		<div class="d-flex align-items-center flex-grow-1 flex-lg-grow-0">
            <a href="../../demo1/dist/index.html" class="d-lg-none">
				<img alt="Logo" src="/panellib/media/havayar_logo_sign.svg" class="h-30px" />
            </a>
        </div>
						 
        <div class="align-items-stretch d-flex flex-lg-grow-1 justify-content-end" id="kt_app_header_wrapper">
            <div class="app-navbar flex-shrink-0">
				<div class="app-navbar-item ms-1 ms-md-4">
					<!--begin::Menu- wrapper-->
					<div style="padding-right: 15px;" class="btn btn-icon btn-custom btn-icon-muted btn-active-light btn-active-color-primary w-35px h-35px" data-kt-menu-trigger="{default: 'click', lg: 'hover'}" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end" id="kt_menu_item_notification">
						<i class="ki-duotone ki-notification-on fs-2tx">
							<span class="path1"></span>
							<span class="path2"></span>
							<span class="path3"></span>	
							<span class="path4"></span>
							<span class="path5"></span>
						</i>
						<span class="badge badge-light-danger fs-base" id="notificationUnreadCount" style="position: relative; top: 10px; right: -36px;">0</span>
					</div>
			 
					<div class="menu menu-sub menu-sub-dropdown menu-column w-350px w-lg-375px" data-kt-menu="true" id="kt_menu_notifications" style="">

						<!--begin::items-->
						<div class="scroll-y mh-325px my-5 px-8" id="notificationSection">
						</div>
						<!--end::items-->
						<!--begin::نمایش بیشتر-->
						<div class="py-3 text-center border-top">
							<a href="/panel/ListMyNotifications" class="btn btn-color-gray-600 btn-active-color-primary">
								نمایش همه
								<i class="ki-duotone ki-arrow-left fs-5">
									<span class="path1"></span>
									<span class="path2"></span>
								</i>
							</a>
						</div>
						<!--end::نمایش بیشتر-->
			 
					</div>
				 
				</div>
                <div class="app-navbar-item ms-1 ms-md-4" id="kt_header_user_menu_toggle">
              
					<div class="cursor-pointer symbol symbol-35px" data-kt-menu-trigger="{default: 'click', lg: 'hover'}" data-kt-menu-attach="parent" data-kt-menu-placement="bottom-end">
						<img src="@userProfileImage" class="rounded-3" alt="user" style="max-inline-size: -webkit-fill-available;">
                        @sdk.CurrentUser?.FullName
                    </div>
					<div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg menu-state-color fw-semibold py-4 fs-6 w-275px" data-kt-menu="true" style="">
						<!--begin::Menu item-->
						<div class="menu-item px-3">
							<div class="menu-content d-flex align-items-center px-3">
								<!--begin::Avatar-->
								<div class="symbol symbol-50px me-5">
									<img alt="Logo" src="@userProfileImage">
								</div>
								<!--end::Avatar-->
								<!--begin::کاربرname-->
								<div class="d-flex flex-column">
									<div class="fw-bold d-flex align-items-center fs-5">
										@sdk.CurrentUser?.FullName
										<span class="badge badge-light-success fw-bold fs-8 px-2 py-1 ms-2">@sdk.CurrentUser?.Username</span>
									</div>
									<a   class="fw-semibold text-muted text-hover-primary fs-7"> </a>
								</div>
								<!--end::کاربرname-->
							</div>
						</div>
						<!--end::Menu item-->
						<!--begin::Menu separator-->
						<div class="separator my-2"></div>
					 

					 
						
					 
					 
						<div class="menu-item px-5">


							<a href="#" id="btnStylePanel" data-toggle="offcanvas" class="menu-link px-5">
								<span class="menu-title position-relative">
									تنظیمات نمایش
									<span class="ms-5 position-absolute translate-middle-y top-50 end-0">
										<i class="fa fa-paint-brush"></i>
									</span>
								</span>
							</a>
 

		 


						
						</div>
						<div class="menu-item px-5">
							<a href="/Authenticate/Logout" class="menu-link px-5">خروج</a>
						</div>
				 
					</div>
                </div>
            </div>
             
        </div>

				 
    </div>
		 	 
</div>

<!-- پنل Offcanvas -->
<div id="styleSettingsPanel" class="offcanvas offcanvas-end"
	tabindex="-1" style="width:320px; direction:rtl;">
	<div class="offcanvas-header">
		<h5 class="offcanvas-title">تنظیمات نمایش</h5>
		<button type="button" class="btn-close" id="btnClosePanel"></button>
	</div>
	<!-- بخش تم رنگی -->
	<div class="mb-4">
		<label class="form-label fw-bold">تم رنگی سایت</label>
		<div id="themeOptions" class="row g-2">
			<!-- با JS پر می‌شه -->
		</div>
	</div>
	<!-- داخل offcanvas، زیر بخش تم‌ها -->
	<hr class="my-3">
	<div class="mb-4 px-3">
		<label class="form-label fw-bold">حالت فیلتر جداول</label>
		<div class="d-flex gap-2" id="tableFilterModeOptions">
			<div class="flex-fill text-center border rounded p-2 table-filter-mode-opt"
				 data-mode="inline"
				 style="cursor:pointer; transition:border-color 0.15s;">
				<div class="mb-1">
					<i class="fa-light fa-table-list fs-3 text-primary"></i>
				</div>
				<small class="text-muted d-block">ردیف زیر هدر</small>
			</div>
			<div class="flex-fill text-center border rounded p-2 table-filter-mode-opt"
				 data-mode="popup"
				 style="cursor:pointer; transition:border-color 0.15s;">
				<div class="mb-1">
					<i class="fa-light fa-filter fs-3 text-primary"></i>
				</div>
				<small class="text-muted d-block">پاپ‌اور</small>
			</div>
		</div>
	</div>
	<hr class="my-3">

	<div class="offcanvas-body">

		<!-- فونت -->
		<div class="mb-4">
			<label class="form-label fw-bold">فونت سایت</label>
			<div id="fontFamilyOptions" class="d-flex flex-wrap gap-2">
				<button class="btn btn-sm btn-outline-secondary font-opt" style="font-family:'IRANSansWeb';font-size:14px"
					   data-font="IRANSansWeb, Tahoma, sans-serif">
					ایران‌سنس
				</button>
				<button class="btn btn-sm btn-outline-secondary font-opt" style="font-family:'Vazirmatn';font-size:14px"
					   data-font="Vazirmatn, sans-serif">
					وزیرمتن
				</button>


				<button class="btn btn-sm btn-outline-secondary font-opt" style="font-family:'BBadr';font-size:14px"
					   data-font="BBadr, sans-serif">
					بدر
				</button>
				<button class="btn btn-sm btn-outline-secondary font-opt" style="font-family:'BBaran';font-size:14px"
					   data-font="BBaran, sans-serif">
					باران
				</button>

				<button class="btn btn-sm btn-outline-secondary font-opt" style="font-family:'BBardiya' ;font-size:14px"
					   data-font="BBardiya, sans-serif">
					بدریا
				</button>

				<button class="btn btn-sm btn-outline-secondary font-opt" style="font-family:'BCompset';font-size:14px"
					   data-font="BCompset, sans-serif">
					کامپست
				</button>

				<button class="btn btn-sm btn-outline-secondary font-opt" style="font-family:'BDavat';font-size:14px"
					   data-font="BDavat, sans-serif">
					دوات
				</button>


				<button class="btn btn-sm btn-outline-secondary font-opt" style="font-family:'BHoma';font-size:14px"
					   data-font="BHoma, sans-serif">
					هما
				</button>



			</div>
		</div>

		<!-- اندازه فونت -->
		<div class="mb-3">
			<label class="form-label">
				اندازه فونت: <strong id="fontSizeDisplay">10</strong>px
			</label>
			<input type="range" class="form-range" id="fontSizeRange"
				  min="8" max="22" step="1" value="10">
		</div>

		<!-- فاصله خطوط -->
		<div class="mb-3">
			<label class="form-label">
				فاصله خطوط: <strong id="lineHeightDisplay">1.7</strong>
			</label>
			<input type="range" class="form-range" id="lineHeightRange"
				  min="1.2" max="2.2" step="0.1" value="1.7">
		</div>

		<!-- بولد -->
		<div class="mb-4">
			<div class="form-check form-switch">
				<input class="form-check-input" type="checkbox" id="boldToggle">
				<label class="form-check-label" for="boldToggle">متن ضخیم (Bold)</label>
			</div>
		</div>

		<!-- پیش‌نمایش -->
		<div class="mb-4 p-3 border rounded" id="previewBox">
			<small class="text-muted d-block mb-1">پیش‌نمایش:</small>
			<span id="previewText">این یک متن نمونه برای پیش‌نمایش است این یک متن نمونه برای پیش‌نمایش است.</span>
		</div>

		<!-- دکمه‌ها -->
		<div class="d-flex gap-2">
			<button class="btn btn-primary flex-fill" id="btnSaveSettings">
				<i class="fa fa-save me-1"></i> ذخیره
			</button>
			<button class="btn btn-outline-secondary" id="btnResetSettings">
				بازنشانی
			</button>
		</div>
	</div>
</div>
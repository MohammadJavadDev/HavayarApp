			<input class='form-control'  data-bind='capacityM3PerMinute'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='CapacityM3PerMinute' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>

@using Entities.App.Hcm
@using Entities.App.Sale
@using Entities.Auth
@using Entities.Base
@model MissionSalary

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(MissionSalary)"></form-action-buttons>
	</div>
	<div class="card-body">
		<div class="row mb-4"><div class="col-12"><h4 class="fw-bold text-dark mb-0">حق ماموریت پرسنل</h4></div></div>
		<input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
		<input type="hidden" data-bind="expertId" value="@Model?.ExpertId" />
		<input type="hidden" data-bind="htsPersonelId" value="@Model?.HtsPersonelId" />
		<div class="row g-3">
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold required">کارشناس</label>
				@(Html.EntitySelector<Personel>(
					"MissionSalaryPersonelSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Name = c.Name, Family = c.Family },
					c => new { c.Name, c.Family },
					"{Name} {Family}",
					"personelId",
					"personelName",
					Model?.PersonelId?.ToString()
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">صبحانه</label>
				<input class="form-control" type="text" data-bind="breakfastFee" data-money="true" asp-for="BreakfastFee" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">ناهار</label>
				<input class="form-control" type="text" data-bind="lunchFee" data-money="true" asp-for="LunchFee" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">شام</label>
				<input class="form-control" type="text" data-bind="dinnerFee" data-money="true" asp-for="DinnerFee" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">حق شب</label>
				<input class="form-control" type="text" data-bind="nightRight" data-money="true" asp-for="NightRight" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">اضافه‌کاری</label>
				<input class="form-control" type="text" data-bind="workOvertimeFee" data-money="true" asp-for="WorkOvertimeFee" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">حق ماموریت</label>
				<input class="form-control" type="text" data-bind="missionRight" data-money="true" asp-for="MissionRight" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">حق تعطیل</label>
				<input class="form-control" type="text" data-bind="missionHolidayRight" data-money="true" asp-for="MissionHolidayRight" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">حقوق روزانه</label>
				<input class="form-control" type="text" data-bind="dailySalary" data-money="true" asp-for="DailySalary" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
		</div>
	</div>
</div>
<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;
		const model = page.$pageEl.dataBind();
		const $btn = $($btnAction.element).block();
		$$.post('save', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			$btnAction.baseaction();
		});
	}
	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>

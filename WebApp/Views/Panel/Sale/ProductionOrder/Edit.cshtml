								"ProjectDlSelector",
								c => c.IsActive == Entities.Base.IsActiveEnum.Active,
								c => new
								{
									Id = c.Id, Title = c.Title
								},
								c => new { c.Title },
								"{Title}",
								"ProjectDlId",
								"ProjectDlName",
								Model?.ProjectDlId?.ToString()
							))
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>
						<div class='col-md-3'>
							<label class=''>کد تفصیل پروژه</label>
							<input class='form-control'  data-bind='projectDlCode'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='ProjectDlCode' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class="col-md-12 my-3">

						</div>

						<div class='col-md-3'>
							<label class=''>کاربر نهایی</label>

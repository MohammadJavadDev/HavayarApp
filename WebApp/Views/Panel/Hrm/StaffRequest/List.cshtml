@using Entities.App.Hrm
<div id="staffRequestRoot"
     data-full="@(ViewBag.IsFull == true ? "1" : "0")"
     data-viewer="@(ViewBag.IsViewer == true ? "1" : "0")"
     data-eng="@(ViewBag.IsEngineering == true ? "1" : "0")">
    <datatableprofile entity-type="typeof(StaffRequest)"></datatableprofile>
</div>
<style>
    #staffRequestRoot[data-full="0"] [data-action="staffApprove"] { display: none !important; }
    #staffRequestRoot[data-viewer="1"][data-full="0"] [data-action="new"],
    #staffRequestRoot[data-viewer="1"][data-full="0"] [data-action="edit"],
    #staffRequestRoot[data-viewer="1"][data-full="0"] [data-action="delete"] { display: none !important; }
    #staffRequestRoot[data-eng="1"][data-full="0"] [data-action="edit"],
    #staffRequestRoot[data-eng="1"][data-full="0"] [data-action="delete"] { display: none !important; }
</style>
<script>
    page.$pageEl.on('staffAction', function (e, action, ctx) {
        const row = (ctx && ctx.selectedRows && ctx.selectedRows[0]) || (ctx && ctx.selectedRow);
        const id = row && (row.t1_Id || row.Id);
        if (!id) { toastr.error('یک ردیف را انتخاب کنید'); return; }
        if (action !== 'approve') return;
        Swal.fire({ title: 'تایید مدیر', text: 'این درخواست نیرو تایید شود؟', icon: 'warning', showCancelButton: true, confirmButtonText: 'تایید', cancelButtonText: 'انصراف' }).then(function (result) {
            if (!result.isConfirmed) return;
            $$.post('Approve?id=' + id, {}, function (r) {
                if (!r.isSuccess) { toastr.error(r.message || 'خطا', 'خطا'); return; }
                toastr.success('تایید شد');
                const table = $$('[data-action="dataProfile"]').data('dtProfileTable') || self.table;
                if (table && table.ajax) table.ajax.reload(null, false);
            });
        });
    });
</script>

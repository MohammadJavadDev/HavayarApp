@using Entities.App.Bom;
@using Entities.App.FIN
@using Entities.App.Gnr
@using Entities.App.Inv
@using Entities.App.Prp
@using Entities.App.SLS
@using Entities.Auth
@using WebFramework.TagHelpers;

<div class="card">

    <div class="card  card-body my-3">
        <div class='col-md-12 '>

            <div class="table-responsive">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">لیست اقلام مصرفی</h4>
                    <button type="button" class="btn btn-primary btn-sm" data-action="addNewBom">
                        <i class="fa fa-plus"></i> افزودن اقلام مصرفی
                    </button>9
                </div>
                <table id="bomTable" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th class="min-w-50px">#</th>
                            <th class="min-w-50px">ردیف</th>
                            <th class="min-w-50px">شماره شناسنامه</th>
                            <th class="min-w-100px"> تفصیل</th>
                            <th class="min-w-100px">شماره درخواست</th>
                            <th class="min-w-150px">کد کالا</th>
                            <th class="min-w-150px">عنوان کالا</th>
                            <th class="min-w-150px">واحد</th>
                            <th class="min-w-150px">توضیحات قطعه</th>
                            <th class="min-w-150px">شماره فرم قطعه</th>
                            <th class="min-w-300px">مبلغ خرید</th>
                            <th class="min-w-300px">قیمت فروش</th>
                            <th class="min-w-300px">مقدار مصرفی</th>
                            <th class="min-w-300px">مقدار برگشتی</th>
                            <th class="min-w-300px">مجموع قیمت</th>
                            <th class="min-w-300px">مجموع مبلغ خرید</th>
                            <th class="min-w-300px"> توضیحات</th>
                            <th class="min-w-300px"> توضیحات راهکاران</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.ProductionOrderItemBomViewData != null)
                        {
                            int counter = 1;
                            @foreach (var item in (List<RepairRequestPart>)ViewBag.ProductionOrderItemBomViewData)
                            {
                                <tr data-item-id="@(item.Id ?? 0)">
                                    <td>
                                        <button class="btn btn-icon btn-warning btn-sm" data-action="openBomModal">
                                            <i class="fa fa-pencil"></i>
                                        </button>
                                    </td>
                                    <td>@counter</td>
                                    <td>@item?.RepairRequestId</td>
                                    <td>@item?.AccDLId</td>
                                    <td>@item?.RequestNo</td>
                                    <td>@item?.PartId</td>
                                    <td>@item?.Part.Name</td>
                                    <td>@item?.UnitName</td>
                                    <td>@item?.ReplacementPartDescription</td>
                                    <td>@item?.ReplacementPartFormNumber</td>
                                    <td>@item?.BuyPrice</td>
                                    <td>@item?.SalePrice</td>
                                    <td>@item?.UsedMount</td>
                                    <td>@item?.ReturnMount</td>
                                    <td>@item?.TotalPrice</td>
                                    <td>@item?.TotalBuyPrice</td>
                                    <td>@item?.Description</td>
                                    <td>@item?.RahkaranDescription</td>
                                </tr>
                                counter++;
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>

</div>

<div class='card-footer row'>
    <div class='col-md-3'>
        <span>ایجاد کننده :</span>
        <span>@Model?.CreatedByName</span>
    </div>
    <div class='col-md-3'>
        <span>تاریخ ایجاد :</span>
        <span>@Model?.CreatedOnShamsiDateTime</span>
    </div>
    <div class='col-md-3'>
        <span>ویرایش کننده :</span>
        <span>@Model?.ModifiedByName</span>
    </div>
    <div class='col-md-3'>
        <span>تاریخ ویرایش :</span>
        <span>@Model?.ModifiedDateShamsiDateTime</span>
    </div>
</div>


<script>

    self.FormActionButtons.addConsumableItems.onclick(function () {

           const url = '/Panel/Rpr/RepairRequest/RepairRequestPartItems';

           $$.get(url, function(result) {
               let bodyCn = `<div style="overflow-x: hidden; overflow-y: auto; max-height: 70vh;">${result}</div>`;
               $.confirm({
                   title: 'اقلام مصرفی ',
                   columnClass: 'col-md-10',
                   content: bodyCn,
                   rtl: true,
                   buttons: {
                       save: {
                           text: 'ذخیره',
                           btnClass: 'btn-success',
                           action: function() {
                               const $content = this.$content;

                               if (validateError($content)) {
                                   return false;
                               }

                               // const model = $content.dataBind();
                               const self = this;

                               // $$.post('/Panel/Sup/OpenOrderRequest/DoLinkVpis', model, function(r) {
                               //     if (!r.isSuccess) {
                               //         toastr.error(`${r.message}`, 'خطا');
                               //         return false;
                               //     }

                               //     toastr.success('لینک با موفقیت ثبت شد');
                               //     self.close();
                               //     page.close()
                               // });

                               return false;
                           }
                       },
                       cancel: {
                           text: 'انصراف',
                           btnClass: 'btn-secondary'
                       }
                   },
                   onContentReady: function () {
                       var self = this;
                       setTimeout(function () {
                           self.$body.find('select.select2-hidden-accessible').each(function() {
                               const $select = $$(this);
                               const currentData = $select.select2('data');
                               $select.select2('destroy');
                               $select.select2({
                                   dropdownParent: self.$body,
                                   width: '100%',
                                   placeholder: $select.attr('placeholder') || 'انتخاب کنید'
                               });
                               if (currentData && currentData.length > 0) {
                                   $select.val($select.val()).trigger('change');
                               }
                           });
                       }, 100);
                   }
               });
           });
       });





    $(document).ready(function() {


        $('form-action-button[action-name="addRepairModal"]').on('click', function(e) {
            e.preventDefault();
            $('#addRepairModal').modal('show');
        });


        $('form-action-button[action-name="confirmationModal"]').on('click', function(e) {
            e.preventDefault();
            $('#confirmationModal').modal('show');
        });

        $('#btnConfirm').on('click', function() {
            $('#addRepairModal').modal('show');
        });

        $('#btnConfirm3').on('click', function() {
            $('#confirmationModal').modal('show');
        });
    });

    function savefn($btnAction) {
        if (validateError($$('.card'))) { return; }
        var model = $$('.card').dataBind();
        const $btn = $(this.element).block();
        $$.post('save',
            model,
            function (r) {
                $btn.block(false);
                if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
                toastr.success('ذخیره سازی با موفقیت انجام شد .');
                $$('.card').dataBind(r.data);
                $btnAction.baseaction();
            })
    }

    self.FormActionButtons.save.onclick(function () { savefn(this) })
    self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
    self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
</script>
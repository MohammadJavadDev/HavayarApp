@using Entities.App.Inv
@{
	var parentId = (long)ViewBag.ParentId;
}
<div class="card" id="partSparePartChildCard">
	<div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
		<h5 class="mb-0 fw-bold">قطعات یدکی</h5>
		<button type="button" class="btn btn-sm btn-primary" data-action="newPartSparePart">افزودن</button>
	</div>
	<div class="card-body">
		<table class="table table-striped table-row-bordered gy-2 w-100" id="partSparePartChildTable">
			<thead>
				<tr class="fw-bold fs-6 text-muted">
					<th>کد</th>
					<th>نام</th>
					<th>ساعت کارکرد</th>
					<th>توضیحات</th>
					<th style="width:120px;">عملیات</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
</div>
<script>
	const partSparePartParentId = @parentId;
	const partSparePartTable = $$('#partSparePartChildTable').DataTable({
		serverSide: false,
		autoWidth: false,
		pageLength: 10,
		language: { url: '/panelLib/plugins/custom/datatables/fa.json' },
		ajax: {
			url: '/Panel/Inv/PartSparePart/GetListByParentId?partId=' + partSparePartParentId,
			type: 'GET',
			dataSrc: function (json) {
				if (json && json.isSuccess === false) {
					toastr.error(json.message || 'خطا در دریافت اطلاعات');
					return [];
				}
				return (json && json.data) ? json.data : (Array.isArray(json) ? json : []);
			}
		},
		columns: [
			{ data: 'sparePartCode', defaultContent: '-' },
			{ data: 'sparePartName', defaultContent: '-' },
			{ data: 'workingHours', defaultContent: '-' },
			{
				data: 'description',
				defaultContent: '-',
				render: function (data, type) {
					if (type !== 'display') return data;
					return typeof renderEllipsisCell === 'function' ? renderEllipsisCell(data, type) : (data || '-');
				}
			},
			{
				data: 'id',
				orderable: false,
				className: 'text-center',
				render: function (id) {
					return '<button type="button" class="btn btn-sm btn-icon btn-light-warning" data-action="editPartSparePart" data-id="' + id + '"><i class="fa fa-edit"></i></button> '
						+ '<button type="button" class="btn btn-sm btn-icon btn-light-danger" data-action="deletePartSparePart" data-id="' + id + '"><i class="fa fa-trash"></i></button>';
				}
			}
		]
	});
	if (typeof bindEmbeddedTableCellTooltips === 'function')
		bindEmbeddedTableCellTooltips(partSparePartTable);

	function decodeChildPartial(r) {
		if (window.appController && typeof appController.decodePartialResponse === 'function')
			return appController.decodePartialResponse(r);
		return { html: (typeof r === 'string' ? r : ''), scripts: [] };
	}

	function openPartSparePartModal(id) {
		const url = id
			? '/Panel/Inv/PartSparePart/Edit?id=' + id + '&partId=' + partSparePartParentId
			: '/Panel/Inv/PartSparePart/New?partId=' + partSparePartParentId;
		const $trigger = id
			? $$('#partSparePartChildCard').find('[data-action="editPartSparePart"][data-id="' + id + '"]')
			: $$('#partSparePartChildCard').find('[data-action="newPartSparePart"]');
		$trigger.block();
		page.getPartialView(url, function (r) {
			$trigger.block(false);
			if (!r) {
				toastr.error('خطا در دریافت فرم', 'خطا');
				return;
			}
			const decoded = decodeChildPartial(r);
			const $bodyCn = $('<div style="overflow-x:hidden;overflow-y:auto;max-height:70vh;"></div>').append(decoded.html || '');
			$bodyCn.find('.form-action-buttons').remove();
			$.confirm({
				title: id ? 'ویرایش قطعه یدکی' : 'افزودن قطعه یدکی',
				columnClass: 'col-md-10',
				content: $bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-primary',
						action: function () {
							const $content = this.$content;
							if (validateError($content)) return false;
							const model = $content.dataBind();
							const selfConfirm = this;
							const $saveBtn = $(this.buttons.save.el).block();
							const saveUrl = id
								? '/Panel/Inv/PartSparePart/Update'
								: '/Panel/Inv/PartSparePart/Add';
							$$.post(saveUrl, model, function (resp) {
								$saveBtn.block(false);
								if (!resp.isSuccess) {
									toastr.error(resp.message || 'خطا در ذخیره', 'خطا');
									return;
								}
								toastr.success('ذخیره سازی با موفقیت انجام شد');
								selfConfirm.close();
								partSparePartTable.ajax.reload(null, false);
							});
							return false;
						}
					},
					cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
				},
				onContentReady: function () {
					const selfConfirm = this;
					setTimeout(function () {
						selfConfirm.$body.find('.entity-selector-wrapper').each(function () {
							if (!$(this).data('readonly') && typeof $(this).entitySelector === 'function')
								$(this).entitySelector();
						});
						if (typeof Inputmask !== 'undefined')
							Inputmask().mask(selfConfirm.$body.find('[data-inputmask]'));
					}, 100);
				}
			});
		});
	}

	$$('#partSparePartChildCard').on('click', '[data-action="newPartSparePart"]', function () {
		openPartSparePartModal(null);
	});
	$$('#partSparePartChildCard').on('click', '[data-action="editPartSparePart"]', function () {
		openPartSparePartModal($(this).data('id'));
	});
	$$('#partSparePartChildCard').on('click', '[data-action="deletePartSparePart"]', function () {
		const id = $(this).data('id');
		Swal.fire({ title: 'حذف', text: 'آیا از حذف این ردیف مطمئن هستید؟', icon: 'warning', showCancelButton: true, confirmButtonText: 'بله', cancelButtonText: 'خیر' })
			.then(function (result) {
				if (!result.isConfirmed) return;
				$$.get('/Panel/Inv/PartSparePart/Delete?id=' + id, function (r) {
					if (r && r.isSuccess === false) { toastr.error(r.message || 'خطا در حذف'); return; }
					toastr.success('رکورد با موفقیت حذف شد');
					partSparePartTable.ajax.reload(null, false);
				});
			});
	});
</script>

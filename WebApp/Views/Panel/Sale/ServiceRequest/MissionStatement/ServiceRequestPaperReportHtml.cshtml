                font-family: "Vazirmatn",Tahoma,sans-serif;
                font-size: 12px;
                font-weight: 400;
                background: #fff;
                margin: 0;
            }

            .printWindow {
                width: 100%;
                max-width: 190mm;
                margin: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
            }

            td, th {
                border: 1px solid #000;
                padding: 5px 4px;
                vertical-align: middle;
                text-align: center;
                font-weight: 400;
            }

            .no-border {
                border: none !important;
            }

            .title {
                font-size: 18px;
                font-weight: 600;
                text-align: center;
            }

            .section-title {

@using Entities.App.Inv;
@model PartSparePart
<div class="entity-item">
	<input class='form-control' type="hidden" data-bind='spareParts.id' value='@Model?.Id' />
	<div class='col-md-3'>
		<label class=''>قطعه یدکی</label>
		@(Html.EntitySelector<Part>(
			"sparePartsSparePartSelector",
			c => c.IsActive == Entities.Base.IsActiveEnum.Active,
			c => new
			{
				Id = c.Id, Name = c.Name, Code = c.Code
			},
			c => new { c.Name, c.Code },
			"{Name} {Code}",
			"spareParts.sparePartId",
			"spareParts.sparePartName",
			Model?.SparePartId?.ToString()
		))
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>

	<div class='col-md-3'>
		<label class=''>ساعت کارکرد</label>
		<input class='form-control' data-bind='spareParts.workingHours'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" value='@Model?.WorkingHours' />
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>

	<div class='col-md-3'>
		<label class=''>توضیحات</label>
		<input class='form-control' data-bind='spareParts.description'  value='@Model?.Description' />
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>

</div>

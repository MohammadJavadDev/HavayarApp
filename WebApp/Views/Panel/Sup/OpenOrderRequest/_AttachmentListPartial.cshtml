@using Common.Utilities
@using Entities.App.Sup
@model List<OpenOrderRequestAttachment>

<div class="row">
	<div class="col-md-12">
		@if (Model != null && Model.Any())
		{
			<div class="table-responsive">
				<table class="table table-striped table-bordered table-hover">
					<thead>
						<tr>
							<th>عملیات</th>
							<th>نوع فایل</th>
							<th>نام فایل</th>
							<th>حجم</th>
							<th>توضیحات</th>
							<th>کاربر ثبت</th>
							<th>تاریخ ثبت</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var attachment in Model.OrderByDescending(c => c.CreatedOnMiladiDateTime))
						{
							<tr>
								<td>
									<a href="/File/download/@attachment.AttachmentId"
										class="btn btn-sm btn-primary" >
										<i class="fa fa-download"></i>
									</a>
									@if (User.IsInRole("Admin")) // TODO: باید دسترسی واقعی چک شود
									{
										<button type="button" class="btn btn-sm btn-danger" 
											onclick="deleteAttachment(@attachment.Id)">
											<i class="fa fa-trash"></i>
										</button>
									}
								</td>
								<td>@attachment.FileType?.ToDisplay()</td>
								<td>@attachment.Attachment?.OriginalName</td>
								<td>@(attachment.Attachment?.Size != null ? (attachment.Attachment.Size / 1024.0).ToString("N2") + " KB" : "-")</td>
								<td>@attachment.Comment</td>
								<td>
									<i class="fa fa-user"></i> @attachment.CreatedByName
								</td>
								<td style="direction: ltr; text-align: right;">@attachment.CreatedOnShamsiDateTime</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		else
		{
			<div class="alert alert-info">
				<i class="fa fa-info-circle"></i> هیچ پیوستی ثبت نشده است
			</div>
		}
	</div>
</div>

<script>
	function deleteAttachment(attachmentId) {
		$.confirm({
			title: 'تایید حذف',
			content: 'آیا از حذف این پیوست اطمینان دارید؟',
			rtl: true,
			buttons: {
				confirm: {
					text: 'بله',
					btnClass: 'btn-danger',
					action: function() {
						$$.post('/Panel/Sup/OpenOrderRequest/DeleteAttachment', { id: attachmentId }, function(r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}
							toastr.success('پیوست با موفقیت حذف شد');
							// Reload attachment list
							const openOrderRequestId = '@ViewBag.OpenOrderRequestId';
							location.href = `/Panel/Sup/OpenOrderRequest/Edit/${openOrderRequestId}`;
						});
					}
				},
				cancel: {
					text: 'انصراف',
					btnClass: 'btn-secondary'
				}
			}
		});
	}
</script>

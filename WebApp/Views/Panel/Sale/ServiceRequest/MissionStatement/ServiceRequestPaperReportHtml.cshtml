                height: 2.5cm;
                background-image: url("/Content/images/havayar.png");
                background-repeat: no-repeat;
                background-position: center;
                background-size: contain;
                margin: auto;
            }

            .text-right {
                text-align: right !important;
            }

            .text-left {
                text-align: left !important;
            }

            .check-box {
                text-align: right;
                padding-right: 8px;
            }

            .day-row td {
                height: 28px;
            }

            .signature-row td {
                height: 30px;
            }

            .printBtn {
                margin-bottom: 10px;
            }

            @@media print {

                .printBtn {
                    display: none;
                }

                body {
                    margin: 0;
                    padding: 0;
                }
            }

            strong {
                font-weight: 400;

@using Entities.App.Hcm
@using Entities.App.Sec
@using Entities.Base
@model EmploymentStatuteSpecial

@{
	var currentPersonelId = Model?.PersonelId;
}

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(EmploymentStatuteSpecial)" new-page-btn="false" save-and-new-btn="false" history-btn="false"></form-action-buttons>
	</div>
	<div class="card-body">
		<div class="row mb-4"><div class="col-12"><h4 class="fw-bold text-dark mb-0">لیست استثنائات سابقه حضور</h4></div></div>
		<input type="hidden" data-bind="id" value="@Model?.Id" />
		<input type="hidden" data-bind="htsId" value="@Model?.HtsId" />

		<div class="row g-3">
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">پرسنل</label>
				@(Html.EntitySelector<Personel>(
					"PersonelSelector",
					c => c.IsActive == IsActiveEnum.Active || c.Id == currentPersonelId,
					c => new { Id = c.Id, Code = c.Code, Name = c.Name, Family = c.Family, FamilyDisplay = c.FamilyDisplay },
					c => new { c.Code, c.Name, c.Family, c.FamilyDisplay },
					"{Code} | {Name} {FamilyDisplay}",
					"PersonelId",
					"PersonelName",
					Model?.PersonelId > 0 ? Model.PersonelId.ToString() : null,
					required: true
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>

			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">تاریخ استخدام واقعی</label>
				<input class="form-control" data-bind="realEmploymentShamsiDate" data-persionDatePicker="true"
					   persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
					   value="@(Model?.RealEmploymentMiladiDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>

			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">میزان افزایش سال</label>
				<input type="number" class="form-control" data-bind="additionalYear" value="@Model?.AdditionalYear" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>

			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">میزان افزایش ماه</label>
				<input type="number" class="form-control" data-bind="additionalMonth" value="@Model?.AdditionalMonth" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
		</div>
	</div>
</div>

<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;

		const model = page.$pageEl.dataBind();
		const $btn = $($btnAction.element).block();
		$$.post('save', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) {
				toastr.error(r.message, 'خطا');
				return;
			}
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			$btnAction.baseaction();
		});
	}

	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>

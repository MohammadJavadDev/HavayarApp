@using Entities.App.Rpr
@model RepairRequestManHours

<div class="row">
    <input type="hidden" data-bind="RepairRequestId" value="@Model?.RepairRequestId" />

    <div class="col-md-12">
        <label class="required">پرسنل</label>
        @(Html.EntitySelector<Personel>(
                "PersonelSelector",
                c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                c => new
                {
                    Id = c.Id,
                    Name = c.Name,
                    Family = c.Family,
                    Code = c.Code
                },
                c => new { c.Name, c.Code, c.Family },
                "{Name} {Family} {Code}",
                "PersonelId",
                "PersonelName",
                Model?.PersonelId.ToString()
                ))
        <div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
    </div>

    <div class='col-md-12'>
        <label class=''>
            تاریخ
        </label>
        <input class='form-control' data-bind='WorkDate' data-persionDatePicker="true"
               persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true}'
               value='@Model?.WorkDate' />
    </div>


    <div class='col-md-12'>
        <label>ساعت شروع</label>
        <input class='form-control'
               name="StartTime"
               id="StartTime"
               data-bind='startTime'
               data-persionDatePicker="true"
               persion-datetimepicker='{"format": "HH:mm","autoClose": true,"initialValue": false,"onlyTimePicker": true}'
               value='@Model?.StartTime' />
    </div>



    <div class='col-md-12'>
        <label>ساعت خاتمه</label>
        <input class='form-control'
               name="EndTime"
               id="EndTime"
               data-bind='endTime'
               data-persionDatePicker="true"
               persion-datetimepicker='{"format": "HH:mm","autoClose": true,"initialValue": false,"onlyTimePicker": true}'
               value='@Model?.EndTime' />
    </div>

    <div class="col-md-12">
        <label>هزینه نفر ساعت</label>
        <input class="form-control" data-bind="manHourPrice" asp-for="ManHourPrice"
               data-invalidMessage="فقط عدد"
               data-inputmask="'regex':'^[\u06F0-\u06F90-9.]+$' , 'placeholder' : ''" />
        <div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
    </div>

    <div class="col-md-12">
        <label>هزینه نفر ساعت فروش</label>
        <input class="form-control" data-bind="manHourSalePrice" asp-for="ManHourSalePrice"
               data-invalidMessage="فقط عدد"
               data-inputmask="'regex':'^[\u06F0-\u06F90-9.]+$' , 'placeholder' : ''" />
        <div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
    </div>


    <div class="col-md-12">
        <label>کامنت</label>
        <textarea class="form-control" data-bind="comment" asp-for="Comment" rows="3"></textarea>
        <div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
    </div>

</div>

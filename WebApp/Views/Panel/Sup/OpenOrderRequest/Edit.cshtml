				columnClass: 'col-md-10',
				content: bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-danger',
						action: function () {
							debugger
							const $content = this.$content;

							if (validateError($content)) {
								return false;
							}

							const model = $content.dataBind();
							model.openOrderRequestId = openOrderRequestId;
							const self = this;

							$$.post('/Panel/Sup/OpenOrderRequest/StopOperation', model, function (r) {
								if (!r.isSuccess) {
									toastr.error(`${r.message}`, 'خطا');
									return false;
								}

								toastr.success('توقف با موفقیت ثبت شد');
								 
								self.close();
								page.close()
							});

							return false;
						}
					},
					cancel: {
						text: 'انصراف',
						btnClass: 'btn-secondary'
					}
				},
				onContentReady: function () {
					var self = this;
					setTimeout(function () {
						initPersionDatePicker(self.$body);
						initFileUploaders(self.$body)
						self.$body.find('select.select2-hidden-accessible').each(function () {
							const $select = $$(this);
							const currentData = $select.select2('data');
							$select.select2('destroy');
							$select.select2({
								dropdownParent: self.$body,
								width: '100%',
								placeholder: $select.attr('placeholder') || 'انتخاب کنید'
							});
							if (currentData && currentData.length > 0) {
								$select.val($select.val()).trigger('change');
							}
						});
					}, 100);
				}
			});
		});
	});
	//#endregion

	//#region Triggering (راه اندازی)
	self.FormActionButtons.triggeringRequest.onclick(function () {
		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			toastr.error('ابتدا درخواست باز را ذخیره کنید');
			return;
		}

		 

		if (!permissions.stopOpersions) {
			toastr.error('شما دسترسی راه‌اندازی را ندارید');
			return;
		}

		$.confirm({
			title: 'تایید',
			content: 'آیا از راه‌اندازی این درخواست اطمینان دارید؟',
			rtl: true,
			buttons: {
				confirm: {
					text: 'بله',
					btnClass: 'btn-success',
					action: function () {
						const self = this;
						$$.post('/Panel/Sup/OpenOrderRequest/Triggering/'+openOrderRequestId, null, function (r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}
							toastr.success('درخواست با موفقیت راه‌اندازی شد');
						 self.close()
						});
					}
				},
				cancel: {
					text: 'انصراف',
					btnClass: 'btn-secondary'
				}
			}
		});
	});
	//#endregion

	//#region InWay Status
	self.FormActionButtons.inWayStatus.onclick(function () {
		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			toastr.error('ابتدا درخواست باز را ذخیره کنید');
			return;
		}

		 

		if (!permissions.stopOpersions) {
			toastr.error('شما دسترسی تغییر وضعیت به در راه را ندارید');
			return;
		}

				$.confirm({
			title: 'تایید',
			content: 'آیا از تغییر وضعیت این درخواست به "در راه" اطمینان دارید؟',
			rtl: true,
			buttons: {
				confirm: {
					text: 'بله',
					btnClass: 'btn-info',
					action: function () {
						$$.post('/Panel/Sup/OpenOrderRequest/SetInWayStatus/'+openOrderRequestId, null, function (r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}
							toastr.success('وضعیت به "در راه" تغییر یافت');
 
							});
					}
				},
				cancel: {
					text: 'انصراف',
					btnClass: 'btn-secondary'
				}
			}
		});

		
	});
	//#endregion

	//#region Status Inquiry
	self.FormActionButtons.statusInquiry.onclick(function () {
		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			toastr.error('ابتدا درخواست باز را ذخیره کنید');
			return;
		}

		 

		if (!permissions.stopOpersions) {
			toastr.error('شما دسترسی استعلام وضعیت را ندارید');
			return;
		}

			$.confirm({
			title: 'تایید',
			content: 'آیا از تغییر وضعیت این درخواست به "در حال استعلام" اطمینان دارید؟',
			rtl: true,
			buttons: {
				confirm: {
					text: 'بله',
					btnClass: 'btn-info',
					action: function () {
						$$.post('/Panel/Sup/OpenOrderRequest/StatusInquiry/'+openOrderRequestId, null, function (r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}
							toastr.success('وضعیت به "در حال استعلام" تغییر یافت');
			 
						});
					}
				},
				cancel: {
					text: 'انصراف',
					btnClass: 'btn-secondary'
				}
			}
		});

		
	});
	//#endregion

	//#region Terminate
	self.FormActionButtons.terminateRequest.onclick(function () {
		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			toastr.error('ابتدا درخواست باز را ذخیره کنید');
			return;
		}

  
		if (!permissions.hasTerminatePermission) {
			toastr.error('شما دسترسی خاتمه را ندارید');
			return;
		}

		$.confirm({
			title: 'تایید',
			content: 'آیا از خاتمه یافتن این درخواست اطمینان دارید؟',
			rtl: true,
			buttons: {
				confirm: {
					text: 'بله',
					btnClass: 'btn-danger',
					action: function () {
						$$.post('/Panel/Sup/OpenOrderRequest/Terminate/'+openOrderRequestId,null, function (r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}
							toastr.success('درخواست با موفقیت خاتمه یافت');
				 
						});
					}
				},
				cancel: {
					text: 'انصراف',
					btnClass: 'btn-secondary'
				}
			}
		});
	});
	//#endregion

	//#region Manage Attachments (moved to tab)
	function reloadAttachmentsList() {
		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			return;
		}

		$$.get(`/Panel/Sup/OpenOrderRequest/AttachmentListPartial?openOrderRequestId=${openOrderRequestId}`, function (html) {
			$$('#attachments_content').html(html);
			const rowCount = $$('#attachments_content tbody tr').length;
			const emptyState = $$('#attachments_content .alert-info').length > 0;
			$$('#attachments_count_badge').text(emptyState ? 0 : rowCount);
		});
	}

	function deleteOpenOrderAttachment(attachmentId) {
		$.confirm({
			title: 'تایید حذف',
			content: 'آیا از حذف این پیوست اطمینان دارید؟',
			rtl: true,
			buttons: {
				confirm: {
					text: 'بله',
					btnClass: 'btn-danger',
					action: function () {
						$$.post('/Panel/Sup/OpenOrderRequest/DeleteAttachment', { id: attachmentId }, function (r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}
							toastr.success('پیوست با موفقیت حذف شد');
							reloadAttachmentsList();
						});
					}
				},
				cancel: {
					text: 'انصراف',
					btnClass: 'btn-secondary'
				}
			}
		});
	}

	$$('#attachments_content').on('click', '.btn-delete-attachment', function () {
		const attachmentId = $$(this).data('attachment-id');
		if (!attachmentId) {
			return;
		}
		deleteOpenOrderAttachment(attachmentId);
	});

	function openAttachmentModal(attachmentId = null) {
		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();

		const url = attachmentId
			? `/Panel/Sup/OpenOrderRequest/AttachmentPartial?id=${attachmentId}&openOrderRequestId=${openOrderRequestId}`
			: `/Panel/Sup/OpenOrderRequest/AttachmentPartial?openOrderRequestId=${openOrderRequestId}`;

		$$.get(url, function (result) {
			let bodyCn = `<div style="overflow-x: hidden;">${result}</div>`;
			$.confirm({
				title: attachmentId ? 'ویرایش پیوست' : 'افزودن پیوست',
				columnClass: 'col-md-8',
				content: bodyCn,
				rtl: true,
				onContentReady: function () {
					var self = this;
					setTimeout(function () {
						initFileUploaders(self.$body)
					},100)
				},
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-primary',
						action: function () {
							const $content = this.$content;

							if (validateError($content)) {
								return false;
							}

							const model = $content.dataBind();
							model.openOrderRequestId = openOrderRequestId;
							const self = this;

							$$.post('/Panel/Sup/OpenOrderRequest/SaveAttachment', model, function (r) {
								if (!r.isSuccess) {
									toastr.error(`${r.message}`, 'خطا');
									return false;
								}

								toastr.success('پیوست با موفقیت ذخیره شد');
								self.close();
								reloadAttachmentsList();
							});

							return false;
						}
					},
					cancel: {
						text: 'انصراف',
						btnClass: 'btn-secondary'
					}
				}
			});
		});
	}
	//#endregion

	//#region Link VPIS
	self.FormActionButtons.linkVpis.onclick(function () {
		 
		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			toastr.error('ابتدا درخواست باز را ذخیره کنید');
			return;
		}

		 
		if (!permissions.isEngineering) {
			toastr.error('شما دسترسی لینک با مدارک پروژه را ندارید');
			return;
		}

		const url = `/Panel/Sup/OpenOrderRequest/LinkVpisPartial?openOrderRequestId=${openOrderRequestId}`;
		
		$$.get(url, function(result) {
			let bodyCn = `<div style="overflow-x: hidden; overflow-y: auto; max-height: 70vh;">${result}</div>`;
			$.confirm({
				title: 'لینک با مدارک پروژه',
				columnClass: 'col-md-10',
				content: bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-success',
						action: function() {
							const $content = this.$content;
							
							if (validateError($content)) {
								return false;
							}
							
							const model = $content.dataBind();
							model.openOrderRequestId = openOrderRequestId;
							const self = this;
							
							$$.post('/Panel/Sup/OpenOrderRequest/DoLinkVpis', model, function(r) {
								if (!r.isSuccess) {
									toastr.error(`${r.message}`, 'خطا');
									return false;
								}
								
								toastr.success('لینک با موفقیت ثبت شد');
								self.close();
								reloadAttachmentsList();
							});
							
							return false;
						}
					},
					cancel: {
						text: 'انصراف',
						btnClass: 'btn-secondary'
					}
				},
				onContentReady: function () {
					var self = this;
					setTimeout(function () {
						self.$body.find('select.select2-hidden-accessible').each(function() {
							const $select = $$(this);
							const currentData = $select.select2('data');
							$select.select2('destroy');
							$select.select2({
								dropdownParent: self.$body,
								width: '100%',
								placeholder: $select.attr('placeholder') || 'انتخاب کنید'
							});
							if (currentData && currentData.length > 0) {
								$select.val($select.val()).trigger('change');
							}
						});
					}, 100);
				}
			});
		});
	});
	//#endregion


	//#region AddRequestedPersonel
	self.FormActionButtons.addRequestedPersonel.onclick(function () {

		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			toastr.error('ابتدا درخواست باز را ذخیره کنید');
			return;
		}

		 

		if (!permissions.hasConfigManagePermission) {
			toastr.error('شما دسترسی افزودن ذینفعان را ندارید');
			return;
		}

			const url = `/Panel/Sup/OpenOrderRequest/AddRequestedPersonelPartial?openOrderRequestId=${openOrderRequestId}`;

				$$.get(url, function(result) {
				let bodyCn = `<div style="overflow-x: hidden; overflow-y: hidden; max-height: 70vh;">${result}</div>`;
				
				$.confirm({
				title: 'افزودن درخواست کنندگان و ذینفعان',
				columnClass: 'col-md-10',
				content: bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-success',
						action: function() {
							const $content = this.$content;

							 
							if (validateError($content)) {
								return false;
							}

							const model = $content.dataBind();
							model.OpenOrderRequestIds = [openOrderRequestId];

							model.requestedPersonelIds = model.requestedPersonelIds.split(',').map(c=>parseInt(c))
							model.requestedEngineeringPersonelIds = model.requestedEngineeringPersonelIds.split(',').map(c=>parseInt(c));
	

							const self = this;

							$$.post('/Panel/Sup/OpenOrderRequest/AddRequestedPersonelToOpenRequest', model, function(r) {
								if (!r.isSuccess) {
									toastr.error(`${r.message}`, 'خطا');
									return false;
								}

								toastr.success('اطلاعات با موفقیت ثبت شد');
								self.close();
								page.close()
							});

							return false;
						}
					},
					cancel: {
						text: 'انصراف',
						btnClass: 'btn-secondary'
					}
				},
				onContentReady: function () {
					var self = this;
					setTimeout(function () {
						 
					}, 100);
				}
			});
				
				})

	})
	//#endregion


@using Entities.App.Hrm
@using Entities.Base
@model EnexFormPart?
@{
	var currentPartId = Model?.EnexPartId ?? 0;
	var returnMiladi = Model?.ReturnMiladiDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="enex-entry-item-form">
	<input type="hidden" data-bind="id" value="@Model?.Id" />
	<input type="hidden" data-bind="partId" value="@Model?.PartId" />
	<div class="row g-3">
		<div class="col-md-12 form-group-inline">
			<label class="form-label fw-bold required">قطعه</label>
			@(Html.EntitySelector<EnexPart>(
				"EnexEntryItemPartSelector",
				c => c.IsActive == IsActiveEnum.Active || c.Id == currentPartId,
				c => new { Id = c.Id, Code = c.Code, Title = c.Title },
				c => new { c.Code, c.Title },
				"{Code} - {Title}",
				"enexPartId",
				"partTitle",
				Model?.EnexPartId > 0 ? Model.EnexPartId.ToString() : null,
				true
			))
			@if (ViewBag.InvPartTitle != null)
			{
				<div class="text-muted mt-1">کالای انبار: @ViewBag.InvPartTitle</div>
			}
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">مقدار خروج</label>
			<input class="form-control" type="text" data-bind="mount"
				value="@(Model?.Mount.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold required">مقدار ورود</label>
			<input class="form-control" type="text" data-bind="enterAmount" data-required="true"
				value="@(Model?.EnterAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
		<div class="col-md-4 form-group-inline">
			<label class="form-label fw-bold">عدم تایید حراست</label>
			<div>
				<input class="form-check-input mt-2" type="checkbox" data-bind="isSecurityDisApproved" id="enexEntrySecurityDisapprove"
					@(Model?.IsSecurityDisApproved == true ? "checked" : "") />
			</div>
		</div>
		<div class="col-md-6 form-group-inline">
			<label class="form-label fw-bold">تاریخ بازگشت</label>
			<input class="form-control" data-bind="returnShamsiDate" data-persionDatePicker="true"
				persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
				value="@returnMiladi" />
			<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
		</div>
		<div class="col-md-12 form-group-inline">
			<label class="form-label fw-bold">توضیحات</label>
			<input class="form-control" data-bind="comment" maxlength="2048" value="@Model?.Comment" />
		</div>
		<div class="col-md-12 form-group-inline">
			<fileuploader bind="fileId" file-id="@Model?.FileId" file-entity="@Model?.File"
				label="فایل پیوست" entity-type="@typeof(EnexFormPart).FullName" entity-prop-name="File"
				max-file-size="20" accepted-file-types=".pdf,.zip,.rar,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx,.txt"></fileuploader>
		</div>
	</div>
</div>

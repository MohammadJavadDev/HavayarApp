@using Entities.App.Edms
@using Entities.App.Edms.Enums
@using Entities.Auth
@using Common.Utilities
@model DocumentComment

@{

	var statusItems = Html.GetEnumSelectList(typeof(Entities.App.Edms.Enums.DocumentStatusEnums));
	var selectedStatusValue = Model?.Status.HasValue == true ? ((int)Model.Status.Value).ToString() : null;
	bool canEdit = false;
	if(ViewData["CanEditDocument"] != null)
	{
		canEdit = (bool)ViewData["CanEditDocument"];
	}
 
}

<div class="entity-item   g-3" data-document-comment-item="true" data-item-id="@(Model?.Id ?? 0)" style="    border-bottom: 1px dashed #8080805e;  
   padding: 10px;
    display: flex;
    flex-direction: row;
    overflow-y: auto;
    gap: 10px;
    align-items: center;">
	<input class='form-control' type="hidden" data-bind='comments.id' value='@Model?.Id' />
	<input class='form-control' type="hidden" data-bind='comments.documentId' value='@Model?.DocumentId' />
	 
	<div class='col-md-1
align-content-center'>
		@if (canEdit)
		{
			 
			<fileuploader bind="comments.attachmentId" file-id="@Model?.AttachmentId" file-entity="@Model?.Attachment"
					    Label="پیوست" entity-type="@typeof(DocumentComment).FullName" entity-prop-name="Attachment" max-file-size="100"
				accepted-file-types=".rar,.zip,.pdf,.excel,.word"></fileuploader>
		}
		else
		{

			@if (Model?.AttachmentId.HasValue == true && Model.AttachmentId.Value > 0)
			{
				<div class="d-flex align-items-center gap-2">
					<a href="/File/download/@Model.AttachmentId.Value" class="btn btn-sm btn-light-primary" target="_blank">
						<i class="ki-file-down ki-solid fs-2hx">
							 
						</i>
						 
					</a>
					@if (Model?.Attachment != null && !string.IsNullOrWhiteSpace(Model.Attachment.OriginalName))
					{
						<span class="text-muted">@Model.Attachment.OriginalName</span>
					}
				</div>
			}
			else
			{

				<a href="#" class="btn btn-sm btn-light-secondary  disabled" disabled>
					<i class="ki-delete-files ki-solid fs-2hx">

					</i>

				</a>
			 
			}
		}
	</div>
 
	<div class='col-md-3'>

		@if (canEdit)
		{
			<label class='form-label'>وضعیت مدرک</label>
			<select class='form-control' data-bind='comments.status' data-comment-status="true">
				<option value="" selected="@(selectedStatusValue == null ? "selected" : (string?)null)">انتخاب کنید...
				</option>
				@foreach (var item in statusItems)
				{
					<option value="@item.Value" selected="@(item.Value == selectedStatusValue ? "selected" : (string?)null)">
						@item.Text</option>
				}
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		}
		else
		{
			<div class="form-control-plaintext">
				@if (Model?.Status.HasValue == true)
				{
					var statusClass = DocumentStatusPalette.BadgeClass(Model?.Status);
					var statusStyle = DocumentStatusPalette.BadgeStyle(Model?.Status);

					<span class="@statusClass" style="@statusStyle">@Model.Status.Value.ToDisplay()</span>
				}
				else
				{
					<span class="text-muted">-</span>
				}
			</div>
		}
	</div>

	 
	<div class='col-md-4'>

		@if (canEdit)
		{
			<label class='form-label'>توضیحات</label>
			<textarea class='form-control' data-bind='comments.comment'>@Model?.Comment</textarea>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		}
		else
		{
			<div class="form-control-plaintext">
				@if (!string.IsNullOrWhiteSpace(Model?.Comment))
				{
					<span>@Model.Comment</span>
				}
				else
				{
					<span class="text-muted">-</span>
				}
				@if (!string.IsNullOrWhiteSpace(Model?.ReceivedTransmittalNumber))
				{
					<div class="text-muted mt-1">شماره کامنت شیت دریافتی: <span class="ltr">@Model.ReceivedTransmittalNumber</span></div>
				}
			</div>
		}
	</div>
	 
	@if (Model != null && Model?.LegalHolder != null && !canEdit)
	{
		<div class='col-md-2'>
			<label class='form-label'>متولی Hold</label>
			<div class="form-control-plaintext">
				@if (Model.LegalHolder.HasValue)
				{
					<span class="badge badge-light-info">@Model.LegalHolder.Value.ToDisplay()</span>
				}
				else
				{
					<span class="text-muted">-</span>
				}
			</div>
		</div>
	}

	@if (Model != null && Model?.HOLDOwnerId != null && !canEdit)
	{
		<div class="col-md-2">
			<label class="form-label">مسئول Hold</label>
			<div class="form-control-plaintext">
				@if (Model.HOLDOwnerId.HasValue && Model.HOLDOwnerId.Value > 0)
				{
					@if (Model.HOLDOwner != null && !string.IsNullOrWhiteSpace(Model.HOLDOwner.Name))
					{
						<span>@Model.HOLDOwner.Name</span>
					}
					else
					{
						<span class="text-muted">شناسه کاربر: @Model.HOLDOwnerId.Value</span>
					}
				}
				else
				{
					<span class="text-muted">-</span>
				}
			</div>
		</div>
	}

	@if (Model != null && Model?.HoldDetails != null && !canEdit)
	{
		<div class='col-md-2'>
			<label class='form-label'>توضیحات Hold</label>
			<div class="form-control-plaintext">
				@if (!string.IsNullOrWhiteSpace(Model.HoldDetails))
				{
					<span>@Model.HoldDetails</span>
				}
				else
				{
					<span class="text-muted">-</span>
				}
			</div>
		</div>
	}

	@if(Model !=null && canEdit == false && Model?.CreatedByName !=null)
	{
		<div class="col-md-2">
			<div class="form-control-plaintext">
				<span class="badge badge-light-primary">@Model.CreatedByName</span>
			</div>
		</div>
	}

	@if (Model != null && canEdit == false && Model.CreatedOnShamsiDateTime != null)
	{
		<div class="col-md-1">
			<div class="form-control-plaintext">
				<span class="badge badge-light-primary" style="direction: ltr;">@Model.CreatedOnShamsiDateTime</span>
			</div>
		</div>
	}

</div>

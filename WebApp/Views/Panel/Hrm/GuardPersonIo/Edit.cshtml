@using Common.Utilities
@using Entities.App.Hcm
@using Entities.App.Hrm
@using Entities.App.Hrm.Enums
@using Entities.Base
@model GuardPersonIo

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(GuardPersonIo)"
			save-btn="true"
			save-and-close-btn="true"
			new-page-btn="false"
			save-and-new-btn="false"
			history-btn="false">
		</form-action-buttons>
	</div>
	<div class="card-body">
		<div class="row mb-4"><div class="col-12"><h4 class="fw-bold text-dark mb-0">ورود/خروج پرسنل/پیمانکار</h4></div></div>
		<input type="hidden" data-bind="id" value="@Model?.Id" />
		<input type="hidden" data-bind="htsId" value="@Model?.HtsId" />

		<div class="row g-3 mb-3">
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold required">نوع</label>
				<select class="form-control" id="guardPersonOperatorType" data-bind="operatorType" data-required="true">
					<option value="">لطفا انتخاب کنید</option>
					@foreach (var v in Enum.GetValues<GuardOperatorTypeEnum>().Where(x => x != GuardOperatorTypeEnum.Miscellaneous))
					{
						<option value="@((int)v)" selected="@(Model?.OperatorType == v)">@v.ToDisplay()</option>
					}
				</select>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>

			<div class="col-md-4 form-group-inline guard-op-person" style="display:none">
				<label class="form-label fw-bold required">پرسنل</label>
				@{ var currentPersonId = Model?.PersonId; }
				@(Html.EntitySelector<Personel>(
					"GuardPersonIoPersonSelector",
					c => c.IsActive == IsActiveEnum.Active || c.Id == currentPersonId,
					c => new { Id = c.Id, Name = c.Name, Family = c.Family, FamilyDisplay = c.FamilyDisplay, Code = c.Code },
					c => new { c.Name, c.Family, c.FamilyDisplay, c.Code },
					"{Name} {FamilyDisplay}",
					"personId",
					"personName",
					Model?.PersonId > 0 ? Model.PersonId.ToString() : null
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>

			<div class="col-md-4 form-group-inline guard-op-contractor" style="display:none">
				<label class="form-label fw-bold required">پیمانکار</label>
				<div class="d-flex gap-2 align-items-start">
					<div class="flex-grow-1">
						@{ var currentContractorId = Model?.ContractorId; }
						@(Html.EntitySelector<GuardContractor>(
							"GuardPersonIoContractorSelector",
							c => c.IsActive == IsActiveEnum.Active || c.Id == currentContractorId,
							c => new { Id = c.Id, FullName = c.FullName, PhoneNumber = c.PhoneNumber },
							c => new { c.FullName, c.PhoneNumber },
							"{FullName}",
							"contractorId",
							"contractorName",
							Model?.ContractorId > 0 ? Model.ContractorId.ToString() : null
						))
					</div>
					<button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-action="quickAddContractor">
						<i class="fa fa-plus"></i> افزودن
					</button>
				</div>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>

			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">تاریخ ورود</label>
				<input class="form-control" data-bind="entryShamsiDate" data-persionDatePicker="true"
					persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
					value="@(Model?.EntryMiladiDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">ساعت ورود</label>
				<input class="form-control ltr" type="text" data-bind="entryTime" data-time="true" placeholder="__:__" value="@Model?.EntryTime" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">تاریخ خروج</label>
				<input class="form-control" data-bind="exitShamsiDate" data-persionDatePicker="true"
					persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
					value="@(Model?.ExitMiladiDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">ساعت خروج</label>
				<input class="form-control ltr" type="text" data-bind="exitTime" data-time="true" placeholder="__:__" value="@Model?.ExitTime" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>

			<div class="col-md-12 form-group-inline">
				<label class="form-label fw-bold">توضیحات</label>
				<textarea class="form-control" data-bind="comment" rows="2" maxlength="2048">@Model?.Comment</textarea>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>

			<div class="col-md-6 form-group-inline">
				<fileuploader bind="entryFileId" file-id="@Model?.EntryFileId" file-entity="@Model?.EntryFile"
					label="تصویر ورود پرسنل/ پیمانکار" entity-type="@typeof(GuardPersonIo).FullName" entity-prop-name="EntryFile"
					max-file-size="5" accepted-file-types=".jpg,.png,.jpeg,.rar,.zip,.pdf,.doc,.docx"></fileuploader>
			</div>
			<div class="col-md-6 form-group-inline" id="exitPersonPicRow" style="@(Model?.Id is null or 0 ? "display:none" : null)">
				<fileuploader bind="exitFileId" file-id="@Model?.ExitFileId" file-entity="@Model?.ExitFile"
					label="تصویر خروج پرسنل/ پیمانکار" entity-type="@typeof(GuardPersonIo).FullName" entity-prop-name="ExitFile"
					max-file-size="5" accepted-file-types=".jpg,.png,.jpeg,.rar,.zip,.pdf,.doc,.docx"></fileuploader>
			</div>
		</div>
	</div>
</div>

<script>
	function hasText(v) {
		return v != null && String(v).trim() !== '';
	}

	function hasTime(v) {
		if (!hasText(v)) return false;
		return String(v).replace(/[_:]/g, '').trim() !== '';
	}

	function toggleOperatorFields() {
		const t = String($$('#guardPersonOperatorType').val() || '');
		$$('.guard-op-person').toggle(t === '1439');
		$$('.guard-op-contractor').toggle(t === '1440');
	}

	function decodeChildPartial(r) {
		if (window.appController && typeof appController.decodePartialResponse === 'function')
			return appController.decodePartialResponse(r);
		return { html: (typeof r === 'string' ? r : ''), scripts: [] };
	}

	function openQuickAddContractor($btn) {
		$btn.block();
		page.getPartialView('/Panel/Hrm/GuardPartIo/QuickForm?type=contractor', function (r) {
			$btn.block(false);
			if (!r) { toastr.error('خطا در دریافت فرم'); return; }
			const decoded = decodeChildPartial(r);
			const $bodyCn = $('<div style="overflow-x:hidden;"></div>').append(decoded.html || '');
			$.confirm({
				title: 'افزودن پیمانکار',
				columnClass: 'col-md-6',
				content: $bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-primary',
						action: function () {
							const $content = this.$content;
							if (validateError($content)) return false;
							const m = $content.dataBind();
							const jc = this;
							jc.showLoading(true);
							$$.post('/Panel/Hrm/GuardContractor/Add', m, function (res) {
								jc.hideLoading(true);
								if (!res.isSuccess) { toastr.error(res.message, 'خطا'); return; }
								const d = res.data || {};
								const display = ((d.name || '') + ' ' + (d.family || '')).trim();
								const $w = $$('#GuardPersonIoContractorSelector');
								if (typeof $w.entitySelector === 'function') $w.entitySelector();
								const sel = $w.data('entitySelector');
								if (sel && d.id) sel.select({ id: d.id, display: display });
								toastr.success('ذخیره سازی با موفقیت انجام شد');
								jc.close();
							});
							return false;
						}
					},
					cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
				}
			});
		});
	}

	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;
		const model = page.$pageEl.dataBind();
		const opType = String(model.operatorType || '');
		if (!opType) { toastr.error('نوع نمی‌تواند خالی باشد', 'خطا'); return; }
		if (opType === '1439' && (!model.personId || model.personId === '0')) { toastr.error('پرسنل نمی‌تواند خالی باشد', 'خطا'); return; }
		if (opType === '1440' && (!model.contractorId || model.contractorId === '0')) { toastr.error('پیمانکار نمی‌تواند خالی باشد', 'خطا'); return; }
		if (hasText(model.entryShamsiDate) && !hasTime(model.entryTime)) { toastr.error('ساعت ورود نمی‌تواند خالی باشد', 'خطا'); return; }
		if (hasText(model.exitShamsiDate) && !hasTime(model.exitTime)) { toastr.error('ساعت خروج نمی‌تواند خالی باشد', 'خطا'); return; }

		if (opType !== '1439') model.personId = null;
		if (opType !== '1440') model.contractorId = null;
		if (!model.id || model.id === '0') model.exitFileId = null;

		const $btn = $($btnAction.element).block();
		$$.post(model.id ? 'update' : 'add', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			if (r.data && r.data.id) $$('#exitPersonPicRow').show();
			$btnAction.baseaction();
		});
	}

	self.FormActionButtons.save.onclick(function () { savefn(this); });
	if (self.FormActionButtons.saveandclose)
		self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });

	$$('#guardPersonOperatorType').on('change', toggleOperatorFields);
	page.$pageEl.on('click', '[data-action="quickAddContractor"]', function () { openQuickAddContractor($(this)); });
	toggleOperatorFields();
</script>

@using Entities.App.Prp
@using Entities.App.Sale
@using Entities.App.Inv
@model List<RepairRequestComment>

<div class="container-fluid">
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover" id="commentListTable" style="width: 100%;">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 8%">ردیف</th>
                            <th style="width: 15%">هزینه</th>
                            <th style="width: 15%">تاریخ</th>
                            <th style="width: 52%">کامنت</th>
                            <th style="width: 10%">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            var index = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@index</td>
                                    <td class="text-end">@(item.Cost?.ToString("N0") ?? "-")</td>
                                    <td>@(item.CreatedOnShamsiDateTime ?? "-")</td>
                                    <td style="max-width:300px; white-space:normal">@(item.Comment ?? "-")</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="deleteComment(@item.Id)">
                                            <i class="fa fa-trash"></i> حذف
                                        </button>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-warning">هیچ اطلاعاتی یافت نشد</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    function deleteComment(id) {
        Swal.fire({
            title: 'آیا اطمینان دارید؟',
            text: "این عملیات غیرقابل بازگشت است!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'بله، حذف شود',
            cancelButtonText: 'انصراف'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: `/Panel/Rpr/RepairRequest/DeleteComment?id=${id}`,
                    type: 'DELETE',
                    dataType: 'json',
                    success: function (response) {
                        if (response && response.data && response.data.success === true) {
                            toastr.success(response.data.message || 'کامنت با موفقیت حذف شد');
                            if (typeof $$ !== 'undefined' && $$.confirm) {
                                $$.confirm.close();
                            }
                            location.reload();
                        } else {
                            const errorMessage = response?.data?.message || response?.message || 'خطا در حذف کامنت';
                            toastr.error(errorMessage);
                        }
                    },
                    error: function (xhr) {
                        let errorMessage = 'خطا در حذف کامنت';
                        if (xhr.responseJSON) {
                            errorMessage = xhr.responseJSON?.data?.message || xhr.responseJSON?.message || errorMessage;
                        } else if (xhr.responseText) {
                            try {
                                const response = JSON.parse(xhr.responseText);
                                errorMessage = response?.data?.message || response?.message || errorMessage;
                            } catch(e) {
                                errorMessage = xhr.responseText;
                            }
                        }
                        toastr.error(errorMessage);
                    }
                });
            }
        });
    }

       $(document).ready(function() {
        if ($.fn.DataTable && $('#commentListTable').length) {
            if ($.fn.DataTable.isDataTable('#commentListTable')) {
                $('#commentListTable').DataTable().destroy();
                $('#commentListTable').empty();
            }            
            $('#commentListTable').DataTable({
                autoWidth: false,
                pageLength: 10,
                lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, "همه"]],                
                columns: [
                    { title: "ردیف", width: "10%", className: "text-center", defaultContent: "" },
                    { title: "هزینه", width: "15%", className: "text-end", defaultContent: "" },
                    { title: "تاریخ", width: "15%", className: "text-center", defaultContent: "" },
                    { title: "کامنت", width: "52%", className: "text-right", defaultContent: "" },
                    { title: "عملیات", width: "10%", className: "text-center", orderable: false, defaultContent: "" }
                ],

                columnDefs: [
                    { targets: 2, orderData: [2] }
                ],

                order: [[2, 'desc']],
                language: {
                    emptyTable: "هیچ اطلاعاتی یافت نشد",
                    zeroRecords: "هیچ اطلاعاتی یافت نشد",
                    infoEmpty: "نمایش 0 تا 0 از 0 آیتم",
                    search: "جستجو:",
                    lengthMenu: "نمایش _MENU_ آیتم در هر صفحه",
                    info: "نمایش _START_ تا _END_ از _TOTAL_ آیتم",
                    paginate: {
                        first: "اول",
                        last: "آخر",
                        next: "بعدی",
                        previous: "قبلی"
                    }
                }
            });
        }
    });
</script>

<style>
    #commentListTable {
        width: 100% !important;
    }

        #commentListTable thead th {
            white-space: nowrap;
        }

        #commentListTable tbody tr:hover {
            background-color: #f5f5f5;
        }

        #commentListTable td {
            vertical-align: middle;
        }
</style>
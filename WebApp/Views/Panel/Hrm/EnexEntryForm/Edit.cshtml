@using Common.Utilities
@using Entities.App.Hrm
@using Entities.App.Hrm.Enums
@model EnexEntryForm

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(EnexEntryForm)"
			save-btn="true"
			save-and-close-btn="true"
			new-page-btn="false"
			save-and-new-btn="false"
			history-btn="false">
		</form-action-buttons>
	</div>
	<div class="card-body">
		<div class="row mb-4"><div class="col-12"><h4 class="fw-bold text-dark mb-0">ورود اضطراری</h4></div></div>
		<input type="hidden" data-bind="id" value="@Model?.Id" />
		<input type="hidden" data-bind="htsId" value="@Model?.HtsId" />
		<input type="hidden" data-bind="exitFormId" value="@Model?.ExitFormId" />
		<input type="hidden" data-bind="sourceEntryId" value="@Model?.SourceEntryId" />
		<input type="hidden" data-bind="isFromExitForm" value="@(Model?.IsFromExitForm == true ? "true" : "false")" />

		<div class="row g-3 mb-3">
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">شماره فرم</label>
				<input class="form-control" value="@(Model?.FormNumber > 0 ? Model.FormNumber.ToString() : "")" readonly />
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">آخرین وضعیت</label>
				<input class="form-control" value="@(Model?.Id > 0 ? Model.LastStatusId.ToDisplay() : "")" readonly />
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">شماره فرم خروج</label>
				<input class="form-control" value="@Model?.ExitForm?.FormNumber" readonly />
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">واحد سازمانی</label>
				<input class="form-control" value="@Model?.OrganizationUnit?.Title" readonly />
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold required">عنوان واردکننده</label>
				<input class="form-control" data-bind="importerTitle" data-required="true" maxlength="128" value="@Model?.ImporterTitle" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">شرکت</label>
				<input class="form-control" data-bind="companyTitle" maxlength="128" value="@Model?.CompanyTitle" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-12 form-group-inline">
				<label class="form-label fw-bold">توضیحات</label>
				<textarea class="form-control" data-bind="comment" maxlength="2048" rows="2">@Model?.Comment</textarea>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
		</div>

		<div class="d-flex justify-content-between align-items-center mb-2">
			<h5 class="mb-0">اقلام</h5>
			<button type="button" class="btn btn-sm btn-primary" data-action="addItem">افزودن</button>
		</div>
		<div class="table-responsive mb-4">
			<table class="table table-row-bordered table-row-gray-300 align-middle gs-3 gy-2" id="enexEntryPartsTable">
				<thead>
					<tr class="fw-bold text-muted">
						<th>قطعه</th>
						<th>مقدار خروج</th>
						<th>مقدار ورود</th>
						<th>عدم تایید حراست</th>
						<th>تاریخ بازگشت</th>
						<th>توضیحات</th>
						<th>پیوست</th>
						<th class="text-center">عملیات</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>

		<h5 class="mb-2">سوابق</h5>
		<div class="table-responsive">
			<table class="table table-row-bordered table-row-gray-300 align-middle gs-3 gy-2" id="enexEntryLogsTable">
				<thead>
					<tr class="fw-bold text-muted">
						<th>وضعیت</th>
						<th>کاربر</th>
						<th>تاریخ</th>
						<th>توضیحات</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>
</div>

<script>
	let enexItems = [];
	let enexEditingIndex = null;

	function esc(v) {
		if (v == null) return '';
		return String(v).replace(/[&<>"']/g, function (c) {
			return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
		});
	}

	function renderItems() {
		const $tb = $$('#enexEntryPartsTable tbody');
		$tb.empty();
		enexItems.forEach(function (item, i) {
			const file = item.fileId
				? '<a class="btn btn-sm btn-icon btn-light-info" href="/File/download/' + item.fileId + '" title="دانلود"><i class="fa fa-download"></i></a>'
				: '';
			const dis = item.isSecurityDisApproved === true || item.isSecurityDisApproved === 'true' ? 'بله' : '';
			$tb.append(
				'<tr>'
				+ '<td>' + esc(item.partTitle) + '</td>'
				+ '<td>' + esc(item.mount) + '</td>'
				+ '<td>' + esc(item.enterAmount) + '</td>'
				+ '<td>' + dis + '</td>'
				+ '<td>' + esc(item.returnShamsiDate) + '</td>'
				+ '<td>' + esc(item.comment) + '</td>'
				+ '<td>' + file + '</td>'
				+ '<td class="text-center">'
				+ '<button type="button" class="btn btn-sm btn-icon btn-light-warning me-1" data-action="editItem" data-index="' + i + '"><i class="fa fa-pen"></i></button>'
				+ '<button type="button" class="btn btn-sm btn-icon btn-light-danger" data-action="deleteItem" data-index="' + i + '"><i class="fa fa-trash"></i></button>'
				+ '</td></tr>'
			);
		});
	}

	function renderLogs(rows) {
		const $tb = $$('#enexEntryLogsTable tbody');
		$tb.empty();
		(rows || []).forEach(function (l) {
			$tb.append('<tr><td>' + esc(l.statusTitle) + '</td><td>' + esc(l.createdByName) + '</td><td>' + esc(l.createdOnShamsiDateTime) + '</td><td>' + esc(l.comment) + '</td></tr>');
		});
	}

	function loadParts(id) {
		if (!id) { enexItems = []; renderItems(); return; }
		$$.get('/Panel/Hrm/EnexEntryForm/GetParts?entryFormId=' + id, function (r) {
			const rows = (r && r.isSuccess && r.data) ? r.data : (Array.isArray(r) ? r : (r && r.data) || []);
			enexItems = (rows || []).map(function (x) {
				return {
					id: x.id, htsId: x.htsId || 0, enexPartId: x.enexPartId, partId: x.partId,
					partTitle: x.partTitle || '', mount: x.mount, enterAmount: x.enterAmount,
					isSecurityDisApproved: x.isSecurityDisApproved === true,
					returnShamsiDate: x.returnShamsiDate || '', returnMiladiDate: x.returnMiladiDate || '',
					comment: x.comment || '', fileId: x.fileId, fileName: x.fileName || ''
				};
			});
			renderItems();
		});
	}

	function loadLogs(id) {
		if (!id) { renderLogs([]); return; }
		$$.get('/Panel/Hrm/EnexEntryForm/GetLogs?entryFormId=' + id, function (r) {
			const rows = (r && r.isSuccess && r.data) ? r.data : (Array.isArray(r) ? r : (r && r.data) || []);
			renderLogs(rows);
		});
	}

	function decodeChildPartial(r) {
		if (window.appController && typeof appController.decodePartialResponse === 'function')
			return appController.decodePartialResponse(r);
		return { html: (typeof r === 'string' ? r : ''), scripts: [] };
	}

	function initModalWidgets($body) {
		setTimeout(function () {
			$body.find('.entity-selector-wrapper').each(function () {
				if (!$(this).data('readonly') && typeof $(this).entitySelector === 'function')
					$(this).entitySelector();
			});
			if (typeof initFileUploaders === 'function') initFileUploaders($body);
			if (typeof initPersionDatePicker === 'function') initPersionDatePicker($body);
		}, 100);
	}

	function buildItemFormUrl(item) {
		let url = '/Panel/Hrm/EnexEntryForm/ItemForm?';
		if (!item) return url;
		url += 'id=' + encodeURIComponent(item.id || '') + '&';
		url += 'enexPartId=' + encodeURIComponent(item.enexPartId || '') + '&';
		url += 'partId=' + encodeURIComponent(item.partId || '') + '&';
		url += 'mount=' + encodeURIComponent(item.mount == null ? '' : item.mount) + '&';
		url += 'enterAmount=' + encodeURIComponent(item.enterAmount == null ? '' : item.enterAmount) + '&';
		url += 'isSecurityDisApproved=' + encodeURIComponent(item.isSecurityDisApproved ? 'true' : 'false') + '&';
		url += 'returnShamsiDate=' + encodeURIComponent(item.returnShamsiDate || '') + '&';
		url += 'returnMiladiDate=' + encodeURIComponent(item.returnMiladiDate || '') + '&';
		url += 'comment=' + encodeURIComponent(item.comment || '') + '&';
		url += 'fileId=' + encodeURIComponent(item.fileId || '');
		return url;
	}

	function openItemModal(item) {
		enexEditingIndex = item ? enexItems.indexOf(item) : null;
		const $trigger = $$('[data-action="addItem"]');
		$trigger.block();
		page.getPartialView(buildItemFormUrl(item), function (r) {
			$trigger.block(false);
			if (!r) { toastr.error('خطا در دریافت فرم'); return; }
			const decoded = decodeChildPartial(r);
			const $bodyCn = $('<div style="overflow-x:hidden;overflow-y:auto;max-height:70vh;"></div>').append(decoded.html || '');
			$.confirm({
				title: item ? 'ویرایش قلم' : 'افزودن قلم',
				columnClass: 'col-md-8',
				content: $bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: item ? 'ویرایش' : 'افزودن',
						btnClass: 'btn-primary',
						action: function () {
							const $content = this.$content;
							if (validateError($content)) return false;
							const m = $content.dataBind();
							const hasEnex = m.enexPartId && m.enexPartId !== '0';
							const hasInv = m.partId && m.partId !== '0';
							if (!hasEnex && !hasInv) { toastr.error('قطعه نمی‌تواند خالی باشد'); return false; }
							if (m.enterAmount === '' || m.enterAmount == null || isNaN(Number(m.enterAmount))) {
								toastr.error('مقدار ورود نمی‌تواند خالی باشد'); return false;
							}
							const mount = m.mount === '' || m.mount == null ? 0 : Number(m.mount);
							const enter = Number(m.enterAmount);
							if (mount > 0 && enter > mount) {
								toastr.error('مقدار ورود نمی‌تواند از مقدار خروج بیشتر باشد'); return false;
							}
							const disapproved = m.isSecurityDisApproved === true || m.isSecurityDisApproved === 'true';
							if (!disapproved && !(m.returnShamsiDate || '').trim()) {
								toastr.error('تاریخ بازگشت نمی‌تواند خالی باشد'); return false;
							}
							const row = {
								id: m.id || (item ? item.id : null),
								htsId: item ? (item.htsId || 0) : 0,
								enexPartId: hasEnex ? parseInt(m.enexPartId, 10) : null,
								partId: hasEnex ? null : (hasInv ? parseInt(m.partId, 10) : null),
								partTitle: m.partTitle || (item ? item.partTitle : ''),
								mount: mount,
								enterAmount: enter,
								isSecurityDisApproved: disapproved,
								returnShamsiDate: m.returnShamsiDate || '',
								returnMiladiDate: m.returnMiladiDate || '',
								comment: m.comment || '',
								fileId: m.fileId ? parseInt(m.fileId, 10) : null,
								fileName: ''
							};
							if (item && item.fileId && String(item.fileId) === String(row.fileId))
								row.fileName = item.fileName;
							if (enexEditingIndex != null && enexEditingIndex >= 0)
								enexItems[enexEditingIndex] = row;
							else
								enexItems.push(row);
							renderItems();
							if (row.fileId && !row.fileName) {
								$$.get('/Panel/Hrm/EnexEntryForm/GetFileInfo?id=' + row.fileId, function (fr) {
									const f = (fr && fr.isSuccess) ? fr.data : fr;
									if (f) { row.fileName = f.fileName || ''; renderItems(); }
								});
							}
						}
					},
					cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
				},
				onContentReady: function () { initModalWidgets(this.$body); }
			});
		});
	}

	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;
		const model = page.$pageEl.dataBind();
		if (!(model.importerTitle || '').trim()) { toastr.error('عنوان واردکننده نمی‌تواند خالی باشد', 'خطا'); return; }
		if (enexItems.length < 1) { toastr.error('اقلام نمی‌تواند خالی باشد', 'خطا'); return; }

		model.parts = enexItems.map(function (x) {
			return {
				id: x.id, enexPartId: x.enexPartId, partId: x.partId, mount: x.mount,
				enterAmount: x.enterAmount, isSecurityDisApproved: x.isSecurityDisApproved,
				returnShamsiDate: x.returnShamsiDate || null, returnMiladiDate: x.returnMiladiDate || null,
				comment: x.comment || null, fileId: x.fileId
			};
		});

		const $btn = $($btnAction.element).block();
		$$.post(model.id ? 'update' : 'add', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			if (r.data && r.data.id) {
				loadParts(r.data.id);
				loadLogs(r.data.id);
			}
			$btnAction.baseaction();
		});
	}

	self.FormActionButtons.save.onclick(function () { savefn(this); });
	if (self.FormActionButtons.saveandclose)
		self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });

	page.$pageEl.on('click', '[data-action="addItem"]', function () { openItemModal(null); });
	page.$pageEl.on('click', '[data-action="editItem"]', function () {
		openItemModal(enexItems[parseInt($(this).data('index'), 10)]);
	});
	page.$pageEl.on('click', '[data-action="deleteItem"]', function () {
		const idx = parseInt($(this).data('index'), 10);
		Swal.fire({
			title: 'حذف قلم', text: 'آیا مطمئن هستید؟', icon: 'warning',
			showCancelButton: true, confirmButtonText: 'بله', cancelButtonText: 'خیر'
		}).then(function (result) {
			if (!result.isConfirmed) return;
			enexItems.splice(idx, 1);
			renderItems();
		});
	});

	const entryId = page.$pageEl.dataBind().id;
	loadParts(entryId);
	loadLogs(entryId);
</script>

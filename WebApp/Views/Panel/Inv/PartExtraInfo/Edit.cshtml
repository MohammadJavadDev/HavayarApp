			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		 

		<div class='col-md-3'>
			<label class='required'>مدل</label>
			<input class='form-control' data-bind='model' required asp-for='Model' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 

		<div class='col-md-3'>
			<label class=''>سایز</label>
			<input class='form-control' data-bind='size'  asp-for='Size' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	 

		<div class='col-md-3'>
			<label class=''>Power KW</label>
			<input class='form-control' data-bind='powerKw'  asp-for='PowerKw' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>
 

		<div class='col-md-3'>
			<label class=''>Motor RPM</label>

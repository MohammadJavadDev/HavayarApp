@*
  Page title header included in each soft-nav content view so PartialView responses stay complete.
*@
@{
    var title = ViewData["Title"] as string ?? "";
    var icon = ViewData["Icon"] as string ?? "cog";
    var description = ViewData["Description"] as string;
}
<div class="page-header" data-page-title="@title">
    <h1>
        <i class="fas fa-@icon me-3"></i>
        @title
    </h1>
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <p>@description</p>
    }
</div>

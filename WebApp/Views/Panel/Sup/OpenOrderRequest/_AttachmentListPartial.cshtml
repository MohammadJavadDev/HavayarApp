@using WebApp.ViewModels.Sup
@model List<OpenOrderRequestAttachmentListItemVm>

<div class="row">
	<div class="col-md-12">
		@if (Model != null && Model.Any())
		{
			<div class="table-responsive">
				<table class="table table-striped table-bordered table-hover">
					<thead>
						<tr>
							<th>عملیات</th>
							<th>نوع فایل</th>
							<th>نام فایل</th>
							<th>حجم</th>
							<th>توضیحات</th>
							<th>کاربر ثبت</th>
							<th>تاریخ ثبت</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var attachment in Model)
						{
							<tr class="@(attachment.IsFromVpis ? "table-light" : "")">
								<td>
									@if (attachment.DownloadFileId.HasValue && attachment.DownloadFileId.Value > 0)
									{
										<a href="/File/download/@attachment.DownloadFileId"
											class="btn btn-sm btn-primary">
											<i class="fa fa-download"></i>
										</a>
									}
									@if (attachment.IsFromVpis)
									{
										<span class="badge badge-light-info ms-1" title="مدرک لینک‌شده از VPIS — حذف از این بخش مجاز نیست">
											<i class="fa fa-link"></i> VPIS
										</span>
									}
									else if (attachment.CanDelete)
									{
										<button type="button" class="btn btn-sm btn-danger btn-delete-attachment"
											data-attachment-id="@attachment.Id">
											<i class="fa fa-trash"></i>
										</button>
									}
								</td>
								<td>@(attachment.FileTypeDisplay ?? "-")</td>
								<td>@(attachment.FileName ?? "-")</td>
								<td>@(attachment.SizeDisplay ?? "-")</td>
								<td>@attachment.Comment</td>
								<td>
									<i class="fa fa-user"></i> @(attachment.CreatedByName ?? "-")
								</td>
								<td style="direction: ltr; text-align: right;">@(attachment.CreatedOnShamsiDateTime ?? "-")</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		else
		{
			<div class="alert alert-info">
				<i class="fa fa-info-circle"></i> هیچ پیوستی ثبت نشده است
			</div>
		}
	</div>
</div>

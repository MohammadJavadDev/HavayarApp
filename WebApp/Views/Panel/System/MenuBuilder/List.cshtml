 
@using Data.Contracts
@using Entities.Base.Menu
 
@inject IUnitOfWork _unitOfWork;
@{
 var list =	_unitOfWork.Repository<SystemMenu>().TableNoTracking.ToArray();
}


 <table class="table table-bordered">
	 <thead>
		 <tr>
			 <th>نام</th>
			 <th>عنوان</th>
			<th>#</th>
		 </tr>
	 </thead>
	<thead>
		@foreach(var l in list)
		{
			<tr>
				<td>
					@l.Name
				</td>
				<td>
					@l.Title
				</td>
				<td>
					<a href="/system/menubuilder/edit?id=@l.Id">ویرایش</a>
				</td>
			</tr>
		}
		
	</thead>
 </table>
@using Common.Utilities
@using Services.Job
@model IEnumerable<JobLog>
@{
    ViewData["Title"] = ViewData["Title"] ?? "جزئیات لاگ";
    ViewData["Icon"] = ViewData["Icon"] ?? "file-alt";
    var jobHistory = ViewBag.JobHistory as Entities.Base.Job.JobHistory;
    var isRunning = jobHistory != null && !jobHistory.EndTime.HasValue;
}

@await Html.PartialAsync("_PageHeader")

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4">نام جاب</dt>
                    <dd class="col-sm-8">@(jobHistory?.JobSchedule?.JobDefinition?.DisplayName ?? "نامشخص")</dd>
                    <dt class="col-sm-4">Schedule ID</dt>
                    <dd class="col-sm-8">@jobHistory?.ScheduleId</dd>
                    <dt class="col-sm-4">History ID</dt>
                    <dd class="col-sm-8">@jobHistory?.Id</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row mb-0">
                    <dt class="col-sm-4">شروع</dt>
                    <dd class="col-sm-8" dir="ltr">@jobHistory?.StartTime.ToShamsiDateTime()</dd>
                    <dt class="col-sm-4">پایان</dt>
                    <dd class="col-sm-8" dir="ltr" id="history-end-time">@(jobHistory?.EndTime.HasValue == true ? jobHistory.EndTime.Value.ToShamsiDateTime() : "—")</dd>
                    <dt class="col-sm-4">مدت</dt>
                    <dd class="col-sm-8" dir="ltr">
                        @if (jobHistory?.EndTime.HasValue == true)
                        {
                            @((jobHistory.EndTime.Value - jobHistory.StartTime).TotalSeconds.ToString("0.00")) <span>ثانیه</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark status-running" id="history-running-badge"><span class="status-pulse"></span>در حال اجرا</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
        <div class="row mt-3">
            <div class="col-md-12">
                <dl class="row mb-0">
                    <dt class="col-sm-2">وضعیت</dt>
                    <dd class="col-sm-10" id="history-status">
                        @if (isRunning)
                        {
                            <span class="badge bg-warning text-dark">Running</span>
                        }
                        else if (jobHistory?.IsSuccess == true)
                        {
                            <span class="badge bg-success">موفق</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">ناموفق</span>
                        }
                    </dd>
                    @if (!string.IsNullOrEmpty(jobHistory?.ErrorMessage))
                    {
                        <dt class="col-sm-2">پیام خطا</dt>
                        <dd class="col-sm-10 text-danger">@jobHistory.ErrorMessage</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0">لاگ‌های جزئی</h5>
        <div class="d-flex gap-2 align-items-center">
            <select id="logLevelFilter" class="form-select form-select-sm" style="width:auto;">
                <option value="all">همه سطوح</option>
                <option value="info">Info</option>
                <option value="warning">Warning</option>
                <option value="error">Error</option>
                <option value="debug">Debug</option>
            </select>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnToggleFollow">توقف اسکرول</button>
            @if (isRunning)
            {
                <span class="badge bg-warning text-dark status-running"><span class="status-pulse"></span> زنده</span>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <div id="liveLogStream" class="live-log-stream" data-history-id="@jobHistory?.Id" data-follow="true">
            @if (Model.Any())
            {
                @foreach (var log in Model)
                {
                    var level = (log.LogLevel ?? "Info").ToLowerInvariant();
                    <div class="log-line log-level-@level" data-level="@level">
                        <span class="log-time" dir="ltr">@log.Timestamp.ToShamsiDateTime()</span>
                        <span class="log-level">[@log.LogLevel]</span>
                        <span class="log-msg">@log.Message</span>
                        @if (!string.IsNullOrEmpty(log.Details))
                        {
                            <pre class="log-details">@log.Details</pre>
                        }
                        @if (!string.IsNullOrEmpty(log.ExceptionType) || !string.IsNullOrEmpty(log.StackTrace))
                        {
                            <pre class="log-exception">@log.ExceptionType
@log.StackTrace</pre>
                        }
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4 empty-logs">
                    <i class="fas fa-info-circle fa-2x mb-2"></i>
                    <p class="mb-0">لاگ جزئی برای این اجرا ثبت نشده است.</p>
                </div>
            }
        </div>
    </div>
    <div class="card-footer">
        <a href="@Url.Action("Index", "JobLogs", new { scheduleId = jobHistory?.ScheduleId })" class="btn btn-secondary js-soft-nav">
            <i class="fas fa-arrow-right me-1"></i> بازگشت به تاریخچه
        </a>
    </div>
</div>

@using Entities.App.Gnr
@using Entities.App.Hrm
@using Entities.App.SLS
@using Entities.App.Sale;
@using Entities.App.Sale.Enums
@model RequirmentAdvertise
<div class="card">
	<div class="form-action-buttons"><form-action-buttons entity-type="typeof(RequirmentAdvertise)"></form-action-buttons></div>
</div>
<div class="card">
	<div class="card-body row">
		<div class="col-12 mb-4">
			<h3 class="fw-bold text-dark">اطلاعات اصلی</h3>
		</div>
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class='col-md-3'>
			<label class=''>شماره درخواست</label>
			<input class='form-control'  data-bind='requestNumber'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='RequestNumber' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3 align-content-center'>
			<div class="form-check">
				<input data-bind='budget' class="form-check-input" type="checkbox" asp-for='Budget' />
				<label class="form-check-label" asp-for='Budget'>
					باجت
				</label>
			</div>
		</div>

		<div class="col-md-3">
			<label class=''>واحد سازمانی</label>
			@(Html.EntitySelector<OrgUnit>(
				"OrganizationUnitSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Title = c.Title
				},
				c => new { c.Title },
				"{Title}",
				"OrganizationUnitId",
				"OrganizationUnitName",
				Model?.OrganizationUnitId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-3">
			<label class=''>کارشناس فروش</label>
			@(Html.EntitySelector<Party>(
				"SalesExpertSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, FullName = c.FullName
				},
				c => new { c.FullName },
				"{FullName}",
				"SalesExpertId",
				"SalesExpertName",
				Model?.SalesExpertId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>سرپرست فروش</label>
			@(Html.EntitySelector<Party>(
				"SalesSupervisorSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, FullName = c.FullName
				},
				c => new { c.FullName },
				"{FullName}",
				"SalesSupervisorId",
				"SalesSupervisorName",
				Model?.SalesSupervisorId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-3">
			<label class=''>شخص/شرکت</label>
			@(Html.EntitySelector<Party>(
				"PersonOrCompanySelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, FullName = c.FullName
				},
				c => new { c.FullName },
				"{FullName}",
				"PersonOrCompanyId",
				"PersonOrCompanyName",
				Model?.PersonOrCompanyId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>زیر صنعت</label>
			@(Html.EntitySelector<PartyIndustry>(
				"SubIndustrySelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Title = c.Title
				},
				c => new { c.Title },
				"{Title}",
				"SubIndustryId",
				"SubIndustryName",
				Model?.SubIndustryId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-3">
			<label class=''>نمایندگی فروش</label>
			@(Html.EntitySelector<Customer>(
				"SalesRepresentativeSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Code = c.Code, Party_FullName = c.Party.FullName
				},
				c => new { c.Code, c.Party },
				"{Code} {Party.FullName}",
				"SalesRepresentativeId",
				"SalesRepresentativeName",
				Model?.SalesRepresentativeId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-3">
			<label class=''>کارشناس معرف</label>
			@(Html.EntitySelector<Party>(
				"ReferrerExpertSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, FullName = c.FullName
				},
				c => new { c.FullName },
				"{FullName}",
				"ReferrerExpertId",
				"ReferrerExpertName",
				Model?.ReferrerExpertId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>نوع استعلام</label>
			<select class='form-control' data-bind='inquiryType'  asp-for='InquiryType' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.RequirementAdvertiseInquiryTypeEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>نام و سمت نماینده مشتری</label>
			<input class='form-control' data-bind='representativeDetails'  asp-for='RepresentativeDetails' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>کشور محل نصب</label>
			@(Html.EntitySelector<Region>(
				"CountryOfInstallationSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Name = c.Name
				},
				c => new { c.Name },
				"{Name}",
				"CountryOfInstallationId",
				"CountryOfInstallationName",
				Model?.CountryOfInstallationId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>استان محل نصب</label>
			@(Html.EntitySelector<Region>(
				"InstallationProvinceSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Name = c.Name
				},
				c => new { c.Name },
				"{Name}",
				"InstallationProvinceId",
				"InstallationProvinceName",
				Model?.InstallationProvinceId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>شهر محل نصب</label>
			@(Html.EntitySelector<Region>(
				"InstallationCitySelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Name = c.Name
				},
				c => new { c.Name },
				"{Name}",
				"InstallationCityId",
				"InstallationCityName",
				Model?.InstallationCityId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>شماره تماس نماینده مشتری</label>
			<input class='form-control' data-bind='representativeContactNumber'  asp-for='RepresentativeContactNumber' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-12'>
			<label class=''>توضیحات</label>
			<input class='form-control' data-bind='description'  asp-for='Description' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	</div>
</div>

<div class="card">
	<div class="card-body row">
		<div class="col-12 mb-4">
			<h3 class="fw-bold text-dark">اطلاعات تکمیلی</h3>
		</div>
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class='col-md-3'>
			<label class=''>مبلغ پیش فاکتور(ریال)</label>
			<input class='form-control'  data-bind='preInvoiceAmountRial'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='PreInvoiceAmountRial' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>مبلغ پیش فاکتور(ارزی)</label>
			<input class='form-control'  data-bind='preInvoiceAmount'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='PreInvoiceAmount' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>نوع ارز</label>
			<input class='form-control' data-bind='currencyType'  asp-for='CurrencyType' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>تاریخ پیش فاکتور</label>
			<input class='form-control'  data-bind='preInvoiceMiladiDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true}' value='@Model?.PreInvoiceMiladiDate' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>تاریخ پیش فاکتور شمسی</label>
			<input class='form-control'  data-bind='preInvoiceShamsiDate' data-persionDatePicker="true" persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": true}' value='@Model?.PreInvoiceShamsiDate' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-3'>
			<label class=''>اولویت</label>
			<select class='form-control' data-bind='priority'  asp-for='Priority' asp-items="Html.GetEnumSelectList(typeof(Entities.App.Sale.Enums.RequirementAdvertisePriorityEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>ارزش مالی پروژه</label>
			<select class='form-control' data-bind='projectFinancialValue'  asp-for='ProjectFinancialValue' asp-items="Html.GetEnumSelectList(typeof(RequirmentAdvertiseProjectFinancialValueEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>کاربر نهایی</label>
			<input class='form-control' data-bind='endUser'  asp-for='EndUser' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6 align-content-center'>
			<div class="form-check">
				<input data-bind='metric' class="form-check-input" type="checkbox" asp-for='Metric' />
				<label class="form-check-label" asp-for='Metric'>
					متریک
				</label>
			</div>
		</div>

	</div>
</div>

<div class="card">
	<div class="card-body row">
		<div class="col-12 mb-4">
			<h3 class="fw-bold text-dark">محصولات</h3>
		</div>
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class='col-md-12'>
			<div data-tab-item-manager="requirmentAdvertiseItems" data-item-selector=".entity-item">
				<ul class="nav nav-tabs nav-line-tabs nav-line-tabs-2x border-transparent fs-4 fw-bold mb-5" role="tablist">
					<li class="nav-item" role="presentation">
						<a class="nav-link active" data-bs-toggle="tab" href="#itemsTab" role="tab" aria-selected="true">
							<span class="svg-icon svg-icon-2 me-2"></span>
							اقلام
						</a>
					</li>
				</ul>
				<div class="tab-content">
					<div class="tab-pane fade show active" id="itemsTab" role="tabpanel" data-add-url="/Panel/RequirmentAdvertise/RequirmentAdvertiseItemPartial">
						<div id='ItemsContainer' class="entity-item-container">
							@if (Model?.Items != null)
							{
								@foreach (var item in Model.Items)
								{
									<div data-item-id="@(item.Id ?? 0)">
										@await Html.PartialAsync("_RequirmentAdvertiseItemPartial.cshtml", item)
									</div>
								}
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="card">
	 
	<div class='card-body row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) { return; }
		var model = page.$pageEl.dataBind();
		const $btn = $(this.element).block();
		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				page.$pageEl.dataBind(r.data);
				$btnAction.baseaction();
			})
	}

	self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
</script>

@using Entities.App.Gnr
@using Entities.App.SLS;
@model Customer
<div class="card">
	<div class="form-action-buttons">
		<form-action-buttons entity-type="typeof(Customer)"></form-action-buttons>
		</div>
	</div>
<div class="card">
	<div class="card-body row">
		<div class="col-12 mb-4">
			<h3 class="fw-bold text-dark">اطلاعات اصلی</h3>
		</div>
		<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
		<div class='col-md-6'>
			<label class=''>کد</label>
			<input class='form-control'  data-bind='code'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='Code' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class='required'>مشتری</label>
			@(Html.EntitySelector<Party>(
				"PartySelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, FullName = c.FullName
				},
				c => new { c.FullName },
				"{FullName}",
				"PartyId",
				"PartyName",
				Model?.PartyId.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>نوع</label>
			<select class='form-control' data-bind='type'  asp-for='Type' asp-items="Html.GetEnumSelectList(typeof(Entities.App.SLS.Enums.CustomerTypeEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>نوع سازمان</label>
			<select class='form-control' data-bind='organizationType'  asp-for='OrganizationType' asp-items="Html.GetEnumSelectList(typeof(Entities.App.SLS.Enums.CustomerOrganizationTypeEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>صنعت</label>
			@(Html.EntitySelector<PartyIndustry>(
				"IndustrySelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Title = c.Title
				},
				c => new { c.Title },
				"{Title}",
				"IndustryId",
				"IndustryName",
				Model?.IndustryId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>استان</label>
			@(Html.EntitySelector<Region>(
				"ProvinceSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Name = c.Name
				},
				c => new { c.Name },
				"{Name}",
				"ProvinceId",
				"ProvinceName",
				Model?.ProvinceId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>شهر</label>
			@(Html.EntitySelector<Region>(
				"CitySelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Name = c.Name
				},
				c => new { c.Name },
				"{Name}",
				"CityId",
				"CityName",
				Model?.CityId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>منطقه</label>
			@(Html.EntitySelector<Region>(
				"AreaSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, Name = c.Name
				},
				c => new { c.Name },
				"{Name}",
				"AreaId",
				"AreaName",
				Model?.AreaId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>شهرک صنعتی</label>
			<input class='form-control' data-bind='industrialTown'  asp-for='IndustrialTown' />
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class="col-md-6">
			<label class=''>رابطه هوایاری</label>
			@(Html.EntitySelector<Party>(
				"AirRelationSelector",
				c => c.IsActive == Entities.Base.IsActiveEnum.Active,
				c => new
				{
					Id = c.Id, FullName = c.FullName
				},
				c => new { c.FullName },
				"{FullName}",
				"AirRelationId",
				"AirRelationName",
				Model?.AirRelationId?.ToString()
			))
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

		<div class='col-md-6'>
			<label class=''>وضعیت کارخانه</label>
			<select class='form-control' data-bind='factoryStatus'  asp-for='FactoryStatus' asp-items="Html.GetEnumSelectList(typeof(Entities.App.SLS.Enums.CustomerFactoryStatusEnum))">
			</select>
			<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
		</div>

	</div>
</div>

<div class="card">
	<div class='card-body row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) { return; }
		var model = page.$pageEl.dataBind();
		const $btn = $(this.element).block();
		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				page.$pageEl.dataBind(r.data);
				$btnAction.baseaction();
			})
	}

	self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })
</script>

@using Common.Attributes
@using Common.Utilities
@using Entities.Base.ImportDefinitions
@using WebFramework.ViewModels.ImportDefinitionsViewModels
@model  ImportDefinitionViewModel
@{
     var def = Model?.Definition ?? new();
     bool isEdit = def.Id > 0;
     var columns = def.Columns.JsonDeserialize<ImportDefinitionColumn[]>();
     ViewData["Title"] = isEdit ? "ویرایش تعریف" : "تعریف جدید ورود اطلاعات";
     var importType = def.ImportType;
     var isApi = importType == ImportSourceType.Api;

     var queryString = def.SqlQuery ?? @"INSERT INTO [Schema].[Table] (CreatedById , ModifiedById , CreatedByName, ModifiedByName,ModifiedDateMiladiDateTime,ModifiedDateShamsiDateTime,CreatedOnMiladiDateTime,CreatedOnShamsiDateTime,IsActive) VALUES (@CurrentUserId, @CurrentUserId,@CurrentUserName,@CurrentUserName ,@CurrentDateTimeMiladi ,@CurrentDateTimeShamsi,@CurrentDateTimeMiladi ,@CurrentDateTimeShamsi, 1 )";
}

<style>
     .select2-container {
          z-index: 999999999 !important
     }
     .import-type-toggle .btn {
          min-width: 110px;
     }
</style>


<div class="container-fluid py-4" dir="rtl">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="fas fa-arrow-right"></i>
        </a>
        <div>
            <h4 class="fw-bold mb-0">@ViewData["Title"]</h4>
            <small class="text-muted">تعریف الگوی ورود اطلاعات از اکسل</small>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div><i class="fas fa-exclamation-circle me-1"></i>@err.ErrorMessage</div>
            }
        </div>
    }

    <div id="frmDefinition">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Definition.Id" data-bind="id" />
        <input type="hidden" id="importTypeInput" data-bind="importType" value="@((int)importType)" />

        <div class="row g-4">
 
            <div class="col-lg-12">
                <div class="card shadow-sm h-100">
                         <div class="card-header bg-primary text-white p-5 d-flex justify-content-between align-items-center">
                              <span><i class="fas fa-info-circle me-2 text-white"></i>اطلاعات پایه</span>
                              <button type="button" class="btn btn-sm btn-light sql-only-section @(isApi ? "d-none" : "")" id="btnLoadFromEntity">
                                   <i class="fas fa-database me-1"></i>بارگذاری از موجودیت سیستم
                              </button>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <label class="form-label fw-semibold">نوع ورود اطلاعات <span class="text-danger">*</span></label>
                            <div class="btn-group import-type-toggle" role="group">
                                <input type="radio" class="btn-check" name="importTypeRadio" id="importTypeSql" value="0" @(isApi ? "" : "checked")>
                                <label class="btn btn-outline-primary" for="importTypeSql">
                                    <i class="fas fa-database me-1"></i>SQL
                                </label>
                                <input type="radio" class="btn-check" name="importTypeRadio" id="importTypeApi" value="1" @(isApi ? "checked" : "")>
                                <label class="btn btn-outline-primary" for="importTypeApi">
                                    <i class="fas fa-plug me-1"></i>API
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">نام موجودیت <span class="text-danger">*</span></label>
                            <input asp-for="Definition.FullNameEntity"
                                          data-bind="fullNameEntity"
                                   class="form-control font-monospace"
                                   placeholder="مثال: StudentImport"
                                   dir="ltr" />
                            <div class="form-text">نام یکتا برای این ورود اطلاعات (بدون فاصله)</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">عنوان نمایشی <span class="text-danger">*</span></label>
                                   <input asp-for="Definition.Title" class="form-control" data-bind="title"
                                   placeholder="مثال: ورود اطلاعات دانشجویان" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">توضیحات</label>
                            <textarea asp-for="Definition.Description" class="form-control" rows="3"
                                             data-bind="description"
                                      placeholder="توضیح مختصر..."></textarea>
                        </div>

                        <div class="sql-only-section @(isApi ? "d-none" : "")">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    کوئری SQL <span class="text-danger">*</span>
                                    <button type="button" class="btn btn-sm btn-outline-info ms-2"
                                            data-bs-toggle="modal" data-bs-target="#sqlHelpModal">
                                        <i class="fas fa-question-circle"></i> راهنما
                                    </button>
                                </label>
                                <div  id="sqlQuery"   style="height:300px"   >
                                       
                                     </div>
                                       <input type="hidden" id="sqlQueryInput" data-bind="sqlQuery" />
                                <div class="form-text">
                                    پارامترهای SQL: <span id="detectedParams" class="text-primary fw-bold"></span>
                                </div>
                            </div>
                        </div>

                        <div class="api-only-section @(isApi ? "" : "d-none")">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">منبع API</label>
                                <div class="btn-group" role="group">
                                    @{
                                        var apiInternalChecked = !isEdit || !isApi || def.ApiIsInternal;
                                    }
                                    <input type="radio" class="btn-check" name="apiSourceRadio" id="apiSourceInternal" value="1" @(apiInternalChecked ? "checked" : "")>
                                    <label class="btn btn-outline-secondary" for="apiSourceInternal">داخلی (سیستم)</label>
                                    <input type="radio" class="btn-check" name="apiSourceRadio" id="apiSourceExternal" value="0" @(!apiInternalChecked ? "checked" : "")>
                                    <label class="btn btn-outline-secondary" for="apiSourceExternal">خارجی</label>
                                </div>
                                <input type="hidden" id="apiIsInternalInput" data-bind="apiIsInternal" value="@(def.ApiIsInternal ? "true" : "false")" />
                            </div>

                            <div class="mb-3 api-internal-section">
                                <label class="form-label fw-semibold">انتخاب API سیستم</label>
                                <select id="selInternalApi" class="form-select" style="width:100%">
                                    <option value="">در حال بارگذاری...</option>
                                </select>
                                <div class="form-text">با انتخاب API، آدرس، متد و ستون‌های ورودی به‌صورت خودکار پر می‌شوند.</div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">آدرس API <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control font-monospace" dir="ltr"
                                           id="apiUrlInput" data-bind="apiUrl"
                                           value="@def.ApiUrl"
                                           placeholder="/panel/..." />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">متد HTTP</label>
                                    @{
                                        var method = string.IsNullOrWhiteSpace(def.ApiHttpMethod) ? "POST" : def.ApiHttpMethod.ToUpperInvariant();
                                    }
                                    <select class="form-select" id="apiHttpMethodInput" data-bind="apiHttpMethod">
                                        @if (method == "POST")
                                        {
                                            <option value="POST" selected>POST</option>
                                        }
                                        else
                                        {
                                            <option value="POST">POST</option>
                                        }
                                        @if (method == "PUT")
                                        {
                                            <option value="PUT" selected>PUT</option>
                                        }
                                        else
                                        {
                                            <option value="PUT">PUT</option>
                                        }
                                        @if (method == "PATCH")
                                        {
                                            <option value="PATCH" selected>PATCH</option>
                                        }
                                        else
                                        {
                                            <option value="PATCH">PATCH</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="mt-3 mb-0">
                                <label class="form-label fw-semibold">حالت فراخوانی</label>
                                @{
                                    var callMode = def.ApiCallMode ?? ApiCallMode.PerRow;
                                }
                                <div class="btn-group d-block" role="group">
                                    <input type="radio" class="btn-check" name="apiCallModeRadio" id="apiCallModePerRow" value="0" @(callMode == ApiCallMode.PerRow ? "checked" : "")>
                                    <label class="btn btn-outline-info" for="apiCallModePerRow">ردیفی (یک درخواست به‌ازای هر ردیف)</label>
                                    <input type="radio" class="btn-check" name="apiCallModeRadio" id="apiCallModeBatch" value="1" @(callMode == ApiCallMode.Batch ? "checked" : "")>
                                    <label class="btn btn-outline-info" for="apiCallModeBatch">دسته‌ای (یک درخواست با آرایه همه ردیف‌ها)</label>
                                </div>
                                <input type="hidden" id="apiCallModeInput" data-bind="apiCallMode" value="@((int)callMode)" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

 
            <div class="col-lg-12">
                <div class="card shadow-sm">
                         <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-columns me-2"></i>ستون‌های ورود اطلاعات</span>
                        <div>
                            <button type="button" id="btnAddFromSql" class="btn btn-sm btn-light me-2 sql-only-section @(isApi ? "d-none" : "")">
                                <i class="fas fa-magic me-1"></i>افزودن از SQL
                            </button>
                            <button type="button" id="btnAddCol" class="btn btn-sm btn-warning">
                                <i class="fas fa-plus me-1"></i>افزودن ستون
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0" id="colTable">
                                <thead class="table-light">
                                    <tr>
                                        <th width="30"></th>
                                        <th id="colNameHeader">@(isApi ? "نام فیلد JSON" : "نام پارامتر SQL")</th>
                                        <th>عنوان در اکسل</th>
                                        <th>نوع</th>
                                        <th class="text-center">سیستمی</th>
                                        <th class="text-center">الزامی</th>
                                        <th width="40"></th>
                                    </tr>
                                </thead>
                                <tbody id="colBody" class="sortable-body">
                                             @if (columns != null && columns.Any())
                                    {
                                                  @foreach (var col in columns.OrderBy(c => c.SortOrder))
                                        {
                                            <tr>
                                                            <td><i class="fas fa-pen-to-square text-warning drag-handle" style="cursor:pointer" data-action='moreSetting'></i></td>
                                                <td>
                                                                 <input type="text" data-bind="columns.columnName"
                                                           value="@col.ColumnName"
                                                           class="form-control form-control-sm font-monospace"
                                                           dir="ltr" placeholder="ParamName" />
                                                </td>
                                                <td>
                                                                 <input type="text" data-bind="columns.displayName"
                                                           value="@col.DisplayName"
                                                           class="form-control form-control-sm"
                                                           placeholder="عنوان اکسل" />
                                                </td>
                                                <td>
                                                                 <select data-bind="columns.dataType" class="form-select form-select-sm col-type-select">
                                                                      @foreach (var dt in EnumExtensions.GetEnumValuesWithDisplayNames<SystemType>())
                                                        {
                                                            <option value="@dt.Value" selected="@(col.DataType == (SystemType)dt.Value)">@dt.Text</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td class="text-center">
                                                                 <input type="checkbox" data-bind="columns.isSystemVariable"
                                                           class="form-check-input sys-var-check"
                                                           value="true" @(col.IsSystemVariable ? "checked" : "") />
                                                                 <input type="hidden" data-bind="columns.optionSettings" value="@(col.OptionSettings.JsonSerialize())" />
                                                                 <select data-bind="columns.systemVariable"
                                                            class="form-select form-select-sm sys-var-select mt-1 @(!col.IsSystemVariable ? "d-none" : "")">
                                                        <option value="">انتخاب...</option>
                                                        @foreach (var sv in  SystemVariables.GetAll())
                                                        {
                                                            <option value="@sv.Key" selected="@(col.SystemVariable == sv.Key)">@sv.Value</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td class="text-center">
                                                                 <input type="checkbox" data-bind="columns.isRequired"
                                                           class="form-check-input"
                                                           value="true" @(col.IsRequired ? "checked" : "") />
                                                    <input type="hidden" name="ColIsRequired" value="false" />
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-remove-col">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                              <div id="noColsMsg" class='text-center py-4 text-muted @(columns != null && columns.Any() ? "d-none" : "")'>
                            <i class="fas fa-table fa-2x mb-2 d-block"></i>
                            <span id="noColsMsgText">ستونی تعریف نشده. از دکمه «افزودن ستون» یا «افزودن از SQL» استفاده کنید.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">انصراف</a>
            <button   class="btn btn-primary px-5" id="save">
                <i class="fas fa-save me-2"></i>ذخیره تعریف
            </button>
        </div>
    </div>
</div>

 
<div class="modal fade" id="loadEntityModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">انتخاب موجودیت سیستم</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">با انتخاب موجودیت، کوئری INSERT و ستون‌های ورود اطلاعات به‌صورت خودکار ساخته می‌شوند.</p>
                <label class="form-label fw-semibold">موجودیت</label>
                <select class="form-select" id="entitySelector">
                    <option value="">در حال بارگذاری...</option>
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" id="btnConfirmLoadEntity">
                    <i class="fas fa-magic me-1"></i>تولید خودکار
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="sqlHelpModal" tabindex="-1" dir="rtl">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">راهنمای نوشتن کوئری SQL</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>برای هر ستون اکسل یا متغیر سیستمی، از پارامتر با پیشوند <code>@@</code> استفاده کنید:</p>
                <pre class="bg-dark text-success p-3 rounded" dir="ltr">INSERT INTO Students (FirstName, LastName, BirthDate, CreatedBy, CreatedAt)
                         VALUES (@@FirstName, @@LastName, @@BirthDate, @@CurrentUserId, @@CurrentDateTimeMiladi)</pre>
                <div class="alert alert-info mt-3">
                    <strong>متغیرهای سیستمی:</strong>
                    <ul class="mb-0 mt-1">
                       <li><code>@@CurrentUserId</code> - شناسه کاربر لاگین‌شده</li>
                        <li><code>@@CurrentUserName</code> - نام کاربر لاگین‌شده</li>
                              <li><code>@@CurrentDateMiladi</code> -  تاریخ جاری میلادی</li>
                              <li><code>@@CurrentDateTimeMiladi</code> - تاریخ و ساعت جاری میلادی</li>
                              <li><code>@@CurrentDateShamsi</code> -  تاریخ جاری شمسی</li>
                              <li><code>@@CurrentDateTimeShamsi</code> - تاریخ و ساعت جاری شمسی</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/panellib/plugins/custom/editor-anc/ace.js"></script>

<script src="~/panellib/plugins/custom/editor-anc/ext-beautify.js"></script>
 
<script>



     var  sqlEditor = null;
     var availableApis = [];
     var currentImportType = @(isApi ? 1 : 0);

          function initSqlEditor(query = ""){
            
                var $sqlQuery  = $$("#sqlQuery");
               if (!$sqlQuery.length) return;
               sqlEditor = ace.edit($sqlQuery[0]);
               sqlEditor.setTheme('ace/theme/chrome');
                sqlEditor.session.setMode('ace/mode/sqlserver');

         
               sqlEditor.setValue(query);

 
               sqlEditor.getSession().on('change', (e) => {
                    const value = sqlEditor.getValue()

                    $$("#sqlQueryInput").val(value)
                    detectParams(value);
               })
                  detectParams(query);
                 $$("#sqlQueryInput").val(query)
          }

          initSqlEditor(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(queryString)));

     function applyImportTypeUi(type) {
          currentImportType = parseInt(type, 10) || 0;
          $$('#importTypeInput').val(currentImportType);
          const isApiMode = currentImportType === 1;

          if (isApiMode) {
               $$('.sql-only-section').addClass('d-none');
               $$('.api-only-section').removeClass('d-none');
               $$('#colNameHeader').text('نام فیلد JSON');
               $$('#noColsMsgText').text('ستونی تعریف نشده. API داخلی را انتخاب کنید یا ستون را دستی اضافه کنید.');
          } else {
               $$('.sql-only-section').removeClass('d-none');
               $$('.api-only-section').addClass('d-none');
               $$('#colNameHeader').text('نام پارامتر SQL');
               $$('#noColsMsgText').text('ستونی تعریف نشده. از دکمه «افزودن ستون» یا «افزودن از SQL» استفاده کنید.');
          }
          applyApiSourceUi();
     }

     function applyApiSourceUi() {
          const isInternal = $$('#apiSourceInternal').is(':checked');
          $$('#apiIsInternalInput').val(isInternal ? 'true' : 'false');
          if (isInternal) {
               $$('.api-internal-section').removeClass('d-none');
               $$('#apiUrlInput').attr('placeholder', '/panel/...');
          } else {
               $$('.api-internal-section').addClass('d-none');
               $$('#apiUrlInput').attr('placeholder', 'https://example.com/api/...');
          }
     }

     $$('input[name="importTypeRadio"]').on('change', function () {
          applyImportTypeUi($(this).val());
     });

     $$('input[name="apiSourceRadio"]').on('change', function () {
          applyApiSourceUi();
     });

     $$('input[name="apiCallModeRadio"]').on('change', function () {
          $$('#apiCallModeInput').val($(this).val());
     });

     applyImportTypeUi(currentImportType);
     // اصلاح حالت پیش‌فرض منبع API برای رکورد جدید از نوع API
     if (currentImportType === 1 && !$$('#apiSourceExternal').is(':checked') && !$$('#apiSourceInternal').is(':checked')) {
          $$('#apiSourceInternal').prop('checked', true);
     }
     applyApiSourceUi();

     async function loadAvailableApis() {
          try {
               const response = await $.get('/panel/importDefinition/getAvailableApis');
               const $sel = $$('#selInternalApi');
               $sel.empty().append('<option value="">انتخاب کنید...</option>');

               if (!response.isSuccess || !response.data) {
                    error2('خطا در بارگذاری لیست APIها');
                    return;
               }

               availableApis = response.data;
               availableApis.forEach((api, idx) => {
                    $sel.append(
                         $('<option></option>')
                              .val(idx)
                              .attr('data-controller', api.controller)
                              .attr('data-action', api.action)
                              .attr('data-path', api.path)
                              .attr('data-method', api.httpMethod)
                              .text(api.label)
                    );
               });

               $sel.select2({ width: '100%' });

               // انتخاب خودکار بر اساس ApiUrl ذخیره‌شده
               const currentUrl = ($$('#apiUrlInput').val() || '').toLowerCase();
               if (currentUrl) {
                    const matchIdx = availableApis.findIndex(a => (a.path || '').toLowerCase() === currentUrl);
                    if (matchIdx >= 0) {
                         $sel.val(String(matchIdx)).trigger('change.select2');
                    }
               }
          } catch (e) {
               console.error(e);
               error2('خطا در بارگذاری لیست APIها');
          }
     }

     $$('#selInternalApi').on('change', async function () {
          const idx = $(this).val();
          if (idx === '' || idx == null) return;
          const api = availableApis[parseInt(idx, 10)];
          if (!api) return;

          try {
               const response = await $$.post('/panel/importDefinition/inspectApi', {
                    controller: api.controller,
                    action: api.action,
                    path: api.path
               });

               if (!response.isSuccess) {
                    error2(response.message || 'خطا در بازرسی API');
                    return;
               }

               const data = response.data;
               $$('#apiUrlInput').val(data.apiUrl || api.path);
               $$('#apiHttpMethodInput').val((data.httpMethod || api.httpMethod || 'POST').toUpperCase());

               clearColumnRows();
               (data.columns || []).forEach(col => {
                    addColumnRow(
                         col.columnName,
                         col.displayName,
                         false,
                         '',
                         col.dataType,
                         !!col.isRequired,
                         ''
                    );
               });

               success2('ستون‌های ورودی API بارگذاری شد.');
          } catch (e) {
               console.error(e);
               error2('خطا در بازرسی API');
          }
     });

     loadAvailableApis();

     // ----------------------------------------------------------------
      // تشخیص پارامترها از SQL
      // ----------------------------------------------------------------
      const systemVarNames = ['CurrentUserId', 'CurrentUserName', 'CurrentDateMiladi',  'CurrentDateTimeMiladi' , 'CurrentDateTimeShamsi','CurrentDateShamsi'];

      function detectParams(sql = "") {
          const matches = [...sql.matchAll(/@@(\w+)/g)].map(m => m[1]);
          const unique = [...new Set(matches)];
          $('#detectedParams').text(unique.map(p => '@@' + p).join(', '));
          return unique;
      }
       

      // ----------------------------------------------------------------
      // نمایش/مخفی‌کردن select متغیر سیستمی
      // ----------------------------------------------------------------
      $$().on('change', '.sys-var-check', function () {
          const select = $(this).closest('td').find('.sys-var-select');
          if ($(this).is(':checked')) {
              select.removeClass('d-none');
          } else {
              select.addClass('d-none').val('');
          }
      });

      let systemEnums = [];

       async function loadSystemEnums() {

            if(systemEnums.length > 0)
               return ;
          try {
               const response = await $.get("/System/ListSystemEnums");
               if (response.isSuccess) {
                    systemEnums = response.data || [];
               }
          } catch (error) {
               error2("خطا در بارگذاری enum های سیستم");
               console.error(error);
          }

     }

     async  function LoadSelectTypeOptions(){
           await loadSystemEnums();

           let $tpl =  $(`    <div class="row col-md-12">
                    <div class="col-md-4">
                         <label class="form-label">نوع تبدیل</label>
                         <select class="form-select" data-action="typeOptions">
                              <option value="0">انتخاب کنید</option>
                              <option value="1">تعریف گزینه</option>
                              <option value="2">گزینه موجود</option>
                              <option value="3">گزینه سیستمی</option>
                         </select>
                    </div>

                     <div class="col-md-8 d-none" data-section="existOptions">
                         <label class="form-label" >گزینه های موجود</label>
                         <select class="form-select w-100" data-action="existOptions">

                         </select>
                    </div>
                    <div class="col-md-8 d-none" data-section="systemOptions">
                       <label class="form-label" >گزینه های سیستمی</label>
                         <select class="form-select w-100" data-action="systemOptions">

                         </select> 
                    </div>

                    <div class="col-md-12 d-none mt-3" data-section="defOptions">
                    <button class="btn btn-success" data-action="addnewOptions">افزودن گزینه جدید</button>
                          <table class="table table-rounded table-striped border table-bordered">
                               <thead>
                                    <tr>
                                          <th>
                                         #
                                         </th>
                                         <th>
                                         مقدار
                                         </th>
                                         <th>
                                             عنوان
                                          </th>
                                    </tr>
                               </thead>
                               <tbody>
                               </tbody>
                          </table>
                    </div>

               </div>`)


            systemEnums.forEach((c) => {
                    let $systemEnumOption = $(`<option value="${c.type}">${c.parentEntityTypeName}.${c.name} || ${c.displayName} </option>`)
                    $tpl.find("[data-action='systemOptions']").append($systemEnumOption)
               });

               $tpl.find(`[data-action="typeOptions"]`).change(function(){
                    var type = $(this).val();
                    if(type ==  1)
                    {
                         $tpl.find(`[data-section="defOptions"]`).removeClass("d-none")
                         $tpl.find(`[data-section="systemOptions"]`).addClass("d-none")
                         $tpl.find(`[data-section="existOptions"]`).addClass("d-none")
                    }
                    else if(type ==  2)
                    {
                         $tpl.find(`[data-section="defOptions"]`).addClass("d-none")
                         $tpl.find(`[data-section="systemOptions"]`).addClass("d-none")
                         $tpl.find(`[data-section="existOptions"]`).removeClass("d-none")
                    }
                    else
                    {
                         $tpl.find(`[data-section="defOptions"]`).addClass("d-none")
                         $tpl.find(`[data-section="systemOptions"]`).removeClass("d-none")
                         $tpl.find(`[data-section="existOptions"]`).addClass("d-none")
                    }
               })

                  $tpl.find("[data-action='systemOptions']").select2({
                         width: '100%',
                    });


          
           return $tpl;
      }

      // ----------------------------------------------------------------
      // افزودن ستون جدید (خالی)
      // ----------------------------------------------------------------
      function addColumnRow(colName, displayName, isSysVar, sysVar, dataType, isRequired, optionSettings) {
             
          colName     = colName || '';
          displayName = displayName || '';
          isSysVar    = !!isSysVar;
          sysVar      = sysVar || '';
          dataType    = dataType ?? 0;
          isRequired  = !!isRequired;
          optionSettings = optionSettings || '';

          const sysVarOptions = @Html.Raw(Json.Serialize(
                            ((IEnumerable<KeyValuePair<string, string>>)
                                SystemVariables.GetAll())
                            .Select(sv => new { Value = sv.Key, Text = sv.Value })
                    ));

  

          let sysVarHtml = sysVarOptions.map(o =>
              `<option value="${o.value}" ${o.value === sysVar ? 'selected' : ''}>${o.text}</option>`
          ).join('');

          const row = $(`
          <tr>
              <td><i class="fas fa-pen-to-square text-warning drag-handle" style="cursor:pointer" data-action='moreSetting'></i></td>
              <td><input type="text" data-bind="columns.columnName" value="${colName}"
                         class="form-control form-control-sm font-monospace"
                         dir="ltr" placeholder="ParamName"/></td>
              <td><input type="text" data-bind="columns.displayName" value="${displayName}"
                         class="form-control form-control-sm" placeholder="عنوان اکسل"/></td>
              <td>
                  <select data-bind="columns.dataType" class="form-select form-select-sm col-type-select">
                              @foreach (var dt in EnumExtensions.GetEnumValuesWithDisplayNames<SystemType>())
                              {
                                        <option value="@dt.Value">@dt.Text</option>
                              }
                  </select>
                  <input type="hidden" data-bind="columns.optionSettings" />
                
              </td>
              <td class="text-center">
                  <input type="checkbox" data-bind="columns.isSystemVariable" class="form-check-input sys-var-check"
                         value="true" ${isSysVar ? 'checked' : ''}/>

                  <select data-bind="columns.systemVariable"
                          class="form-select form-select-sm sys-var-select mt-1 ${isSysVar ? '' : 'd-none'}">
                      <option value="">انتخاب...</option>
                      ${sysVarHtml}
                  </select>
              </td>
              <td class="text-center">
                  <input type="checkbox" data-bind="columns.isRequired" class="form-check-input" value="true" ${isRequired ? 'checked' : ''}/>

              </td>
              <td>
                  <button type="button" class="btn btn-sm btn-outline-danger btn-remove-col">
                      <i class="fas fa-times"></i>
                  </button>
              </td>
          </tr>`);

         
        

          row.find('[data-bind="columns.dataType"]').val(dataType);
          row.find('[data-bind="columns.optionSettings"]').val(optionSettings);
          $$('#colBody').append(row);
          $$('#noColsMsg').addClass('d-none');
      }

      function clearColumnRows() {
          $$('#colBody').empty();
          $$('#noColsMsg').removeClass('d-none');
      }

      function applyGeneratedDefinition(data) {
          if (!data) return;

          $$('[data-bind="fullNameEntity"]').val(data.fullNameEntity || '');
          $$('[data-bind="title"]').val(data.title || '');
          $$('[data-bind="description"]').val(data.description || '');

          if (sqlEditor && data.sqlQuery) {
              sqlEditor.setValue(data.sqlQuery);
              $$("#sqlQueryInput").val(data.sqlQuery);
              detectParams(data.sqlQuery);
          }

          clearColumnRows();

          (data.columns || []).forEach(col => {
              const optionSettings = col.optionSettings
                  ? JSON.stringify(col.optionSettings)
                  : '';
              addColumnRow(
                  col.columnName,
                  col.displayName,
                  col.isSystemVariable,
                  col.systemVariable,
                  col.dataType,
                  col.isRequired,
                  optionSettings
              );
          });
      }

      async function loadAvailableEntities() {
          try {
              const response = await $.get('/panel/importDefinition/getAvailableEntities');
              const $selector = $$('#entitySelector');
              $selector.empty().append('<option value="">انتخاب کنید...</option>');

              if (!response.isSuccess || !response.data) {
                  error2('خطا در بارگذاری لیست موجودیت‌ها');
                  return;
              }

              response.data.forEach(entity => {
                  $selector.append(
                      $('<option></option>')
                          .val(entity.fullName)
                          .text(`${entity.displayName} (${entity.name})`)
                  );
              });

              $selector.select2({
                  width: '100%',
                  dropdownParent: $$('#loadEntityModal')
              });
          } catch (error) {
              error2('خطا در بارگذاری لیست موجودیت‌ها');
              console.error(error);
          }
      }

      $$('#btnLoadFromEntity').on('click', function () {
          $$('#loadEntityModal').modal('show');
      });

      $$('#btnConfirmLoadEntity').on('click', async function () {
          const entityFullName = $$('#entitySelector').val();
          if (!entityFullName) {
              toastr.error('لطفاً یک موجودیت انتخاب کنید');
              return;
          }

          const $btn = $$(this);
          $btn.prop('disabled', true);

          try {
              const response = await $$.post('/panel/importDefinition/generateFromEntity', {
                  entityFullName: entityFullName
              });

              if (!response.isSuccess) {
                  error2(response.message || 'خطا در تولید تعریف ورود اطلاعات');
                  return;
              }

              applyGeneratedDefinition(response.data);
              $$('#loadEntityModal').modal('hide');
              success2('تعریف ورود اطلاعات از موجودیت با موفقیت ساخته شد.');
          } catch (error) {
              error2('خطا در تولید تعریف ورود اطلاعات');
              console.error(error);
          } finally {
              $btn.prop('disabled', false);
          }
      });

      loadAvailableEntities();

      $$().on("click","[data-action='moreSetting']", async function(e){
             e.preventDefault();
              
             var selectOptions = await  LoadSelectTypeOptions();
             let $tr = $(this).closest("tr");
                   
               $.confirm({
                   title: 'تنظیمات ستون',
                   columnClass: 'col-md-10',
                   content: selectOptions,
                   rtl: true,
                   buttons: {
                       save: {
                           text: 'ذخیره',
                           btnClass: 'btn-success',
                           action: function() {
                               const $content = this.$content;
                               var optionSettringJson = "";

                                 let typeOption = $content.find("[data-action=typeOptions]").val()
                                             let listOptions = [];
                                             let systemTypeName = "";

                                             if (typeOption === "0") {
                                                  toastr.error("نوع گزینه ها انتخاب نشده است")
                                                  return false;
                                             }

                                             else if (typeOption === "1") {
                                                  let $trOptions = $content.find('[data-section="defOptions"] tbody tr');
                                                  if ($trOptions.length === 0) {
                                                       toastr.error("هیچ گزینه ای برای ثبت ایجاد نشده است")
                                                       return false;
                                                  }
                                                  let haveError = false;
                                                  listOptions = $trOptions.map((i, c) => {

                                                       let value = $(c).find('[data-feild="value"]').val();
                                                       if (!value || value.length === 0) {
                                                            $(c).find('[data-feild="value"]').addClass("border border-danger");
                                                            haveError = true;
                                                       }
                                                       else {
                                                            if (isNaN(parseInt(value))) {
                                                                 $(c).find('[data-feild="value"]').addClass("border border-danger");
                                                                 haveError = true;
                                                            }
                                                            else {
                                                                 $(c).find('[data-feild="value"]').removeClass("border border-danger")

                                                            }
                                                       }
                                                       let name = $(c).find('[data-feild="name"]').val();

                                                       if (!name || name.length === 0) {
                                                            $(c).find('[data-feild="name"]').addClass("border border-danger");
                                                            haveError = true;
                                                       }
                                                       else {
                                                            $(c).find('[data-feild="name"]').removeClass("border border-danger")

                                                       }

                                                       return { value, name };
                                                  }).get();

                                                  if (haveError === true) {
                                                       toastr.error("برای یک یا چند گزینه وارد شده اطلاعات صحیح وارد نشده است")
                                                       return false;
                                                  }
                                             }
                                             else if (typeOption === "2") {

                                                  toastr.error("قابلیت پیاده سازی نشده است")
                                                  return false;
                                             }
                                             else if (typeOption === "3") {
                                                  systemTypeName = $content.find('[data-action="systemOptions"]').val();
                                             }

                                             optionSettringJson = JSON.stringify({ listOptions, typeOption, systemTypeName });

                                          $tr.find(`[data-bind="columns.optionSettings"]`).val(optionSettringJson);
                                
                           }
                       },
                       cancel: {
                           text: 'انصراف',
                           btnClass: 'btn-secondary'
                       }
                   }
                
               });
      })

      $$('#btnAddCol').on('click', function () { addColumnRow(); });

      // ----------------------------------------------------------------
      // افزودن خودکار از پارامترهای SQL
      // ----------------------------------------------------------------
      $$('#btnAddFromSql').on('click', function () {
          if (!sqlEditor) return;
          const value = sqlEditor.getValue()
          const params = detectParams(value);
          const existing = $$('#colBody input[data-bind="columns.columnName"]')
              .map(function () { return $(this).val(); }).get();

          let added = 0;
          params.forEach(p => {
              if (!existing.includes(p)) {
                  const isSys = systemVarNames.includes(p);
                  if(!isSys)
                     addColumnRow(p, isSys ? '' : p, isSys, isSys ? p : '');
                  added++;
              }
          });
          if (added === 0) {
              alert('همه پارامترهای SQL قبلاً اضافه شده‌اند.');
          }
      });

      // ----------------------------------------------------------------
      // حذف ستون
      // ----------------------------------------------------------------
      $$().on('click', '.btn-remove-col', function () {
          $(this).closest('tr').remove();
          if ($$('#colBody tr').length === 0) $$('#noColsMsg').removeClass('d-none');
      });

      // ----------------------------------------------------------------
      // Sort با drag & drop (اختیاری - نیاز به jQuery UI Sortable)
      // ----------------------------------------------------------------
      if ($.fn.sortable) {
          $$('#colBody').sortable({ handle: '.drag-handle', axis: 'y' });
      }

      $$("#save").on("click",function(){
          applyApiSourceUi();
          $$('#importTypeInput').val(currentImportType);
          $$('#apiCallModeInput').val($$('input[name="apiCallModeRadio"]:checked').val() || '0');

          var model = $$().dataBind();
          model.importType = currentImportType;
          model.apiIsInternal = $$('#apiSourceInternal').is(':checked');
          model.apiCallMode = parseInt($$('#apiCallModeInput').val(), 10);
          model.apiUrl = $$('#apiUrlInput').val();
          model.apiHttpMethod = $$('#apiHttpMethodInput').val();

          if (!model.fullNameEntity || !model.title) {
               return error2('فیلدهای الزامی را پر کنید.');
          }

          if (!model.columns || model.columns.length === 0) {
               return error2('حداقل یک ستون تعریف کنید.');
          }

          if (currentImportType === 0) {
               model.sqlQuery = sqlEditor ? sqlEditor.getValue() : $$('#sqlQueryInput').val();
               if (!model.sqlQuery || !String(model.sqlQuery).trim()) {
                    return error2('برای نوع SQL، کوئری SQL الزامی است.');
               }
          } else {
               if (!model.apiUrl || !String(model.apiUrl).trim()) {
                    return error2('برای نوع API، آدرس API الزامی است.');
               }
               if (!model.apiIsInternal && !/^https?:\/\//i.test(model.apiUrl)) {
                    return error2('برای API خارجی باید آدرس کامل (شامل http/https) وارد شود.');
               }
          }

          model.columns.forEach(c=>{
               if(c.optionSettings && c.optionSettings.length > 0)
               {
                    c.optionSettings = JSON.parse(c.optionSettings);
               }
          })

           model.columns = JSON.stringify(model.columns)
           
          $$.post("/panel/importDefinition/save",model,function(r){
               if(!r.isSuccess)return error2(r.message);

               success2("ذخیره سازی با موفقیت انجام شد.");
               if (typeof appController !== 'undefined' && appController.refreshCurrentPage) {
                    appController.refreshCurrentPage();
               }
          })
      })
</script>

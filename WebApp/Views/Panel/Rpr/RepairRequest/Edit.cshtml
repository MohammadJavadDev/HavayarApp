            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success">تایید</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
            </div>
        </div>
    </div>
</div>

<script>


    $(document).on('click', '[data-action="addPartFraction"]', function() {
       var url = '/Panel/Rpr/RepairRequest/ShowPartFractionForm';
       $$.get(url, function(result) {
           var bodyCn = $('<div style="overflow-x: hidden; overflow-y: auto; max-height: 70vh;">' + result + '</div>');
           $.confirm({
               title: 'افزودن کسری قطعات',
               columnClass: 'col-md-4',
               content: bodyCn,
               rtl: true,
               buttons: {
                   save: {
                       text: 'ذخیره',
                       btnClass: 'btn-success',
                       action: function() {
                           var $content = this.$content;
                           if (validateError($content)) {
                               return false;
                           }
                           var model = $content.dataBind();
                           var self = this;
                               $$.post('/Panel/Rpr/RepairRequest/AddPartFraction', model, function(r) {
                               if (!r.isSuccess) {
                                   toastr.error(r.message || 'خطا در ذخیره', 'خطا');
                                   return false;
                               }

@using Entities.App.Law
@using Entities.App.Law.Enums
@model JudicialImportantDate
<div class="row">
	<input type="hidden" data-bind="id" value="@Model?.Id" />
	<input type="hidden" data-bind="judicialFileId" value="@Model?.JudicialFileId" />
	<div class="col-md-12 form-group-inline">
		<label class="form-label fw-bold required">عنوان</label>
		<input class="form-control" data-bind="title" data-required="true" asp-for="Title" maxlength="50" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-12 form-group-inline">
		<label class="form-label fw-bold required">تاریخ</label>
		<input class="form-control" data-bind="dateShamsiDate" data-required="true" data-persionDatePicker="true"
			 persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
			 value="@(Model?.DateMiladiDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-12 form-group-inline">
		<label class="form-label fw-bold">گیرندگان پیامک</label>
		<input class="form-control" data-bind="recipients" asp-for="Recipients" maxlength="256" placeholder="شماره‌های موبایل را با ; جدا کنید" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
</div>

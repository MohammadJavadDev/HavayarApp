@using Common.Utilities
@using Stimulsoft.Report.Mvc

@{
     Layout = null;
 }
 <div style="direction: ltr">

 
	 @Html.StiNetCoreDesigner("STDesiner",new StiNetCoreDesignerOptions()
	 {
		 Actions =
		 {
			 GetReport = "GetReport",
			 SaveReport = "SaveReport",
			 DesignerEvent = "DesignerEvent",

        
		 }

	 })
 </div>
 
 
	 <script>
		   var urlParams = new URLSearchParams(window.location.search);

	    const queryParams = @Html.Raw(Json.Serialize(ViewBag.QueryParams));
	    const reportId = @Html.Raw(Json.Serialize(ViewBag.ReportId));

	jsSTDesiner.onBeginProcessData = function (args) {

	    if (args.action == "GetReport") {

		   args.data["reportId"] = reportId;

		   for (const key in queryParams) {
			  args.data[key] = JSON.stringify(queryParams[key]);
		   }

	    }
	};

	 </script>
  
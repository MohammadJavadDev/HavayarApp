@using Entities.App.Sale
@{
	var parentId = (long)ViewBag.ParentId;
}
<div class="card">
	<div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
		<h5 class="mb-0 fw-bold">یادداشت‌های پرسش فنی</h5>
		<button type="button" class="btn btn-sm btn-primary" data-action="newChild">افزودن</button>
	</div>
	<div class="card-body">
		<table class="table table-striped table-row-bordered gy-2 w-100" id="childTable">
			<thead>
				<tr class="fw-bold fs-6 text-muted">
					<th>متن</th>
					<th>کاربر</th>
					<th>تاریخ</th>
					<th style="width:120px;">عملیات</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
</div>
<script>
	const parentId = @parentId;
	const table = $$('#childTable').DataTable({
		serverSide: false,
		autoWidth: false,
		pageLength: 10,
		language: { url: '/panelLib/plugins/custom/datatables/fa.json' },
		ajax: {
			url: '/Panel/Sale/TechnicalQueryComment/GetListByParentId?technicalQueryId=' + parentId,
			type: 'GET',
			dataSrc: function (json) {
				if (json && json.isSuccess === false) {
					toastr.error(json.message || 'خطا در دریافت اطلاعات');
					return [];
				}
				return (json && json.data) ? json.data : (Array.isArray(json) ? json : []);
			}
		},
		columns: [
			{ data: 'comment', defaultContent: '-' },
			{ data: 'userName', defaultContent: '-' },
			{ data: 'createdOnShamsiDateTime', defaultContent: '-' },
			{
				data: 'id',
				orderable: false,
				className: 'text-center',
				render: function (id) {
					return '<button type="button" class="btn btn-sm btn-icon btn-light-warning" data-action="editChild" data-id="' + id + '"><i class="fa fa-edit"></i></button> '
						+ '<button type="button" class="btn btn-sm btn-icon btn-light-danger" data-action="deleteChild" data-id="' + id + '"><i class="fa fa-trash"></i></button>';
				}
			}
		]
	});
	page.$pageEl.on('click', '[data-action="newChild"]', function () {
		appController.addPage('/Panel/Sale/TechnicalQueryComment/New?technicalQueryId=' + parentId, true, 'یادداشت پرسش فنی');
	});
	page.$pageEl.on('click', '[data-action="editChild"]', function () {
		appController.addPage('/Panel/Sale/TechnicalQueryComment/Edit?id=' + $(this).data('id') + '&technicalQueryId=' + parentId, true, 'یادداشت پرسش فنی');
	});
	page.$pageEl.on('click', '[data-action="deleteChild"]', function () {
		const id = $(this).data('id');
		Swal.fire({ title: 'حذف', text: 'آیا از حذف این ردیف مطمئن هستید؟', icon: 'warning', showCancelButton: true, confirmButtonText: 'بله', cancelButtonText: 'خیر' })
			.then(function (result) {
				if (!result.isConfirmed) return;
				$$.get('/Panel/Sale/TechnicalQueryComment/Delete?id=' + id, function (r) {
					if (r && r.isSuccess === false) { toastr.error(r.message || 'خطا در حذف'); return; }
					toastr.success('رکورد با موفقیت حذف شد');
					table.ajax.reload(null, false);
				});
			});
	});
</script>

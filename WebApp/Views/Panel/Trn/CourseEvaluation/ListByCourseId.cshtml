@using Entities.App.Trn
@using WebApp.Controllers.Dynamic
@model CourseEvaluationListByParentViewModel

@{
     var tableId = "courseEvaluationTable_" + Model.CourseId;
}

<div class="card" id="courseEvaluationListPage" data-course-id="@Model.CourseId">
     <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold">
               <i class="fa fa-clipboard-check ms-2"></i>
               ارزیابی‌های دوره (@Model.CourseTitle)
          </h5>
          <div>
               <button type="button" class="btn btn-sm btn-info" id="btnEvaluationChart">
                    <i class="fa fa-chart-bar ms-1"></i>
                    چاپ نمودار ارزیابی
               </button>
               <button type="button" class="btn btn-sm btn-primary" id="btnNewCourseEvaluation">
                    <i class="fa fa-plus ms-1"></i>
                    ارزیابی جدید
               </button>
          </div>
     </div>
     <div class="card-body">
          <table id="@tableId" class="table table-striped table-row-bordered gy-2 w-100">
               <thead>
                    <tr class="fw-bold fs-6 text-muted">
                         <th>ارزیاب (نام)</th>
                         <th>ارزیاب (نام خانوادگی)</th>
                         <th>میانگین امتیاز</th>
                         <th>تاریخ ثبت</th>
                         <th style="width:120px;">عملیات</th>
                    </tr>
               </thead>
               <tbody></tbody>
          </table>
     </div>
</div>
<script>
     const courseId = '@Model.CourseId';
     const tableSelector = '#@tableId';
     const listApiUrl = '/Panel/Trn/CourseEvaluation/GetListByParentId?courseId=' + courseId;

     function escapeHtml(text) {
          if (text === null || text === undefined) return '-';
          return String(text)
               .replace(/&/g, '&amp;')
               .replace(/</g, '&lt;')
               .replace(/>/g, '&gt;')
               .replace(/"/g, '&quot;');
     }

     function deleteCourseEvaluation(id) {
          Swal.fire({
               title: 'حذف ردیف',
               text: 'آیا از حذف این ارزیابی مطمئن هستید؟',
               icon: 'warning',
               showCancelButton: true,
               confirmButtonText: 'بله',
               cancelButtonText: 'خیر'
          }).then(function (result) {
               if (!result.isConfirmed) return;

               $$.get('/Panel/Trn/CourseEvaluation/Delete?id=' + id, function (response) {
                    if (response && response.isSuccess === false) {
                         toastr.error(response.message || 'خطا در حذف رکورد');
                         return;
                    }
                    toastr.success('رکورد با موفقیت حذف شد');
                    reloadCourseEvaluationList();
               });
          });
     }

     function reloadCourseEvaluationList() {
          const dt = window['@tableId'];
          if (dt && dt.ajax) {
               dt.ajax.reload(null, false);
          }
     }

     const table = $$(tableSelector).DataTable({
          serverSide: false,
          autoWidth: false,
          scrollX: true,
          pageLength: 10,
          lengthMenu: [[5, 10, 25, 50, -1], [5, 10, 25, 50, 'همه']],
          order: [[3, 'desc']],
          language: { url: '/panelLib/plugins/custom/datatables/fa.json' },
          ajax: {
               url: listApiUrl,
               type: 'GET',
               dataSrc: function (json) {
                    if (json && json.isSuccess === false) {
                         toastr.error(json.message || 'خطا در دریافت اطلاعات');
                         return [];
                    }
                    return (json && json.data) ? json.data : (Array.isArray(json) ? json : []);
               }
          },
          columns: [
               { data: 'firstName', render: function (d) { return escapeHtml(d); } },
               { data: 'lastName', render: function (d) { return escapeHtml(d); } },
               { data: 'averageScore', render: function (d) { return escapeHtml(d); } },
               { data: 'createdOnShamsiDateTime', render: function (d) { return escapeHtml(d); } },
               {
                    data: null,
                    orderable: false,
                    className: 'text-center',
                    render: function (d, t, row) {
                         return '<button type="button" class="btn btn-sm btn-icon btn-light-warning btn-edit-row" data-id="' + row.id + '" title="ویرایش"><i class="fa fa-edit"></i></button> '
                              + '<button type="button" class="btn btn-sm btn-icon btn-light-danger btn-delete-row" data-id="' + row.id + '" title="حذف"><i class="fa fa-trash"></i></button>';
                    }
               }
          ]
     });

     window['@tableId'] = table;

     $$('#btnNewCourseEvaluation').on('click', function () {
          appController.addPage('/Panel/Trn/CourseEvaluation/New?courseId=' + courseId);
     });

     // Step 08 §5 — قالب نمودار Stimulsoft + SavedQuery در Step 10 (ReportBuilder) ساخته می‌شود؛
     // این دکمه از همان now قرارداد ViewReportByName استفاده می‌کند.
     $$('#btnEvaluationChart').on('click', function () {
          appController.addPage('/System/ReportBuilder/ViewReportByName/CourseEvaluationChart?courseId={\'values\':[\'' + courseId + '\'],\'condition\':\'=\'}&autoRun=True');
     });

     $$(tableSelector).on('click', '.btn-edit-row', function () {
          const id = $(this).data('id');
          appController.addPage('/Panel/Trn/CourseEvaluation/Edit?id=' + id);
     });

     $$(tableSelector).on('click', '.btn-delete-row', function () {
          const id = $(this).data('id');
          deleteCourseEvaluation(id);
     });
</script>

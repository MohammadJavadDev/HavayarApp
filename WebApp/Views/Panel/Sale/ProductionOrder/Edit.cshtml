								</label>
							</div>
						</div>

						<div class='col-md-3'>
							<label class=''>تعداد</label>
							<input class='form-control'  data-bind='centrifugeCompressorCount'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='CentrifugeCompressorCount' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>

						<div class='col-md-3'>
							<label class=''>ولتاژ الکتروموتور</label>
							<input class='form-control'  data-bind='centrifugeElectromotorVoltage'  data-invalidMessage='فقط عداد' data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='CentrifugeElectromotorVoltage' />
							<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
						</div>


						<div class='col-md-3 align-content-center'>
							<div class="form-check">
								<input data-bind='hasGA' class="form-check-input" type="checkbox" asp-for='HasGA' />
								<label class="form-check-label" asp-for='HasGA'>
									GA
								</label>
							</div>
						</div>

						<div class='col-md-3 align-content-center'>

               </div>

               <div class='col-md-2 align-content-center'>
                    <div class="form-check">
                         <input data-bind='airFilterReplacement' class="form-check-input" type="checkbox" asp-for='AirFilterReplacement' />
                         <label class="form-check-label form-label fw-bold" asp-for='AirFilterReplacement'>
                              تعويض فيلتر هوا

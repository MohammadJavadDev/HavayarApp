@{

     ViewData["Title"] = "طراح گزارش";



     var ReportType = ViewBag.ReportType != null ? ViewBag.ReportType : 0;
}

<link href="~/panellib/css/query-designer.css" rel="stylesheet" />
<style>
     .select2-container {
          z-index: 999999999 !important
     }

     .dragging-mirror {
          cursor: grabbing;
          box-shadow: 0 5px 15px rgba(0,0,0,0.2);
          z-index: 9999;
     }

     .dragging-source {
          opacity: 0.5;
     }

     .col-type-card {
          transition: border-color .2s, box-shadow .2s;
          border-color: #dee2e6 !important;
     }

          .col-type-card:hover {
               border-color: #0d6efd !important;
               box-shadow: 0 0 0 .2rem rgba(13,110,253,.15);
          }

          .col-type-card.active {
               border-color: #0d6efd !important;
               background: rgba(13,110,253,.06);
          }
</style>

<script>
     window.__reportId = @(ViewBag.ReportId != null ? ViewBag.ReportId : "null");
     window.__reportType = @(ViewBag.ReportType != null ? ViewBag.ReportType : 0)
</script>

<div class="row mb-2 p-3">
     <div class="col-md-6">
          <label for="reportName" class="form-label">
               <strong>نام گزارش (یکتا)</strong>
               <span class="text-danger">*</span>
          </label>
          <input type="text" id="reportName" class="form-control form-control-sm ltr" data-inputmask="'regex': '[a-zA-Z_]+'" placeholder="مثال: rpt_users_list" required>
     </div>
     <div class="col-md-6">
          <label for="reportTitle" class="form-label">
               <strong>عنوان نمایشی</strong>
               <span class="text-danger">*</span>
          </label>
          <input type="text" id="reportTitle" class="form-control form-control-sm" placeholder="مثال: لیست کاربران" required>
     </div>

     <div class="col-md-6">
          <label for="entityFullName" class="form-label">
               <strong>نام کامل موجودیت</strong>
               <span class="text-danger">*</span>
          </label>
          <input type="text" value="@(ViewBag.EntityFullName != null ? ViewBag.EntityFullName :"")" id="entityFullName" class="form-control form-control-sm" disabled>
     </div>

    
     <div class="col-md-12 border border-1 my-5 p-5 row" id="actionOptionsSection">
           <h4 class="text-center mb-4"> فعال یا فعال نبودن عملیات ها </h4>
           <p class="text-muted small text-center mb-3">
                گزینه «انتخاب چندتایی پیش‌فرض» باعث می‌شود هنگام باز شدن جدول، حالت چندانتخابی از ابتدا فعال باشد.
           </p>
     </div>

     <div class="col-md-12 border border-1 rounded my-4 p-4" id="customButtonsSection">
          <div class="d-flex justify-content-between align-items-center mb-4">
               <h5 class="mb-0">
                    <i class="bi bi-lightning-charge-fill text-warning"></i>
                    دکمه‌های اکشن سفارشی
               </h5>
               <button type="button" id="btnAddCustomButton" class="btn btn-outline btn-outline-primary btn-sm">
                    <i class="bi bi-plus-circle"></i> افزودن دکمه
               </button>
          </div>

          <div id="customButtonsList" class="row g-3">
               <div id="customButtonsEmpty" class="col-12 text-center text-muted small py-3">
                    <i class="bi bi-info-circle"></i>
                    هیچ دکمه سفارشی تعریف نشده است
               </div>
          </div>
     </div>
     <div class="col-md-12 border border-1 rounded my-4 p-4" id="eventScriptsSection">
          <div class="d-flex justify-content-between align-items-center mb-4">
               <h5 class="mb-0">
                    <i class="bi bi-braces-asterisk text-info"></i>
                    رویدادهای جدول
               </h5>
               <span class="badge bg-secondary small">
                    کدهای JS که هنگام وقوع رویداد اجرا می‌شوند
               </span>
          </div>

          <ul class="nav nav-tabs mb-0" id="eventScriptsTabs" role="tablist">
               <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-onSelectedRow"
                            data-bs-toggle="tab" data-bs-target="#pane-onSelectedRow"
                            type="button" role="tab">
                         <i class="bi bi-cursor-fill text-primary"></i>
                         onSelectedRow
                         <span id="badge-onSelectedRow" class="badge bg-primary ms-1 d-none">✓</span>
                    </button>
               </li>
               <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-onRowAdded"
                            data-bs-toggle="tab" data-bs-target="#pane-onRowAdded"
                            type="button" role="tab">
                         <i class="bi bi-plus-square text-success"></i>
                         onRowAdded
                         <span id="badge-onRowAdded" class="badge bg-success ms-1 d-none">✓</span>
                    </button>
               </li>
          </ul>

          <div class="tab-content border border-top-0 rounded-bottom p-4">

 
               <div class="tab-pane fade show active" id="pane-onSelectedRow" role="tabpanel">
                    <div class="row g-3">
                         <div class="col-md-4">
                              <div class="alert alert-primary py-2 small ltr mb-3" style="font-family:monospace">
                                   <strong class="d-block mb-1">// متغیرهای در دسترس:</strong>
                                   <span class="text-success">ctx.selectedRow</span>
                                   <span class="text-muted"> → آبجکت ردیف انتخاب‌شده</span><br>
                                   <span class="text-success">ctx.selectedRows</span>
                                   <span class="text-muted"> → آرایه ردیف‌های انتخاب‌شده (چندانتخابی)</span><br>
                                   <span class="text-success">ctx.primaryKeyValues</span>
                                   <span class="text-muted"> → آرایه PKهای انتخاب‌شده</span><br>
                                   <span class="text-success">ctx.multiSelectMode</span>
                                   <span class="text-muted"> → true در حالت چندانتخابی</span><br>
                                   <span class="text-success">ctx.$row</span>
                                   <span class="text-muted"> → jQuery المان tr</span><br>
                                   <span class="text-success">ctx.table</span>
                                   <span class="text-muted"> → DataTable API</span><br>
                                   <span class="text-success">ctx.$toolbar</span>
                                   <span class="text-muted"> → jQuery نوار ابزار</span><br>
                                   <span class="text-success"> ctx.dataActionBtns </span>
                                   <span class="text-muted"> → دکمه های موجود بر اساس dataAction</span><br>
                                   <span class="text-success">ctx.isDeselect</span>
                                   <span class="text-muted"> → true اگر ردیف deselect شد</span><br>
                                   <span class="text-success">ctx.draw()</span>
                                   <span class="text-muted"> → بارگذاری مجدد</span>
                              </div>
                              <div class="d-flex flex-column gap-2">
                                   <button type="button" class="btn btn-sm btn-outline-secondary"
                                           data-event="onSelectedRow" data-action="insertTemplate">
                                        <i class="bi bi-file-code"></i> درج قالب
                                   </button>
                                   <button type="button" class="btn btn-sm btn-outline-danger"
                                           data-event="onSelectedRow" data-action="clearScript">
                                        <i class="bi bi-trash"></i> پاک کردن
                                   </button>
                              </div>
                         </div>
                         <div class="col-md-8">
                              <div id="scriptOnSelectedRow" data-event="onSelectedRow" class="h-200px">
                                   function(ctx) {
                                   // هنگام انتخاب یا deselect یک ردیف اجرا می‌شود
                                   }
                              </div>
                              <div class="form-text mt-1">
                                   تابع به صورت <code>function(ctx) { ... }</code>
                              </div>
                         </div>
                    </div>
               </div>

            
               <div class="tab-pane fade" id="pane-onRowAdded" role="tabpanel">
                    <div class="row g-3">
                         <div class="col-md-4">
                              <div class="alert alert-success py-2 small ltr mb-3" style="font-family:monospace">
                                   <strong class="d-block mb-1">// متغیرهای در دسترس:</strong>
                                   <span class="text-success">ctx.rowData</span>
                                   <span class="text-muted"> → آبجکت داده ردیف</span><br>
                                   <span class="text-success">ctx.$row</span>
                                   <span class="text-muted"> → jQuery المان tr</span><br>
                                   <span class="text-success">ctx.table</span>
                                   <span class="text-muted"> → DataTable API</span><br>
                                   <span class="text-success">ctx.rowIndex</span>
                                   <span class="text-muted"> → ایندکس ردیف در صفحه جاری</span><br>
                                   <span class="text-success">ctx.draw()</span>
                                   <span class="text-muted"> → بارگذاری مجدد</span>
                              </div>
                              <div class="d-flex flex-column gap-2">
                                   <button type="button" class="btn btn-sm btn-outline-secondary"
                                           data-event="onRowAdded" data-action="insertTemplate">
                                        <i class="bi bi-file-code"></i> درج قالب
                                   </button>
                                   <button type="button" class="btn btn-sm btn-outline-danger"
                                           data-event="onRowAdded" data-action="clearScript">
                                        <i class="bi bi-trash"></i> پاک کردن
                                   </button>
                              </div>
                         </div>
                         <div class="col-md-8">
                              <div id="scriptOnRowAdded"
                                        data-event="onRowAdded"
                                         class="h-200px"
                                        >function(ctx) {
                                                 // هنگام رندر هر ردیف (بعد از هر draw) اجرا می‌شود
                                             }</div>
                              <div class="form-text mt-1">
                                   تابع به صورت <code>function(ctx) { ... }</code>
                                   — برای هر ردیف یک‌بار صدا زده می‌شود
                              </div>
                         </div>
                    </div>
               </div>

          </div>
     </div>


</div>

<div class="container-fluid h-100">
     <!-- انتخاب حالت -->
     <div id="modeSelection" class="mode-selection py-5">
          <h4 class="text-center mb-4">نوع ایجاد گزارش را انتخاب کنید</h4>
          <div class="row justify-content-center g-4">
               <div class="col-md-5">
                    <div class="card mode-card h-100 cursor-pointer" data-mode="0">
                         <div class="card-body text-center py-5">
                              <i class="bi bi-diagram-3 display-4 text-primary mb-3"></i>
                              <h5 class="card-title">طراحی بصری</h5>
                              <p class="card-text text-muted">جداول، روابط و فیلترها را به صورت بصری طراحی کنید</p>
                         </div>
                    </div>
               </div>
               <div class="col-md-5">
                    <div class="card mode-card h-100 cursor-pointer" data-mode="1">
                         <div class="card-body text-center py-5">
                              <i class="bi bi-code-slash display-4 text-success mb-3"></i>
                              <h5 class="card-title">نوشتن Query</h5>
                              <p class="card-text text-muted">مستقیماً Query SQL را بنویسید</p>
                         </div>
                    </div>
               </div>
          </div>
     </div>

     <!-- محتوای اصلی - حالت طراحی -->
     <div id="designModeContent" class="d-none">
          <div class="row h-100">
               <!-- Sidebar - لیست جداول -->
               <div class="col-md-3 border-start designer-sidebar">
                    <div class="sidebar-header p-3 border-bottom">
                         <h5 class="mb-3">
                              <i class="bi bi-list-ul"></i>
                              جداول و ویوها
                         </h5>
                         <div class="input-group input-group-sm">
                              <input type="text"
                                     id="tableSearch"
                                     class="form-control"
                                     placeholder="جستجوی جدول..."
                                     autocomplete="off">
                              <span class="input-group-text">
                                   <i class="bi bi-search"></i>
                              </span>
                         </div>
                    </div>
                    <div class="sidebar-body p-2" style="max-height: 45vh;">
                         <div id="tablesList">
                              <!-- لیست جداول به صورت دینامیک بارگذاری می‌شود -->
                              <div class="text-center p-3">
                                   <div class="spinner-border spinner-border-sm text-primary" role="status">
                                        <span class="visually-hidden">در حال بارگذاری...</span>
                                   </div>
                                   <p class="text-muted mt-2 mb-0">در حال بارگذاری جداول...</p>
                              </div>
                         </div>
                    </div>

                    <div class="sidebar-footer p-3 border-top bg-light">
                         <h6 class="mb-2">
                              <i class="bi bi-filter"></i>
                              فیلترها
                         </h6>
                         <div id="filtersListContainer" class="filters-list-container">
                              <div id="filtersList" class="filters-list">
                                   <!-- فیلترها به صورت دینامیک اضافه می‌شوند -->
                              </div>
                              <div id="filtersEmpty" class="text-muted small text-center py-2">
                                   فیلتری اضافه نشده
                              </div>
                         </div>
                    </div>
                    <div class="sidebar-conditions p-3 border-top bg-light">
                         <div class="d-flex justify-content-between align-items-center mb-2">
                              <h6 class="mb-0">
                                   <i class="bi bi-braces"></i>
                                   شرط‌های Query
                              </h6>
                              <button type="button" id="btnAddCustomCondition" class="btn btn-outline btn-outline-primary btn-sm" title="افزودن شرط">
                                   <i class="bi bi-plus"></i>
                              </button>
                         </div>
                         <p class="small text-muted mb-2">عبارت SQL دلخواه برای بخش WHERE — مثال: <code class="ltr">[t1].[NeedCount] = [t2].[BuyCount]</code></p>
                         <div id="customConditionsListContainer" class="filters-list-container">
                              <div id="customConditionsList" class="filters-list">
                                   <!-- شرط‌ها به صورت دینامیک -->
                              </div>
                              <div id="customConditionsEmpty" class="text-muted small text-center py-2">
                                   شرطی اضافه نشده
                              </div>
                         </div>
                    </div>
                    <div class="sidebar-parameters p-3 border-top bg-light" style="max-height: 28vh; overflow-y: auto;">
                         <h6 class="mb-2">
                              <i class="bi bi-input-cursor-text"></i>
                              پارامترها
                         </h6>
                         <p class="small text-muted mb-2">در فیلترها یا Query از <code>@@ParamName</code> استفاده کنید</p>
                         <div class="mb-2">
                              <button type="button" id="btnAddParameter" class="btn btn-outline btn-outline-primary w-100">
                                   <i class="bi bi-plus"></i> پارامتر جدید
                              </button>
                         </div>
                         <div id="parametersList" class="parameters-list small">
                              <!-- پارامترهای داینامیک -->
                         </div>
                         <div id="parametersEmpty" class="text-muted text-center py-2">
                              پارامتر داینامیکی تعریف نشده
                         </div>
                         <details class="mt-2">
                              <summary class="small cursor-pointer">پارامترهای از پیش تعریف شده</summary>
                              <div id="builtInParamsList" class="mt-1 small text-muted" style="max-height: 120px; overflow-y: auto;">
                                   <div class="text-center py-2">در حال بارگذاری...</div>
                              </div>
                         </details>
                    </div>
               </div>

               <!-- Main Content -->
               <div class="col-md-9 d-flex flex-column">
                    <!-- Toolbar -->
                    <div class="designer-toolbar border-bottom p-2 bg-light">
                         <div class="d-flex justify-content-between align-items-center">
                              <div class="btn-group btn-group-sm" role="group">
                                   <button type="button" id="btnZoomOut" class="btn btn-outline-secondary" title="کوچک‌نمایی">
                                        <i class="bi bi-zoom-out"></i>
                                   </button>
                                   <button type="button" id="btnFitView" class="btn btn-outline-secondary" title="نمای کامل">
                                        <i class="bi bi-arrows-angle-expand"></i>
                                   </button>
                                   <button type="button" id="btnZoomIn" class="btn btn-outline-secondary" title="بزرگ‌نمایی">
                                        <i class="bi bi-zoom-in"></i>
                                   </button>
                              </div>

                              <div class="btn-group btn-group-sm" role="group">
                                   <button type="button" id="btnConvertToQueryMode" class="btn btn-outline-success" title="تبدیل به حالت نوشتن Query">
                                        <i class="bi bi-code-slash"></i>
                                        تبدیل به Query
                                   </button>
                                   <button type="button" id="btnClearDiagram" class="btn btn-outline-danger" title="پاک کردن دیاگرام">
                                        <i class="bi bi-trash"></i>
                                        پاک کردن
                                   </button>
                              </div>
                         </div>
                    </div>

                    <!-- محتوای اصلی - یک نمای واحد -->
                    <div class="flex-grow-1 border border-top-0 p-3 d-flex flex-column" style="min-height: 0;">
                         <!-- ۱. دیاگرام -->
                         <div class="diagram-container position-relative mb-3" style="max-height: 74vh; min-height: 200px;">
                              <div class="diagram-scroll-wrapper h-100">
                                   <div id="diagramCanvas" class="position-relative">
                                        <div class="empty-state">
                                             <i class="bi bi-diagram-3 text-muted" style="font-size: 4rem;"></i>
                                             <h5 class="text-muted mt-3">دیاگرام خالی است</h5>
                                             <p class="text-muted">جداول را از سمت راست به اینجا بکشید</p>
                                        </div>
                                   </div>
                              </div>
                         </div>

                         <!-- ۲. تنظیمات ستون‌ها -->
                         
                    </div>
               </div>

               <div class="col-md-12">
                    <div class="mb-3 flex-shrink-0">

                         <div class="d-flex justify-content-between align-items-center mb-2">
                              <h6 class="mb-0">
                                   <i class="bi bi-gear"></i>
                                   تنظیمات ستون‌ها
                              </h6>
                              <div class="d-flex gap-2">
                                   <button type="button" id="btnBulkEditColumnsJson"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="ویرایش دسته‌جمعی تنظیمات ستون‌ها به‌صورت JSON">
                                        <i class="bi bi-braces"></i> ویرایش JSON ستون‌ها
                                   </button>
                                   <button type="button" id="btnAddColumnManual"
                                           class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-plus-circle"></i> افزودن ستون
                                   </button>
                              </div>
                         </div>

                         <div class="table-responsive">
                              <table id="columnsTable" class="table table-sm table-bordered mb-0">
                                   <thead class="table-light" style="position: sticky; top: 0; background: #f8f9fa; z-index: 1;">
                                        <tr>
                                             <th style="width: 30px;"> #</th>
                                             <th style="width: 30px;"> تنظیمات</th>
                                             <th style="width: 30px;">نمایش</th>
                                             @if((int)ReportType == 1)
                                             {
                                                  <th style="width: 30px;" action-key="primaryKey">کلید اصلی</th>
                                             }
                                             
                                             <th style="width: 80px;">ستون</th>
                                             <th style="width: 100px;">عنوان نمایشی</th>
                                             <th style="width: 80px;">نوع</th>
                                             <th style="width: 30px;">Group By</th>
                                             <th style="width: 80px;">Aggregate</th>
                                             <th style="width: 50px;">مرتب‌سازی</th>
                                             <th style="width: 30px;">ترتیب</th>
                                        </tr>
                                   </thead>
                                   <tbody id="columnsTableBody">
                                        <tr>
                                             <td colspan="7" class="text-center text-muted">
                                                  ستونی انتخاب نشده است
                                             </td>
                                        </tr>
                                   </tbody>
                              </table>
                         </div>
                    </div>

                    <!-- ۳. نمایش کد SQL -->
                    <div class="flex-grow-1 d-flex flex-column" style="min-height: 0;">
                         <div class="mb-2 d-flex justify-content-between align-items-center">
                              <span class="fw-bold"><i class="bi bi-code-slash"></i> Query SQL</span>
                              <div class="btn-group btn-group-sm" role="group">
                                   <button type="button" id="btnValidateQuery" class="btn btn-outline btn-outline-success">
                                        <i class="bi bi-check-circle"></i> اعتبارسنجی
                                   </button>
                                   <button type="button" id="btnPreviewQuery" class="btn btn-outline btn-outline-info">
                                        <i class="bi bi-eye"></i> پیش‌نمایش
                                   </button>
                              </div>
                         </div>
                         <textarea id="queryEditor"
                                   class="form-control font-monospace flex-grow-1"
                                   dir="ltr"
                                   placeholder="Query به صورت خودکار ساخته می‌شود یا می‌توانید دستی ویرایش کنید..."
                                   style="min-height: 120px;"></textarea>
                         <div class="alert alert-info py-2 mt-2 mb-0 small" role="alert">
                              <i class="bi bi-info-circle"></i>
                              Query به صورت خودکار با هر تغییر بروزرسانی می‌شود.
                         </div>
                         <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                              <button type="button" id="btnCancel" class="btn btn-secondary">
                                   <i class="bi bi-x-circle"></i> انصراف
                              </button>
                              <div class="d-flex gap-2">
                                   <button type="button" id="btnConvertToQueryModeBottom" class="btn btn-outline-success">
                                        <i class="bi bi-code-slash"></i> تبدیل به حالت Query
                                   </button>
                                   <button type="button" id="btnSaveReport" class="btn btn-success">
                                        <i class="bi bi-save"></i> ذخیره پرس  و جو
                                   </button>
                              </div>
                         </div>
                    </div>
               </div>
          </div>
     </div>

     <!-- محتوای حالت نوشتن Query -->
     <div id="writeModeContent" class="d-none p-4">
          <div class="mb-3">
               <details class="mb-3">
                    <summary class="cursor-pointer text-primary"><i class="bi bi-database-gear"></i> درج Stored Procedure</summary>
                    <div class="mt-2 p-2 border rounded bg-light">
                         <div class="input-group input-group-sm mb-2">
                              <input type="text" id="spSearch" class="form-control" placeholder="جستجوی SP..." autocomplete="off">
                         </div>
                         <div id="storedProceduresList" class="small" style="max-height: 180px; overflow-y: auto;">
                              <div class="text-center py-2 text-muted">در حال بارگذاری...</div>
                         </div>
                    </div>
               </details>
          </div>
          <div class="mb-3">
               <label for="queryEditorWrite" class="form-label">Query SQL</label>
               <div id="queryEditorWrite" style="height:500px" ></div>
          </div>
          <div class="btn-group mb-3">
               <button type="button" id="btnValidateQueryWrite" class="btn btn-outline btn-outline-success">اعتبارسنجی</button>
               <button type="button" id="btnPreviewQueryWrite" class="btn btn-outline btn-outline-info">پیش‌نمایش</button>
          </div>

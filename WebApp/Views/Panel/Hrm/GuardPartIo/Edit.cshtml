@using Common.Utilities
@using Entities.App.Hcm
@using Entities.App.Hrm
@using Entities.App.Hrm.Enums
@using Entities.Base
@model GuardPartIo

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(GuardPartIo)"
			save-btn="true"
			save-and-close-btn="true"
			new-page-btn="false"
			save-and-new-btn="false"
			history-btn="false">
		</form-action-buttons>
	</div>
	<div class="card-body">
		<div class="row mb-4"><div class="col-12"><h4 class="fw-bold text-dark mb-0">ورود و خروج کالا (حراست/دژبان)</h4></div></div>
		<input type="hidden" data-bind="id" value="@Model?.Id" />
		<input type="hidden" data-bind="htsId" value="@Model?.HtsId" />

		<div class="row g-3 mb-3">
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold required">نوع ورود/خروج</label>
				<select class="form-control" data-bind="ioType" data-required="true">
					<option value="">لطفا انتخاب کنید</option>
					@foreach (var v in Enum.GetValues<GuardIoTypeEnum>().Where(x => x != GuardIoTypeEnum.EmergencyExitReturn))
					{
						<option value="@((int)v)" selected="@(Model?.IoType == v)">@v.ToDisplay()</option>
					}
				</select>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold required">درب</label>
				<select class="form-control" data-bind="ioDoor" data-required="true">
					<option value="">لطفا انتخاب کنید</option>
					@foreach (var v in Enum.GetValues<GuardIoDoorEnum>())
					{
						<option value="@((int)v)" selected="@(Model?.IoDoor == v)">@v.ToDisplay()</option>
					}
				</select>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold required">نوع اپراتور</label>
				<select class="form-control" id="guardIoOperatorType" data-bind="operatorType" data-required="true">
					<option value="">لطفا انتخاب کنید</option>
					@foreach (var v in Enum.GetValues<GuardOperatorTypeEnum>())
					{
						<option value="@((int)v)" selected="@(Model?.OperatorType == v)">@v.ToDisplay()</option>
					}
				</select>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>

			<div class="col-md-4 form-group-inline guard-op-person" style="display:none">
				<label class="form-label fw-bold required">پرسنل</label>
				@{ var currentPersonId = Model?.PersonId; }
				@(Html.EntitySelector<Personel>(
					"GuardPartIoPersonSelector",
					c => c.IsActive == IsActiveEnum.Active || c.Id == currentPersonId,
					c => new { Id = c.Id, Name = c.Name, Family = c.Family, FamilyDisplay = c.FamilyDisplay, Code = c.Code },
					c => new { c.Name, c.Family, c.FamilyDisplay, c.Code },
					"{Name} {FamilyDisplay}",
					"personId",
					"personName",
					Model?.PersonId > 0 ? Model.PersonId.ToString() : null
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline guard-op-contractor" style="display:none">
				<label class="form-label fw-bold required">پیمانکار</label>
				<div class="d-flex gap-2 align-items-start">
					<div class="flex-grow-1">
						@(Html.EntitySelector<GuardContractor>(
							"GuardPartIoContractorSelector",
							c => c.IsActive == IsActiveEnum.Active,
							c => new { Id = c.Id, FullName = c.FullName, PhoneNumber = c.PhoneNumber },
							c => new { c.FullName, c.PhoneNumber },
							"{FullName}",
							"contractorId",
							"contractorName",
							Model?.ContractorId > 0 ? Model.ContractorId.ToString() : null
						))
					</div>
					<button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-action="quickAdd" data-type="contractor" data-selector="GuardPartIoContractorSelector">
						<i class="fa fa-plus"></i> افزودن
					</button>
				</div>
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-4 form-group-inline guard-op-misc" style="display:none">
				<label class="form-label fw-bold required">شخص متفرقه</label>
				<input class="form-control" data-bind="operatorTitle" maxlength="128" value="@Model?.OperatorTitle" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
		</div>

		<div class="row g-3 mb-3">
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">راننده</label>
				<div class="d-flex gap-2 align-items-start">
					<div class="flex-grow-1">
						@(Html.EntitySelector<GuardDriver>(
							"GuardPartIoDriverSelector",
							c => c.IsActive == IsActiveEnum.Active,
							c => new { Id = c.Id, FullName = c.FullName, CarName = c.CarName, LicensePlate = c.LicensePlate },
							c => new { c.FullName, c.CarName, c.LicensePlate },
							"{FullName} | {CarName} | {LicensePlate}",
							"driverId",
							"driverName",
							Model?.DriverId > 0 ? Model.DriverId.ToString() : null
						))
					</div>
					<button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-action="quickAdd" data-type="driver" data-selector="GuardPartIoDriverSelector">
						<i class="fa fa-plus"></i> افزودن
					</button>
				</div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">مبدأ</label>
				<div class="d-flex gap-2 align-items-start">
					<div class="flex-grow-1">
						@(Html.EntitySelector<GuardLocation>(
							"GuardPartIoSourceSelector",
							c => c.IsActive == IsActiveEnum.Active,
							c => new { Id = c.Id, Title = c.Title },
							c => new { c.Title },
							"{Title}",
							"ioSourceId",
							"ioSourceName",
							Model?.IoSourceId > 0 ? Model.IoSourceId.ToString() : null
						))
					</div>
					<button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-action="quickAdd" data-type="location" data-selector="GuardPartIoSourceSelector">
						<i class="fa fa-plus"></i> افزودن
					</button>
				</div>
			</div>
			<div class="col-md-4 form-group-inline">
				<label class="form-label fw-bold">مقصد</label>
				<div class="d-flex gap-2 align-items-start">
					<div class="flex-grow-1">
						@(Html.EntitySelector<GuardLocation>(
							"GuardPartIoDestinationSelector",
							c => c.IsActive == IsActiveEnum.Active,
							c => new { Id = c.Id, Title = c.Title },
							c => new { c.Title },
							"{Title}",
							"ioDestinationId",
							"ioDestinationName",
							Model?.IoDestinationId > 0 ? Model.IoDestinationId.ToString() : null
						))
					</div>
					<button type="button" class="btn btn-sm btn-light-primary text-nowrap" data-action="quickAdd" data-type="location" data-selector="GuardPartIoDestinationSelector">
						<i class="fa fa-plus"></i> افزودن
					</button>
				</div>
			</div>
			<div class="col-md-12 form-group-inline">
				<label class="form-label fw-bold">توضیحات</label>
				<textarea class="form-control" data-bind="comment" rows="2" maxlength="2048">@Model?.Comment</textarea>
			</div>
		</div>

		<div class="card border mt-3">
			<div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
				<span class="fw-bold">کالاها</span>
				<button type="button" class="btn btn-sm btn-primary" data-action="addItem">
					<i class="fa fa-plus"></i> افزودن
				</button>
			</div>
			<div class="card-body p-0">
				<table class="table table-sm table-hover mb-0" id="guardPartIoItemsTable">
					<thead>
						<tr>
							<th>کالا</th>
							<th>مقدار</th>
							<th>علت</th>
							<th>شماره برگه</th>
							<th>واحد مرتبط</th>
							<th>نام فایل پیوست</th>
							<th>حجم پیوست</th>
							<th style="width:150px" class="text-center dt-ellipsis-skip">عملیات</th>
						</tr>
					</thead>
					<tbody></tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<script>
	let guardItems = [];
	let guardEditingIndex = null;

	function esc(s) {
		return String(s == null ? '' : s)
			.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
	}

	function formatBytes(n) {
		if (n == null || n === '') return '';
		const units = ['B', 'KB', 'MB', 'GB'];
		let v = Number(n), i = 0;
		while (v >= 1024 && i < units.length - 1) { v /= 1024; i++; }
		return (Math.round(v * 100) / 100) + ' ' + units[i];
	}

	function toggleOperatorFields() {
		const t = $$('#guardIoOperatorType').val();
		$$('.guard-op-person').toggle(t === '1439');
		$$('.guard-op-contractor').toggle(t === '1440');
		$$('.guard-op-misc').toggle(t === '1441');
	}

	function renderItems() {
		const $tb = $$('#guardPartIoItemsTable tbody');
		$tb.empty();
		guardItems.forEach(function (item, idx) {
			let actions =
				'<button type="button" class="btn btn-sm btn-icon btn-light-primary" data-action="editItem" data-index="' + idx + '" title="ویرایش"><i class="fa fa-pen"></i></button> '
				+ '<button type="button" class="btn btn-sm btn-icon btn-light-danger" data-action="deleteItem" data-index="' + idx + '" title="حذف"><i class="fa fa-trash"></i></button>';
			if (item.fileId)
				actions = '<a class="btn btn-sm btn-icon btn-light-info" href="/File/DownloadFile?id=' + item.fileId + '" title="دانلود پیوست"><i class="fa fa-download"></i></a> ' + actions;
			$tb.append(
				'<tr>'
				+ '<td>' + esc(item.partTitle) + '</td>'
				+ '<td>' + esc(item.mount) + '</td>'
				+ '<td>' + esc(item.ioReasonTitle) + '</td>'
				+ '<td>' + esc(item.paperNumber) + '</td>'
				+ '<td>' + esc(item.relatedUnitTitle) + '</td>'
				+ '<td>' + esc(item.fileName) + '</td>'
				+ '<td>' + esc(formatBytes(item.fileSize)) + '</td>'
				+ '<td class="text-center">' + actions + '</td>'
				+ '</tr>'
			);
		});
	}

	function loadItemsFromServer(id) {
		if (!id) { guardItems = []; renderItems(); return; }
		$$.get('/Panel/Hrm/GuardPartIo/GetDetails?partIoId=' + id, function (r) {
			const rows = (r && r.isSuccess && r.data) ? r.data : (Array.isArray(r) ? r : (r && r.data) || []);
			guardItems = (rows || []).map(function (x) {
				return {
					id: x.id, htsId: x.htsId || 0, partId: x.partId, partTitle: x.partTitle || '',
					mount: x.mount, ioReason: x.ioReason, ioReasonTitle: x.ioReasonTitle || '',
					paperNumber: x.paperNumber || '', relatedUnitId: x.relatedUnitId,
					relatedUnitTitle: x.relatedUnitTitle || '', fileId: x.fileId,
					fileName: x.fileName || '', fileSize: x.fileSize
				};
			});
			renderItems();
		});
	}

	function decodeChildPartial(r) {
		if (window.appController && typeof appController.decodePartialResponse === 'function')
			return appController.decodePartialResponse(r);
		return { html: (typeof r === 'string' ? r : ''), scripts: [] };
	}

	function initModalWidgets($body) {
		setTimeout(function () {
			$body.find('.entity-selector-wrapper').each(function () {
				if (!$(this).data('readonly') && typeof $(this).entitySelector === 'function')
					$(this).entitySelector();
			});
			if (typeof initFileUploaders === 'function') initFileUploaders($body);
		}, 100);
	}

	function buildItemFormUrl(item) {
		let url = '/Panel/Hrm/GuardPartIo/ItemForm?';
		if (!item) return url;
		url += 'id=' + encodeURIComponent(item.id || '') + '&';
		url += 'partId=' + encodeURIComponent(item.partId || '') + '&';
		url += 'mount=' + encodeURIComponent(item.mount == null ? '' : item.mount) + '&';
		url += 'ioReason=' + encodeURIComponent(item.ioReason || '') + '&';
		url += 'paperNumber=' + encodeURIComponent(item.paperNumber || '') + '&';
		url += 'relatedUnitId=' + encodeURIComponent(item.relatedUnitId || '') + '&';
		url += 'fileId=' + encodeURIComponent(item.fileId || '');
		return url;
	}

	function openItemModal(item) {
		guardEditingIndex = item ? guardItems.indexOf(item) : null;
		const $trigger = $$('[data-action="addItem"]');
		$trigger.block();
		page.getPartialView(buildItemFormUrl(item), function (r) {
			$trigger.block(false);
			if (!r) { toastr.error('خطا در دریافت فرم'); return; }
			const decoded = decodeChildPartial(r);
			const $bodyCn = $('<div style="overflow-x:hidden;overflow-y:auto;max-height:70vh;"></div>').append(decoded.html || '');
			$.confirm({
				title: item ? 'ویرایش کالا' : 'افزودن کالا',
				columnClass: 'col-md-8',
				content: $bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: item ? 'ویرایش' : 'افزودن',
						btnClass: 'btn-primary',
						action: function () {
							const $content = this.$content;
							if (validateError($content)) return false;
							const m = $content.dataBind();
							if (!m.partId || m.partId === '0') { toastr.error('کالا نمی‌تواند خالی باشد'); return false; }
							if (m.mount === '' || m.mount == null || isNaN(Number(m.mount)) || Number(m.mount) < 0) {
								toastr.error('مقدار نامعتبر است'); return false;
							}
							if (!m.ioReason) { toastr.error('علت نمی‌تواند خالی باشد'); return false; }
							const duplicate = guardItems.some(function (x, i) {
								return String(x.partId) === String(m.partId) && i !== guardEditingIndex;
							});
							if (duplicate) { toastr.warning('امکان ثبت داده تکراری وجود دارد'); return false; }

							const row = {
								id: m.id || null,
								htsId: item ? (item.htsId || 0) : 0,
								partId: parseInt(m.partId, 10),
								partTitle: m.partTitle || '',
								mount: Number(m.mount),
								ioReason: parseInt(m.ioReason, 10),
								ioReasonTitle: $content.find('[data-bind="ioReason"] option:selected').text(),
								paperNumber: m.paperNumber || '',
								relatedUnitId: m.relatedUnitId ? parseInt(m.relatedUnitId, 10) : null,
								relatedUnitTitle: m.relatedUnitId ? (m.relatedUnitTitle || '') : '',
								fileId: m.fileId ? parseInt(m.fileId, 10) : null,
								fileName: '', fileSize: null
							};
							if (item && item.fileId && String(item.fileId) === String(row.fileId)) {
								row.fileName = item.fileName; row.fileSize = item.fileSize;
							}
							if (guardEditingIndex != null && guardEditingIndex >= 0)
								guardItems[guardEditingIndex] = row;
							else
								guardItems.push(row);
							renderItems();
							if (row.fileId && !row.fileName) {
								$$.get('/Panel/Hrm/GuardPartIo/GetFileInfo?id=' + row.fileId, function (fr) {
									const f = (fr && fr.isSuccess) ? fr.data : fr;
									if (f) { row.fileName = f.fileName || ''; row.fileSize = f.fileSize; renderItems(); }
								});
							}
						}
					},
					cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
				},
				onContentReady: function () { initModalWidgets(this.$body); }
			});
		});
	}

	function openQuickAdd($btn) {
		const type = $btn.data('type');
		const selectorId = $btn.data('selector');
		$btn.block();
		page.getPartialView('/Panel/Hrm/GuardPartIo/QuickForm?type=' + type, function (r) {
			$btn.block(false);
			if (!r) { toastr.error('خطا در دریافت فرم'); return; }
			const decoded = decodeChildPartial(r);
			const $bodyCn = $('<div style="overflow-x:hidden;"></div>').append(decoded.html || '');
			const titles = { contractor: 'افزودن پیمانکار', driver: 'افزودن راننده', location: 'افزودن مکان', part: 'افزودن کالا' };
			const urls = { contractor: '/Panel/Hrm/GuardContractor/Add', driver: '/Panel/Hrm/GuardDriver/Add', location: '/Panel/Hrm/GuardLocation/Add', part: '/Panel/Hrm/GuardPart/Add' };
			$.confirm({
				title: titles[type],
				columnClass: 'col-md-6',
				content: $bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-primary',
						action: function () {
							const $content = this.$content;
							if (validateError($content)) return false;
							const m = $content.dataBind();
							if (type === 'driver' && !m.name) m.name = '.';
							const jc = this;
							jc.showLoading(true);
							$$.post(urls[type], m, function (res) {
								jc.hideLoading(true);
								if (!res.isSuccess) { toastr.error(res.message, 'خطا'); return; }
								const d = res.data || {};
								let display = '';
								if (type === 'contractor') display = ((d.name || '') + ' ' + (d.family || '')).trim();
								else if (type === 'driver') display = ((d.name || '') + ' ' + (d.family || '')).trim() + ' | ' + (d.carName || '') + ' | ' + (d.licensePlate || '');
								else display = d.title || '';
								const $w = $$('#' + selectorId);
								if (typeof $w.entitySelector === 'function') $w.entitySelector();
								const sel = $w.data('entitySelector');
								if (sel && d.id) sel.select({ id: d.id, display: display });
								toastr.success('ذخیره سازی با موفقیت انجام شد');
								jc.close();
							});
							return false;
						}
					},
					cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
				}
			});
		});
	}

	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;
		const model = page.$pageEl.dataBind();
		const opType = String(model.operatorType || '');
		if (!model.ioType) { toastr.error('نوع ورود/خروج نمی‌تواند خالی باشد', 'خطا'); return; }
		if (!model.operatorType) { toastr.error('نوع اپراتور نمی‌تواند خالی باشد', 'خطا'); return; }
		if (opType === '1439' && (!model.personId || model.personId === '0')) { toastr.error('پرسنل نمی‌تواند خالی باشد', 'خطا'); return; }
		if (opType === '1440' && (!model.contractorId || model.contractorId === '0')) { toastr.error('پیمانکار نمی‌تواند خالی باشد', 'خطا'); return; }
		if (opType === '1441' && !(model.operatorTitle || '').trim()) { toastr.error('شخص متفرقه نمی‌تواند خالی باشد', 'خطا'); return; }
		if (guardItems.length < 1) { toastr.error('کالاها نمی‌تواند خالی باشد', 'خطا'); return; }

		// فقط فیلد مرتبط با نوع اپراتور ارسال می‌شود (مثل مقداردهی فرم HTS)
		if (opType !== '1439') model.personId = null;
		if (opType !== '1440') model.contractorId = null;
		if (opType !== '1441') model.operatorTitle = null;

		model.details = guardItems.map(function (x) {
			return {
				id: x.id, partId: x.partId, mount: x.mount, ioReason: x.ioReason,
				paperNumber: x.paperNumber || null, relatedUnitId: x.relatedUnitId, fileId: x.fileId
			};
		});

		const $btn = $($btnAction.element).block();
		$$.post(model.id ? 'update' : 'add', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			if (r.data && r.data.id)
				loadItemsFromServer(r.data.id);
			$btnAction.baseaction();
		});
	}

	self.FormActionButtons.save.onclick(function () { savefn(this); });
	if (self.FormActionButtons.saveandclose)
		self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });

	$$('#guardIoOperatorType').on('change', toggleOperatorFields);
	page.$pageEl.on('click', '[data-action="addItem"]', function () { openItemModal(null); });
	page.$pageEl.on('click', '[data-action="editItem"]', function () {
		openItemModal(guardItems[parseInt($(this).data('index'), 10)]);
	});
	page.$pageEl.on('click', '[data-action="quickAdd"]', function () { openQuickAdd($(this)); });
	page.$pageEl.on('click', '[data-action="deleteItem"]', function () {
		const idx = parseInt($(this).data('index'), 10);
		Swal.fire({
			title: 'حذف کالا', text: 'آیا مطمئن هستید؟', icon: 'warning',
			showCancelButton: true, confirmButtonText: 'بله', cancelButtonText: 'خیر'
		}).then(function (result) {
			if (!result.isConfirmed) return;
			guardItems.splice(idx, 1);
			renderItems();
		});
	});

	toggleOperatorFields();
	loadItemsFromServer(page.$pageEl.dataBind().id);
</script>

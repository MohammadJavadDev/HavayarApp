@using Entities.App.Sale
@{
	var parentId = (long)ViewBag.ParentId;
}
<div class="card" id="projectUtilizedMaterialChangeCard">
	<div class="card-header bg-white py-3">
		<h5 class="mb-0 fw-bold">سوابق تغییرات اقلام مصرفی در پروژه</h5>
	</div>
	<div class="card-body">
		<table class="table table-striped table-row-bordered gy-2 w-100" id="projectUtilizedMaterialChangeTable">
			<thead>
				<tr class="fw-bold fs-6 text-muted">
					<th>توضیحات</th>
					<th>ایجادکننده</th>
					<th>تاریخ</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
</div>
<script>
	const projectUtilizedMaterialChangeParentId = @parentId;
	$$('#projectUtilizedMaterialChangeTable').DataTable({
		serverSide: false,
		autoWidth: false,
		pageLength: 10,
		language: { url: '/panelLib/plugins/custom/datatables/fa.json' },
		ajax: {
			url: '/Panel/Sale/ProjectUtilizedMaterialChange/GetListByParentId?projectUtilizedMaterialId=' + projectUtilizedMaterialChangeParentId,
			type: 'GET',
			dataSrc: function (json) {
				if (json && json.isSuccess === false) {
					toastr.error(json.message || 'خطا در دریافت اطلاعات');
					return [];
				}
				return (json && json.data) ? json.data : (Array.isArray(json) ? json : []);
			}
		},
		columns: [
			{ data: 'comment', defaultContent: '-' },
			{ data: 'createdByName', defaultContent: '-' },
			{ data: 'createdOnShamsiDateTime', defaultContent: '-' }
		]
	});
</script>

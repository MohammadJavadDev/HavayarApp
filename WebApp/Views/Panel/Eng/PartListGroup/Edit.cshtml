@using Entities.App.Eng;
@using Entities.App.Inv
@model PartListGroup


<div class="card">
    <div class="form-action-buttons">
        <form-action-buttons entity-type="typeof(PartListGroup)"></form-action-buttons>
    </div>
</div>


<div class="card">
    <div class="card-body row">

        <div class="col-12 mb-4">
            <h3 class="fw-bold text-dark">اطلاعات اصلی</h3>
        </div>

        <input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />

        <div class="col-md-6">
            <label>محصول</label>
            @(Html.EntitySelector<Part>(
                        "ProductSelector",
                        c => c.IsActive == Entities.Base.IsActiveEnum.Active,
                        c => new { Id = c.Id, Code = c.Code, Name = c.Name },
                        c => new { c.Code, c.Name },
                        "{Code} {Name}",
                        "ProductId",
                        "ProductName",
                        Model?.ProductId?.ToString()
                        ))
            <div data-invalidmessagespan><span class="text-danger"></span></div>
        </div>

        <div class="col-md-6">
            <label>عنوان</label>
            <input class="form-control" data-bind="title" asp-for="Title" />
            <div data-invalidmessagespan><span class="text-danger"></span></div>
        </div>

        <div class="col-md-6">
            <label>ترتیب</label>
            <input class="form-control"
                   data-bind="order"
                   data-invalidMessage="فقط عدد"
                   data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$','placeholder':''"
                   asp-for="Order" />
            <div data-invalidmessagespan><span class="text-danger"></span></div>
        </div>

   
        <div class="col-md-6">
            <fileuploader bind="pictureId"
                          accepted-file-types=".jpg,.png"
                          file-id="@Model?.PictureId"
                          file-entity="@Model?.Picture"
                          entity-prop-name="Picture"
                          entity-type="@typeof(PartListGroup).FullName"
                          max-file-size="10"
                          label="تصویر">
            </fileuploader>
        </div>

        
        <div class="col-md-12">
            <label>توضیحات</label>
            <input class="form-control" data-bind="description" asp-for="Description" />
            <div data-invalidmessagespan><span class="text-danger"></span></div>
        </div>

    </div>
</div>


<div class="card mt-3">
    <div class="card-header d-flex justify-content-between">
        <span>پارت لیست</span>


        <button id="btnAddPartList" class="btn btn-success btn-sm">
            افزودن پارت لیست
        </button>
    </div>

    <div class="card-body">
        <div style="max-height:200px; overflow-y:auto;">
            <table class="table table-bordered" id="partListTable">
                <thead>
                    <tr>
                        <th>ردیف</th>
                        <th>دسته بندی</th>
                        <th>محصول</th>
                        <th>کالا</th>
                        <th>مقدار</th>
                        <th>ترتیب</th>
                        <th>توضیحات</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

</div>


<div class="modal fade" id="partListModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5>پارت لیست</h5>
            </div>

            <div class="modal-body" id="partListContainer"></div>

        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body row">
        <div class="col-md-3">
            <span>ایجاد کننده :</span>
            <span data-bind="createdByName">@Model?.CreatedByName</span>
        </div>
        <div class="col-md-3">
            <span>تاریخ ایجاد :</span>
            <span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
        </div>
        <div class="col-md-3">
            <span>ویرایش کننده :</span>
            <span data-bind="modifiedByName">@Model?.ModifiedByName</span>
        </div>
        <div class="col-md-3">
            <span>تاریخ ویرایش :</span>
            <span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
        </div>
    </div>
</div>

<script>

    function editPartList(id) {

    $$.get(`/Panel/Eng/PartList/GetById/${id}`, function (html) {
     
        $("#partListModalContent").html(html);
        
        $("#partListModal").modal("show");
    });
}

       
        window.openPartListModal = function (id = null) {

            const model = page.$pageEl.dataBind();

            if (!model.id) {
                toastr.warning("کاربر گرامی ابتدا دسته بندی پارت لیست را ذخیره نمایید.");
                return;
            }

            const url = `/Panel/Eng/PartList/CreateOrEdit?groupId=${model.id}&id=${id ?? ''}`;

            $("#partListContainer").load(url, function (response, status, xhr) {

                if (status === "error") {
                    console.error(xhr.responseText);
                    toastr.error("خطا در لود فرم");
                    return;
                }

                $("#partListModal").modal("show");
            });
        };


        $(document).on("click", "#btnAddPartList", function () {
            openPartListModal();
        });


         function loadPartListGrid() {

            $$.get(`/Panel/Eng/PartList/GetPartList`, function (res) {

                let rows = '';

                res.data.forEach(x => {
                    rows += `
                        <tr>
                            <td>${x.id}</td>
                            <td>${x.partListGroup?.title ?? ''}</td>
                            <td>${x.product?.name ?? ''}</td>
                            <td>${x.part?.name ?? ''}</td>
                            <td>${x.qty ?? ''}</td>
                            <td>${x.order ?? ''}</td>
                            <td>${x.description ?? ''}</td>
                            <td>
                                <button class="btn btn-sm btn-primary"
                                    onclick="editPartList(${x.id})">
                                    ویرایش
                                </button>
                            </td>
                        </tr>
                    `;
                });

                $("#partListTable tbody").html(rows);
            });
        }

        // 👇 برای مودال
        window.parentLoadPartList = loadPartListGrid;

        // ✅ On Page Load
        // $(document).ready(function () {
        //     if (page.$pageEl.dataBind().id) {
        //         loadPartListGrid();
        //     }
        // });

        $(document).ready(function () {
        loadPartListGrid();
    });



        // ✅ Save Group
        function savefn($btnAction) {

            if (validateError(page.$pageEl)) return;

            var model = page.$pageEl.dataBind();
            const $btn = $($btnAction.element).block();

            $$.post('save', model, function (r) {

                $btn.block(false);

                if (!r.isSuccess) {
                    toastr.error(r.message);
                    return;
                }

                toastr.success('ذخیره شد');

                page.$pageEl.dataBind(r.data);

                loadPartListGrid();

                $btnAction.baseaction();
            });
        }

        self.FormActionButtons.save.onclick(function () { savefn(this) });
        self.FormActionButtons.saveandnew.onclick(function () { savefn(this) });
        self.FormActionButtons.saveandclose.onclick(function () { savefn(this) });

</script>
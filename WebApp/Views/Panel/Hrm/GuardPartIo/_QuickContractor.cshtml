<div class="row g-3">
	<div class="col-md-6 form-group-inline">
		<label class="form-label fw-bold required">نام</label>
		<input class="form-control" data-bind="name" data-required="true" maxlength="50" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-6 form-group-inline">
		<label class="form-label fw-bold required">نام خانوادگی</label>
		<input class="form-control" data-bind="family" data-required="true" maxlength="50" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-6 form-group-inline">
		<label class="form-label fw-bold required">شماره تماس</label>
		<input class="form-control" data-bind="phoneNumber" data-required="true" maxlength="50" />
		<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
	</div>
	<div class="col-md-6 form-group-inline">
		<label class="form-label fw-bold">آدرس</label>
		<input class="form-control" data-bind="address" maxlength="128" />
	</div>
</div>

<div class="card">
<div class='  card-body row'>
		<div class='col-md-3'>
			<span>ایجاد کننده :</span>
			<span data-bind="createdByName">@Model?.CreatedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ایجاد :</span>
			<span data-bind="createdOnShamsiDateTime">@Model?.CreatedOnShamsiDateTime</span>
		</div>
		<div class='col-md-3'>
			<span>ویرایش کننده :</span>
			<span data-bind="modifiedByName">@Model?.ModifiedByName</span>
		</div>
		<div class='col-md-3'>
			<span>تاریخ ویرایش :</span>
			<span data-bind="modifiedDateShamsiDateTime">@Model?.ModifiedDateShamsiDateTime</span>
		</div>
	</div>
</div>

<script>
	 
	var infoType = @InfoType
	 
	if(infoType >0){
		$$(`[name=InfoType][value =${infoType}]`).prop("checked",true)
	}
	 
	function savefn($btnAction) {
	  
	 
		if(!$$("[name=InfoType]:checked").val())
		{
			return error2("نوع شناسنامه مشخص نشده است.");
		}
		 
		if (validateError($$('.card'))) { return; }
		var model = page.$pageEl.dataBind();
		model.InfoType = $$("[name=InfoType]:checked").val();
		const $btn = $(this.element).block();
		$$.post('save',
			model,
			function (r) {
				$btn.block(false);
				if (!r.isSuccess) return toastr.error(`${r.message}`, 'خطا');
				toastr.success('ذخیره سازی با موفقیت انجام شد .');
				$$('.card').dataBind(r.data);
				$$("#revision").val(r.data.revision)
				$btnAction.baseaction();
			})
	}

	self.FormActionButtons.save.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this) })
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this) })


	$$("[name=InfoType]").change(function(){
		var val =$(this).val();
		//ثابت و Psa یکی هستن
		if(val == "5")
		{
			val = "4"
		}
	  
		 $$("[data-info]").each((c,x)=>{
	    let infoTypes = $(x).data("info").toString();
	    if(infoTypes.includes(val))
	    {
		   $(x).show()
	    }
	    else
	    {
		    $(x).hide()
	    }

	})
	});

	self.FormActionButtons.showDataSheet.onclick(function(){
		var id = $$("[data-bind=id]").val()
		if(!id || id == 0)
		{
			return toastr.error("برای نمایش دیتاشیت اول شناسنامه محصول باید ذخیره شود.");
		}
		var revision = $$("#revision").val()

		if(!revision || revision ==0)
		{
			return toastr.error("نسخه شناسنامه نامشخص میباشد.");
		}
		var partId = $$("[data-bind=productId]").val()

		if(!partId || partId ==0 )
		{
			return toastr.error("محصول انتخاب نشده است");
		}

		var typeInfo =  $$("[name=InfoType]:checked").val();

	   if(!typeInfo || typeInfo == 0 )
		{
			return toastr.error("نوع شناسنامه انتخاب نشده است.");
		}

		if(typeInfo == 1)
		{
		   appController.addPage(`/System/ReportBuilder/ViewReportByName/partexterainfooilinject?productId={'values':['${partId}'],'condition':'='}&rev={'values':['${revision}'],'condition':'='}&autoRun=True`)

		}
		else if(typeInfo == 2){

	    appController.addPage(`/System/ReportBuilder/ViewReportByName/PartExteraInfoOilFree?productId={'values':['${partId}'],'condition':'='}&rev={'values':['${revision}'],'condition':'='}&autoRun=True`)

		}
		else if(typeInfo == 3){
			appController.addPage(`/System/ReportBuilder/ViewReportByName/PartExteraInfoDryer?productId={'values':['${partId}'],'condition':'='}&rev={'values':['${revision}'],'condition':'='}&autoRun=True`)

		}

		else if(typeInfo == 4){
		 appController.addPage(`/System/ReportBuilder/ViewReportByName/PartExteraInfoPsa?productId={'values':['${partId}'],'condition':'='}&rev={'values':['${revision}'],'condition':'='}&autoRun=True`)

		}

		else if(typeInfo == 5){
				    appController.addPage(`/System/ReportBuilder/ViewReportByName/PartExteraInfoPsa?productId={'values':['${partId}'],'condition':'='}&rev={'values':['${revision}'],'condition':'='}&autoRun=True`)

		}

 
	})
		 
</script>

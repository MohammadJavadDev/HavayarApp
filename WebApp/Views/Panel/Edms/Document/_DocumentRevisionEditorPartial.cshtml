@using Common.Utilities
@using Data.SystemAuth
@using Entities.App.Edms;
@using Entities.App.Edms.Enums
@using Entities.Auth
@inject ISdk sdk;
@model Document

@{

	var CanEditDocument = false;
	if (ViewData["CanEditDocument"] != null)
	{
		CanEditDocument = (bool)ViewData["CanEditDocument"];
	}

	var statusText = Model.Status.HasValue ? Model.Status.Value.ToDisplay() : "-";
	var statusClass = DocumentStatusPalette.BadgeClass(Model?.Status);
	var statusStyle = DocumentStatusPalette.BadgeStyle(Model?.Status);

	var canDeleteFiles = sdk.HasRole("Edms.Document.EditRev");

	var isNewDoc = Model.Id == null || Model?.Status == DocumentStatusEnums.NotIssue;

	// برگشت به کارتابل تهیه‌کننده: نظر بررسی‌کننده / تاییدکننده / DCC، یا رد DCC
	var returnedToProducer = Model?.Status is DocumentStatusEnums.CommentedByReviewer
		or DocumentStatusEnums.CommentedByApprover
		or DocumentStatusEnums.CommentedByDcc
		or DocumentStatusEnums.RejectByDcc;

	var holdFileReplace = Model?.Status is DocumentStatusEnums.Hold or DocumentStatusEnums.UnHold;

	var actionFlags = ViewData["ActionFlags"] as WebApp.ViewModels.Edms.DocumentEditActionFlags;
	var producerCanSave = actionFlags?.CanSaveAndClose == true;

	if (!canDeleteFiles && (isNewDoc || ((returnedToProducer || holdFileReplace) && producerCanSave)))
	{
		canDeleteFiles = true;
	}

	var canEditReplySheet = returnedToProducer && producerCanSave;

	var vpisProducerName = ViewData["VpisProducerName"] as string ?? "-";
	var vpisReviewerNames = ViewData["VpisReviewerNames"] as string ?? "-";
	var vpisApproverName = ViewData["VpisApproverName"] as string ?? "-";
}
<div id="DocumentRevisionEditor" data-transmittal-attachment-id="@(ViewData["TransmittalAttachmentId"] ?? 0)" data-reply-transmittal-attachment-id="@(ViewData["ReplyTransmittalAttachmentId"] ?? 0)">
	 
     <div class="card shadow-sm my-1">
		<div class="card-body row g-4">
			<input class='form-control' data-bind='id' value='@Model?.Id' type='hidden' />
			<input class='form-control' data-bind='projectId' value='@Model?.ProjectId' type='hidden' />
			<input class='form-control' data-bind='documentVpisId' value='@Model?.DocumentVpisId' type='hidden' />
			<input class='form-control' id="docStatus"  value='@Model?.Status' type='hidden' />
			<input class='form-control' id="projectId" value='@Model?.ProjectId' type='hidden' />

			<div class="col-12">
				<div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
					<div class="d-flex flex-wrap align-items-center gap-2">
						<span class="fw-bold">ریویژن</span>
						<span class="badge badge-light-primary">@Model?.Revision</span>
						<span class="text-muted">وضعیت:</span>
						<span class="@statusClass" style="@statusStyle">@statusText</span>
					</div>
					<div class="text-muted small">
						آخرین ویرایش: <span class="rtl">@(Model?.ModifiedDateShamsiDateTime ?? "-")</span>
					</div>
				</div>
			</div>

			<div class='col-md-4 form-group-inline'>
				<label class='form-label'>هدف از تولید مدرک</label>
				<select class='form-control' data-bind='goalOfProduction' asp-for='GoalOfProduction'
						asp-items="Html.GetEnumSelectList(typeof(Entities.App.Edms.Enums.DocumentGoalOfProductionEnum))">
				</select>
				<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
			</div>

			<div class='col-md-4 form-group-inline'>
				<label class='form-label required'>نفر-ساعت (ساعت:دقیقه)</label>
				<input class='form-control ltr' type='text' id='HourPrePerson' name='HourPrePerson' data-bind='hourPrePerson' data-duration-hm='true' required
					placeholder='__:__' value='@Common.Utilities.MinutesFromHourMinJsonConverter.MinToHourMin(Model?.HourPrePerson, hourLength: 2)' />
				<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
			</div>

			<div class='col-md-4 form-group-inline'>
				<label class='form-label required'>تاریخ انتشار/ارسال</label>
				<input class='form-control' data-bind='publicationShamsiDate' required data-persionDatePicker="true"
					persion-datetimepicker='{"format": "YYYY/MM/DD","autoClose": true,"initialValue": false}'
					value='@Model?.PublicationMiladiDate' />
				<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
			</div>

			<div class='col-md-4 form-group-inline d-none'>
				<label class='form-label'>رویژن</label>
				<input class='form-control' data-bind='revision' data-invalidMessage='فقط عدد'
					data-inputmask="'regex':'^[\u06F0-\u06F90-9]+$' , 'placeholder' : ''" asp-for='Revision' disabled />
				<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
			</div>
		

			<div class="col-md-4 form-group-inline">
				<label class="form-label">تهیه کننده</label>
				<input class="form-control" value="@vpisProducerName" readonly tabindex="-1" />
			</div>

			<div class="col-md-4 form-group-inline">
				<label class="form-label">بررسی کننده</label>
				<input class="form-control" value="@vpisReviewerNames" readonly tabindex="-1" />
			</div>

			<div class="col-md-4 form-group-inline">
				<label class="form-label">تایید کننده</label>
				<input class="form-control" value="@vpisApproverName" readonly tabindex="-1" />
			</div>

				<div class='col-md-4 form-group-inline d-none'>
				<label class='form-label'>وضعیت مدرک</label>
				<select class='form-control' data-bind='status' asp-for='Status'
					   asp-items="Html.GetEnumSelectList(typeof(Entities.App.Edms.Enums.DocumentStatusEnums))"
					   disabled="disabled">
				</select>
				<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
			</div>

			<div class='col-md-12 form-group-inline'>
				<label class='form-label'>توضیحات</label>
				<textarea class='form-control' data-bind='comment' asp-for='Comment'>@Model?.Comment</textarea>
				<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
			</div>

			<div class='col-md-6 '>
				<fileuploader bind="mainFileId" file-id="@Model?.MainFileId" file-entity="@Model?.MainFile"
						    label="فایل اصلی" entity-type="@typeof(Document).FullName" entity-prop-name="MainFile" bindid="mainFile"
						    max-file-size="100" accepted-file-types=".rar,.zip,.pdf,.excel,.word,.docx,.xls,.xlsx" show-delete="@canDeleteFiles"></fileuploader>
			</div>

			<div class='col-md-6'>
				<fileuploader bind="motherFileId" file-id="@Model?.MotherFileId" file-entity="@Model?.MotherFile"
						    label="فایل مادر" entity-type="@typeof(Document).FullName" entity-prop-name="MotherFile" bindid="motherFile"
						    max-file-size="100" accepted-file-types=".rar,.zip,.pdf,.excel,.word,.docx,.xls,.xlsx" show-delete="@canDeleteFiles"></fileuploader>
			</div>

			<div class='col-md-6'>
				<fileuploader bind="secondaryFileId" file-id="@Model?.SecondaryFileId" file-entity="@Model?.SecondaryFile"
						    label="فایل ثانوی" entity-type="@typeof(Document).FullName" entity-prop-name="SecondaryFile" bindid="secondaryFile"
						    max-file-size="100" accepted-file-types=".rar,.zip,.pdf,.excel,.word,.docx,.xls,.xlsx" show-delete="@canDeleteFiles"></fileuploader>
			</div>

			 
				<div class='col-md-6'>
					<fileuploader bind="replySheetId" file-id="@Model?.ReplySheetId" file-entity="@Model?.ReplySheet"
							    label="فایل ReplySheet" entity-type="@typeof(Document).FullName" entity-prop-name="ReplySheet" bindid="replySheet"
							    max-file-size="100" accepted-file-types=".rar,.zip,.pdf,.excel,.word,.docx,.xls,.xlsx" show-delete="true"></fileuploader>
				</div>

				@if (Model?.SecondReplySheetId is > 0)
				{
					<div class='col-md-6'>
						<label class='form-label'>فایل ثانوی ReplySheet</label>
						<div class="border rounded p-3 min-h-75px d-flex align-items-center justify-content-between gap-3">
							<div class="d-flex align-items-center gap-2 text-break">
								<i class="ki-duotone ki-file fs-2x text-primary"></i>
								<span>@(Model.SecondReplySheet?.OriginalName ?? $"فایل شماره {Model.SecondReplySheetId}")</span>
							</div>
							<a href="/File/download/@Model.SecondReplySheetId" class="btn btn-sm btn-light-primary" target="_blank" rel="noopener" title="دانلود فایل ثانوی ReplySheet">
								<i class="ki-duotone ki-arrow-down fs-5"></i>
								<span>دانلود</span>
							</a>
						</div>
					</div>
				}
			 
		 

		

		
		 
		</div>
 </div>
  
	<div class="card my-1">
		<div class="card-header pt-5">
			<div class="card-title d-flex flex-column">
				<span class="fs-6 fw-bold">کامنت ها و گردش فرآیند</span>
			
			</div>
		</div>
		<div class="card-body">
			<div class='col-md-12'>
				<div class=" ">
					@if (Model?.Comments != null)
					{
						foreach (var item in Model.Comments)
						{
							@await Html.PartialAsync("_DocumentCommentPartial.cshtml", item, ViewData)
						}
					}
				</div>
			</div>
		</div>

	</div>
 
	@{
		  actionFlags = ViewData["ActionFlags"] as WebApp.ViewModels.Edms.DocumentEditActionFlags
			?? new WebApp.ViewModels.Edms.DocumentEditActionFlags();
	}
	<script type="application/json" id="documentActionFlags">@Html.Raw(Json.Serialize(actionFlags))</script>
</div>
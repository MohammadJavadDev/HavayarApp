						<h6 class="fw-bold text-dark mb-0"><i class="bi bi-paperclip me-2"></i>مدیریت پیوست‌ها</h6>
						<button type="button" class="btn btn-sm btn-primary" id="btnAddNewAttachment">
							<i class="fa fa-plus me-1"></i>افزودن پیوست جدید
						</button>
					</div>
					<div id="attachments_content">
						@await Html.PartialAsync("_AttachmentListPartial.cshtml", attachmentListItems)
					</div>
				</div>

				<!-- Tab 7: تاریخچه کامنت‌ها -->
				<div class="tab-pane fade card card-body" id="tab_comments_@Model.Id" role="tabpanel">
					<div class="d-flex justify-content-between align-items-center mb-4">
						<h6 class="fw-bold text-dark mb-0"><i class="bi bi-chat-dots me-2"></i>تاریخچه کامنت‌ها</h6>
						<button type="button" class="btn btn-sm btn-primary" id="btnAddNewComment">
							<i class="fa fa-plus me-1"></i>افزودن کامنت
						</button>
					</div>
					<div id="comments_content">
							@await Html.PartialAsync("_CommentListPartial.cshtml", Model?.Comments)
					</div>
				</div>

				</div>
			</div>
		</div>
 
</div>
<script>
    var permissions = @Html.Raw(Json.Serialize(new {
				   isProjectOrSalesUnit,
				   isIndustrial,
				   isEngineering,
				   isSupply,
				   hasStopPermission,
				   hasStartPermission,
				   hasSendingPermission,
				   hasQueryPermission,
				   hasTerminatePermission,
				   hasConfigManagePermission
			    }));
	var openOrderRequest =  @Html.Raw(Json.Serialize(Model));
	 
	
	function initializePage(){
		  	 
	for(let btn in self.FormActionButtons)
	{
		self.FormActionButtons[btn].element.disabled = true;
	}

		self.FormActionButtons.history.element.disabled = false;
		self.FormActionButtons.addComment.element.disabled = false;
		self.FormActionButtons.addSupplier.element.disabled = false;

		 
	
		if(permissions.isEngineering)
		{

		    self.FormActionButtons.linkVpis.element.disabled = false;

		    if(!openOrderRequest.engineeringAccept && !openOrderRequest.isStop)
		      self.FormActionButtons.engineeringAccept.element.disabled = false
			 
		}

		if(permissions.isProjectOrSalesUnit)
		{

			self.FormActionButtons.salesOrProjectAccept.element.disabled = false;
		    
			 
		}
		permissions.stopOpersions = false;
		if(permissions.isIndustrial || permissions.isSupply || permissions.isEngineering || permissions.hasStopPermission)
		{
			permissions.stopOpersions = true;
		}
	 
		if(permissions.stopOpersions)
		{

			self.FormActionButtons.statusInquiry.element.disabled = false;
			self.FormActionButtons.inWayStatus.element.disabled = false;
			self.FormActionButtons.triggeringRequest.element.disabled = false;
			self.FormActionButtons.stopRequest.element.disabled = false;
			self.FormActionButtons.terminateRequest.element.disabled = false;
		  
		}
		

		if(permissions.hasConfigManagePermission)
		{
		   self.FormActionButtons.addRequestedPersonel.element.disabled = false;
		}

		if (permissions.isEngineering && !permissions.isIndustrial) {
            self.FormActionButtons.triggeringRequest.element.disabled = true;
		  self.FormActionButtons.inWayStatus.element.disabled = true;
		  self.FormActionButtons.statusInquiry.element.disabled = true;
		  self.FormActionButtons.terminateRequest.element.disabled = true;
        }
	}

	initializePage()
	
	self.FormActionButtons.addSupplier.onclick(function () {
	const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			toastr.error('ابتدا درخواست باز را ذخیره کنید');
			return;
		}
	})

	//#region Add Comment
	self.FormActionButtons.addComment.onclick(function () {
		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			toastr.error('ابتدا درخواست باز را ذخیره کنید');
			return;
		}

		const url = `/Panel/Sup/OpenOrderRequest/AddCommentPartial?openOrderRequestId=${openOrderRequestId}`;

		$$.get(url, function (result) {
			let bodyCn = `<div style="overflow-x: hidden;overflow-y: auto; max-height: 70vh;">${result}</div>`;
			$.confirm({
				title: 'افزودن کامنت',
				columnClass: 'col-md-8',
				content: bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-primary',
						action: function () {
							const $content = this.$content;

							if (validateError($content)) {
								return false;
							}

							const model = $content.dataBind();
							model.openOrderRequestId = openOrderRequestId;
							const self = this;

							$$.post('/Panel/Sup/OpenOrderRequest/SaveComment', model, function (r) {
								if (!r.isSuccess) {
									toastr.error(`${r.message}`, 'خطا');
									return false;
								}

								toastr.success('کامنت با موفقیت ذخیره شد');
								 
								self.close();
								page.close()
							});

							return false;
						}
					},
					cancel: {
						text: 'انصراف',
						btnClass: 'btn-secondary'
					}
				},
				onContentReady: function () {
					var self = this;
					setTimeout(function () {
						initPersionDatePicker(self.$body);
						self.$body.find('select.select2-hidden-accessible').each(function () {
							const $select = $$(this);
							const currentData = $select.select2('data');
							$select.select2('destroy');
							$select.select2({
								dropdownParent: self.$body,
								width: '100%',
								placeholder: $select.attr('placeholder') || 'انتخاب کنید'
							});
							if (currentData && currentData.length > 0) {
								$select.val($select.val()).trigger('change');
							}
						});
					}, 100);
				}
			});
		});
	});
	//#endregion

	//#region View Comments List (moved to tab)
	//#endregion

	//#region Engineering Accept
	self.FormActionButtons.engineeringAccept.onclick(function () {
		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			toastr.error('ابتدا درخواست باز را ذخیره کنید');
			return;
		}

		 
		if (!permissions.isEngineering) {
			toastr.error('شما دسترسی تایید مهندسی را ندارید');
			return;
		}

		$.confirm({
			title: 'تایید',
			content: 'آیا از تایید مهندسی این درخواست اطمینان دارید؟',
			rtl: true,
			buttons: {
				confirm: {
					text: 'بله',
					btnClass: 'btn-success',
					action: function () {
						debugger
						$$.post('/Panel/Sup/OpenOrderRequest/EngineeringAccept/'+openOrderRequestId, null, function (r) {
							if (!r.isSuccess) {
								toastr.error(`${r.message}`, 'خطا');
								return;
							}

							toastr.success('تایید مهندسی با موفقیت انجام شد');
						 
						});
					}
				},
				cancel: {
					text: 'انصراف',
					btnClass: 'btn-secondary'
				}
			}
		});
	});
	//#endregion

	//#region Sales/Project Accept
	self.FormActionButtons.salesOrProjectAccept.onclick(function () {
		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			toastr.error('ابتدا درخواست باز را ذخیره کنید');
			return;
		}

 

		if (!permissions.isProjectOrSalesUnit) {
			toastr.error('شما دسترسی تایید واحد فروش/پروژه را ندارید');
			return;
		}

		const url = `/Panel/Sup/OpenOrderRequest/SalesOrProjectAcceptPartial?openOrderRequestId=${openOrderRequestId}`;

		$$.get(url, function (result) {
			let bodyCn = `<div style="overflow-x: hidden;">${result}</div>`;
			$.confirm({
				title: 'تایید واحد فروش/پروژه',
				columnClass: 'col-md-6',
				content: bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'تایید',
						btnClass: 'btn-success',
						action: function () {
							const $content = this.$content;

							if (validateError($content)) {
								return false;
							}

							const model = $content.dataBind();
							model.openOrderRequestId = openOrderRequestId;
							const self = this;

							$$.post('/Panel/Sup/OpenOrderRequest/SalesOrProjectAccept', model, function (r) {
								if (!r.isSuccess) {
									toastr.error(`${r.message}`, 'خطا');
									return false;
								}

								toastr.success('تایید با موفقیت انجام شد');
							 
								self.close();
								page.close()
							});

							return false;
						}
					},
					cancel: {
						text: 'انصراف',
						btnClass: 'btn-secondary'
					}
				},
				onContentReady: function () {
					var self = this;
					setTimeout(function () {
						initPersionDatePicker(self.$body);
					}, 100);
				}
			});
		});
	});
	//#endregion

	//#region Stop Request
	self.FormActionButtons.stopRequest.onclick(function () {
		const openOrderRequestId = page.$pageEl.find('[data-bind="id"]').val();
		if (!openOrderRequestId || openOrderRequestId == '0') {
			toastr.error('ابتدا درخواست باز را ذخیره کنید');

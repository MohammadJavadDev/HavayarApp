@using Common.Auth.Enums
@using Data.SystemAuth
@using ReportBuilder.Entities
@using ReportBuilder.Services.Contracts
@using Services.AccessServices
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IReportBuilderService _reportBuilderService
@inject IAccessMemoryStorage _accessMemoryStorage
@inject ISdk _sdk
@{
	IgnoreBody();

	var dashbords = _reportBuilderService.GetDashboardSelectItemsByRole();

	if (_sdk.IsAdministrator)
	{
		var pageDashboards = _accessMemoryStorage.GetAllAccessControllers()
			.SelectMany(c => c.Actions ?? Enumerable.Empty<Entities.Auth.AccessAction>())
			.Where(a => a.ActionAccessItemType == ActionAccessItemType.Dashbord
				&& a.ActionAccessType == ActionAccessType.View
				&& !string.IsNullOrWhiteSpace(a.Path)
				&& a.Path.StartsWith("/"))
			.Select(a => new DashboardSelectItem
			{
				Title = string.IsNullOrWhiteSpace(a.DisplayName) ? a.Name : a.DisplayName,
				Url = a.Path,
				Type = "page"
			});

		dashbords = dashbords.Concat(pageDashboards).ToList();
	}
	else
	{
		var pageDashboards = (_sdk.CurrentUser?.RoleAccess ?? new List<RoleAccessDto>())
			.Where(c => c.ActionAccessItemType == ActionAccessItemType.Dashbord
				&& !string.IsNullOrWhiteSpace(c.Path)
				&& c.Path.StartsWith("/"))
			.Select(c => new DashboardSelectItem
			{
				Title = string.IsNullOrWhiteSpace(c.DisplayName) ? c.Path! : c.DisplayName!,
				Url = c.Path!,
				Type = "page"
			});

		dashbords = dashbords.Concat(pageDashboards).ToList();
	}
}
<!DOCTYPE html>
<html direction="rtl" dir="rtl" style="direction: rtl">

<head>


	<meta charset="utf-8" />
	<meta name="viewport" content="" width=device-width, initial-scale="1" />
	<title>@ViewData["Title"]  سیستم جامع هوایار</title>

	 
	<link rel="icon" href="~/panellib/media/icons/favicon.ico" type="image/x-icon" />
	<link rel="icon" type="image/png" sizes="128x128" href="~/panellib/media/icons/logo128.png" />
	<link rel="icon" type="image/png" sizes="144x144" href="~/panellib/media/icons/logo144.png" />
	<link rel="icon" type="image/png" sizes="192x192" href="~/panellib/media/icons/logo192.png" />
	<link rel="icon" type="image/png" sizes="48x48" href="~/panellib/media/icons/logo48.png" />
	<link rel="icon" type="image/png" sizes="512x512" href="~/panellib/media/icons/logo512.png" />

	<link href="~/css/site.css" rel="stylesheet" type="text/css" asp-append-version="true" />
	<link href="~/panelLib/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
	<link href="~/panelLib/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" />
	<link href="~/panelLib/plugins/custom/datatables/datatables.bundle.css" rel="stylesheet" type="text/css" />
	<link href="~/panelLib/plugins/custom/persion-datepicker/persion-datepicker.css" rel="stylesheet" type="text/css" />
	<link href="~/panelLib/plugins/custom/datatables/searchBuilder.dataTables.css"></link>
	<link href="~/panelLib/plugins/global/fonts/fontawesomeprov7.0.1/css/all.css" rel="stylesheet" />
	@await RenderSectionAsync("Style", required: false)
</head>

<body id="kt_app_body" data-kt-app-layout="dark-sidebar"
	 data-kt-app-header-fixed="true" data-kt-app-sidebar-enabled="true"
	 data-kt-app-sidebar-fixed="true" data-kt-app-sidebar-hoverable="true"
	 data-kt-app-sidebar-push-header="true" data-kt-app-sidebar-push-toolbar="true"
	 data-kt-app-sidebar-push-footer="true" data-kt-app-toolbar-enabled="true" class="app-default">

	<div class="d-flex flex-column flex-root app-root" id="kt_app_root">
		<div class="app-page flex-column flex-column-fluid" id="kt_app_page">
			@await Html.PartialAsync("~/Views/Panel/Shared/_AdminHeader.cshtml")
			<div class="app-wrapper flex-column flex-row-fluid" id="kt_app_wrapper">
				@await Html.PartialAsync("~/Views/Panel/Shared/_AdminSidebar.cshtml")
				<div class="app-main flex-column flex-row-fluid" id="kt_app_main">
					<div class="" id="tabsContainer">
						<li class="page_tab active_page_tab" id="dashbordTab">
							<span>داشبورد</span>
						</li>
					</div>
					<div id="pagesContainer">
						 <div class="tab-pane fade " data-sys="system-tab"  id="dashbordContent">
							<div class="row mb-4">
								<div class="col-md-6">
									<select class="form-select" id="selectDashbords">
										<option value="0">
											انتخاب کنید
										</option>
										@foreach(var r in dashbords)
										{
											var optionValue = r.Type == "stimulsoft" ? $"stimulsoft:{r.Id}" : $"page:{r.Url}";
											<option value="@optionValue" data-type="@r.Type" data-url="@r.Url">
												@r.Title
											</option>
										}
									</select>
								</div>
							</div>
							<div id="dashbordRenderArea"></div>
						</div> 
					</div>
				</div>
			</div>
		</div>
	</div>
	<div id="kt_scrolltop" class="scrolltop" data-kt-scrolltop="true">
		<i class="ki-duotone ki-arrow-up">
			<span class="path1"></span>
			<span class="path2"></span>
		</i>
	</div>

     <script src="~/js/static.js"></script>
 	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/panelLib/js/scripts.bundle.js"></script>
	<script src="~/panelLib/plugins/custom/datatables/datatables.bundle.js"></script>
	<script src="~/panellib/plugins/custom/dropzone/dropzone.js"></script>
	<script src="~/panelLib/plugins/custom/persion-datepicker/persian-date.js"></script>
	<script src="~/panelLib/plugins/custom/persion-datepicker/persion-datepicker.js"></script>

	<script src="~/panelLib/plugins/custom/inputmask/jquery.inputmask.js"></script>
	<script src="~/panelLib/plugins/custom/inputmask/inputmask.binding.js"></script>

	<script src="~/panelLib/plugins/custom/xlsx/xlsx.full.min.js"></script>
	<script src="~/lib/signalr/signalr.js"></script>
	<script>
		window.AppConfig = {
			realtimeHubUrl: "@Configuration["RealtimeHub:Url"]"
		};
	</script>

	<script src="~/panellib/plugins/custom/querybuilder/querybuilder.js" asp-append-version="true"></script>
	<script src="~/panellib/js/panel.js" asp-append-version="true"></script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

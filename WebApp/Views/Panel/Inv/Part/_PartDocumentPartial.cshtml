@using Entities.App.Hrm
@using Entities.App.Inv;
@using Entities.App.Inv.Enums
@model PartDocument
<div class="entity-item">
	<input class='form-control' type="hidden" data-bind='documents.id' value='@Model?.Id' />
	<div class='col-md-3 align-content-center'>
		<div class="form-check">
			<input data-bind='documents.main' class="form-check-input" type="checkbox" value='@Model?.Main' />
			<label class="form-check-label">
				اصلی
			</label>
		</div>
	</div>

	<div class='col-md-3'>
		<label class=''>نوع</label>
		<select class='form-control' data-bind='documents.type'  asp-for='Type' asp-items="Html.GetEnumSelectList(typeof(PartDocumentTypeEnum))">
		</select>
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>

	<div class='col-md-3'>
		<label class=''>واحد سازمانی</label>
		@(Html.EntitySelector<OrgUnit>(
			"documentsOrganizationUnitSelector",
			c => c.IsActive == Entities.Base.IsActiveEnum.Active,
			c => new
			{
				Id = c.Id, Title = c.Title
			},
			c => new { c.Title },
			"{Title}",
			"documents.organizationUnitId",
			"documents.organizationUnitName",
			Model?.OrganizationUnitId?.ToString()
		))
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>

	<div class='col-md-3'>
		<label class=''>کامنت</label>
		<input class='form-control' data-bind='documents.comment'  value='@Model?.Comment' />
		<div data-invalidmessagespan class='my-1 mx-1'> <span class='text-danger'></span> </div>
	</div>

	<div class='col-md-3'>
		<fileuploader bind="documents.attachmentId"
		accepted-file-types=".pdf,.zip,.png,.jpg"
			file-id="@Model?.AttachmentId"
			file-entity="@Model?.Attachment"
			entity-prop-name="AttachmentId"
			required=true
			max-file-size="10"
			label="پیوست"></fileuploader>
	</div>

</div>

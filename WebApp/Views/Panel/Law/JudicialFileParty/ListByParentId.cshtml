@{
	var parentId = (long)ViewBag.ParentId;
}
<div class="card" id="JudicialFilePartyChildCard">
	<div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
		<h5 class="mb-0 fw-bold">طرفین پرونده</h5>
		<button type="button" class="btn btn-sm btn-primary" data-action="newJudicialFileParty">افزودن</button>
	</div>
	<div class="card-body">
		<table class="table table-striped table-row-bordered gy-2 w-100" id="JudicialFilePartyChildTable">
			<thead>
				<tr class="fw-bold fs-6 text-muted">
					<th>عنوان</th>
					<th>نام و نام خانوادگی / نام شرکت</th>
					<th>ایجاد کننده</th>
					<th>تاریخ ایجاد</th>
					<th style="width:120px;">عملیات</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
</div>
<script>
	const judicialFilePartyParentId = @parentId;
	const judicialFilePartyTable = $$('#JudicialFilePartyChildTable').DataTable({
		serverSide: false,
		autoWidth: false,
		pageLength: 10,
		language: { url: '/panelLib/plugins/custom/datatables/fa.json' },
		ajax: {
			url: '/Panel/Law/JudicialFileParty/GetListByParentId?judicialFileId=' + judicialFilePartyParentId,
			type: 'GET',
			dataSrc: function (json) {
				if (json && json.isSuccess === false) {
					toastr.error(json.message || 'خطا در دریافت اطلاعات');
					return [];
				}
				return (json && json.data) ? json.data : (Array.isArray(json) ? json : []);
			}
		},
		columns: [
			{ data: 'typeTitle', defaultContent: '-' },
			{ data: 'fullname', defaultContent: '-' },
			{ data: 'createdByName', defaultContent: '-' },
			{ data: 'createdOnShamsiDateTime', defaultContent: '-' },
			{
				data: null,
				orderable: false,
				className: 'text-center dt-ellipsis-skip',
				render: function (row) {
					const view = row.fileId
						? '<a class="btn btn-sm btn-icon btn-light-primary" href="/File/download/' + row.fileId + '" target="_blank"><i class="fa fa-eye"></i></a> '
						: '';
					return view
						+ '<button type="button" class="btn btn-sm btn-icon btn-light-danger" data-action="deleteJudicialFileParty" data-id="' + row.id + '"><i class="fa fa-trash"></i></button>';
				}
			}
		]
	});

	function openJudicialFilePartyModal() {
		const url = '/Panel/Law/JudicialFileParty/New?judicialFileId=' + judicialFilePartyParentId;
		const $trigger = $$('#JudicialFilePartyChildCard').find('[data-action="newJudicialFileParty"]');
		$trigger.block();
		page.getPartialView(url, function (r) {
			$trigger.block(false);
			if (!r) {
				toastr.error('خطا در دریافت فرم', 'خطا');
				return;
			}
			const decoded = (window.appController && typeof appController.decodePartialResponse === 'function')
				? appController.decodePartialResponse(r)
				: { html: (typeof r === 'string' ? r : ''), scripts: [] };
			const $bodyCn = $('<div style="overflow-x:hidden;overflow-y:auto;max-height:70vh;"></div>').append(decoded.html || '');
			$bodyCn.find('.form-action-buttons').remove();
			$.confirm({
				title: 'افزودن طرف پرونده',
				columnClass: 'col-md-8',
				content: $bodyCn,
				rtl: true,
				buttons: {
					save: {
						text: 'ذخیره',
						btnClass: 'btn-primary',
						action: function () {
							const $content = this.$content;
							if (validateError($content)) return false;
							const model = $content.dataBind();
							const selfConfirm = this;
							const $saveBtn = $(this.buttons.save.el).block();
							$$.post('/Panel/Law/JudicialFileParty/save', model, function (resp) {
								$saveBtn.block(false);
								if (!resp.isSuccess) {
									toastr.error(resp.message || 'خطا در ذخیره', 'خطا');
									return;
								}
								toastr.success('ذخیره سازی با موفقیت انجام شد');
								selfConfirm.close();
								judicialFilePartyTable.ajax.reload(null, false);
							});
							return false;
						}
					},
					cancel: { text: 'انصراف', btnClass: 'btn-secondary' }
				},
				onContentReady: function () {
					const selfConfirm = this;
					setTimeout(function () {
						if (typeof initPersionDatePicker === 'function')
							initPersionDatePicker(selfConfirm.$body);
						if (typeof initMoneyInputs === 'function')
							initMoneyInputs(selfConfirm.$body);
						if (typeof initFileUploaders === 'function')
							initFileUploaders(selfConfirm.$body);
					}, 100);
				}
			});
		});
	}

	$$('#JudicialFilePartyChildCard').on('click', '[data-action="newJudicialFileParty"]', function () {
		openJudicialFilePartyModal();
	});
	$$('#JudicialFilePartyChildCard').on('click', '[data-action="deleteJudicialFileParty"]', function () {
		const id = $(this).data('id');
		Swal.fire({ title: 'حذف', text: 'آیا از حذف این ردیف مطمئن هستید؟', icon: 'warning', showCancelButton: true, confirmButtonText: 'بله', cancelButtonText: 'خیر' })
			.then(function (result) {
				if (!result.isConfirmed) return;
				$$.get('/Panel/Law/JudicialFileParty/Delete?id=' + id, function (r) {
					if (r && r.isSuccess === false) { toastr.error(r.message || 'خطا در حذف'); return; }
					toastr.success('رکورد با موفقیت حذف شد');
					judicialFilePartyTable.ajax.reload(null, false);
				});
			});
	});
</script>

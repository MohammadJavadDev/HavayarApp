</div>
<script>

         function addNumericSeparator(value) {
             if (value === null || value === undefined || value === '') return '';
             var numStr = value.toString().replace(/[^0-9]/g, '');
             if (numStr === '') return '';
             return numStr.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
         }

         function removeNumericSeparator(value) {
             if (value === null || value === undefined) return '';
             return value.toString().replace(/,/g, '');
         }

         function formatNumberFa(value) {
             if (value === null || value === undefined || value === '') return '-';
             var numStr = value.toString().replace(/[^0-9]/g, '');
             if (numStr === '') return '-';
             var faDigits = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
             var formatted = numStr.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
             $.each(faDigits, function(i, d) {
                 formatted = formatted.replace(new RegExp(i, 'g'), d);
             });
             return formatted;
         }

         function fixFieldTypes() {
             var numericFields = [
                 '[data-bind="breakfastPrice"]',
                 '[data-bind="lunchPrice"]',
                 '[data-bind="dinnerPrice"]',
                 '[data-bind="nightShiftAllowance"]',
                 '[data-bind="workOvertimeFee"]',
                 '[data-bind="missionRight"]',
                 '[data-bind="transportationPersonal"]',
                 '[data-bind="transportationDriving"]',
                 '[data-bind="missionHolidayRight"]',
                 '[data-bind="otherCost"]'
             ];

             $(numericFields.join(', ')).each(function() {
                 if ($(this).attr('type') === 'number' || $(this).attr('type') === undefined) {
                     $(this).attr('type', 'text');
                     $(this).attr('inputmode', 'numeric');
                     $(this).attr('pattern', '[0-9,]*');
                 }
             });
             }

         function formatNumberField($field) {
             if (!$field || $field.length === 0) return;

             var currentValue = $field.val();
             if (!currentValue || currentValue === '') return;

             var pureNumber = currentValue.replace(/[^0-9]/g, '');

             if (pureNumber === '') {
                 $field.val('');
                 return;
             }

             var formatted = pureNumber.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
             $field.val(formatted);
         }

         var numericFieldSelectors = [
             '[data-bind="breakfastPrice"]',
             '[data-bind="lunchPrice"]',
             '[data-bind="dinnerPrice"]',
             '[data-bind="nightShiftAllowance"]',
             '[data-bind="workOvertimeFee"]',
             '[data-bind="missionRight"]',
             '[data-bind="transportationPersonal"]',
             '[data-bind="transportationDriving"]',
             '[data-bind="missionHolidayRight"]',
             '[data-bind="otherCost"]'
         ];

         var numericFieldsSelector = numericFieldSelectors.join(', ');

         $(document).ready(function() {

             fixFieldTypes();

             $(document).on('keyup', numericFieldsSelector, function(e) {
                 formatNumberField($(this));
             });

             $(document).on('blur', numericFieldsSelector, function() {
                 formatNumberField($(this));
             });

             $(document).on('input', numericFieldsSelector, function() {
                 var value = $(this).val();
                 var filtered = value.replace(/[^0-9,]/g, '');
                 if (filtered !== value) {
                     $(this).val(filtered);
                 }
             });

             $(numericFieldsSelector).each(function() {
                 formatNumberField($(this));
             });

             setInterval(function() {
                 fixFieldTypes();

                 $(numericFieldsSelector).each(function() {
                     var value = $(this).val();
                     if (value && value.length > 3 && value.indexOf(',') === -1) {
                         formatNumberField($(this));
                     }
                 });
             }, 500);
         });

         $('#btnGetMissionRight').on('click', function() {
             var personelId = $('[data-bind="PersonelId"]').val() || $('select[name="PersonelId"]').val();
             var fromDate = $('[data-bind="DispatchShamsiDate"]').val() || $('input[data-bind="DispatchShamsiDate"]').val();
             var toDate = $('[data-bind="returnShamsiDate"]').val() || $('input[data-bind="returnShamsiDate"]').val();
             var fromHour = $('[data-bind="fromHour"]').val() || $('input[data-bind="fromHour"]').val();
             var toHour = $('[data-bind="toHour"]').val() || $('input[data-bind="toHour"]').val();

             if (!personelId || personelId === '0') {
                 toastr.warning('لطفا ابتدا پرسنل را انتخاب کنید');
                 return;
             }

             if (!fromDate) {
                 toastr.warning('لطفا تاریخ اعزام را انتخاب کنید');
                 return;
             }

             if (!toDate) {
                 toastr.warning('لطفا تاریخ برگشت را انتخاب کنید');
                 return;
             }

             var $btn = $(this);
             var btnOriginalText = $btn.html();
             $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> در حال دریافت...');

             $.ajax({
                 url: '/Panel/Sale/SaleMission/GetSaleMissionPrice',
                 type: 'GET',
                 data: {
                     id: personelId,
                     fromDate: fromDate,
                     toDate: toDate,
                     fromHour: fromHour,
                     toHour: toHour
                 },
                 dataType: 'json',
                 success: function(response) {
                     $btn.prop('disabled', false).html(btnOriginalText);

                     if (response && response.isSuccess) {
                         var list = response.data.result || response.data;
                         if ($.isArray(list) && list.length > 0) {
                             var data = list[0];
                             applyMissionDataToForm(data);
                             toastr.success('اطلاعات حق ماموریت با موفقیت دریافت و اعمال شد');
                         } else if (!$.isArray(list) && list) {
                             applyMissionDataToForm(list);
                             toastr.success('اطلاعات حق ماموریت با موفقیت دریافت و اعمال شد');
                         } else {
                             toastr.warning('هیچ اطلاعاتی برای این پرسنل یافت نشد');
                         }
                     } else {
                         toastr.error(response.message || 'خطا در دریافت اطلاعات');
                     }
                 },
                 error: function(xhr) {
                     $btn.prop('disabled', false).html(btnOriginalText);

                     var errorMessage = 'خطا در ارتباط با سرور';
                     if (xhr.responseJSON && xhr.responseJSON.message) {
                         errorMessage = xhr.responseJSON.message;
                     }
                     toastr.error(errorMessage);
                 }
             });
         });


         function applyMissionDataToForm(data) {
             if (data.breakfastFee !== null && data.breakfastFee !== undefined) {
                 $('[data-bind="breakfastPrice"]').val(addNumericSeparator(data.breakfastFee));
             }
             if (data.lunchFee !== null && data.lunchFee !== undefined) {
                 $('[data-bind="lunchPrice"]').val(addNumericSeparator(data.lunchFee));
             }
             if (data.dinnerFee !== null && data.dinnerFee !== undefined) {
                 $('[data-bind="dinnerPrice"]').val(addNumericSeparator(data.dinnerFee));
             }
             if (data.nightRight !== null && data.nightRight !== undefined) {
                 $('[data-bind="nightShiftAllowance"]').val(addNumericSeparator(data.nightRight));
             }
             if (data.missionRight !== null && data.missionRight !== undefined) {
                 $('[data-bind="missionRight"]').val(addNumericSeparator(data.missionRight));
             }
             if (data.transportationPersonal !== null && data.transportationPersonal !== undefined) {
                 $('[data-bind="transportationPersonal"]').val(addNumericSeparator(data.transportationPersonal));
             }
             if (data.transportationDriving !== null && data.transportationDriving !== undefined) {
                 $('[data-bind="transportationDriving"]').val(addNumericSeparator(data.transportationDriving));
             }
             if (data.workOvertimeFee !== null && data.workOvertimeFee !== undefined) {
                 $('[data-bind="workOvertimeFee"]').val(addNumericSeparator(data.workOvertimeFee));
             }
            if (data.workOvertimeHour !== null && data.workOvertimeHour !== undefined) {
             // اگر مقدار شامل : نیست، فرمت کن
             var hourValue = data.workOvertimeHour.toString();
             if (hourValue.indexOf(':') === -1) {
                 // فرض می‌کنیم مقدار مثل 700 یا 0700 هست
                 hourValue = hourValue.replace(/[^0-9]/g, '');
                 if (hourValue.length === 4) {
                     hourValue = hourValue.substring(0, 2) + ':' + hourValue.substring(2, 4);
                 } else if (hourValue.length === 3) {
                     hourValue = '0' + hourValue.substring(0, 1) + ':' + hourValue.substring(1, 3);
                 }
             }
             $('[data-bind="workOvertimeHour"]').val(hourValue);
         }
             if (data.missionHolidayRight !== null && data.missionHolidayRight !== undefined) {
                 $('[data-bind="missionHolidayRightFactor"]').val(addNumericSeparator(data.missionHolidayRight));
             }
             if (data.otherCost !== null && data.otherCost !== undefined) {
                 $('[data-bind="otherCost"]').val(addNumericSeparator(data.otherCost));
             }
             if (data.dailySalary !== null && data.dailySalary !== undefined) {
                 $('[data-bind="dailySalary"]').val(addNumericSeparator(data.dailySalary));
             }
             if (data.breakfastQuantity !== null && data.breakfastQuantity !== undefined) {
                 $('[data-bind="breakfastQuantity"]').val(data.breakfastQuantity);
             }
             if (data.lunchQuantity !== null && data.lunchQuantity !== undefined) {
                 $('[data-bind="lunchQuantity"]').val(data.lunchQuantity);
             }
             if (data.dinnerQuantity !== null && data.dinnerQuantity !== undefined) {
                 $('[data-bind="dinnerQuantity"]').val(data.dinnerQuantity);
             }
             if (data.missionRightFactor !== null && data.missionRightFactor !== undefined) {
                 $('[data-bind="missionRightFactor"]').val(data.missionRightFactor);
             }
             if (data.nightShiftCoefficient !== null && data.nightShiftCoefficient !== undefined) {
                 $('[data-bind="nightShiftCoefficient"]').val(data.nightShiftCoefficient);
             }

             toastr.info('مقادیر با موفقیت در فرم اعمال شد');
         }


         function formatTimeInput($input) {
             if (!$input || $input.length === 0) return '';

             var val = $input.val().replace(/[^0-9]/g, '');

             if (val.length === 0) {
                 $input.val('');
                 return '';
             }

             if (val.length >= 3) {
                 var hours = val.substring(0, val.length - 2);
                 var minutes = val.substring(val.length - 2);

                 if (hours.length === 1) hours = '0' + hours;
                 var hourNum = parseInt(hours, 10);
                 var minuteNum = parseInt(minutes, 10);

                 if (hourNum > 23) hours = '23';
                 if (minuteNum > 59) minutes = '59';

                 var formattedTime = hours + ':' + minutes;
                 $input.val(formattedTime);
                 return formattedTime;
             } else {
                 $input.val(val);
                 return val;
             }
     }




                $(document).ready(function() {
             $(document).on('blur', '.time-input', function() {
                 formatTimeInput($(this));
             });

             $(document).on('input', '.time-input', function() {
                 var val = $(this).val().replace(/[^0-9]/g, '');
                 if (val.length > 4) {
                     val = val.substring(0, 4);
                 }
                 $(this).val(val);
             });

             $(document).on('keydown', '.time-input', function(e) {
                 if (e.key === 'Backspace' || e.key === 'Delete' || e.key === 'Tab' ||
                     e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === 'Home' ||
                     e.key === 'End' || e.key === 'Enter') {
                     return;
                 }

                 if (!/^[0-9]$/.test(e.key)) {
                     e.preventDefault();
                     return false;
                 }
             });
         });

         function savefn(btnActionContext) {
             if (validateError(page.$pageEl)) return;

             $('.time-input').each(function() {
                 formatTimeInput($(this));
             });

             var model = page.$pageEl.dataBind();
             model.ServiceRequestId = sessionStorage.getItem("ServiceRequestId") || "@Model?.ServiceRequestId";

             if (model.fromHour && model.fromHour.indexOf(':') === -1) {
                 model.fromHour = formatTimeInput($('#fromHour'));
             }
             if (model.toHour && model.toHour.indexOf(':') === -1) {
                 model.toHour = formatTimeInput($('#toHour'));
             }
                 if (model.workOvertimeHour && model.workOvertimeHour.indexOf(':') === -1) {
             model.workOvertimeHour = formatTimeInput($('#workOvertimeHour'));
         }

             var amountFields = [
                 'breakfastPrice', 'lunchPrice', 'dinnerPrice',
                 'nightShiftAllowance',
                 'workOvertimeFee',
                 'missionRight',
                 'transportationPersonal', 'transportationDriving',
                 'missionHolidayRightFactor', 'otherCost' ,'missionHolidayRight'
             ];

             $.each(amountFields, function(index, field) {
                 if (model[field]) {
                     model[field] = removeNumericSeparator(model[field]);
                 }
             });

             var $btn = $(btnActionContext.element);
             $btn.prop('disabled', true);
             var btnOriginalText = $btn.html();
             $btn.html('<i class="fa fa-spinner fa-spin"></i> در حال ذخیره...');

             $.ajax({
                 url: 'save',
                 type: 'POST',
                 data: JSON.stringify(model),
                 contentType: 'application/json',
                 dataType: 'json',
                 success: function(r) {
                     $btn.prop('disabled', false).html(btnOriginalText);

                     if (!r.isSuccess) {
                         toastr.error(r.message, 'خطا');
                         return;
                     }

                     toastr.success('ذخیره سازی با موفقیت انجام شد');

                     page.$pageEl.dataBind(r.data);

                     setTimeout(function() {
                         fixFieldTypes();
                         $(numericFieldsSelector).each(function() {
                             formatNumberField($(this));
                         });
                     }, 100);

                     var parentId = r.data ? (r.data.serviceRequestId || r.data.ServiceRequestId || model.ServiceRequestId) : model.ServiceRequestId;
                     if (typeof window.reloadSaleMissionList === 'function' && parentId) {
                         window.reloadSaleMissionList(parentId);
                     }

                     if (btnActionContext && typeof btnActionContext.baseaction === 'function') {
                         btnActionContext.baseaction();
                     }
                 },
                 error: function() {
                     $btn.prop('disabled', false).html(btnOriginalText);
                     toastr.error('خطا در ارتباط با سرور', 'خطا');
                 }
             });
         }


         function getServiceRequestId() {
             return $('[data-bind="id"]').val();
         }

         function loadServiceRequestDetails(serviceRequestId) {
             if (!serviceRequestId || serviceRequestId === '0') {
                 $('#contractorTableBody').html(
                     '<tr>' +
                     '<td colspan="13" class="text-center text-warning">شناسه معتبر نیست</td>' +
                     '</tr>'
                 );
                 return;
             }

             $.ajax({
                 url: '/Panel/Sale/ServiceRequest/GetServiceRequest',
                 type: 'GET',
                 data: { serviceRequestId: serviceRequestId },
                 dataType: 'json',
                 success: function(res) {
                     if (res && res.isSuccess === true && $.isArray(res.data)) {
                         renderServiceRequestDetails(res.data);
                     } else {
                         $('#contractorTableBody').html(
                             '<tr>' +
                             '<td colspan="13" class="text-center text-warning">اطلاعاتی یافت نشد</td>' +
                             '</tr>'
                         );
                     }
                 },
                 error: function() {
                     $('#contractorTableBody').html(
                         '<tr>' +
                         '<td colspan="13" class="text-center text-danger">خطا در دریافت اطلاعات</td>' +
                         '</tr>'
                     );
                 }
             });
         }

         function renderServiceRequestDetails(list) {
             var SaleRequestTypeEnum = {
                 1: 'آموزش',
                 2: 'اورهال',
                 3: 'بازدید و مشاوره',
                 4: 'تعمیرات گارانتی',
                 5: 'تعمیرات وارانتی',
                 6: 'راه اندازی اولیه',
                 7: 'پایپینگ',
                 8: 'سرویس دوره ای',
                 9: 'سایر موارد',
                 10: 'OPI',
                 11: 'راه اندازی تجهیز تعمیری',
                 12: 'پیش راه اندازی',
                 13: 'نصب'
             };

             var tbody = $('#contractorTableBody');
             tbody.empty();

             $.each(list, function(index, item) {
                 var requestTypeName = SaleRequestTypeEnum[item.requestType] || 'نامشخص';
                 var itemId = item.id || 0;
                 var partName = (item.part && item.part.name) ? item.part.name : '-';
                 var costFormatted = item.cost ? formatNumberFa(item.cost) : '-';

                 var row =
                     '<tr data-id="' + itemId + '">' +
                     '<td class="text-center">' +
                     '<button class="btn btn-warning btn-sm" data-action="editDetail" data-id="' + itemId + '">' +
                     '<i class="fa fa-pencil"></i>' +
                     '</button>' +
                     '<button class="btn btn-danger btn-sm" data-action="deleteDetail" data-id="' + itemId + '">' +
                     '<i class="fa fa-trash"></i>' +
                     '</button>' +
                     '</td>' +
                     '<td>' + (index + 1) + '</td>' +
                     '<td>' + requestTypeName + '</td>' +
                     '<td class="text-end">' + costFormatted + '</td>' +
                     '<td>' + partName + '</td>' +
                     '<td>' + (item.sendPartShamsiDate || '-') + '</td>' +
                     '<td>' + (item.contractorAcceptShamsiDate || '-') + '</td>' +
                     '<td>' + (item.noticeShamsiDate || '-') + '</td>' +
                     '<td>' + (item.noticeTime || '-') + '</td>' +
                     '</tr>';

                 tbody.append(row);
             });
         }

         function refreshServiceRequestDetails() {
             var serviceRequestId = getServiceRequestId();
             if (!serviceRequestId) return;

             $('#contractorTableBody').html(
                 '<tr>' +
                 '<td colspan="13" class="text-center py-4">' +
                 '<div class="spinner-border text-primary"></div>' +
                 '</td>' +
                 '</tr>'
             );

             loadServiceRequestDetails(serviceRequestId);
         }

         $(document).on('click', '[data-action="addNewContractor"]', function() {
             var serviceRequestId = getServiceRequestId();
             if (!serviceRequestId) {
                 toastr.error('ابتدا اطلاعات را ذخیره کنید');
                 return;
             }

             var url = '/Panel/Sale/ServiceRequest/ShowProductDetailForm?serviceRequestId=' + serviceRequestId;

             $.get(url, function(html) {
                 var bodyCn = $('<div style="overflow-y:auto;max-height:70vh;"></div>');
                 bodyCn.html(html);
                 initPersionDatePicker(bodyCn);

                 $.confirm({
                     title: 'افزودن آیتم',
                     columnClass: 'col-md-6',
                     content: bodyCn,
                     rtl: true,
                     buttons: {
                         save: {
                             text: 'ذخیره',
                             btnClass: 'btn-success',
                             action: function() {
                                 var $content = this.$content;
                                 if (validateError($content)) return false;

                                 var model = $content.dataBind();
                                 model.ServiceRequestId = serviceRequestId;
                                 var self = this;

                                 $.ajax({
                                     url: '/Panel/Sale/ServiceRequest/AddRepairProductDetail',
                                     type: 'POST',
                                     data: JSON.stringify(model),
                                     contentType: 'application/json',
                                     dataType: 'json',
                                     success: function(r) {
                                         if (!r.isSuccess) {
                                             toastr.error(r.message || 'خطا در ذخیره');
                                             return;
                                         }
                                         toastr.success('با موفقیت ذخیره شد');
                                         refreshServiceRequestDetails();
                                         self.close();
                                     }
                                 });
                                 return false;
                             }
                         },
                         cancel: {
                             text: 'انصراف',
                             btnClass: 'btn-secondary'
                         }
                     }
                 });
             });
         });

         $(document).on('click', '[data-action="editDetail"]', function() {
             var selectedRow = $(this).data('id');
             var serviceRequestId = getServiceRequestId();

             var url = selectedRow
                 ? '/Panel/Sale/ServiceRequest/EditServiceRequest?id=' + selectedRow + '&serviceRequestId=' + serviceRequestId
                 : '/Panel/Sale/ServiceRequest/EditServiceRequest?serviceRequestId=' + serviceRequestId;

             $.get(url, function(html) {
                 var bodyCn = $('<div style="overflow-y:auto;max-height:70vh;"></div>');
                 bodyCn.html(html);
                 initPersionDatePicker(bodyCn);

                 $.confirm({
                     title: selectedRow ? 'ویرایش' : 'افزودن',
                     columnClass: 'col-md-6',
                     content: bodyCn,
                     rtl: true,
                     buttons: {
                         save: {
                             text: 'ذخیره',
                             btnClass: 'btn-success',
                             action: function() {
                                 var $content = this.$content;
                                 if (validateError($content)) return false;

                                 var model = $content.dataBind();
                                 if (model.noticeTime) {
                                     model.NoticeTime = model.noticeTime;
                                 }
                                 delete model.noticetime;
                                 delete model.noticeTime;
                                 model.ServiceRequestId = serviceRequestId;

                                 if (selectedRow) model.Id = selectedRow;

                                 var self = this;
                                 $.ajax({
                                     url: '/Panel/Sale/ServiceRequest/AddRepairProductDetail',
                                     type: 'POST',
                                     data: JSON.stringify(model),
                                     contentType: 'application/json',
                                     dataType: 'json',
                                     success: function(r) {
                                         if (!r.isSuccess) {
                                             toastr.error(r.message || 'خطا');
                                             return;
                                         }
                                         toastr.success(selectedRow ? 'ویرایش انجام شد' : 'با موفقیت ثبت شد');
                                         refreshServiceRequestDetails();
                                         self.close();
                                     }
                                 });
                                 return false;
                             }
                         },
                         cancel: {
                             text: 'انصراف'
                         }
                     }
                 });
             });
         });

         $(document).on('click', '[data-action="deleteDetail"]', function() {
             var id = $(this).data('id');

             $.confirm({
                 title: 'آیا مطمئن هستید؟',
                 content: 'این عملیات قابل بازگشت نیست',
                 type: 'red',
                 icon: 'fa fa-warning',
                 rtl: true,
                 buttons: {
                     confirm: {
                         text: 'حذف',
                         btnClass: 'btn-danger',
                         action: function() {
                             $.ajax({
                                 url: '/Panel/Sale/ServiceRequest/DeleteServiceRequest?id=' + id,
                                 type: 'DELETE',
                                 dataType: 'json',
                                 success: function(res) {
                                     if (res && res.data && res.data.data && res.data.data.success === true) {
                                         toastr.success(res.data.data.message || 'حذف شد');
                                         refreshServiceRequestDetails();
                                     } else {
                                         toastr.error(
                                             (res && res.data && res.data.data && res.data.data.message) || 'خطا در حذف'
                                         );
                                     }
                                 },
                                 error: function() {
                                     toastr.error('خطا در حذف رکورد');
                                 }
                             });
                         }
                     },
                     cancel: {
                         text: 'انصراف',
                         btnClass: 'btn-secondary'
                     }
                 }
             });
         });

         var personelListLoaded = false;

         function loadPersonelsFromApi() {
             if (personelListLoaded) return;

             var serviceRequestId = sessionStorage.getItem("ServiceRequestId") || "@Model?.ServiceRequestId";

             if (!serviceRequestId || serviceRequestId === "0") {
                 toastr.error("شناسه درخواست معتبر نیست.");
                 return;
             }

             var $select = $('#PersonelId');
             if ($select.length === 0) return;
             $select.prop('disabled', true);

             var missionId = $('[data-bind="id"]').val() || "@Model?.Id" || 0;

             var url = "/Panel/Sale/SaleMission/GetMissionPersonelsWithServiceRequest" + "?serviceRequestId=" + encodeURIComponent(serviceRequestId);

             $.get(url, function(response) {
                 $select.prop('disabled', false);

                 var persons = [];
                 if (response && response.isSuccess === true && response.data) {
                     if ($.isArray(response.data)) {
                         persons = response.data;
                     } else if (response.data.data && $.isArray(response.data.data)) {
                         persons = response.data.data;
                     }
                 } else if ($.isArray(response)) {
                     persons = response;
                 }

                 if (response && response.isSuccess === false) {
                     toastr.error(response.message || "خطا در دریافت پرسنل‌های ماموریت");
                     return;
                 }

                 if (persons.length === 0) {
                     toastr.warning("هیچ پرسنلی برای این درخواست یافت نشد.");
                     return;
                 }

                 var selectedId = "@Model?.PersonelId";
                 if (!selectedId || selectedId === "0") {
                     selectedId = $select.val();
                 }

                 $select.empty();
                 $select.append(new Option('انتخاب کنید', ''));
                 $.each(persons, function(i, p) {
                     var fullName = ((p.name || '') + ' ' + (p.family || '')).trim();
                     $select.append(new Option(fullName, p.id));
                 });

                 if (selectedId && selectedId !== '') {
                     $select.val(selectedId);
                 }

                 personelListLoaded = true;

             }).fail(function(xhr) {
                 $select.prop('disabled', false);
                 var msg = "خطا در ارتباط با سرور";
                 if (xhr.responseJSON && xhr.responseJSON.message) {
                     msg = xhr.responseJSON.message;
                 }
                 toastr.error(msg);
             });
         }

         $(document).ready(function() {
             $(document).on('click', '#PersonelId', function() {
                 loadPersonelsFromApi();
             });

             fixFieldTypes();

             $(numericFieldsSelector).each(function() {
                 formatNumberField($(this));
             });

             var serviceRequestId = getServiceRequestId();
             if (serviceRequestId && serviceRequestId !== '0') {
                 loadServiceRequestDetails(serviceRequestId);
             }
         });

         $(self.FormActionButtons.save.element).on('click', function() {savefn(this);});
         $(self.FormActionButtons.saveandnew.element).on('click', function() {savefn(this);});
         $(self.FormActionButtons.saveandclose.element).on('click', function() {savefn(this);});
</script>
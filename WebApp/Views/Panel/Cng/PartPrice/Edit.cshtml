@using Entities.App.Cng
@using Entities.App.Inv
@using Entities.Base
@model PartPrice

<div class="card shadow-sm border-0">
	<div class="form-action-buttons border-bottom p-3">
		<form-action-buttons entity-type="typeof(PartPrice)"></form-action-buttons>
	</div>
	<div class="card-body">
		<div class="row mb-4"><div class="col-12"><h4 class="fw-bold text-dark mb-0">مدیریت قیمت قطعات</h4></div></div>
		<input class="form-control" data-bind="id" value="@Model?.Id" type="hidden" />
		<input class="form-control" data-bind="htsId" value="@Model?.HtsId" type="hidden" />
		<div class="row g-3">
			<div class="col-md-6 form-group-inline">
				<label class="form-label fw-bold required">کالا</label>
				@(Html.EntitySelector<Part>(
					"CngPartPricePartSelector",
					c => c.IsActive == IsActiveEnum.Active,
					c => new { Id = c.Id, Name = c.Name, Code = c.Code },
					c => new { c.Name, c.Code },
					"{Code} {Name}",
					"partId",
					"partName",
					Model?.PartId > 0 ? Model.PartId.ToString() : null,
					true
				))
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold required">قیمت</label>
				<input type="text" class="form-control" data-bind="price" data-money="true" data-required="true" asp-for="Price" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-3 form-group-inline">
				<label class="form-label fw-bold">تاریخ بروزرسانی</label>
				<input class="form-control" data-bind="updatedDateShamsi" data-persionDatePicker="true"
					   persion-datetimepicker='{"format":"YYYY/MM/DD","autoClose": true,"initialValue": false}'
					   value="@Model?.UpdatedDate" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-2 form-group-inline">
				<label class="form-label fw-bold">داخلی</label>
				<input class="form-check-input mt-2" type="checkbox" data-bind="isInternal" asp-for="IsInternal" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-2 form-group-inline">
				<label class="form-label fw-bold">خارجی</label>
				<input class="form-check-input mt-2" type="checkbox" data-bind="isExternal" asp-for="IsExternal" />
				<div data-invalidmessagespan class="my-1 mx-1"><span class="text-danger"></span></div>
			</div>
			<div class="col-md-12 form-group-inline">
				<label class="form-label fw-bold">کامنت</label>
				<textarea class="form-control" data-bind="comment" asp-for="Comment" rows="3"></textarea>
			</div>
			<div class="col-md-12 form-group-inline">
				<label class="form-label fw-bold">توضیحات (شخصی)</label>
				<textarea class="form-control" data-bind="description" asp-for="Description" rows="3"></textarea>
			</div>
		</div>
	</div>
</div>
<script>
	function savefn($btnAction) {
		if (validateError(page.$pageEl)) return;
		const model = page.$pageEl.dataBind();
		if (!model.partId || model.partId === '0' || model.partId === 0) {
			toastr.error('کالا نمی‌تواند خالی باشد', 'خطا');
			return;
		}
		if (model.price === null || model.price === undefined || model.price === '') {
			toastr.error('قیمت نمی‌تواند خالی باشد', 'خطا');
			return;
		}
		const $btn = $($btnAction.element).block();
		$$.post('save', model, function (r) {
			$btn.block(false);
			if (!r.isSuccess) { toastr.error(r.message, 'خطا'); return; }
			toastr.success('ذخیره سازی با موفقیت انجام شد');
			page.$pageEl.dataBind(r.data);
			$btnAction.baseaction();
		});
	}
	self.FormActionButtons.save.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandnew.onclick(function () { savefn(this); });
	self.FormActionButtons.saveandclose.onclick(function () { savefn(this); });
</script>
